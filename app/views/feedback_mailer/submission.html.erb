<p style="margin:0 0 12px;font-family:system-ui,sans-serif;font-size:14px;color:#334155;">
  <strong>From:</strong> <%= @user&.email_address.presence || "Anonymous visitor" %><br>
  <% if @feedback.page_context.present? %>
    <strong>Page:</strong> <%= @feedback.page_context %><br>
  <% end %>
  <% if @feedback.app_version.present? %>
    <strong>App version:</strong> <%= @feedback.app_version %><br>
  <% end %>
  <% if @feedback.rating.present? %>
    <strong>Rating:</strong> <%= @feedback.rating %>/5<br>
  <% end %>
  <% if @feedback.ok_to_contact? %>
    <strong>OK to contact:</strong> yes — <%= @feedback.contact_info.presence || "no detail shared" %><br>
  <% else %>
    <strong>OK to contact:</strong> no<br>
  <% end %>
  <strong>Sent:</strong> <%= @feedback.created_at.utc.strftime("%Y-%m-%d %H:%M UTC") %>
</p>

<p style="margin:0;font-family:system-ui,sans-serif;font-size:16px;line-height:1.5;color:#0f172a;white-space:pre-wrap;"><%= @feedback.body %></p>
