<% if @uncompleted %>
  <%= turbo_stream.append "today-battlefield-rows" do %>
    <%= render "dashboard/dash_battlefield_row",
          todo: @todo,
          mission: nil,
          journey: @journey %>
  <% end %>
<% else %>
  <%= turbo_stream.remove dom_id(@todo, :battlefield_row) %>
<% end %>

<%= turbo_stream.update "today-battlefield-count" do %>
  <%= t("dash.battlefield.count",
        done: @battlefield_health.done_count,
        total: @battlefield_health.total_count) %>
<% end %>

<%= turbo_stream.update "today-battles-waiting-host" do %>
  <% if @battles_waiting_count.to_i.positive? && !@battlefield_health.all_clear? %>
    <p class="lp-today-v2-waiting" id="today-battles-waiting" role="status">
      <%= t("dash.battlefield.more_waiting", count: @battles_waiting_count) %>
    </p>
  <% end %>
<% end %>

<%= turbo_stream.replace "today-battlefield-header" do %>
  <%= render "dashboard/dash_battlefield_header",
        health: @battlefield_health,
        streak: @climb_streak %>
<% end %>

<% if @battlefield_health.all_clear? %>
  <%= turbo_stream.replace "today-battlefield-body" do %>
    <div id="today-battlefield-body">
      <div id="today-battlefield-inline-ack-host">
        <%= render "dashboard/dash_battlefield_inline_ack", variant: :battles %>
      </div>
    </div>
  <% end %>
<% end %>

<% if habits_enabled? %>
  <%= turbo_stream.replace "today-anytime-host" do %>
    <div id="today-anytime-host">
      <%= render "dashboard/dash_anytime", habits: @habits %>
    </div>
  <% end %>
<% end %>

<% if @end_of_day_ready || @battlefield_day_ended %>
  <%= turbo_stream.replace "today-end-of-day-host" do %>
    <div id="today-end-of-day-host">
      <%= render "dashboard/dash_end_of_day",
            health: @battlefield_health,
            streak: @climb_streak,
            step: @eod_step,
            recap_share: @recap_share %>
    </div>
  <% end %>
<% else %>
  <%= turbo_stream.replace "today-end-of-day-host" do %>
    <div id="today-end-of-day-host"></div>
  <% end %>
<% end %>

<% unless @battlefield_health.empty? %>
  <%= turbo_stream.replace "today-battlefield-mountain-link" do %>
    <%= render "dashboard/dash_battlefield_mountain_link",
          health: @battlefield_health,
          journey: @journey %>
  <% end %>
<% end %>

<%= turbo_stream.replace "today-dash-nav" do %>
  <%= render "shared/lp_dash_nav_today_v2",
        active: :today,
        notch: {
          open_count: @battle_open_count,
          day_ended: @battlefield_day_ended,
          all_clear: @battlefield_health.all_clear?,
          recap_share_text: @recap_share
        } %>
<% end %>

<% unless @uncompleted %>
  <%= turbo_stream.append "body" do %>
    <div data-controller="battle-day-stream-bridge"
         data-battle-day-stream-bridge-celebrate-value="<%= @stream_celebrate %>"
         data-battle-day-stream-bridge-ap-gained-value="<%= @stream_ap_gained %>"
         data-battle-day-stream-bridge-boss-value="<%= @stream_boss %>"
         data-battle-day-stream-bridge-all-clear-value="<%= @battlefield_health.all_clear? %>"
         data-battle-day-stream-bridge-win-number-value="<%= @stream_win_number %>"
         data-battle-day-stream-bridge-push-offer-eligible-value="<%= @stream_push_offer_eligible %>"
         hidden></div>
  <% end %>

  <% if @stream_climb_reward.present? %>
    <%= turbo_stream.update "climb-reward-host" do %>
      <%= render "shared/climb_reward", reward: @stream_climb_reward %>
    <% end %>
  <% end %>
<% end %>
