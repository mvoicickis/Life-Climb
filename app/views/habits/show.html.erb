<% content_for :title, @habit.name %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>
<% status = @habit.status %>
<% progress = @habit.goal_progress_percent %>
<% saved = params[:saved].present? %>
<% won = params[:won] == "1" %>

<div class="lp-habits mx-auto max-w-lg"
     data-controller="save-pop share"
     data-save-pop-saved-value="<%= saved %>"
     data-save-pop-won-value="<%= won %>"
     data-share-text-value="<%= share_message_body_for(@habit) %>"
     data-share-url-value="<%= share_landing_url %>"
     data-share-title-value="<%= @habit.name %> · LifePoints">
  <%= link_to t("habits.back_list"), habits_path, class: "lp-habits__back" %>

  <article id="detail-card"
           class="lp-habits__detail has-color is-amber <%= 'pop-save' if saved %> <%= 'glow-win' if won %>">
    <div class="lp-habits__detail-top">
      <div>
        <% if @habit.identity_label.present? %>
          <p class="lp-habit-identity"><%= @habit.identity_label %></p>
        <% end %>
        <h1 class="lp-habits__detail-title"><%= @habit.name %></h1>
        <p class="lp-habits__meta">
          <%= @habit.unit %> · <%= @habit.evaluation_label %>
        </p>
        <% if @habit.life_journey.present? %>
          <p class="lp-habits__mountain">
            <%= t("habits.linked_mountain", title: @habit.life_journey.title) %>
          </p>
        <% end %>
      </div>
      <%= render "shared/status_badge", status: status %>
    </div>

    <% if @milestone_label.present? %>
      <p class="lp-habits__milestone"><%= @milestone_label %></p>
    <% end %>

    <p class="lp-habits__status-lead"><%= status_full_text(status) %></p>

    <% if @habit.filed? && @habit.tracker_state_label.present? %>
      <p class="lp-areas__state is-<%= @habit.state.presence || 'unset' %>">
        <%= @habit.tracker_state_label %>
      </p>
    <% end %>

    <% if @sparkline&.any? %>
      <div class="lp-tracker-spark-wrap" aria-label="<%= t('habits.sparkline_label') %>">
        <p class="lp-habits__stat-label"><%= t("habits.sparkline_label") %></p>
        <%= render "habits/sparkline", values: @sparkline %>
      </div>
    <% end %>

    <div class="lp-habits__stats">
      <div>
        <p class="lp-habits__stat-label"><%= t("habits.today") %></p>
        <p class="lp-habits__stat-value"><%= format_amount(@habit.today_amount) %></p>
      </div>
      <div class="lp-habits__stats-side">
        <% if @habit.better_than_yesterday? %>
          <p class="lp-habits__stat-label"><%= t("habits.yesterday") %></p>
          <p class="lp-habits__stat-side"><%= format_amount(@habit.yesterday_amount) %></p>
          <% if @habit.goal.present? %>
            <p class="lp-habits__meta"><%= t("habits.goal", value: format_amount(@habit.goal)) %></p>
          <% end %>
        <% else %>
          <p class="lp-habits__stat-label"><%= t("habits.healthy_range") %></p>
          <p class="lp-habits__stat-side"><%= @habit.range_summary %></p>
        <% end %>
      </div>
    </div>

    <% if progress && @habit.better_than_yesterday? && @habit.goal.present? %>
      <div class="lp-habits__progress">
        <div class="lp-habits__progress-labels">
          <span><%= t("habits.toward_goal") %></span>
          <span><%= progress %>%</span>
        </div>
        <div class="lp-habits__progress-track">
          <div class="lp-habits__progress-fill" style="width: <%= habit_progress_bar_width(progress) %>%"></div>
        </div>
      </div>
    <% end %>

    <p class="lp-habits__hint"><%= t("habits.zero_counts") %></p>

    <% if @habit.show_goal_raise_prompt? %>
      <div class="lp-habits__raise">
        <p class="lp-habits__raise-title"><%= t("habits.raise_title") %></p>
        <p class="lp-habits__meta">
          <%= t("habits.raise_hit", value: format_amount(@habit.goal), unit: @habit.unit) %>
        </p>
        <div class="lp-habits__raise-actions">
          <%= button_to t("habits.raise_confirm"), raise_goal_habit_path(@habit), method: :patch,
              class: "lp-habits__btn is-primary" %>
          <%= button_to t("habits.raise_keep"), decline_goal_raise_habit_path(@habit), method: :patch,
              class: "lp-habits__btn is-quiet" %>
        </div>
      </div>
    <% end %>

    <%= form_with url: daily_logs_path(habit_id: @habit.id), scope: :daily_log, class: "lp-habits__log", data: { turbo: false } do |form| %>
      <%= hidden_field_tag :mode, "set" %>
      <%= form.label :amount, t("habits.how_many"), class: "lp-habits__field-label" %>
      <%= form.number_field :amount,
          value: format_amount(@habit.today_log&.amount || 0),
          min: 0,
          step: @habit.quantity_input_step,
          inputmode: @habit.quantity_inputmode,
          class: "lp-habits__input" %>
      <%= form.submit t("habits.save"), class: "lp-habits__btn is-primary is-wide" %>
    <% end %>

    <div class="lp-habits__detail-actions">
      <button type="button"
              data-action="click->share#open"
              class="lp-habits__btn is-quiet <%= 'is-highlight' if @share_worthy %>">
        <%= t("habits.share") %>
      </button>
      <%= link_to t("habits.edit"), edit_habit_path(@habit), class: "lp-habits__btn is-quiet" %>
    </div>
  </article>

  <%= render "habits/tracker_state", habit: @habit, projects: @improvement_projects %>

  <%= render "shared/share_sheet" %>
</div>

<%= render "shared/lp_dash_nav", active: :habits %>
