<% content_for :title, @habit.name %>
<% status = @habit.vs_yesterday %>
<% goal = @habit.todays_goal_value %>
<% progress = @habit.goal_progress_percent %>
<% saved = params[:saved].present? %>
<% won = params[:won] == "1" %>

<div class="mx-auto max-w-lg"
     data-controller="save-pop"
     data-save-pop-saved-value="<%= saved %>"
     data-save-pop-won-value="<%= won %>">
  <%= link_to "← Home", dashboard_path, class: "mb-4 inline-block text-sm font-bold text-slate-600 hover:text-emerald-700" %>

  <article id="detail-card"
           class="overflow-hidden rounded-3xl border-2 p-5 shadow-sm <%= vs_yesterday_classes(status) %> <%= 'pop-save' if saved %> <%= 'glow-win' if won %>">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h1 class="text-3xl font-black tracking-tight"><%= @habit.name %></h1>
        <p class="text-sm font-bold opacity-70"><%= @habit.unit %></p>
      </div>
      <span class="rounded-2xl px-3 py-2 text-xs font-black <%= vs_yesterday_badge_class(status) %>">
        <%= vs_yesterday_short(status) %>
      </span>
    </div>

    <div class="mt-6 flex items-end justify-between gap-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wide opacity-60">Today</p>
        <p class="text-5xl font-black leading-none"><%= format_amount(@habit.today_amount) %></p>
      </div>
      <div class="text-right">
        <p class="text-xs font-bold uppercase tracking-wide opacity-60">Goal</p>
        <p class="text-2xl font-black"><%= format_amount(goal) %></p>
        <p class="text-xs font-bold opacity-70">Yesterday <%= format_amount(@habit.yesterday_amount) %></p>
      </div>
    </div>

    <div class="mt-5">
      <div class="mb-2 flex justify-between text-xs font-bold uppercase tracking-wide opacity-70">
        <span>Goal bar</span>
        <span><%= progress %>%</span>
      </div>
      <div class="h-4 overflow-hidden rounded-full bg-black/10">
        <div class="bar-fill h-full rounded-full <%= vs_yesterday_bar_class(status) %>" style="width: <%= progress %>%"></div>
      </div>
      <p class="mt-2 text-sm font-bold"><%= @habit.vs_yesterday_label %></p>
      <p class="mt-1 text-xs font-semibold opacity-60">No number today? It counts as 0.</p>
    </div>

    <%= form_with url: daily_logs_path(habit_id: @habit.id), scope: :daily_log, class: "mt-6 space-y-3", data: { turbo: false } do |form| %>
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <%= form.label :amount, "How many today?", class: "mb-1 block text-sm font-bold" %>
          <%= form.number_field :amount,
              value: @habit.today_log&.amount || 0,
              min: 0,
              step: :any,
              class: "w-full rounded-2xl border-2 border-black/10 bg-white px-4 py-3 text-xl font-black focus:border-emerald-500 focus:outline-none" %>
        </div>
        <div>
          <%= form.label :goal, "Today's goal", class: "mb-1 block text-sm font-bold" %>
          <%= form.number_field :goal,
              value: goal,
              min: 0,
              step: :any,
              class: "w-full rounded-2xl border-2 border-black/10 bg-white px-4 py-3 text-xl font-black focus:border-emerald-500 focus:outline-none" %>
        </div>
      </div>

      <%= form.submit "Save",
          class: "w-full cursor-pointer rounded-2xl bg-slate-900 px-4 py-4 text-lg font-black text-white hover:bg-slate-800" %>
    <% end %>

    <p class="mt-3 text-xs font-semibold opacity-60">
      Goal grows a little each day (+1%). You can change it.
    </p>

    <div class="mt-5 flex gap-2">
      <%= link_to "Edit", edit_habit_path(@habit), class: "rounded-xl border-2 border-black/10 bg-white/70 px-3 py-2 text-sm font-bold" %>
    </div>
  </article>
</div>
