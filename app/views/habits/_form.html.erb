<%
  target_enabled = habit.healthy_range? || habit.goal.present?
  initial_type = habit.stat_type.presence || "growth"
%>
<%= form_with model: habit,
    class: "space-y-6",
    data: {
      turbo: false,
      controller: "stat-type",
      stat_type_type_value: initial_type,
      stat_type_enabled_value: target_enabled
    } do |form| %>
  <% if habit.errors.any? %>
    <div class="rounded-2xl border-2 border-rose-300 bg-rose-50 px-4 py-3 font-bold text-rose-900">
      <ul class="list-inside list-disc">
        <% habit.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "What matters to you?", class: "mb-1.5 block text-sm font-bold text-slate-800" %>
    <%= form.text_field :name,
        placeholder: "Push-ups, Sleep, Pages read...",
        class: "w-full rounded-2xl border-2 border-slate-200 px-4 py-3.5 text-lg font-bold focus:border-emerald-500 focus:outline-none" %>
  </div>

  <div>
    <%= form.label :unit, "What are you counting?", class: "mb-1.5 block text-sm font-bold text-slate-800" %>
    <%= form.text_field :unit,
        list: "count-ideas",
        placeholder: "reps, hours, pages, steps...",
        class: "w-full rounded-2xl border-2 border-slate-200 px-4 py-3.5 text-lg font-bold focus:border-emerald-500 focus:outline-none" %>
    <datalist id="count-ideas">
      <% Habit::UNIT_IDEAS.each do |idea| %>
        <option value="<%= idea %>"></option>
      <% end %>
    </datalist>
  </div>

  <div>
    <%= form.label :description, "Note (optional)", class: "mb-1.5 block text-sm font-bold text-slate-800" %>
    <%= form.text_area :description, rows: 2,
        class: "w-full rounded-2xl border-2 border-slate-200 px-4 py-3 font-semibold focus:border-emerald-500 focus:outline-none" %>
  </div>

  <label class="flex cursor-pointer items-center justify-between gap-4 rounded-3xl border-2 border-slate-200 bg-white px-5 py-4">
    <span>
      <span class="block font-black text-slate-900">Enable a target</span>
      <span class="mt-1 block text-sm font-semibold text-slate-500">
        Off = just log numbers and compare with yesterday.
      </span>
    </span>
    <input type="checkbox"
           class="h-5 w-5 rounded border-slate-300 text-emerald-600"
           <%= "checked" if target_enabled %>
           data-stat-type-target="enabled"
           data-action="change->stat-type#toggleEnabled">
  </label>

  <div data-stat-type-target="targetPanel" class="space-y-4" <%= "hidden" unless target_enabled %>>
    <fieldset class="space-y-3">
      <legend class="text-sm font-bold text-slate-800">How should we judge today?</legend>

      <label class="flex cursor-pointer items-start gap-3 rounded-3xl border-2 border-slate-200 bg-white p-4 transition has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50">
        <%= form.radio_button :stat_type, "growth",
            class: "mt-1 h-4 w-4 text-emerald-600",
            data: { stat_type_target: "typeInput", action: "change->stat-type#changeType" } %>
        <span>
          <span class="block text-base font-black text-slate-900">Better Than Yesterday</span>
          <span class="mt-1 block text-sm font-semibold text-slate-600">
            Higher is better. Same is same. Lower is worse.
          </span>
        </span>
      </label>

      <label class="flex cursor-pointer items-start gap-3 rounded-3xl border-2 border-slate-200 bg-white p-4 transition has-[:checked]:border-sky-500 has-[:checked]:bg-sky-50">
        <%= form.radio_button :stat_type, "standard",
            class: "mt-1 h-4 w-4 text-sky-600",
            data: { stat_type_target: "typeInput", action: "change->stat-type#changeType" } %>
        <span>
          <span class="block text-base font-black text-slate-900">Healthy Range</span>
          <span class="mt-1 block text-sm font-semibold text-slate-600">
            Stay inside your ideal min / max (sleep, water, screen time…).
          </span>
        </span>
      </label>
    </fieldset>

    <div data-stat-type-target="growthFields" class="space-y-3 rounded-3xl border-2 border-emerald-100 bg-emerald-50/60 p-5">
      <%= form.label :goal, "Stretch goal (optional)", class: "mb-1.5 block text-sm font-bold text-slate-800" %>
      <%= form.number_field :goal,
          min: 0,
          step: :any,
          placeholder: "e.g. 50",
          class: "w-full rounded-2xl border-2 border-slate-200 bg-white px-4 py-3 text-lg font-bold focus:border-emerald-500 focus:outline-none" %>
      <p class="text-xs font-semibold text-slate-600">Leave blank to only compare with yesterday.</p>
    </div>

    <div data-stat-type-target="standardFields" class="space-y-4 rounded-3xl border-2 border-sky-100 bg-sky-50/60 p-5" hidden>
      <p class="text-sm font-black text-sky-950">Your healthy range</p>
      <p class="text-xs font-semibold text-slate-600">Set a minimum, a maximum, or both.</p>
      <div>
        <%= form.label :min_value, "Minimum", class: "mb-1.5 block text-sm font-bold text-slate-800" %>
        <%= form.number_field :min_value,
            step: :any,
            placeholder: "e.g. 8",
            class: "w-full rounded-2xl border-2 border-slate-200 bg-white px-4 py-3 text-lg font-bold focus:border-sky-500 focus:outline-none" %>
      </div>
      <div>
        <%= form.label :max_value, "Maximum", class: "mb-1.5 block text-sm font-bold text-slate-800" %>
        <%= form.number_field :max_value,
            step: :any,
            placeholder: "e.g. 9",
            class: "w-full rounded-2xl border-2 border-slate-200 bg-white px-4 py-3 text-lg font-bold focus:border-sky-500 focus:outline-none" %>
      </div>
    </div>
  </div>

  <%= form.hidden_field :points, value: habit.points.presence || 5 %>
  <%= form.hidden_field :frequency, value: "daily" %>
  <% unless habit.persisted? %>
    <%= form.hidden_field :show_on_home, value: true %>
    <%= form.hidden_field :active, value: true %>
  <% end %>

  <% if habit.persisted? %>
    <div class="flex flex-wrap gap-4 rounded-3xl border-2 border-slate-100 bg-slate-50/80 px-5 py-4">
      <label class="inline-flex items-center gap-2">
        <%= form.check_box :show_on_home, class: "h-5 w-5 rounded border-slate-300 text-emerald-600" %>
        <span class="text-sm font-bold text-slate-800">Show on Home</span>
      </label>
      <label class="inline-flex items-center gap-2">
        <%= form.check_box :active, class: "h-5 w-5 rounded border-slate-300 text-emerald-600" %>
        <span class="text-sm font-bold text-slate-800">On</span>
      </label>
    </div>
  <% end %>

  <div class="flex gap-3 pt-1">
    <%= form.submit "Save",
        class: "cursor-pointer rounded-2xl bg-emerald-500 px-5 py-3.5 font-black text-white hover:bg-emerald-600" %>
    <%= link_to "Cancel", habit.persisted? ? habits_path : dashboard_path,
        class: "rounded-2xl border-2 border-slate-200 px-5 py-3.5 font-bold text-slate-700" %>
  </div>
<% end %>
