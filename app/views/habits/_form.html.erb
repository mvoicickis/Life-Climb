<%
  journeys = local_assigns.fetch(:journeys) { @journeys || [] }
  areas = local_assigns.fetch(:areas) { @areas || [] }
  target_enabled = habit.healthy_range? || habit.goal.present?
  initial_type = habit.stat_type.presence || "growth"
%>
<%= form_with model: habit,
    class: "lp-habits-form",
    data: {
      turbo: false,
      controller: "stat-type",
      stat_type_type_value: initial_type,
      stat_type_enabled_value: target_enabled
    } do |form| %>
  <% if habit.errors.any? %>
    <div class="lp-habits-form__errors">
      <ul>
        <% habit.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="lp-habits-form__field">
    <%= form.label :name, t("habits.name_label"), class: "lp-habits__field-label" %>
    <%= form.text_field :name,
        placeholder: t("habits.name_placeholder"),
        class: "lp-habits__input" %>
  </div>

  <div class="lp-habits-form__field">
    <%= form.label :identity_label, t("habits.identity_label"), class: "lp-habits__field-label" %>
    <%= form.text_field :identity_label,
        placeholder: t("habits.identity_placeholder"),
        maxlength: 120,
        class: "lp-habits__input" %>
    <p class="lp-habits__hint"><%= t("habits.identity_hint") %></p>
  </div>

  <div class="lp-habits-form__field">
    <%= form.label :unit, t("habits.unit_label"), class: "lp-habits__field-label" %>
    <%= form.text_field :unit,
        list: "count-ideas",
        placeholder: t("habits.unit_placeholder"),
        class: "lp-habits__input" %>
    <datalist id="count-ideas">
      <% Habit::UNIT_IDEAS.each do |idea| %>
        <option value="<%= idea %>"></option>
      <% end %>
    </datalist>
  </div>

  <div class="lp-habits-form__field">
    <%= form.label :area_id, t("habits.area_label"), class: "lp-habits__field-label" %>
    <%= form.collection_select :area_id,
          areas,
          :id,
          :name,
          { include_blank: t("habits.area_none") },
          class: "lp-habits__input is-select" %>
    <p class="lp-habits__hint"><%= t("habits.area_hint") %></p>
  </div>

  <div class="lp-habits-form__field">
    <%= form.label :description, t("habits.note_label"), class: "lp-habits__field-label" %>
    <%= form.text_area :description, rows: 2, class: "lp-habits__input is-area" %>
  </div>

  <div class="lp-habits-form__field">
    <%= form.label :life_journey_id, t("habits.mountain_label"), class: "lp-habits__field-label" %>
    <%= form.collection_select :life_journey_id,
          journeys,
          :id,
          :title,
          { include_blank: t("habits.mountain_none") },
          class: "lp-habits__input is-select" %>
    <p class="lp-habits__hint"><%= t("habits.mountain_hint") %></p>
  </div>

  <label class="lp-habits-form__toggle">
    <span>
      <span class="lp-habits-form__toggle-title"><%= t("habits.enable_target") %></span>
      <span class="lp-habits__meta"><%= t("habits.enable_target_hint") %></span>
    </span>
    <input type="checkbox"
           class="lp-habits-form__checkbox"
           <%= "checked" if target_enabled %>
           data-stat-type-target="enabled"
           data-action="change->stat-type#toggleEnabled">
  </label>

  <div data-stat-type-target="targetPanel" class="lp-habits-form__targets" <%= "hidden" unless target_enabled %>>
    <fieldset class="lp-habits-form__fieldset">
      <legend class="lp-habits__field-label"><%= t("habits.judge_legend") %></legend>

      <label class="lp-habits-form__choice">
        <%= form.radio_button :stat_type, "growth",
            class: "lp-habits-form__radio",
            data: { stat_type_target: "typeInput", action: "change->stat-type#changeType" } %>
        <span>
          <span class="lp-habits-form__choice-title"><%= t("habits.growth_title") %></span>
          <span class="lp-habits__meta"><%= t("habits.growth_body") %></span>
        </span>
      </label>

      <label class="lp-habits-form__choice">
        <%= form.radio_button :stat_type, "standard",
            class: "lp-habits-form__radio",
            data: { stat_type_target: "typeInput", action: "change->stat-type#changeType" } %>
        <span>
          <span class="lp-habits-form__choice-title"><%= t("habits.range_title") %></span>
          <span class="lp-habits__meta"><%= t("habits.range_body") %></span>
        </span>
      </label>
    </fieldset>

    <div data-stat-type-target="growthFields" class="lp-habits-form__panel is-growth">
      <%= form.label :goal, t("habits.stretch_goal"), class: "lp-habits__field-label" %>
      <%= form.number_field :goal,
          min: 0,
          step: :any,
          placeholder: t("habits.example_number", n: 50),
          class: "lp-habits__input" %>
      <p class="lp-habits__hint"><%= t("habits.stretch_hint") %></p>
    </div>

    <div data-stat-type-target="standardFields" class="lp-habits-form__panel is-range" hidden>
      <p class="lp-habits-form__choice-title"><%= t("habits.range_heading") %></p>
      <p class="lp-habits__hint"><%= t("habits.range_hint") %></p>
      <div class="lp-habits-form__field">
        <%= form.label :min_value, t("habits.minimum"), class: "lp-habits__field-label" %>
        <%= form.number_field :min_value, step: :any, placeholder: t("habits.example_number", n: 8), class: "lp-habits__input" %>
      </div>
      <div class="lp-habits-form__field">
        <%= form.label :max_value, t("habits.maximum"), class: "lp-habits__field-label" %>
        <%= form.number_field :max_value, step: :any, placeholder: t("habits.example_number", n: 9), class: "lp-habits__input" %>
      </div>
    </div>
  </div>

  <%= form.hidden_field :points, value: habit.points.presence || 5 %>
  <%= form.hidden_field :frequency, value: "daily" %>
  <% unless habit.persisted? %>
    <%= form.hidden_field :show_on_home, value: true %>
    <%= form.hidden_field :active, value: true %>
  <% end %>

  <% if habit.persisted? %>
    <div class="lp-habits-form__flags">
      <label class="lp-habits-form__flag">
        <%= form.check_box :show_on_home, class: "lp-habits-form__checkbox" %>
        <span><%= t("habits.show_on_today") %></span>
      </label>
      <label class="lp-habits-form__flag">
        <%= form.check_box :hidden_from_dashboard, class: "lp-habits-form__checkbox" %>
        <span><%= t("habits.hide_from_journey") %></span>
      </label>
      <label class="lp-habits-form__flag">
        <%= form.check_box :active, class: "lp-habits-form__checkbox" %>
        <span><%= t("habits.active") %></span>
      </label>
    </div>
  <% end %>

  <div class="lp-habits-form__actions">
    <%= form.submit t("habits.save"), class: "lp-habits__btn is-primary" %>
    <%= link_to t("habits.cancel"), habits_path,
        class: "lp-habits__btn is-quiet" %>
  </div>
<% end %>
