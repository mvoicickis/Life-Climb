<%= form_with model: habit, class: "space-y-4", data: { turbo: false } do |form| %>
  <% if habit.errors.any? %>
    <div class="rounded-2xl border-2 border-rose-300 bg-rose-50 px-4 py-3 font-bold text-rose-900">
      <ul class="list-inside list-disc">
        <% habit.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "What is it called?", class: "mb-1 block text-sm font-bold" %>
    <%= form.text_field :name,
        placeholder: "Move, Sleep, Water, Income...",
        class: "w-full rounded-2xl border-2 border-slate-200 px-4 py-3 text-lg font-bold focus:border-emerald-500 focus:outline-none" %>
  </div>

  <div>
    <%= form.label :unit, "What are you counting?", class: "mb-1 block text-sm font-bold" %>
    <%= form.text_field :unit,
        list: "count-ideas",
        placeholder: "steps, pages, money...",
        class: "w-full rounded-2xl border-2 border-slate-200 px-4 py-3 text-lg font-bold focus:border-emerald-500 focus:outline-none" %>
    <datalist id="count-ideas">
      <% Habit::UNIT_IDEAS.each do |idea| %>
        <option value="<%= idea %>"></option>
      <% end %>
    </datalist>
    <p class="mt-1 text-xs font-semibold text-slate-500">Pick an idea or type your own word.</p>
  </div>

  <div>
    <%= form.label :description, "Note (optional)", class: "mb-1 block text-sm font-bold" %>
    <%= form.text_area :description, rows: 2,
        class: "w-full rounded-2xl border-2 border-slate-200 px-4 py-3 font-semibold focus:border-emerald-500 focus:outline-none" %>
  </div>

  <%= form.hidden_field :points, value: habit.points.presence || 5 %>
  <%= form.hidden_field :frequency, value: "daily" %>

  <div class="flex items-center gap-2">
    <%= form.check_box :show_on_home, class: "h-5 w-5 rounded border-slate-300 text-emerald-600" %>
    <%= form.label :show_on_home, "Show on Home", class: "text-sm font-bold" %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.check_box :active, class: "h-5 w-5 rounded border-slate-300 text-emerald-600" %>
    <%= form.label :active, "On", class: "text-sm font-bold" %>
  </div>

  <div class="flex gap-3 pt-2">
    <%= form.submit "Save",
        class: "cursor-pointer rounded-2xl bg-emerald-500 px-5 py-3 font-black text-white hover:bg-emerald-600" %>
    <%= link_to "Cancel", habits_path, class: "rounded-2xl border-2 border-slate-200 px-5 py-3 font-bold text-slate-700" %>
  </div>
<% end %>
