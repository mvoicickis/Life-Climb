<%# locals: habit %>
<% return unless habit.filed? %>

<section class="lp-tracker-state" aria-label="<%= t('habits.state_section') %>">
  <header class="lp-tracker-state__head">
    <h2><%= t("habits.state_section") %></h2>
    <p><%= t("habits.state_hint") %></p>
  </header>

  <%= form_with model: habit, url: habit_path(habit), method: :patch, class: "lp-tracker-state__form", data: { turbo: false } do |form| %>
    <%= hidden_field_tag :return_to, "show" %>

    <fieldset class="lp-tracker-state__choices">
      <legend class="sr-only"><%= t("habits.state_section") %></legend>
      <label class="lp-tracker-state__choice <%= 'is-active' if habit.state == 'good' %>">
        <%= form.radio_button :state, "good", class: "sr-only" %>
        <span><%= habit.state_label_good.presence || t("habits.state_fallback_good") %></span>
      </label>
      <label class="lp-tracker-state__choice <%= 'is-active' if habit.state == 'attention' %>">
        <%= form.radio_button :state, "attention", class: "sr-only" %>
        <span><%= habit.state_label_attention.presence || t("habits.state_fallback_attention") %></span>
      </label>
      <label class="lp-tracker-state__choice <%= 'is-active' if habit.state.blank? %>">
        <%= form.radio_button :state, "", class: "sr-only", checked: habit.state.blank? %>
        <span><%= t("habits.state_unset") %></span>
      </label>
    </fieldset>

    <div class="lp-tracker-state__labels">
      <div class="lp-habits-form__field">
        <%= form.label :state_label_good, t("habits.state_label_good"), class: "lp-habits__field-label" %>
        <%= form.text_field :state_label_good,
            placeholder: t("habits.state_fallback_good"),
            maxlength: 80,
            class: "lp-habits__input" %>
      </div>
      <div class="lp-habits-form__field">
        <%= form.label :state_label_attention, t("habits.state_label_attention"), class: "lp-habits__field-label" %>
        <%= form.text_field :state_label_attention,
            placeholder: t("habits.state_fallback_attention"),
            maxlength: 80,
            class: "lp-habits__input" %>
      </div>
    </div>

    <%= form.submit t("habits.save_state"), class: "lp-habits__btn is-primary is-wide" %>
  <% end %>

  <% if habit.attention? %>
    <div class="lp-tracker-state__improve">
      <%= button_to t("areas.improve.cta"),
            habit_improvement_projects_path(habit),
            method: :post,
            class: "lp-habits__btn is-primary is-wide",
            data: { turbo: false } %>
      <p class="lp-habits__hint"><%= t("areas.improve.hint") %></p>
    </div>
  <% end %>

  <% if local_assigns[:projects].present? %>
    <ul class="lp-tracker-state__projects">
      <% projects.each do |project| %>
        <li>
          <% if project.life_journey %>
            <%= link_to t("areas.improve.open_project", title: project.title),
                  life_journey_path(project.life_journey, focus_id: project.id),
                  class: "lp-habits__btn is-quiet is-wide" %>
          <% else %>
            <span class="lp-habits__meta"><%= project.title %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
