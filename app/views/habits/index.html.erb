<% content_for :title, t("habits.index_title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>

<% if flash[:turbo_clear_cache] %>
  <div data-controller="turbo-cache"
       data-turbo-cache-clear-value="true"
       hidden
       aria-hidden="true"></div>
<% end %>

<div class="lp-habits mx-auto max-w-lg px-4 pb-28 pt-5">
  <header class="lp-habits__head">
    <div class="lp-habits__head-copy">
      <p class="lp-habits__eyebrow"><%= t("dash.section_habits") %></p>
      <h1 class="lp-habits__title"><%= t("habits.index_title") %></h1>
      <p class="lp-habits__sub"><%= t("habits.index_subtitle") %></p>
    </div>
    <%= link_to t("dashboard.add"), new_habit_path, class: "lp-habits__add" %>
  </header>

  <% if @habits.any? %>
    <ul class="lp-habits__list">
      <% @habits.each do |habit| %>
        <% status = habit.status %>
        <li class="lp-habits__card has-color is-amber <%= 'is-off' unless habit.active? %>">
          <div class="lp-habits__card-main">
            <div class="lp-habits__card-copy">
              <% if habit.identity_label.present? %>
                <p class="lp-habit-identity"><%= habit.identity_label %></p>
              <% end %>
              <%= link_to habit.name, habit_path(habit), class: "lp-habits__name" %>
              <p class="lp-habits__meta">
                <%= habit.unit %> · <%= habit.evaluation_label %>
                <% if habit.show_on_home? %> · <%= t("habits.on_today") %><% end %>
                <% unless habit.active? %> · <%= t("habits.off") %><% end %>
              </p>
              <% if habit.life_journey.present? %>
                <p class="lp-habits__mountain">
                  <%= t("habits.linked_mountain", title: habit.life_journey.title) %>
                </p>
              <% end %>
              <p class="lp-habits__status is-<%= status_tone(status) %>">
                <%= status_full_text(status) %>
              </p>
            </div>
            <div class="lp-habits__card-actions">
              <%= link_to t("habits.edit"), edit_habit_path(habit), class: "lp-habits__btn is-quiet" %>
              <%= button_to t("habits.delete"), habit_path(habit), method: :delete,
                    data: { turbo_confirm: t("habits.delete_confirm") },
                    class: "lp-habits__btn is-danger" %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="lp-habits__empty">
      <p class="lp-habits__empty-title"><%= t("habits.empty_title") %></p>
      <p class="lp-habits__empty-body"><%= t("habits.empty_body") %></p>
      <%= link_to t("habits.empty_cta"), new_habit_path, class: "lp-habits__add is-block" %>
    </div>
  <% end %>
</div>

<%= render "shared/lp_dash_nav", active: :habits %>
