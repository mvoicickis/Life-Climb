<% content_for :title, "My stats" %>

<div class="mx-auto max-w-3xl">
  <div class="mb-8 flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-4xl font-black text-slate-900">My stats</h1>
      <p class="mt-2 text-lg text-slate-600">Things you count every day.</p>
    </div>
    <%= link_to "+ Add", new_habit_path,
        class: "rounded-2xl bg-emerald-500 px-5 py-3 text-sm font-black text-white hover:bg-emerald-600" %>
  </div>

  <% if @habits.any? %>
    <div class="space-y-3">
      <% @habits.each do |habit| %>
        <div class="flex items-center justify-between rounded-3xl border-2 border-slate-200 bg-white p-5 shadow-sm">
          <div>
            <div class="flex items-center gap-2">
              <%= link_to habit.name, habit_path(habit), class: "text-xl font-black text-slate-900 hover:text-emerald-700" %>
              <% unless habit.active? %>
                <span class="rounded-xl bg-slate-100 px-2 py-1 text-xs font-bold text-slate-600">Off</span>
              <% end %>
            </div>
            <p class="mt-1 text-sm font-semibold text-slate-500">
              <%= habit.unit %>
              <% if habit.show_on_home? %> · On Home<% end %>
            </p>
          </div>
          <div class="flex gap-2">
            <%= link_to "Edit", edit_habit_path(habit),
                class: "rounded-xl border-2 border-slate-200 px-3 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50" %>
            <%= button_to "Delete", habit_path(habit), method: :delete,
                data: { turbo_confirm: "Remove this?" },
                class: "cursor-pointer rounded-xl border-2 border-rose-200 px-3 py-2 text-sm font-bold text-rose-700 hover:bg-rose-50" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-3xl border-2 border-dashed border-slate-300 bg-white p-10 text-center">
      <p class="text-xl font-black text-slate-900">Nothing yet</p>
      <%= link_to "Add something", new_habit_path, class: "mt-4 inline-block font-bold text-emerald-600" %>
    </div>
  <% end %>
</div>
