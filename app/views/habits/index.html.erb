<% content_for :title, "Habits" %>

<div class="mx-auto max-w-3xl">
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-slate-900">Your habits</h1>
      <p class="mt-1 text-slate-600">Create and manage the things you want to do.</p>
    </div>
    <%= link_to "New habit", new_habit_path,
        class: "rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700" %>
  </div>

  <% if @habits.any? %>
    <div class="space-y-3">
      <% @habits.each do |habit| %>
        <div class="flex items-center justify-between rounded-lg border border-slate-200 bg-white p-4">
          <div>
            <div class="flex items-center gap-2">
              <h2 class="font-semibold text-slate-900"><%= habit.name %></h2>
              <% unless habit.active? %>
                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">Inactive</span>
              <% end %>
            </div>
            <% if habit.description.present? %>
              <p class="mt-1 text-sm text-slate-600"><%= habit.description %></p>
            <% end %>
            <p class="mt-2 text-sm text-slate-500">
              <%= habit.points %> points · <%= habit.frequency %>
            </p>
          </div>
          <div class="flex gap-2">
            <%= link_to "Edit", edit_habit_path(habit),
                class: "rounded-lg border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50" %>
            <%= button_to "Delete", habit_path(habit), method: :delete,
                data: { turbo_confirm: "Delete this habit?" },
                class: "cursor-pointer rounded-lg border border-red-200 px-3 py-1.5 text-sm text-red-700 hover:bg-red-50" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center">
      <p class="text-slate-600">No habits yet.</p>
      <%= link_to "Create your first habit", new_habit_path,
          class: "mt-4 inline-block font-medium text-emerald-600 hover:text-emerald-700" %>
    </div>
  <% end %>
</div>
