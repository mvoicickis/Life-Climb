<% content_for :title, t("admin.dashboard.title") %>

<header class="lp-admin__page-head">
  <div>
    <p class="lp-admin__eyebrow"><%= t("admin.brand") %></p>
    <h1 class="lp-admin__h1"><%= t("admin.dashboard.title") %></h1>
    <p class="lp-admin__lead"><%= t("admin.dashboard.lead") %></p>
  </div>
  <%= link_to t("admin.users.export_csv"),
        admin_users_path(format: :csv, sort: @funnel_sort, filter: @funnel_filter),
        class: "lp-admin__btn" %>
</header>

<section class="lp-admin__cards" aria-label="<%= t('admin.dashboard.metrics') %>">
  <% [
    [ @cards[:users_total], t("admin.metrics.users_total") ],
    [ @cards[:users_week], t("admin.metrics.users_week") ],
    [ @cards[:users_month], t("admin.metrics.users_month") ],
    [ @cards[:returned_users], t("admin.metrics.returned_users") ],
    [ @cards[:onboarding_done], t("admin.metrics.onboarding_done") ],
    [ @cards[:onboarding_pending], t("admin.metrics.onboarding_pending") ],
    [ @cards[:battles_completed], t("admin.metrics.battles") ],
    [ @cards[:projects_completed], t("admin.metrics.projects") ]
  ].each do |value, label| %>
    <article class="lp-admin__card">
      <p class="lp-admin__card-label"><%= label %></p>
      <p class="lp-admin__card-value"><%= value %></p>
    </article>
  <% end %>
</section>

<section class="lp-admin__charts"
         data-controller="admin-charts"
         data-admin-charts-users-value="<%= @charts[:users_per_day].to_json %>"
         data-admin-charts-points-value="<%= @charts[:life_points_per_day].to_json %>"
         data-admin-charts-battles-value="<%= @charts[:battles_per_day].to_json %>">
  <article class="lp-admin__panel">
    <header class="lp-admin__panel-head">
      <h2><%= t("admin.charts.users") %></h2>
    </header>
    <div class="lp-admin__chart"><canvas data-admin-charts-target="users"></canvas></div>
  </article>
  <article class="lp-admin__panel">
    <header class="lp-admin__panel-head">
      <h2><%= t("admin.charts.life_points") %></h2>
    </header>
    <div class="lp-admin__chart"><canvas data-admin-charts-target="points"></canvas></div>
  </article>
  <article class="lp-admin__panel">
    <header class="lp-admin__panel-head">
      <h2><%= t("admin.charts.battles") %></h2>
    </header>
    <div class="lp-admin__chart"><canvas data-admin-charts-target="battles"></canvas></div>
  </article>
</section>

<section class="lp-admin__panel" aria-label="<%= t('admin.funnel.title') %>">
  <header class="lp-admin__panel-head">
    <h2><%= t("admin.funnel.title") %></h2>
  </header>

  <%= render "admin/dashboard/funnel_counts", stage_counts: @funnel[:stage_counts] %>

  <div class="lp-admin__toolbar">
    <%= link_to t("admin.funnel.filter_all"),
          admin_root_path(sort: @funnel_sort),
          class: @funnel_filter.blank? ? "lp-admin__btn" : "lp-admin__ghost" %>
    <%= link_to t("admin.funnel.filter_inactive"),
          admin_root_path(sort: @funnel_sort, filter: Admin::UserFunnel::FILTER_INACTIVE),
          class: @funnel_filter == Admin::UserFunnel::FILTER_INACTIVE ? "lp-admin__btn" : "lp-admin__ghost" %>
    <span class="lp-admin__meta">
      <%= t("admin.funnel.row_count", count: @funnel[:rows].size) %>
    </span>
  </div>

  <%= render "admin/dashboard/funnel_table",
        rows: @funnel[:rows],
        funnel_sort: @funnel_sort,
        funnel_filter: @funnel_filter %>
</section>

<div class="lp-admin__split">
  <section class="lp-admin__panel">
    <header class="lp-admin__panel-head">
      <h2><%= t("admin.dashboard.latest_users") %></h2>
      <%= link_to t("admin.nav.users"), admin_users_path, class: "lp-admin__text-link" %>
    </header>
    <ul class="lp-admin__list">
      <% @recent_users.each do |user| %>
        <li>
          <%= link_to admin_user_path(user), class: "lp-admin__list-row" do %>
            <span class="lp-admin__avatar" aria-hidden="true"><%= admin_initials(user) %></span>
            <span>
              <strong><%= user.display_name %></strong>
              <small><%= user.email_address %></small>
            </span>
            <span class="lp-admin__meta"><%= l(user.created_at.to_date, format: :long) %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="lp-admin__panel">
    <header class="lp-admin__panel-head">
      <h2><%= t("admin.dashboard.newest_activity") %></h2>
    </header>
    <ul class="lp-admin__list">
      <% @recent_ledgers.each do |ledger| %>
        <li class="lp-admin__list-static">
          <span class="lp-admin__avatar is-points" aria-hidden="true">⚡</span>
          <span>
            <strong><%= ledger.user&.display_name || "—" %></strong>
            <small><%= ledger.reason %></small>
          </span>
          <span class="lp-admin__meta"><%= ledger.amount.positive? ? "+#{ledger.amount}" : ledger.amount %></span>
        </li>
      <% end %>
      <% if @recent_ledgers.blank? %>
        <li class="lp-admin__empty"><%= t("admin.dashboard.no_activity") %></li>
      <% end %>
    </ul>
  </section>
</div>
