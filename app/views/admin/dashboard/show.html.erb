<% content_for :title, "Admin" %>

<header class="mb-8">
  <h1 class="text-3xl font-black tracking-tight text-slate-900">Dashboard</h1>
  <p class="mt-1 text-sm font-semibold text-slate-600">Users and feedback from the app.</p>
</header>

<div class="mb-8 grid gap-3 sm:grid-cols-2">
  <div class="rounded-3xl border-2 border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Users</p>
    <p class="mt-2 text-4xl font-black text-slate-900"><%= @users_count %></p>
  </div>
  <div class="rounded-3xl border-2 border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Feedbacks</p>
    <p class="mt-2 text-4xl font-black text-slate-900"><%= @feedbacks_count %></p>
  </div>
</div>

<section class="mb-10">
  <h2 class="text-xl font-black text-slate-900">Feedback</h2>
  <% if @feedbacks.any? %>
    <ul class="mt-4 space-y-3">
      <% @feedbacks.each do |feedback| %>
        <li class="rounded-3xl border-2 border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <p class="font-black text-slate-900"><%= feedback.user.email_address %></p>
            <p class="text-xs font-bold text-slate-500"><%= feedback.created_at.strftime("%b %-d, %Y · %H:%M") %></p>
          </div>
          <p class="mt-3 whitespace-pre-wrap text-sm font-semibold leading-relaxed text-slate-700"><%= feedback.body %></p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 rounded-2xl border-2 border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">No feedback yet.</p>
  <% end %>
</section>

<section>
  <h2 class="text-xl font-black text-slate-900">Recent users</h2>
  <ul class="mt-4 divide-y divide-slate-200 overflow-hidden rounded-3xl border-2 border-slate-200 bg-white shadow-sm">
    <% @recent_users.each do |user| %>
      <li class="flex flex-wrap items-center justify-between gap-2 px-5 py-3">
        <div>
          <p class="font-bold text-slate-900"><%= user.email_address %></p>
          <p class="text-xs font-semibold text-slate-500">Joined <%= user.created_at.strftime("%b %-d, %Y") %></p>
        </div>
        <% if user.admin? %>
          <span class="rounded-lg bg-slate-900 px-2 py-1 text-[10px] font-black uppercase tracking-wide text-white">Admin</span>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
