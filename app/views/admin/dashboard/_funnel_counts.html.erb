<section class="lp-admin__cards is-compact" aria-label="<%= t('admin.funnel.stage_counts') %>">
  <% [
    [ :signed_up, t("admin.funnel.stage_signed_up") ],
    [ :onboarding_complete, t("admin.funnel.stage_onboarding") ],
    [ :first_camp_planted, t("admin.funnel.stage_first_camp") ],
    [ :first_battle_won, t("admin.funnel.stage_first_battle") ],
    [ :returned_second_day, t("admin.funnel.stage_returned") ]
  ].each do |key, label| %>
    <article class="lp-admin__card">
      <p class="lp-admin__card-label"><%= label %></p>
      <p class="lp-admin__card-value"><%= stage_counts[key] %></p>
    </article>
  <% end %>
</section>
