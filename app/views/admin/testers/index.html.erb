<% content_for :title, t("admin.testers.title") %>

<header class="lp-admin__page-head">
  <div>
    <p class="lp-admin__eyebrow"><%= t("admin.brand") %></p>
    <h1 class="lp-admin__h1"><%= t("admin.testers.title") %></h1>
    <p class="lp-admin__lead"><%= t("admin.testers.lead") %></p>
  </div>
</header>

<div class="lp-admin__toolbar" role="navigation" aria-label="<%= t('admin.testers.filter_label') %>">
  <%= link_to t("admin.testers.filter_needs_message"),
        admin_testers_path(filter: Admin::Testers::FILTER_NEEDS_MESSAGE),
        class: @filter == Admin::Testers::FILTER_NEEDS_MESSAGE ? "lp-admin__btn" : "lp-admin__ghost" %>
  <%= link_to t("admin.testers.filter_everyone"),
        admin_testers_path(filter: Admin::Testers::FILTER_EVERYONE),
        class: @filter == Admin::Testers::FILTER_EVERYONE ? "lp-admin__btn" : "lp-admin__ghost" %>
  <%= link_to t("admin.testers.play_testers_list"),
        Admin::Testers::PLAY_TESTERS_URL,
        class: "lp-admin-testers__play-link",
        target: "_blank",
        rel: "noopener" %>
</div>

<% if @rows.empty? %>
  <p class="lp-admin__lead"><%= t("admin.testers.empty") %></p>
<% else %>
  <div class="lp-admin-testers" id="admin-testers">
    <% @rows.each do |row| %>
      <% contact = row.contact %>
      <article class="lp-admin-tester<%= " has-reason" if row.reason.present? %>"
               id="tester-<%= row.user.id %>"
               data-user-id="<%= row.user.id %>"
               data-reason="<%= row.reason_key %>">
        <header class="lp-admin-tester__head">
          <div class="lp-admin-tester__who">
            <p class="lp-admin-tester__name"><%= row.user.display_name %></p>
            <%= mail_to row.user.email_address,
                  row.user.email_address,
                  class: "lp-admin-tester__email",
                  aria: { label: t("admin.testers.email_aria", name: row.user.display_name) } %>
          </div>
          <% if row.reason.present? %>
            <span class="lp-admin-tester__reason"><%= row.reason %></span>
          <% end %>
        </header>

        <div class="lp-admin-tester__contact">
          <p class="lp-admin-tester__reach">
            <span class="lp-admin-tester__reach-label"><%= t("admin.testers.reach_on") %></span>
            <% if contact&.channel.present? %>
              <span class="lp-admin-tester__channel"><%= t("admin.testers.channels.#{contact.channel}") %></span>
              <% reach_url = admin_tester_reach_url(contact, user: row.user) %>
              <% reach_label = contact.details.presence || contact.mailto_address(fallback_email: row.user.email_address) %>
              <% if reach_url.present? && reach_label.present? %>
                <%= link_to reach_label,
                      reach_url,
                      class: "lp-admin-tester__reach-link",
                      target: (reach_url.start_with?("https://") ? "_blank" : nil),
                      rel: (reach_url.start_with?("https://") ? "noopener noreferrer" : nil) %>
              <% elsif contact.details.present? %>
                <span class="lp-admin-tester__reach-text"><%= contact.details %></span>
              <% end %>
            <% else %>
              <span class="lp-admin-tester__reach-text"><%= t("admin.testers.dash") %></span>
            <% end %>
          </p>

          <p class="lp-admin-tester__last-contact">
            <% if contact&.last_contacted_on.present? %>
              <%= t("admin.testers.last_contacted_line",
                    date: l(contact.last_contacted_on, format: :long),
                    note: contact.note.presence || t("admin.testers.dash")) %>
            <% else %>
              <%= t("admin.testers.not_contacted") %>
            <% end %>
          </p>

          <%= link_to t("admin.testers.edit_contact"),
                edit_admin_tester_contact_path(row.user),
                class: "lp-admin-tester__edit" %>
        </div>

        <dl class="lp-admin-tester__grid">
          <div>
            <dt><%= t("admin.testers.signed_up") %></dt>
            <dd><%= l(row.signed_up_at.to_date, format: :long) %></dd>
          </div>
          <div>
            <dt><%= t("admin.testers.onboarding") %></dt>
            <dd><%= row.onboarding_done ? t("admin.testers.done") : t("admin.testers.not_done") %></dd>
          </div>
          <div>
            <dt><%= t("admin.testers.first_win") %></dt>
            <dd><%= row.first_win_at ? l(row.first_win_at.to_date, format: :long) : t("admin.testers.dash") %></dd>
          </div>
          <div>
            <dt><%= t("admin.testers.last_win") %></dt>
            <dd><%= row.last_win_at ? l(row.last_win_at.to_date, format: :long) : t("admin.testers.dash") %></dd>
          </div>
          <div>
            <dt><%= t("admin.testers.wins_this_week") %></dt>
            <dd><%= row.wins_this_week %></dd>
          </div>
          <div>
            <dt><%= t("admin.testers.last_opened") %></dt>
            <dd>
              <% if row.days_since_open.nil? %>
                <%= t("admin.testers.dash") %>
              <% elsif row.days_since_open.zero? %>
                <%= t("admin.testers.opened_today") %>
              <% else %>
                <%= t("admin.testers.days_ago", count: row.days_since_open) %>
              <% end %>
            </dd>
          </div>
          <div>
            <dt><%= t("admin.testers.push") %></dt>
            <dd><%= row.push_on ? t("admin.testers.done") : t("admin.testers.not_done") %></dd>
          </div>
          <div>
            <dt><%= t("admin.testers.partner") %></dt>
            <dd><%= row.partner ? t("admin.testers.done") : t("admin.testers.not_done") %></dd>
          </div>
        </dl>
      </article>
    <% end %>
  </div>
<% end %>
