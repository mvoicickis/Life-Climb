<% checker = DevBoardItem.other_admin(item.owner, admin_owners) %>

<div class="lp-dev-board__actions">
  <% if item.idea? %>
    <%= button_to t("admin.dev_board.moves.plan_for_week"),
                  move_admin_dev_board_item_path(item),
                  method: :patch,
                  params: { to: "plan_for_week" },
                  class: "lp-dev-board__move-btn" %>
  <% elsif item.todo? %>
    <%= button_to t("admin.dev_board.moves.start"),
                  move_admin_dev_board_item_path(item),
                  method: :patch,
                  params: { to: "start" },
                  class: "lp-dev-board__move-btn" %>
  <% elsif item.doing? %>
    <% if checker.present? %>
      <%= button_to t("admin.dev_board.moves.send_to_check", name: checker.display_name),
                    move_admin_dev_board_item_path(item),
                    method: :patch,
                    params: { to: "send_to_check" },
                    class: "lp-dev-board__move-btn" %>
    <% end %>
  <% elsif item.needs_check? %>
    <%= button_to t("admin.dev_board.moves.looks_good"),
                  move_admin_dev_board_item_path(item),
                  method: :patch,
                  params: { to: "looks_good" },
                  class: "lp-dev-board__move-btn" %>
    <%= form_with url: move_admin_dev_board_item_path(item),
                  method: :patch,
                  class: "lp-dev-board__not-yet-form",
                  local: true do %>
      <%= hidden_field_tag :to, "not_yet" %>
      <label class="lp-admin__field">
        <span><%= t("admin.dev_board.moves.check_note_label") %></span>
        <%= text_area_tag :check_note,
                          nil,
                          class: "lp-input lp-dev-board__control lp-dev-board__control--area",
                          rows: 2,
                          required: true,
                          maxlength: DevBoardItem::CHECK_NOTE_MAX %>
      </label>
      <%= button_tag t("admin.dev_board.moves.not_yet"), type: "submit", class: "lp-dev-board__move-btn" %>
    <% end %>
  <% end %>

  <details class="lp-dev-board__card-menu">
    <summary class="lp-dev-board__card-menu-summary" aria-label="<%= t("admin.dev_board.moves.menu") %>">
      ⋯
    </summary>
    <div class="lp-dev-board__card-menu-panel">
      <button type="button"
              class="lp-dev-board__menu-btn"
              data-action="dev-board-report#openEdit"
              data-dev-board-report-url-value="<%= admin_dev_board_item_path(item) %>"
              data-dev-board-report-title-label-value="<%= t('admin.dev_board.report.edit_title') %>"
              data-dev-board-report-submit-label-value="<%= t('admin.dev_board.report.save') %>"
              data-dev-board-report-item-title-value="<%= item.title %>"
              data-dev-board-report-item-description-value="<%= item.description.to_s %>"
              data-dev-board-report-item-kind-value="<%= item.kind %>"
              data-dev-board-report-item-priority-value="<%= item.priority %>"
              data-dev-board-report-item-owner-id-value="<%= item.owner_id %>"
              data-dev-board-report-item-reporter-note-value="<%= item.reporter_note.to_s %>">
        <%= t("admin.dev_board.report.edit") %>
      </button>
      <details class="lp-dev-board__move-submenu">
        <summary class="lp-dev-board__menu-btn lp-dev-board__menu-btn--sub">
          <%= t("admin.dev_board.moves.move_to") %>
        </summary>
        <div class="lp-dev-board__move-submenu-panel">
          <% DevBoardItem::COLUMN_STATUSES.each do |status| %>
            <% next if status == item.status %>
            <%= button_to t("admin.dev_board.columns.#{status}"),
                          move_admin_dev_board_item_path(item),
                          method: :patch,
                          params: { to: "relocate", column: status },
                          class: "lp-dev-board__menu-btn" %>
          <% end %>
        </div>
      </details>
      <%= button_to t("admin.dev_board.delete.action"),
                    admin_dev_board_item_path(item),
                    method: :delete,
                    class: "lp-dev-board__menu-btn is-danger",
                    form: { data: { turbo_confirm: t("admin.dev_board.delete.confirm") } } %>
    </div>
  </details>
</div>