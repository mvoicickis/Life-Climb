<article class="lp-dev-board__card lp-dev-board__card--compact"
         data-controller="dev-board-card">
  <div class="lp-dev-board__card-head">
    <span class="lp-dev-board__card-type" aria-hidden="true"><%= item.kind_icon %></span>
    <button type="button"
            class="lp-dev-board__card-title-btn"
            data-action="dev-board-card#toggle"
            aria-expanded="false">
      <%= item.title %>
    </button>
  </div>
  <span class="lp-dev-board__pill lp-dev-board__pill--<%= item.priority %>"><%= item.priority_label %></span>
  <div class="lp-dev-board__owner-row lp-dev-board__owner-row--compact">
    <%= render "shared/avatar_circle", user: item.owner, size: :sm %>
    <span class="lp-dev-board__owner-name"><%= item.owner.display_name %></span>
  </div>
  <% if item.doing? && item.check_note.present? %>
    <p class="lp-dev-board__check-note">
      <%= truncate(item.check_note, length: 80) %>
    </p>
  <% end %>
  <% if item.description.present? %>
    <p class="lp-dev-board__card-desc" data-dev-board-card-target="description">
      <%= item.description %>
    </p>
  <% end %>
  <p class="lp-dev-board__meta">
    <%= t("admin.dev_board.reported_by",
          name: item.reported_by_label,
          date: l(item.created_at.to_date, format: :long)) %>
  </p>
  <% if item.persisted? %>
    <%= render "card_actions", item: item, admin_owners: admin_owners %>
  <% end %>
</article>