<%# locals: (blog_post:, save_state: :idle) %>
<p class="lp-blog-writer__status<%= " is-error" if save_state == :error %>"
   id="blog_save_status"
   data-blog-writer-target="statusBar"
   <%= %(data-action="click->blog-writer#retrySave") if save_state == :error %>>
  <%= admin_blog_save_status_copy(blog_post) %>
  <% if save_state == :saved %>
    · <%= t("admin.blog_posts.saved_now") %>
    <span class="lp-blog-writer__status-ok" aria-hidden="true">✓</span>
    <%= t("admin.blog_posts.saved_just_now") %>
  <% elsif save_state == :error %>
    · <%= t("admin.blog_posts.not_saved_tap") %>
  <% end %>
</p>