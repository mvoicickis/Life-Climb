<div id="blog_post_editor"
     class="lp-blog-writer"
     data-controller="blog-writer blog-slug blog-trix-toolbar blog-title-field"
     data-action="trix-change->blog-writer#scheduleSave turbo:submit-end->blog-writer#noteSaved input->blog-writer#markDirty change->blog-writer#markDirty"
     data-blog-writer-new-value="<%= @blog_post.persisted? ? "false" : "true" %>"
     data-blog-writer-post-id-value="<%= @blog_post.persisted? ? @blog_post.id : "new" %>"
     data-blog-writer-untitled-value="<%= BlogPost::UNTITLED_TITLE %>"
     data-blog-writer-server-snapshot-value="<%= admin_blog_writer_snapshot(@blog_post) %>"
     data-blog-writer-preview-missing-value="<%= t("admin.blog_posts.google_preview_missing") %>"
     data-blog-writer-preview-url-value="<%= @blog_post.persisted? ? preview_admin_blog_post_path(@blog_post) : "" %>"
     data-blog-writer-copy-saving-value="<%= t("admin.blog_posts.saving") %>"
     data-blog-writer-copy-saved-value="<%= t("admin.blog_posts.saved_now") %>"
     data-blog-writer-copy-saved-just-now-value="<%= t("admin.blog_posts.saved_just_now") %>"
     data-blog-writer-copy-not-saved-yet-value="<%= t("admin.blog_posts.not_saved_yet") %>"
     data-blog-writer-copy-not-saved-tap-value="<%= t("admin.blog_posts.not_saved_tap") %>"
     data-blog-writer-copy-draft-value="<%= t("admin.blog_posts.save_status_draft") %>"
     data-blog-writer-copy-published-value="<%= t("admin.blog_posts.save_status_published") %>">
  <%= render "backup_restore" %>
  <header class="lp-blog-writer__bar">
    <%= link_to t("admin.blog_posts.back_to_list"), admin_blog_posts_path, class: "lp-blog-writer__back" %>
    <%= render "save_status", blog_post: @blog_post %>
    <div class="lp-blog-writer__bar-actions" id="blog_post_toolbar">
      <% if @blog_post.persisted? %>
        <%= link_to t("admin.blog_posts.preview"),
              preview_admin_blog_post_path(@blog_post),
              class: "lp-blog-writer__btn is-white",
              target: "_blank",
              rel: "noopener",
              data: { action: "click->blog-writer#openPreview" } %>
      <% end %>
      <% if @blog_post.status != "published" %>
        <button type="button"
                class="lp-blog-writer__btn is-white"
                data-action="click->blog-writer#saveDraft">
          <%= t("admin.blog_posts.save_draft") %>
        </button>
        <button type="button"
                class="lp-blog-writer__btn is-green"
                data-action="click->blog-writer#publish">
          <%= t("admin.blog_posts.publish") %>
        </button>
      <% else %>
        <button type="submit" form="blog-post-writer" class="lp-blog-writer__btn is-green" data-turbo="false">
          <%= t("admin.blog_posts.update") %>
        </button>
      <% end %>
    </div>
  </header>

  <%= form_with model: @blog_post,
        url: (@blog_post.persisted? ? admin_blog_post_path(@blog_post) : admin_blog_posts_path),
        id: "blog-post-writer",
        class: "lp-blog-writer__layout",
        data: { blog_writer_target: "form", turbo: true } do |f| %>
      <%= hidden_field_tag :autosave, "", data: { blog_writer_target: "autosaveFlag" } %>
      <%= hidden_field_tag :publish, "", data: { blog_writer_target: "publishFlag" } %>
      <%= hidden_field_tag :slug_auto, "", data: { blog_writer_target: "slugAutoFlag" } %>

    <div class="lp-blog-writer__main">
      <%= render "cover", blog_post: @blog_post, form: f %>

      <%= render "publish_title_error", blog_post: @blog_post %>

      <% title_field_class = "lp-blog-writer__title" %>
      <% title_field_class += " has-error" if defined?(@publish_error) && @publish_error %>
      <%= f.text_area :title,
            class: title_field_class,
            placeholder: t("admin.blog_posts.writer_title_placeholder"),
            rows: 1,
            value: (@blog_post.untitled_draft_title? ? "" : @blog_post.title),
            data: {
              blog_slug_target: "title",
              blog_title_field_target: "input",
              blog_writer_target: "titleInput",
              blog_slug_untitled_value: BlogPost::UNTITLED_TITLE,
              action: "input->blog-slug#syncFromTitle input->blog-writer#scheduleSave input->blog-writer#syncGooglePreview input->blog-writer#markDirty input->blog-title-field#input keydown->blog-title-field#keydown blur->blog-writer#saveOnBlur"
            } %>

      <div class="lp-blog-writer__body-wrap">
        <%= f.rich_text_area :body, placeholder: t("admin.blog_posts.body_placeholder"), data: { action: "trix-change->blog-writer#syncGooglePreview trix-change->blog-writer#markDirty", blog_writer_target: "bodyField" } %>
      </div>

      <details class="lp-blog-writer__more">
        <summary><%= t("admin.blog_posts.more_settings") %></summary>
        <div class="lp-blog-writer__more-grid">
          <label class="lp-blog-writer__more-field">
            <span><%= t("admin.blog_posts.field_slug") %></span>
            <span id="blog_post_slug_field">
              <%= f.text_field :slug,
                    class: "lp-input lp-blog-writer__more-input",
                    data: {
                      blog_slug_target: "slug",
                      action: "input->blog-slug#markSlugEdited input->blog-writer#scheduleSave blur->blog-writer#saveOnBlur"
                    } %>
            </span>
            <small class="lp-blog-writer__hint"><%= t("admin.blog_posts.slug_auto_hint") %></small>
          </label>
          <label class="lp-blog-writer__more-field">
            <span><%= t("admin.blog_posts.field_excerpt") %></span>
            <%= f.text_area :excerpt,
                  class: "lp-input lp-blog-writer__more-input",
                  rows: 2,
                  data: { action: "input->blog-writer#scheduleSave blur->blog-writer#saveOnBlur" } %>
            <small class="lp-blog-writer__hint"><%= t("admin.blog_posts.excerpt_auto_hint") %></small>
          </label>
          <label class="lp-blog-writer__more-field">
            <span><%= t("admin.blog_posts.field_author") %></span>
            <%= f.text_field :author_name,
                  class: "lp-input lp-blog-writer__more-input",
                  data: { action: "input->blog-writer#scheduleSave blur->blog-writer#saveOnBlur" } %>
          </label>
        </div>
      </details>
    </div>

    <aside class="lp-blog-writer__seo">
      <div class="lp-blog-writer__seo-panel">
        <h2 class="lp-blog-writer__seo-kicker"><%= t("admin.blog_posts.google_check") %></h2>

        <h3 class="lp-blog-writer__seo-heading"><%= t("admin.blog_posts.google_preview") %></h3>
        <%= render "google_preview", blog_post: @blog_post %>

        <label class="lp-blog-writer__seo-field">
          <span><%= t("admin.blog_posts.focus_phrase") %></span>
          <%= f.text_field :focus_phrase,
                class: "lp-input lp-blog-writer__more-input",
                data: { action: "input->blog-writer#scheduleSave blur->blog-writer#saveOnBlur" } %>
        </label>

        <%= render "seo_checklist", blog_post: @blog_post %>
        <p class="lp-blog-writer__hint"><%= t("admin.blog_posts.checklist_hint") %></p>

        <details class="lp-blog-writer__seo-edit">
          <summary class="lp-blog-writer__seo-edit-summary"><%= t("admin.blog_posts.edit_google_text") %></summary>
          <div class="lp-blog-writer__seo-edit-fields">
            <label class="lp-blog-writer__seo-field">
              <span><%= t("admin.blog_posts.seo_title") %></span>
              <%= f.text_field :seo_title,
                    maxlength: BlogPost::SEO_TITLE_MAX,
                    class: "lp-input lp-blog-writer__more-input",
                    data: {
                      blog_writer_target: "seoTitle",
                      action: "input->blog-writer#counterInput input->blog-writer#syncGooglePreview input->blog-writer#scheduleSave blur->blog-writer#saveOnBlur"
                    } %>
              <small class="lp-blog-writer__hint">
                <span data-blog-writer-target="seoTitleCount"><%= @blog_post.seo_title.to_s.length %></span>
                / <%= BlogPost::SEO_TITLE_MAX %>
              </small>
            </label>
            <label class="lp-blog-writer__seo-field">
              <span><%= t("admin.blog_posts.meta_description") %></span>
              <%= f.text_area :meta_description,
                    maxlength: BlogPost::META_DESCRIPTION_MAX,
                    rows: 3,
                    class: "lp-input lp-blog-writer__more-input",
                    data: {
                      blog_writer_target: "metaDescription",
                      action: "input->blog-writer#counterInput input->blog-writer#syncGooglePreview input->blog-writer#scheduleSave blur->blog-writer#saveOnBlur"
                    } %>
              <small class="lp-blog-writer__hint">
                <span data-blog-writer-target="metaCount"><%= @blog_post.meta_description.to_s.length %></span>
                / <%= BlogPost::META_DESCRIPTION_MAX %>
              </small>
            </label>
          </div>
        </details>

        <% if @blog_post.persisted? %>
          <div class="lp-blog-writer__more-actions">
            <% if @blog_post.status == "published" %>
              <%= button_to t("admin.blog_posts.unpublish"),
                    unpublish_admin_blog_post_path(@blog_post),
                    method: :patch,
                    class: "lp-blog-writer__ghost" %>
            <% end %>
            <%= button_to t("admin.blog_posts.delete"),
                  admin_blog_post_path(@blog_post),
                  method: :delete,
                  class: "lp-blog-writer__ghost is-danger",
                  form: { data: { turbo_confirm: t("admin.blog_posts.confirm_delete") } } %>
          </div>
        <% end %>
      </div>
    </aside>
  <% end %>
</div>