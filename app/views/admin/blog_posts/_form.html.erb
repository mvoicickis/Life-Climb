<%= render "admin/blog_posts/head_assets" %>

<%= form_with model: @blog_post,
      url: (@blog_post.persisted? ? admin_blog_post_path(@blog_post) : admin_blog_posts_path),
      class: "lp-admin__panel lp-admin__form lp-admin__form--blog",
      data: { controller: "blog-slug" } do |f| %>
  <% if @blog_post.errors.any? %>
    <div class="lp-admin__flash is-alert">
      <%= @blog_post.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <label class="lp-admin__field">
    <span><%= t("admin.blog_posts.field_title") %></span>
    <%= f.text_field :title,
          class: "lp-input lp-admin__input--blog",
          required: true,
          data: {
            blog_slug_target: "title",
            action: "input->blog-slug#syncFromTitle"
          } %>
  </label>

  <label class="lp-admin__field">
    <span><%= t("admin.blog_posts.field_slug") %></span>
    <%= f.text_field :slug,
          class: "lp-input lp-admin__input--blog",
          required: true,
          data: {
            blog_slug_target: "slug",
            action: "input->blog-slug#markSlugEdited"
          } %>
    <small class="lp-admin__meta"><%= t("admin.blog_posts.slug_hint") %></small>
  </label>

  <label class="lp-admin__field">
    <span><%= t("admin.blog_posts.field_excerpt") %></span>
    <%= f.text_area :excerpt, class: "lp-input lp-admin__input--blog lp-admin__textarea--blog", rows: 3 %>
  </label>

  <label class="lp-admin__field">
    <span><%= t("admin.blog_posts.field_author") %></span>
    <%= f.text_field :author_name, class: "lp-input lp-admin__input--blog", required: true %>
  </label>

  <label class="lp-admin__field">
    <span><%= t("admin.blog_posts.field_cover") %></span>
    <%= f.file_field :cover_photo, class: "lp-admin__file", accept: "image/*" %>
    <% if @blog_post.cover_photo.attached? %>
      <p class="lp-admin__meta"><%= t("admin.blog_posts.cover_attached", filename: @blog_post.cover_photo.filename) %></p>
    <% end %>
  </label>

  <div class="lp-admin__field">
    <span><%= t("admin.blog_posts.field_body") %></span>
    <%= f.rich_text_area :body, class: "lp-admin__trix" %>
  </div>

  <div class="lp-admin__btn-row">
    <%= f.submit t("admin.blog_posts.save"), class: "lp-admin__btn" %>
    <%= link_to t("admin.blog_posts.back_to_list"), admin_blog_posts_path, class: "lp-admin__ghost" %>
  </div>
<% end %>