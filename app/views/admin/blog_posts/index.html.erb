<% content_for :title, t("admin.blog_posts.title") %>

<header class="lp-admin__page-head">
  <div>
    <p class="lp-admin__eyebrow"><%= t("admin.brand") %></p>
    <h1 class="lp-admin__h1"><%= t("admin.blog_posts.title") %></h1>
    <p class="lp-admin__lead"><%= t("admin.blog_posts.lead") %></p>
  </div>
  <%= link_to t("admin.blog_posts.new"), new_admin_blog_post_path, class: "lp-admin__btn" %>
</header>

<% if @blog_posts.any? %>
  <div class="lp-blog-writer__cards">
    <% @blog_posts.each do |post| %>
      <article class="lp-blog-writer__card">
        <div class="lp-blog-writer__card-thumb <%= "has-image" if post.cover_photo.attached? %>">
          <% if post.cover_photo.attached? %>
            <%= image_tag post.cover_photo.variant(resize_to_fill: [ 640, 360 ]), alt: "", class: "lp-blog-writer__card-photo" %>
          <% end %>
        </div>
        <div class="lp-blog-writer__card-body">
          <h2 class="lp-blog-writer__card-title"><%= post.title %></h2>
          <div class="lp-blog-writer__card-meta">
            <% if post.status == "published" %>
              <span class="lp-admin__badge"><%= t("admin.blog_posts.status_published") %></span>
            <% else %>
              <span class="lp-admin__badge is-muted"><%= t("admin.blog_posts.status_draft") %></span>
            <% end %>
            <span><%= admin_blog_post_card_date(post) %></span>
          </div>
          <div class="lp-blog-writer__card-foot">
            <%= link_to t("admin.blog_posts.edit"), edit_admin_blog_post_path(post), class: "lp-blog-writer__ghost" %>
          </div>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <p class="lp-admin__empty"><%= t("admin.blog_posts.empty") %></p>
<% end %>
