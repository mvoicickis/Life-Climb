<% content_for :title, t("strategy.weekly_planner.shell.title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>

<div class="lp-home mx-auto max-w-lg space-y-5 px-4 pb-24 pt-5">
  <header class="space-y-3">
    <p class="lp-brand-kicker">
      <%= render "shared/lp_brand_mark", size: 22, class_name: "lp-brand-kicker__mark" %>
      <span><%= t("strategy.weekly_planner.shell.kicker") %></span>
    </p>
    <div class="min-w-0">
      <h1 class="text-2xl font-semibold text-[var(--lp-ink)]"><%= t("strategy.weekly_planner.shell.title") %></h1>
      <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= @journey.title %></p>
    </div>
  </header>

  <% if flash[:weekly_planner_ack].present? %>
    <p class="lp-glass rounded-xl px-4 py-3 text-sm font-semibold text-[var(--lp-ink)]"
       role="status"
       data-weekly-planner-ack>
      <%= flash[:weekly_planner_ack] %>
    </p>
  <% end %>

  <% if @step.week_nearly_done? %>
    <section class="lp-glass space-y-4 p-5" aria-labelledby="weekly-planner-nearly-done">
      <h2 id="weekly-planner-nearly-done" class="text-2xl font-semibold text-[var(--lp-ink)]">
        <%= @step.question %>
      </h2>
      <p class="text-sm text-[var(--lp-muted)]"><%= @step.notice %></p>
      <%= link_to t("strategy.weekly_planner.shell.done_cta"),
            life_journey_path(@journey),
            class: "lp-cta inline-flex w-full items-center justify-center" %>
    </section>
  <% elsif @step.week_exhausted? %>
    <section class="lp-glass space-y-4 p-5" aria-labelledby="weekly-planner-exhausted">
      <h2 id="weekly-planner-exhausted" class="text-2xl font-semibold text-[var(--lp-ink)]">
        <%= @step.question %>
      </h2>
      <p class="text-sm text-[var(--lp-muted)]"><%= @step.notice %></p>
      <%= link_to t("strategy.weekly_planner.shell.done_cta"),
            life_journey_path(@journey),
            class: "lp-cta inline-flex w-full items-center justify-center" %>
    </section>
  <% elsif @step.completed? %>
    <section class="lp-glass space-y-4 p-5" aria-labelledby="weekly-planner-done">
      <h2 id="weekly-planner-done" class="text-2xl font-semibold text-[var(--lp-ink)]">
        <%= t("strategy.weekly_planner.shell.done_title") %>
      </h2>
      <p class="text-sm text-[var(--lp-muted)]">
        <%= t("strategy.weekly_planner.shell.done_body",
              count: @step.sitting_count.to_i,
              title: @step.title.to_s) %>
      </p>
      <%= link_to t("strategy.weekly_planner.shell.done_cta"),
            life_journey_path(@journey),
            class: "lp-cta inline-flex w-full items-center justify-center" %>
    </section>
  <% else %>
    <% if @step.notice.present? %>
      <p class="lp-glass rounded-xl px-4 py-3 text-sm text-[var(--lp-muted)]"
         role="status"
         data-weekly-planner-notice>
        <%= @step.notice %>
      </p>
    <% end %>
    <%= render "step", step: @step, error: @error, attempted_value: @attempted_value %>
  <% end %>
</div>

<%= render "shared/lp_dash_nav", active: :you %>
