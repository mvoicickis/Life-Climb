<% content_for :title, "Sign in" %>

<div class="mx-auto max-w-md">
  <h1 class="mb-2 text-4xl font-black">Welcome back</h1>
  <p class="mb-8 text-slate-600">Sign in to keep going up.</p>

  <%= form_with url: session_path, class: "space-y-4", data: { turbo: false } do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "mb-1 block text-sm font-bold" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          value: params[:email_address],
          class: "w-full rounded-2xl border-2 border-slate-200 px-4 py-3 font-semibold focus:border-emerald-500 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :password, "Password", class: "mb-1 block text-sm font-bold" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
          class: "w-full rounded-2xl border-2 border-slate-200 px-4 py-3 font-semibold focus:border-emerald-500 focus:outline-none" %>
    </div>

    <%= form.submit "Sign in", class: "w-full cursor-pointer rounded-2xl bg-emerald-500 px-4 py-3 font-black text-white hover:bg-emerald-600" %>
  <% end %>

  <p class="mt-4 text-center text-sm font-semibold">
    <%= link_to "Forgot password?", new_password_path, class: "text-emerald-700" %>
  </p>

  <p class="mt-6 text-center text-sm text-slate-600">
    New here?
    <%= link_to "Make an account", new_registration_path, class: "font-bold text-emerald-700" %>
  </p>
</div>
