<% content_for :title, t("auth.sign_in_submit") %>

<div class="lp-auth-card mx-auto max-w-md">
  <%= render "shared/auth_topbar" %>

  <h1 class="lp-auth-title"><%= t("auth.sign_in_title") %></h1>
  <p class="lp-auth-sub"><%= t("auth.sign_in_subtitle") %></p>

  <%= form_with url: session_path, class: "space-y-4", data: { turbo: false } do |form| %>
    <div>
      <%= form.label :email_address, t("auth.email"), class: "lp-auth-label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          value: params[:email_address],
          class: "lp-auth-input" %>
    </div>

    <div>
      <%= form.label :password, t("auth.password"), class: "lp-auth-label" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
          class: "lp-auth-input" %>
    </div>

    <%= form.submit t("auth.sign_in_submit"), class: "lp-auth-submit" %>
  <% end %>

  <p class="mt-4 text-center text-sm font-semibold">
    <%= link_to t("auth.forgot_password"), new_password_path, class: "lp-auth-link" %>
  </p>

  <p class="mt-6 text-center text-sm font-semibold text-[var(--lp-muted,#475569)]">
    <%= t("auth.new_here") %>
    <%= link_to t("auth.make_account"), new_registration_path, class: "lp-auth-link" %>
  </p>
</div>
