<% content_for :title, "Sign in" %>

<div class="mx-auto max-w-md">
  <h1 class="mb-2 text-3xl font-bold">Welcome back</h1>
  <p class="mb-8 text-slate-600">Sign in to continue earning life points.</p>

  <%= form_with url: session_path, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "mb-1 block text-sm font-medium" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          value: params[:email_address],
          class: "w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200" %>
    </div>

    <div>
      <%= form.label :password, class: "mb-1 block text-sm font-medium" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
          class: "w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200" %>
    </div>

    <%= form.submit "Sign in", class: "w-full cursor-pointer rounded-lg bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-700" %>
  <% end %>

  <p class="mt-4 text-center text-sm">
    <%= link_to "Forgot password?", new_password_path, class: "text-emerald-600 hover:text-emerald-700" %>
  </p>

  <p class="mt-6 text-center text-sm text-slate-600">
    New here?
    <%= link_to "Create an account", new_registration_path, class: "font-medium text-emerald-600 hover:text-emerald-700" %>
  </p>
</div>
