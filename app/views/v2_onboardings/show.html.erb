<% content_for :title, t("v2_onboarding.title") %>
<% content_for :lp_game, true %>

<%
  key = @area_key.to_s
  eyebrow = key.present? ? t("life_area_catalog.#{key}.name") : nil
%>

<div class="lp-home mx-auto max-w-lg space-y-6 px-4 pb-24 pt-5">
  <% if @step == "area" %>
    <header>
      <h1 class="text-3xl font-semibold text-[var(--lp-ink)]"><%= t("v2_onboarding.one_area_title") %></h1>
      <p class="mt-2 text-sm text-[var(--lp-muted)]"><%= t("v2_onboarding.one_area_subtitle") %></p>
      <p class="mt-1 text-sm text-[var(--lp-lime)]"><%= t("v2_onboarding.one_area_soft") %></p>
    </header>

    <%= form_with url: v2_onboarding_path(step: "area"), method: :patch, class: "space-y-4" do %>
      <div class="grid gap-3" role="radiogroup" aria-label="<%= t('v2_onboarding.one_area_title') %>">
        <% @catalog.each do |entry| %>
          <% area_key = entry[:key] %>
          <label class="lp-glass flex cursor-pointer items-start gap-3 p-4">
            <%= radio_button_tag "onboarding[area_key]", area_key, @area_key == area_key, id: "ob_area_#{area_key}", class: "mt-1" %>
            <span>
              <span class="block text-lg font-semibold text-[var(--lp-ink)]">
                <span aria-hidden="true"><%= entry[:emoji] %></span>
                <%= t("life_area_catalog.#{area_key}.name") %>
              </span>
              <span class="mt-1 block text-sm text-[var(--lp-muted)]"><%= t("life_area_catalog.#{area_key}.hint") %></span>
            </span>
          </label>
        <% end %>
      </div>
      <%= submit_tag t("v2_onboarding.continue"), class: "lp-cta w-full" %>
    <% end %>
  <% elsif @step == "want" %>
    <%= render "shared/coach_beat",
          form_url: v2_onboarding_path(step: "want"),
          scope: "onboarding",
          field: "ideal_scene",
          value: @draft["ideal_scene"],
          eyebrow: eyebrow,
          label: t("area_interview.#{key}.ideal", default: t("coach.want")),
          hint: t("area_interview.#{key}.ideal_hint", default: t("coach.want_hint")),
          placeholder: t("area_interview.#{key}.ideal_placeholder", default: t("journeys.ideal_placeholder")),
          cta: t("coach.continue"),
          hidden: { area_key: key } %>
  <% elsif @step == "now" %>
    <%= render "shared/coach_beat",
          form_url: v2_onboarding_path(step: "now"),
          scope: "onboarding",
          field: "current_reality",
          value: @draft["current_reality"],
          eyebrow: eyebrow,
          label: t("area_interview.#{key}.present", default: t("coach.now")),
          hint: t("area_interview.#{key}.present_hint", default: t("coach.now_hint")),
          placeholder: t("area_interview.#{key}.present_placeholder", default: t("journeys.present_placeholder")),
          cta: t("coach.continue"),
          hidden: { area_key: key } %>
  <% elsif @step == "next" %>
    <%= render "shared/coach_beat",
          form_url: v2_onboarding_path(step: "next"),
          scope: "onboarding",
          field: "next_win",
          value: @draft["next_win"],
          eyebrow: eyebrow,
          label: t("coach.next"),
          hint: t("coach.next_hint"),
          placeholder: t("area_interview.#{key}.next_placeholder", default: t("coach.next_placeholder")),
          cta: t("coach.continue"),
          input: :text,
          hidden: { area_key: key } %>
  <% else %>
    <%= render "shared/coach_beat",
          form_url: v2_onboarding_path(step: "today"),
          scope: "onboarding",
          field: "today_mission",
          value: @draft["today_mission"],
          eyebrow: eyebrow,
          label: t("coach.today"),
          hint: t("coach.today_hint"),
          placeholder: t("area_interview.#{key}.today_placeholder", default: t("coach.today_placeholder")),
          cta: t("coach.begin_today"),
          input: :text,
          hidden: { area_key: key } %>
  <% end %>
</div>
