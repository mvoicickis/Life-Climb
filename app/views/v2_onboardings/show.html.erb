<% content_for :title, t("v2_onboarding.title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>

<div class="lp-adventure mx-auto max-w-lg space-y-6 px-4 pb-24 pt-8<%= ' is-welcome' if @step == 'welcome' %>">
  <% if @step == "welcome" %>
    <section class="lp-adventure__card lp-adventure__welcome" aria-labelledby="adventure-welcome-title">
      <div class="lp-adventure__sky" aria-hidden="true">
        <span class="lp-adventure__spark is-a"></span>
        <span class="lp-adventure__spark is-b"></span>
        <span class="lp-adventure__spark is-c"></span>
        <%= render "v2_onboardings/mountain_art", prefix: "lp-welcome-mtn" %>
      </div>

      <%= render "shared/lp_brand_mark", size: 64, class_name: "lp-adventure__mark" %>
      <div class="lp-adventure__intro">
        <h1 id="adventure-welcome-title" class="lp-adventure__title"><%= t("v2_onboarding.welcome_title") %></h1>
        <p class="lp-adventure__lead"><%= t("v2_onboarding.welcome_lead") %></p>
      </div>

      <ul class="lp-adventure__beats">
        <li class="lp-adventure__beat is-mountain">
          <span class="lp-adventure__beat-dot" aria-hidden="true"></span>
          <span><%= t("v2_onboarding.welcome_beat_mountain") %></span>
        </li>
        <li class="lp-adventure__beat is-battle">
          <span class="lp-adventure__beat-dot" aria-hidden="true"></span>
          <span><%= t("v2_onboarding.welcome_beat_battle") %></span>
        </li>
        <li class="lp-adventure__beat is-points">
          <span class="lp-adventure__beat-dot" aria-hidden="true"></span>
          <span><%= t("v2_onboarding.welcome_beat_points") %></span>
        </li>
      </ul>

      <p class="lp-adventure__ready"><%= t("v2_onboarding.welcome_ready") %></p>

      <%= button_to t("v2_onboarding.start_journey"),
            v2_onboarding_path(step: "welcome"),
            method: :patch,
            class: "lp-cta lp-adventure__cta w-full",
            form: { data: { turbo: false }, class: "lp-adventure__cta-form" } %>
    </section>

  <% elsif @step == "mountain" %>
    <section class="lp-adventure__card" aria-labelledby="adventure-mountain-title">
      <p class="lp-adventure__kicker"><%= t("v2_onboarding.mountain_kicker") %></p>
      <h1 id="adventure-mountain-title" class="lp-adventure__title"><%= t("v2_onboarding.mountain_title") %></h1>
      <p class="lp-adventure__lead"><%= t("v2_onboarding.mountain_lead") %></p>

      <%= form_with url: v2_onboarding_path(step: "mountain"), method: :patch, class: "lp-adventure__form", data: { turbo: false } do %>
        <label class="lp-adventure__label" for="onboarding_title"><%= t("v2_onboarding.mountain_field_label") %></label>
        <%= text_field_tag "onboarding[title]", @draft["title"],
              id: "onboarding_title",
              required: true,
              maxlength: 120,
              class: "lp-input w-full",
              placeholder: t("v2_onboarding.mountain_placeholder"),
              autocomplete: "off",
              autofocus: true %>
        <p class="lp-adventure__example"><%= t("v2_onboarding.mountain_example") %></p>
        <%= submit_tag t("v2_onboarding.continue"), class: "lp-cta w-full" %>
      <% end %>
    </section>

  <% elsif @step == "deadline" %>
    <section class="lp-adventure__card" aria-labelledby="adventure-deadline-title">
      <p class="lp-adventure__kicker"><%= t("v2_onboarding.deadline_kicker") %></p>
      <h1 id="adventure-deadline-title" class="lp-adventure__title"><%= t("v2_onboarding.deadline_title") %></h1>
      <p class="lp-adventure__lead"><%= t("v2_onboarding.deadline_lead") %></p>
      <p class="lp-adventure__body"><%= t("v2_onboarding.deadline_body") %></p>
      <p class="lp-adventure__mountain-echo"><%= @draft["title"] %></p>
      <%= button_to t("v2_onboarding.forge_cta"),
            v2_onboarding_path(step: "deadline"),
            method: :patch,
            class: "lp-cta w-full",
            form: { data: { turbo: false } } %>
    </section>

  <% else %>
    <section class="lp-adventure__card lp-adventure__forge"
             aria-labelledby="adventure-forge-title"
             data-controller="adventure-forge"
             data-adventure-forge-url-value="<%= dashboard_path %>"
             data-adventure-forge-delay-value="3200">
      <h1 id="adventure-forge-title" class="lp-adventure__title"><%= t("v2_onboarding.forge_title") %></h1>
      <ul class="lp-adventure__forge-list" aria-live="polite">
        <li class="lp-adventure__forge-item is-on" data-adventure-forge-target="step"><%= t("v2_onboarding.forge_step_mountain") %></li>
        <li class="lp-adventure__forge-item" data-adventure-forge-target="step"><%= t("v2_onboarding.forge_step_journey") %></li>
        <li class="lp-adventure__forge-item" data-adventure-forge-target="step"><%= t("v2_onboarding.forge_step_camp") %></li>
        <li class="lp-adventure__forge-item" data-adventure-forge-target="step"><%= t("v2_onboarding.forge_step_ready") %></li>
      </ul>
      <p class="lp-adventure__forge-wait"><%= t("v2_onboarding.forge_wait") %></p>
      <%= link_to t("v2_onboarding.enter_today"), dashboard_path, class: "lp-cta w-full inline-flex justify-center" %>
    </section>
  <% end %>
</div>
