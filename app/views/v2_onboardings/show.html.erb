<% content_for :title, t("v2_onboarding.title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>

<div class="lp-adventure mx-auto max-w-lg space-y-6 px-4 pb-24 pt-8">
  <% if @step == "character" %>
    <section class="lp-adventure__card" aria-labelledby="character-pick-title">
      <div class="lp-adventure__step-head">
        <span class="lp-adventure__progress-label"><%= t("v2_onboarding.step_progress", current: @setup_step_index, total: @setup_step_total) %></span>
      </div>
      <div class="lp-adventure__progress-track" role="progressbar" aria-valuemin="1" aria-valuenow="<%= @setup_step_index %>" aria-valuemax="<%= @setup_step_total %>" aria-label="<%= t("v2_onboarding.step_progress", current: @setup_step_index, total: @setup_step_total) %>">
        <span class="lp-adventure__progress-fill" style="width: <%= ((@setup_step_index.to_f / @setup_step_total) * 100).round %>%"></span>
      </div>

      <%= form_with url: v2_onboarding_path(step: "character"), method: :patch, data: { turbo: false } do %>
        <%= render "shared/character_picker",
              selected: current_user.character,
              show_brand: false,
              submit_label: t("v2_onboarding.continue") %>
      <% end %>
    </section>

  <% elsif @step == "goal" %>
    <section class="lp-adventure__card" aria-labelledby="adventure-goal-title">
      <div class="lp-adventure__step-head">
        <%= link_to t("v2_onboarding.back"), v2_onboarding_path(step: "character"), class: "lp-adventure__back" %>
        <span class="lp-adventure__progress-label"><%= t("v2_onboarding.step_progress", current: @setup_step_index, total: @setup_step_total) %></span>
      </div>
      <div class="lp-adventure__progress-track" role="progressbar" aria-valuemin="1" aria-valuenow="<%= @setup_step_index %>" aria-valuemax="<%= @setup_step_total %>">
        <span class="lp-adventure__progress-fill" style="width: <%= ((@setup_step_index.to_f / @setup_step_total) * 100).round %>%"></span>
      </div>

      <h1 id="adventure-goal-title" class="lp-adventure__title"><%= t("v2_onboarding.goal_title") %></h1>

      <%= form_with url: v2_onboarding_path(step: "goal"), method: :patch, class: "lp-adventure__form", data: { turbo: false } do %>
        <%= text_field_tag "onboarding[goal]", @draft["goal"],
              id: "onboarding_goal",
              required: true,
              maxlength: 120,
              class: "lp-input w-full",
              autocomplete: "off",
              autofocus: true,
              placeholder: t("v2_onboarding.goal_placeholder") %>
        <div class="lp-adventure__examples-note" role="note" aria-hidden="true">
          <p class="lp-adventure__examples-note-label"><%= t("v2_onboarding.goal_examples_label") %></p>
          <p class="lp-adventure__examples-note-text"><%= t("v2_onboarding.goal_examples") %></p>
        </div>
        <%= submit_tag t("v2_onboarding.continue"), class: "lp-cta w-full" %>
      <% end %>
    </section>

  <% elsif @step == "camp" %>
    <section class="lp-adventure__card" aria-labelledby="adventure-camp-title">
      <div class="lp-adventure__step-head">
        <%= link_to t("v2_onboarding.back"), v2_onboarding_path(step: "goal"), class: "lp-adventure__back" %>
        <span class="lp-adventure__progress-label"><%= t("v2_onboarding.step_progress", current: @setup_step_index, total: @setup_step_total) %></span>
      </div>
      <div class="lp-adventure__progress-track" role="progressbar" aria-valuemin="1" aria-valuenow="<%= @setup_step_index %>" aria-valuemax="<%= @setup_step_total %>">
        <span class="lp-adventure__progress-fill" style="width: <%= ((@setup_step_index.to_f / @setup_step_total) * 100).round %>%"></span>
      </div>

      <h1 id="adventure-camp-title" class="lp-adventure__title"><%= t("v2_onboarding.camp_title") %></h1>
      <p class="lp-adventure__lead"><%= t("v2_onboarding.camp_lead") %></p>

      <%= form_with url: v2_onboarding_path(step: "camp"), method: :patch, class: "lp-adventure__form", data: { turbo: false } do %>
        <%= text_field_tag "onboarding[camp]", @draft["camp"],
              id: "onboarding_camp",
              required: true,
              maxlength: 120,
              class: "lp-input w-full",
              autocomplete: "off",
              autofocus: true,
              placeholder: t("v2_onboarding.camp_placeholder") %>
        <p class="lp-adventure__examples-plain"><%= t("v2_onboarding.camp_examples") %></p>
        <%= submit_tag t("v2_onboarding.continue"), class: "lp-cta w-full" %>
      <% end %>
    </section>

  <% elsif @step == "basic" %>
    <section class="lp-adventure__card" aria-labelledby="adventure-basic-title">
      <div class="lp-adventure__step-head">
        <%= link_to t("v2_onboarding.back"), v2_onboarding_path(step: "camp"), class: "lp-adventure__back" %>
        <span class="lp-adventure__progress-label"><%= t("v2_onboarding.step_progress", current: @setup_step_index, total: @setup_step_total) %></span>
      </div>
      <div class="lp-adventure__progress-track" role="progressbar" aria-valuemin="1" aria-valuenow="<%= @setup_step_index %>" aria-valuemax="<%= @setup_step_total %>">
        <span class="lp-adventure__progress-fill" style="width: <%= ((@setup_step_index.to_f / @setup_step_total) * 100).round %>%"></span>
      </div>

      <h1 id="adventure-basic-title" class="lp-adventure__title"><%= t("v2_onboarding.basic_title") %></h1>
      <p class="lp-adventure__goal-recap"><%= @draft["goal"] %></p>
      <p class="lp-adventure__lead"><%= t("v2_onboarding.basic_lead", goal: @draft["goal"]) %></p>

      <%= form_with url: v2_onboarding_path(step: "basic"), method: :patch, class: "lp-adventure__form", data: { turbo: false } do %>
        <%= text_field_tag "onboarding[basic_title]", @draft["basic_title"],
              id: "onboarding_basic_title",
              required: true,
              maxlength: 120,
              class: "lp-input w-full",
              autocomplete: "off",
              autofocus: true,
              placeholder: t("v2_onboarding.basic_placeholder") %>
        <p class="lp-adventure__examples-plain"><%= t("v2_onboarding.basic_hint") %></p>
        <%= submit_tag t("v2_onboarding.continue"), class: "lp-cta w-full" %>
      <% end %>
    </section>

  <% else %>
    <% battle_rows = Array(@draft["battle_titles"]).presence || [ "" ] %>
    <section class="lp-adventure__card" aria-labelledby="adventure-battles-title"
             data-controller="onboarding-battles">
      <div class="lp-adventure__step-head">
        <%= link_to t("v2_onboarding.back"), v2_onboarding_path(step: "basic"), class: "lp-adventure__back" %>
        <span class="lp-adventure__progress-label"><%= t("v2_onboarding.step_progress", current: @setup_step_index, total: @setup_step_total) %></span>
      </div>
      <div class="lp-adventure__progress-track" role="progressbar" aria-valuemin="1" aria-valuenow="<%= @setup_step_index %>" aria-valuemax="<%= @setup_step_total %>">
        <span class="lp-adventure__progress-fill" style="width: <%= ((@setup_step_index.to_f / @setup_step_total) * 100).round %>%"></span>
      </div>

      <h1 id="adventure-battles-title" class="lp-adventure__title"><%= t("v2_onboarding.battles_title") %></h1>
      <p class="lp-adventure__goal-recap"><%= @draft["goal"] %></p>
      <p class="lp-adventure__lead"><%= t("v2_onboarding.battles_lead", goal: @draft["goal"]) %></p>

      <%= form_with url: v2_onboarding_path(step: "battles"), method: :patch, class: "lp-adventure__form", data: { turbo: false, onboarding_battles_target: "form" } do %>
        <div class="lp-adventure__battle-list" data-onboarding-battles-target="list">
          <% battle_rows.each do |title| %>
            <div class="lp-adventure__battle-row" data-onboarding-battles-target="row">
              <%= text_field_tag "onboarding[battle_titles][]", title,
                    maxlength: 120,
                    class: "lp-input w-full",
                    autocomplete: "off",
                    autofocus: battle_rows.first == title,
                    placeholder: t("v2_onboarding.battle_placeholder"),
                    data: { onboarding_battles_target: "input", action: "input->onboarding-battles#refresh" } %>
              <button type="button"
                      class="lp-adventure__battle-remove"
                      data-action="onboarding-battles#remove"
                      aria-label="<%= t("v2_onboarding.battle_remove") %>">×</button>
            </div>
          <% end %>
        </div>

        <button type="button"
                class="lp-adventure__add-battle"
                data-action="onboarding-battles#add">
          <%= t("v2_onboarding.battle_add") %>
        </button>

        <%= submit_tag t("v2_onboarding.finish"), class: "lp-cta w-full", data: { onboarding_battles_target: "submit" } %>
      <% end %>
    </section>
  <% end %>
</div>
