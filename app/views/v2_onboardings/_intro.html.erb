<%# locals: step, photo, title, bodies, dot_index, battles_scene: false %>
<% battles_scene = local_assigns.fetch(:battles_scene, false) %>
<div class="lp-ob lp-ob--intro lp-ob--screen">
  <div class="lp-ob-intro__art" aria-hidden="false">
    <div class="lp-ob-art-surface lp-ob-art-surface--intro">
      <%= image_tag photo, class: "lp-ob-intro__photo", alt: "", decoding: "async" %>
      <% if battles_scene %>
        <div class="lp-ob-intro__battles" aria-hidden="true">
          <span class="lp-ob-intro__battle-ring is-won"></span>
          <span class="lp-ob-intro__battle-ring"></span>
          <span class="lp-ob-intro__battle-ring"></span>
        </div>
      <% else %>
        <div class="lp-ob-intro__trail" aria-hidden="true">
          <% tent_classes = [
            %w[lp-ob-intro__tent--a lp-ob-intro__tent--lg],
            %w[lp-ob-intro__tent--b],
            %w[lp-ob-intro__tent--c lp-ob-intro__tent--sm]
          ] %>
          <% mountain_trail_intro_camp_positions.each_with_index do |pos, index| %>
            <div class="lp-ob-intro__camp"
                 style="--lp-trail-x: <%= pos[:x] %>; --lp-trail-y: <%= pos[:y] %>;">
              <span class="lp-ob-intro__camp-num"><%= index + 1 %></span>
              <span class="lp-ob-intro__tent <%= tent_classes[index].join(" ") %>" aria-hidden="true"></span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <div class="lp-ob-intro__fade"></div>
    <%= button_to t("v2_onboarding.intro_skip"),
          v2_onboarding_path(step: step),
          method: :patch,
          params: { onboarding: { skip: true } },
          class: "lp-ob-intro__skip",
          form: { class: "lp-ob-intro__skip-form" } %>
  </div>

  <div class="lp-ob-intro__copy">
    <h1 class="lp-ob-intro__title"><%= title %></h1>
    <% Array(bodies).each do |line| %>
      <p class="lp-ob-intro__body"><%= line %></p>
    <% end %>
    <div class="lp-ob-intro__spacer"></div>
    <div class="lp-ob-intro__dots" aria-hidden="true">
      <span class="lp-ob-intro__dot<%= dot_index == 0 ? " is-on" : "" %>"></span>
      <span class="lp-ob-intro__dot<%= dot_index == 1 ? " is-on" : "" %>"></span>
    </div>
  </div>
  <footer class="lp-ob__cta-dock">
    <%= button_to t("v2_onboarding.intro_next"),
          v2_onboarding_path(step: step),
          method: :patch,
          class: "lp-cta w-full",
          form: { class: "lp-ob__cta-dock-form", data: { turbo: false } } %>
  </footer>
</div>
