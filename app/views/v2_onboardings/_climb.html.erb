<%# locals: goal_title, camp_titles %>
<% tent_classes = [
  %w[lp-ob-intro__tent--a lp-ob-intro__tent--lg],
  %w[lp-ob-intro__tent--b],
  %w[lp-ob-intro__tent--c lp-ob-intro__tent--sm]
] %>
<div class="lp-ob lp-ob--climb lp-ob--screen"
     data-controller="onboarding-climb"
     data-onboarding-climb-goal-value="<%= goal_title %>"
     data-onboarding-climb-camps-value="<%= camp_titles.to_json %>"
     data-action="click->onboarding-climb#skipToEnd">
  <div class="lp-ob-climb" data-onboarding-climb-target="root">
    <div class="lp-ob-climb__bg" aria-hidden="true">
      <div class="lp-ob-art-surface lp-ob-art-surface--climb">
        <%= image_tag MountainTrailHelper::BUILTIN_DAY_PHOTO, class: "lp-ob-climb__photo", alt: "", decoding: "async" %>
        <div class="lp-ob-climb__stage" data-onboarding-climb-target="stage">
          <div class="lp-ob-climb__summit"
               data-onboarding-climb-target="summit"
               style="--lp-trail-x: <%= MountainTrailHelper::PEAK_X %>; --lp-trail-y: <%= MountainTrailHelper::PEAK_Y %>;">
            <span class="lp-ob-climb__peak-flag" aria-hidden="true"></span>
            <p class="lp-ob-climb__goal-chip"><%= goal_title %></p>
          </div>

          <% mountain_trail_intro_camp_positions.each_with_index do |pos, index| %>
            <div class="lp-ob-climb__camp"
                 data-onboarding-climb-target="camp"
                 style="--lp-trail-x: <%= pos[:x] %>; --lp-trail-y: <%= pos[:y] %>;">
              <span class="lp-ob-intro__tent <%= tent_classes[index].join(" ") %>" aria-hidden="true"></span>
              <p class="lp-ob-climb__camp-chip" data-onboarding-climb-target="campChip"></p>
            </div>
          <% end %>
        </div>
      </div>
      <div class="lp-ob-climb__shade"></div>
    </div>

    <footer class="lp-ob__cta-dock">
      <%= button_to t("v2_onboarding.climb_next"),
            v2_onboarding_path(step: "climb"),
            method: :patch,
            class: "lp-cta w-full lp-ob-climb__next",
            form: { class: "lp-ob__cta-dock-form", data: { onboarding_climb_next: true } },
            data: { onboarding_climb_target: "next" } %>
    </footer>
  </div>
</div>
