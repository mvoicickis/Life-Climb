<%# locals: moment (Today::StreakMoment::Result) %>
<% moment = local_assigns[:moment] %>
<% return if moment.blank? %>
<% kind = (moment.kind || :celebrate).to_sym %>
<% week = moment.week || {} %>
<% week_days = Array(week[:days]) %>
<% local_today = Battles::WinsOnLocalDate.local_today_for(current_user) %>
<% offer_commit = moment.offer_commit %>
<% offered = Array(moment.offered_targets) %>
<% default_target = moment.default_target %>
<% run_start = local_today - (moment.days.to_i - 1) %>
<% today_idx = week_days.index(local_today) %>
<% run_indices = [] %>
<% week_days.each_with_index do |day, index| %>
  <% run_indices << index if day >= run_start && day <= local_today %>
<% end %>
<% run_len = run_indices.size %>
<% run_first = run_indices.first %>
<% aria =
     case kind
     when :progress
       t("climb.streak_moment.day_of", n: moment.days, m: moment.target_days)
     when :goal
       t("climb.streak_moment.days_in_a_row_bang", count: moment.days)
     else
       t("climb.streak_moment.aria", count: moment.days)
     end %>
<% streak_fire_path = Rails.root.join("app/assets/animations/streak_fire.json") %>
<% streak_lottie_url = streak_fire_path.exist? ? asset_path("animations/streak_fire.json") : nil %>

<div class="lp-streak-moment<%= ' is-goal' if kind == :goal %>"
     data-controller="streak-moment"
     data-streak-moment-offer-commit-value="<%= offer_commit ? 'true' : 'false' %>"
     data-streak-moment-commit-url-value="<%= streak_commitment_path %>"
     data-streak-moment-decline-url-value="<%= decline_streak_commitment_path %>"
     data-streak-moment-not-saved-value="<%= t('dash.battlefield.win_not_saved') %>"
     data-streak-moment-commit-cta-template-value="<%= t('climb.streak_moment.commit_to_template') %>"
     data-streak-moment-share-text-value="<%= moment.share_text %>"
     <% if streak_lottie_url.present? %>data-streak-moment-lottie-url-value="<%= streak_lottie_url %>"<% end %>
     data-record="<%= moment.new_record ? 'true' : 'false' %>"
     role="dialog"
     aria-label="<%= aria %>"
     hidden>
  <div class="lp-streak-moment__flood" aria-hidden="true"></div>

  <div class="lp-streak-moment__panel" data-streak-moment-target="celebrate">
    <div class="lp-streak-moment__body">
      <div class="lp-streak-moment__hero" aria-hidden="true">
        <div class="lp-streak-moment__impact-sparks" data-streak-moment-target="sparks"></div>
        <div class="lp-streak-moment__embers" data-streak-moment-target="embers"></div>
        <div class="lp-streak-moment__fireball" data-streak-moment-target="fireball">
          <svg viewBox="0 0 64 64" focusable="false" aria-hidden="true">
            <path class="lp-streak-moment__fb-trail" d="M8 54 L18 42"/>
            <path class="lp-streak-moment__fb-trail" d="M4 46 L16 38"/>
            <path class="lp-streak-moment__fb-trail" d="M12 60 L22 48"/>
            <circle class="lp-streak-moment__fb-rim" cx="36" cy="28" r="16"/>
            <circle class="lp-streak-moment__fb-mid" cx="36" cy="28" r="11"/>
            <circle class="lp-streak-moment__fb-core" cx="34" cy="25" r="6"/>
          </svg>
        </div>
        <div class="lp-streak-moment__fire" aria-hidden="true" data-streak-moment-target="fire">
          <div class="lp-streak-moment__glow"></div>
          <div class="lp-streak-moment__lottie" data-streak-moment-target="lottie"></div>
        </div>
        <div class="lp-streak-moment__avatar-wrap">
          <% if current_user.character_image.present? %>
            <%= image_tag current_user.character_image,
                  class: "lp-streak-moment__avatar",
                  alt: "",
                  width: 168,
                  height: 168,
                  decoding: "async" %>
          <% else %>
            <%= image_tag "avatars/fox.webp",
                  class: "lp-streak-moment__avatar",
                  alt: "",
                  width: 168,
                  height: 168,
                  decoding: "async" %>
          <% end %>
        </div>
      </div>

      <div class="lp-streak-moment__meter">
        <div class="lp-streak-moment__odometer" aria-live="polite">
          <span class="lp-streak-moment__digit is-old"><%= moment.from_days %></span>
          <span class="lp-streak-moment__digit is-new lp-streak-moment__num is-to"><%= moment.days %></span>
        </div>
        <p class="lp-streak-moment__sub"><%= t("climb.streak_moment.day_streak") %></p>
      </div>

      <% if week_days.any? %>
        <div class="lp-streak-moment__week" aria-label="<%= t('climb.streak_moment.this_week') %>">
          <div class="lp-streak-moment__week-labels">
            <% week_days.each do |day| %>
              <span><%= l(day, format: "%a").first %></span>
            <% end %>
          </div>
          <div class="lp-streak-moment__week-track">
            <% if run_len.positive? && !run_first.nil? %>
              <div class="lp-streak-moment__pill"
                   style="grid-column: <%= run_first + 1 %> / <%= run_first + run_len + 1 %>; --lp-streak-run: <%= run_len %>">
                <% run_indices.each do |index| %>
                  <% if index == today_idx %>
                    <span class="lp-streak-moment__today" data-streak-moment-target="todayMark">✓</span>
                  <% else %>
                    <span class="lp-streak-moment__check">✓</span>
                  <% end %>
                <% end %>
                <span class="lp-streak-moment__runner" data-streak-moment-target="runner" aria-hidden="true">
                  <svg viewBox="0 0 16 16" focusable="false"><path fill="var(--lp-fire)" d="M8 1.2C5.5 4.8 4 7 4 9.2a4 4 0 1 0 8 0C12 7 10.5 4.8 8 1.2z"/><path fill="var(--lp-fire-pale)" d="M8 4.8c-1.3 2-1.9 3.1-1.9 4.1a1.9 1.9 0 1 0 3.8 0c0-1-.6-2.1-1.9-4.1z"/></svg>
                </span>
              </div>
            <% end %>
            <% week_days.each_with_index do |_day, index| %>
              <% next if run_indices.include?(index) %>
              <span class="lp-streak-moment__future" aria-hidden="true"></span>
            <% end %>
          </div>
        </div>
      <% end %>

      <p class="lp-streak-moment__record"><%= t("climb.streak_moment.longest") %></p>

      <% if kind == :goal %>
        <p class="lp-streak-moment__did-it"><%= t("climb.streak_moment.you_did_it") %></p>
      <% end %>

      <% if kind == :progress && moment.target_days.present? %>
        <p class="lp-streak-moment__meta"><%= t("climb.streak_moment.day_of", n: moment.days, m: moment.target_days) %></p>
        <div class="lp-streak-moment__track"
             role="progressbar"
             aria-valuenow="<%= moment.days %>"
             aria-valuemin="0"
             aria-valuemax="<%= moment.target_days %>"
             aria-label="<%= t('climb.streak_moment.day_of', n: moment.days, m: moment.target_days) %>"
             style="--streak-fill: <%= moment.fill_pct.to_i %>%">
          <span class="lp-streak-moment__fill"></span>
        </div>
      <% end %>

      <div class="lp-streak-moment__spacer" aria-hidden="true"></div>

      <div class="lp-streak-moment__actions">
        <button type="button"
                class="lp-streak-moment__share"
                data-action="streak-moment#share">
          <%= t("climb.streak_moment.show_it_off") %>
        </button>
        <% if kind == :goal && offered.any? %>
          <button type="button"
                  class="lp-streak-moment__continue"
                  data-action="streak-moment#showCommit">
            <%= t("climb.streak_moment.pick_next") %>
          </button>
        <% else %>
          <button type="button"
                  class="lp-streak-moment__continue"
                  data-action="streak-moment#continue">
            <%= t("climb.streak_moment.continue") %>
          </button>
        <% end %>
      </div>
    </div>
  </div>

  <% commit_targets = offered %>
  <% commit_default = default_target %>
  <% if commit_targets.any? && commit_default.present? %>
    <div class="lp-streak-moment__panel is-card" data-streak-moment-target="commit" hidden>
      <div class="lp-streak-moment__card is-commit">
        <%= render "dashboard/streak_commit",
              offered_targets: commit_targets,
              default_target: commit_default %>
      </div>
    </div>
  <% end %>

  <div class="lp-streak-moment__panel is-card" data-streak-moment-target="reminderHost" hidden></div>
</div>
