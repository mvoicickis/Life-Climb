<%# locals: moment (Today::StreakMoment::Result) %>
<% moment = local_assigns[:moment] %>
<% return if moment.blank? %>
<% kind = (moment.kind || :celebrate).to_sym %>
<% week = moment.week || {} %>
<% week_days = Array(week[:days]) %>
<% week_counts = Array(week[:counts]) %>
<% local_today = Battles::WinsOnLocalDate.local_today_for(current_user) %>
<% offer_commit = moment.offer_commit %>
<% offered = Array(moment.offered_targets) %>
<% default_target = moment.default_target %>
<% aria =
     case kind
     when :progress
       t("climb.streak_moment.day_of", n: moment.days, m: moment.target_days)
     when :goal
       t("climb.streak_moment.days_in_a_row_bang", count: moment.days)
     else
       t("climb.streak_moment.aria", count: moment.days)
     end %>

<div class="lp-streak-moment<%= ' is-goal' if kind == :goal %>"
     data-controller="streak-moment"
     data-streak-moment-offer-commit-value="<%= offer_commit ? 'true' : 'false' %>"
     data-streak-moment-commit-url-value="<%= streak_commitment_path %>"
     data-streak-moment-decline-url-value="<%= decline_streak_commitment_path %>"
     data-streak-moment-not-saved-value="<%= t('dash.battlefield.win_not_saved') %>"
     data-streak-moment-commit-cta-template-value="<%= t('climb.streak_moment.commit_to_template') %>"
     role="dialog"
     aria-label="<%= aria %>">
  <div class="lp-streak-moment__veil" data-action="click->streak-moment#dismiss" aria-hidden="true"></div>

  <div class="lp-streak-moment__panel" data-streak-moment-target="celebrate">
  <div class="lp-streak-moment__card">
    <% if kind == :goal %>
      <div class="lp-streak-moment__confetti" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
      </div>
    <% end %>

    <div class="lp-streak-moment__badge">
      <img class="lp-streak-moment__logo" src="/icon.png?v=8" alt="" aria-hidden="true" width="56" height="56">
      <div class="lp-streak-moment__num-halo">
        <div class="lp-streak-moment__num-roll" aria-live="polite">
          <span class="lp-streak-moment__num is-from"><%= moment.from_days %></span>
          <span class="lp-streak-moment__num is-to"><%= moment.days %></span>
        </div>
      </div>
      <% if kind == :goal %>
        <p class="lp-streak-moment__sub"><%= t("climb.streak_moment.days_in_a_row_bang", count: moment.days) %></p>
      <% elsif kind != :progress %>
        <p class="lp-streak-moment__sub"><%= t("climb.streak_moment.days_in_a_row") %></p>
      <% end %>
    </div>

    <% if kind == :goal %>
      <p class="lp-streak-moment__did-it"><%= t("climb.streak_moment.you_did_it") %></p>
    <% end %>

    <% if week_days.any? %>
      <ul class="lp-streak-moment__week" aria-label="<%= t('climb.streak_moment.this_week') %>">
        <% week_days.each_with_index do |day, index| %>
          <% won = week_counts[index].to_i.positive? %>
          <li class="lp-streak-moment__day<%= ' is-today' if day == local_today %>">
            <span class="lp-streak-moment__day-label"><%= l(day, format: "%a") %></span>
            <span class="lp-streak-moment__day-mark<%= ' is-won' if won %>"></span>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if kind == :progress && moment.target_days.present? %>
      <p class="lp-streak-moment__meta"><%= t("climb.streak_moment.day_of", n: moment.days, m: moment.target_days) %></p>
      <div class="lp-streak-moment__track"
           role="progressbar"
           aria-valuenow="<%= moment.days %>"
           aria-valuemin="0"
           aria-valuemax="<%= moment.target_days %>"
           aria-label="<%= t('climb.streak_moment.day_of', n: moment.days, m: moment.target_days) %>"
           style="--streak-fill: <%= moment.fill_pct.to_i %>%">
        <span class="lp-streak-moment__fill"></span>
      </div>
    <% elsif kind == :celebrate && moment.goal_title.present? %>
      <div class="lp-streak-moment__goal">
        <span class="lp-streak-moment__goal-label"><%= t("climb.streak_moment.mountain_yours") %></span>
        <p class="lp-streak-moment__goal-title"><%= moment.goal_title %></p>
      </div>
    <% end %>

    <div class="lp-today-empty-cta__wrap lp-streak-moment__cta">
      <% if kind == :goal && offered.any? %>
        <button type="button"
                class="lp-today-empty-cta__pill"
                data-action="streak-moment#showCommit">
          <%= t("climb.streak_moment.pick_next") %>
        </button>
      <% else %>
        <button type="button"
                class="lp-today-empty-cta__pill"
                data-action="streak-moment#continue">
          <%= t("climb.streak_moment.continue") %>
        </button>
      <% end %>
    </div>

    <% if kind == :goal %>
      <button type="button" class="lp-streak-moment__share" hidden disabled>
        <%= t("climb.streak_moment.share") %>
      </button>
    <% end %>
  </div>
  </div>

  <% commit_targets = offered %>
  <% commit_default = default_target %>
  <% if commit_targets.any? && commit_default.present? %>
    <div class="lp-streak-moment__panel" data-streak-moment-target="commit" hidden>
      <div class="lp-streak-moment__card is-commit">
        <%= render "dashboard/streak_commit",
              offered_targets: commit_targets,
              default_target: commit_default %>
      </div>
    </div>
  <% end %>

  <div class="lp-streak-moment__panel" data-streak-moment-target="reminderHost" hidden></div>
</div>
