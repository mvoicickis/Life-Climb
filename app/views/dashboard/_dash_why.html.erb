<%# locals: journey, project_title %>
<section class="lp-dash-why" aria-label="<%= t('dash.why_label') %>">
  <p class="lp-dash-kicker"><%= t("dash.why_label") %></p>
  <div class="lp-dash-why__flow">
    <div class="lp-dash-why__step">
      <span class="lp-dash-why__icon" aria-hidden="true">❤️</span>
      <p><%= t("dash.why_goal") %></p>
    </div>
    <span class="lp-dash-why__arrow" aria-hidden="true">↓</span>
    <div class="lp-dash-why__step">
      <span class="lp-dash-why__icon" aria-hidden="true">🚀</span>
      <p><%= t("dash.why_project") %></p>
    </div>
    <span class="lp-dash-why__arrow" aria-hidden="true">↓</span>
    <div class="lp-dash-why__step">
      <span class="lp-dash-why__icon" aria-hidden="true">⚔</span>
      <p><%= t("dash.why_battle") %></p>
    </div>
  </div>
  <%= link_to t("dash.view_journey"), life_journey_path(journey), class: "lp-dash-why__link" %>
</section>
