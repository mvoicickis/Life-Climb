<%# Sequential end-of-day takeover orchestrator. %>
<%
  health = local_assigns.fetch(:health) { @battlefield_health }
  streak = local_assigns[:streak] || @climb_streak
  step = local_assigns.fetch(:step) { @eod_step }
  tomorrow_battles = Array(local_assigns.fetch(:tomorrow_battles) { @tomorrow_battles })
  flow_active = Today::EodFlow.flow_active?(step)
  closed_active = step == :closed
  takeover_active = Today::EodFlow.takeover_active?(step)
%>

<% if takeover_active %>
<section class="lp-today-v2-eod-takeover<%= ' is-flow' if flow_active %><%= ' is-closed' if closed_active %>"
         id="today-end-of-day"
         aria-label="<%= t('dash.end_of_day.title') %>">
  <% case step %>
  <% when :day_won %>
    <%= render "dashboard/dash_eod_step_day_won",
          health: health,
          handoff_only: @eod_handoff_only %>
  <% when :closed %>
    <%= render "dashboard/dash_eod_step_closed",
          streak: streak,
          tomorrow_battles: tomorrow_battles,
          mountain: @mountain,
          strategy_goal: @strategy_goal %>
  <% end %>
</section>
<% end %>
