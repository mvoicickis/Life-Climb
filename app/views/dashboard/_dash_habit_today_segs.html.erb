<%# locals: habit %>
<% ctx = habit_today_amount_context(habit) %>
<% if ctx[:progress].is_a?(Numeric) && (habit.binary_checkin? || (habit.quantity_checkin? && habit.stretch_goal?)) %>
  <%= tag.div(id: dom_id(habit, :today_segs), class: "lp-dash-habit__segs", aria: { hidden: true }) do %>
    <% habit_progress_segments(ctx[:progress], count: 16).each do |klass| %>
      <i class="<%= klass %>"></i>
    <% end %>
  <% end %>
<% else %>
  <%= tag.div id: dom_id(habit, :today_segs), hidden: true %>
<% end %>
