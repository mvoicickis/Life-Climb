<% content_for :title, "Home" %>

<div class="mx-auto flex max-w-5xl flex-col" style="min-height: calc(100dvh - 6rem);">
  <header class="mb-3 flex flex-wrap items-end justify-between gap-2">
    <div>
      <h1 class="text-3xl font-black tracking-tight text-slate-900 md:text-4xl">Home</h1>
      <p class="text-sm font-semibold text-slate-600 md:text-base">Green = good. Amber = Level. Red = needs work.</p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Settings", settings_path, class: "rounded-xl bg-white/80 px-3 py-2 text-sm font-bold text-slate-700 shadow-sm hover:bg-white" %>
      <%= link_to "+ Add", new_habit_path, class: "rounded-xl bg-emerald-500 px-3 py-2 text-sm font-black text-white shadow-sm hover:bg-emerald-600" %>
    </div>
  </header>

  <% if @trackers.any? %>
    <div class="mb-3 grid grid-cols-3 gap-2">
      <div class="rounded-2xl bg-emerald-500 px-3 py-2 text-center text-white shadow-sm">
        <p class="text-2xl font-black leading-none"><%= @ups %></p>
        <p class="mt-1 text-[10px] font-bold uppercase tracking-wide text-emerald-50">Up</p>
      </div>
      <div class="rounded-2xl bg-amber-400 px-3 py-2 text-center text-amber-950 shadow-sm">
        <p class="text-2xl font-black leading-none"><%= @levels %></p>
        <p class="mt-1 text-[10px] font-bold uppercase tracking-wide text-amber-900/80">Level</p>
      </div>
      <div class="rounded-2xl bg-rose-500 px-3 py-2 text-center text-white shadow-sm">
        <p class="text-2xl font-black leading-none"><%= @downs %></p>
        <p class="mt-1 text-[10px] font-bold uppercase tracking-wide text-rose-50">Down</p>
      </div>
    </div>

    <section class="home-board flex-1" style="<%= home_grid_style(@grid_count) %>">
      <% @trackers.each do |tracker| %>
        <% status = tracker.status %>
        <div class="home-card rounded-3xl border-2 p-3 shadow-sm <%= vs_yesterday_classes(status) %>"
             data-controller="share"
             data-share-text-value="<%= share_message_for(tracker) %>"
             data-share-url-value="<%= absolute_url(root_path) %>">
          <%= link_to habit_path(tracker), class: "flex min-h-0 flex-1 flex-col justify-between outline-none" do %>
            <div class="flex items-start justify-between gap-2">
              <p class="home-card-name font-black"><%= tracker.name %></p>
              <span class="home-card-trend rounded-lg px-2 py-1 font-black <%= vs_yesterday_badge_class(status) %>">
                <%= vs_yesterday_short(status) %>
              </span>
            </div>
            <div>
              <p class="home-card-value font-black"><%= format_amount(tracker.today_amount) %></p>
              <p class="home-card-trend mt-1 font-bold opacity-70"><%= tracker.unit %></p>
            </div>
          <% end %>
          <button type="button"
                  data-action="click->share#share"
                  class="mt-2 w-full rounded-xl border border-current/20 bg-white/50 px-2 py-1.5 text-xs font-black uppercase tracking-wide opacity-90 hover:bg-white/80">
            Share
          </button>
        </div>
      <% end %>
    </section>
  <% else %>
    <div class="flex flex-1 items-center justify-center rounded-3xl border-2 border-dashed border-slate-300 bg-white/70 p-8 text-center">
      <div>
        <p class="text-2xl font-black text-slate-900">Nothing on Home yet</p>
        <p class="mt-2 text-slate-600">Add something to count each day.</p>
        <%= link_to "Add something", new_habit_path, class: "mt-5 inline-flex rounded-2xl bg-emerald-500 px-5 py-3 font-black text-white" %>
      </div>
    </div>
  <% end %>
</div>
