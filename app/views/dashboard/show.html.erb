<% content_for :title, t("dashboard.title") %>

<div class="today-page today-fade mx-auto flex max-w-6xl flex-col gap-6"
     data-controller="share"
     data-share-url-value="<%= share_landing_url %>"
     data-share-title-value="LifePoints">

  <header class="today-hero flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <p class="today-kicker"><%= t("dashboard.kicker") %></p>
      <h1 class="today-title">
        <%= t("dashboard.title") %>
        <span class="today-sun" aria-hidden="true">☀</span>
      </h1>
      <p class="today-subtitle"><%= t("dashboard.subtitle") %></p>
      <p class="today-unique"><%= t("dashboard.unique_note") %></p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <aside class="today-quote" aria-label="<%= t('dashboard.quote') %>">
        <span aria-hidden="true">🌿</span>
        <p><%= t("dashboard.quote") %></p>
      </aside>
      <%= link_to t("dashboard.add"), new_habit_path, class: "today-add" %>
    </div>
  </header>

  <% if @trackers.any? %>
    <div class="today-summary" role="group" aria-label="<%= t('dashboard.title') %> summary">
      <div class="today-chip today-chip--good">
        <p class="today-chip-value"><%= @good %></p>
        <p class="today-chip-label"><%= t("dashboard.summary.better") %></p>
        <p class="today-chip-note"><%= t("dashboard.summary.better_note") %></p>
      </div>
      <div class="today-chip today-chip--same">
        <p class="today-chip-value"><%= @same %></p>
        <p class="today-chip-label"><%= t("dashboard.summary.same") %></p>
        <p class="today-chip-note"><%= t("dashboard.summary.same_note") %></p>
      </div>
      <div class="today-chip today-chip--off">
        <p class="today-chip-value"><%= @off %></p>
        <p class="today-chip-label"><%= t("dashboard.summary.needs_work") %></p>
        <p class="today-chip-note"><%= t("dashboard.summary.needs_work_note") %></p>
      </div>
      <div class="today-chip today-chip--streak">
        <p class="today-chip-value"><%= @streak %></p>
        <p class="today-chip-label"><%= t("dashboard.summary.streak") %></p>
        <p class="today-chip-note"><%= @streak.positive? ? t("dashboard.summary.streak_hot") : t("dashboard.summary.streak_start") %></p>
      </div>
    </div>

    <% if @celebrations.any? %>
      <section class="today-celebrate" aria-live="polite">
        <% @celebrations.each do |item| %>
          <div class="today-celebrate-card">
            <div>
              <p class="today-celebrate-kicker"><%= t("dashboard.celebrate.title") %></p>
              <p class="today-celebrate-label">
                <%= item[:label] %>
                <% if item[:tracker] %> · <%= item[:tracker].name %><% end %>
              </p>
            </div>
            <% if item[:tracker] %>
              <button type="button"
                      class="today-celebrate-btn"
                      data-action="click->share#open"
                      data-share-text-param="<%= share_message_body_for(item[:tracker]) %>"
                      data-share-url-param="<%= share_landing_url %>"
                      data-share-title-param="<%= item[:tracker].name %> · LifePoints">
                <%= t("dashboard.celebrate.cta") %>
              </button>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>

    <section class="home-board" style="<%= home_grid_style(@grid_count) %>" aria-label="<%= t('dashboard.title') %>">
      <% @trackers.each do |tracker| %>
        <% status = tracker.status %>
        <% progress = tracker.goal_progress_percent %>
        <%= link_to habit_path(tracker), class: "home-card #{vs_yesterday_classes(status)} today-card-link", aria: { label: "#{tracker.name}, #{status_full_text(status)}" } do %>
          <div class="flex items-start justify-between gap-2">
            <div class="flex min-w-0 items-center gap-2.5">
              <span class="today-card-icon" aria-hidden="true"><%= stat_icon_for(tracker) %></span>
              <div class="min-w-0">
                <p class="home-card-name truncate font-black"><%= tracker.name %></p>
                <p class="today-card-unit"><%= tracker.unit %></p>
              </div>
            </div>
            <%= render "shared/status_badge", status: status %>
          </div>

          <div class="mt-auto pt-5">
            <p class="home-card-value font-black"><%= format_amount(tracker.today_amount) %></p>
            <p class="today-delta mt-2"><%= amount_delta_label(tracker) %></p>

            <% if tracker.better_than_yesterday? && tracker.todays_goal_value.to_d > 0 %>
              <div class="today-mini-bar mt-3" aria-hidden="true">
                <div class="today-mini-bar-fill <%= vs_yesterday_bar_class(status) %>" style="width: <%= progress %>%"></div>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </section>

    <section class="today-lower">
      <div class="today-panel today-week"
           data-controller="week-chart"
           data-week-chart-points-value="<%= @week_series.to_json %>">
        <div class="flex items-center justify-between gap-3">
          <h2 class="today-panel-title"><%= t("dashboard.weekly.title") %></h2>
          <span class="today-week-score"><%= @week_percent %>%</span>
        </div>

        <div class="week-line-wrap">
            <svg data-week-chart-target="svg" class="week-line-svg" role="img" aria-label="<%= t('dashboard.weekly.aria') %>">
            <defs>
              <linearGradient id="weekArea" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#34d399" stop-opacity="0.35"/>
                <stop offset="100%" stop-color="#34d399" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <path data-week-chart-target="area" class="week-line-area" fill="url(#weekArea)"></path>
            <path data-week-chart-target="line" class="week-line-path" fill="none"></path>
            <g data-week-chart-target="points"></g>
          </svg>
          <div data-week-chart-target="tooltip" class="week-line-tooltip" hidden>
            <p data-week-chart-target="tooltipLabel" class="week-line-tooltip-label"></p>
            <p data-week-chart-target="tooltipValue" class="week-line-tooltip-value"></p>
          </div>
        </div>

        <div class="week-line-legend" aria-hidden="true">
          <% @week_series.each do |point| %>
            <span class="<%= 'is-current' if point[:current] %>"><%= point[:label] %></span>
          <% end %>
        </div>
      </div>

      <div class="today-panel today-focus">
        <h2 class="today-panel-title"><%= t("dashboard.focus.title") %></h2>
        <ul class="today-focus-list">
          <% @focus_tips.each do |tip| %>
            <li>
              <span aria-hidden="true">➜</span>
              <p><%= tip %></p>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="today-panel today-banner" style="background-image: url('/lifepoints-landing-hero.jpg');">
        <div class="today-banner-veil">
          <p class="today-banner-kicker"><%= t("dashboard.banner.kicker") %></p>
          <p class="today-banner-copy"><%= t("dashboard.banner.copy") %></p>
        </div>
      </div>
    </section>
  <% else %>
    <div class="today-empty">
      <p class="text-2xl font-black tracking-tight text-white"><%= t("dashboard.empty_title") %></p>
      <p class="mt-3 text-base font-semibold leading-relaxed text-slate-300">
        <%= t("dashboard.empty_body") %>
      </p>
      <p class="mt-2 text-sm font-semibold text-emerald-300/90"><%= t("dashboard.unique_note") %></p>
      <%= link_to t("dashboard.empty_cta"), new_habit_path, class: "today-add mt-6" %>
    </div>
  <% end %>

  <%= render "shared/share_sheet" %>
</div>
