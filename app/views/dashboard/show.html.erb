<% content_for :title, t("game_ui.dashboard_title") %>
<% content_for :lp_game, true %>

<%
  incomplete = @actions.reject(&:completed?)
  focus_action = incomplete.first || @actions.first
  gap = current_user.overall_gap_percent(@life_areas)
  morale = current_user.morale_score(actions: @actions)
  greeting =
    case Time.current.hour
    when 5..11 then t("game_ui.good_morning")
    when 12..17 then t("game_ui.good_afternoon")
    else t("game_ui.good_evening")
    end
%>

<div class="lp-home mx-auto max-w-lg px-4 pb-4 pt-5">
  <header class="flex items-start justify-between gap-3">
    <div class="flex min-w-0 items-center gap-3">
      <%= image_tag current_user.character_image,
            alt: current_user.character_key.capitalize,
            class: "lp-avatar-ring h-14 w-14 object-cover" %>
      <div class="min-w-0">
        <h1 class="truncate text-xl font-semibold text-[var(--lp-ink)]">
          <%= greeting %>, <span class="text-[var(--lp-lime)]"><%= current_user.display_name %></span>!
        </h1>
        <p class="mt-0.5 text-sm text-[var(--lp-muted)]"><%= t("game_ui.closer_line") %></p>
      </div>
    </div>
    <%= link_to settings_path, class: "mt-1 text-[var(--lp-gold)]", aria: { label: t("nav.settings") } do %>
      <span aria-hidden="true">🔔</span>
    <% end %>
  </header>

  <section class="lp-glass mt-5 p-4" aria-label="<%= t('nav.life_points') %>">
    <div class="flex items-end justify-between gap-3">
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-[var(--lp-gold)]">✦ <%= t("nav.life_points") %></p>
        <p class="mt-1 text-4xl font-bold tracking-tight text-[var(--lp-lime)]">
          <%= number_with_delimiter(@life_points) %> <span class="text-2xl">LP</span>
        </p>
        <p class="mt-2 inline-flex rounded-full bg-[var(--lp-elevated)] px-3 py-1 text-xs font-bold text-[var(--lp-gold)]">
          +<%= number_with_delimiter(@lp_today) %> LP <%= t("game_ui.today") %>
        </p>
      </div>
      <div class="text-right">
        <p class="text-xs font-bold uppercase tracking-wide text-[var(--lp-muted)]"><%= @alive_level.title %></p>
        <div class="lp-sparkline mt-2" aria-hidden="true">
          <svg viewBox="0 0 120 40" class="h-10 w-28">
            <path d="M2 32 C20 28, 28 18, 40 20 S60 8, 78 12 S100 4, 118 6" fill="none" stroke="var(--lp-lime)" stroke-width="2.5" stroke-linecap="round"/>
            <circle cx="118" cy="6" r="4" fill="var(--lp-gold)"/>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <section id="life-map" class="lp-glass lp-map-card mt-4 overflow-hidden" aria-label="<%= t('game_ui.life_map') %>">
    <div class="lp-map-stage">
      <div class="lp-map-ring" role="list">
        <% @life_areas.each_with_index do |area, index| %>
          <% angle = (360.0 / @life_areas.size) * index - 90 %>
          <%= link_to life_area_path(area),
                class: "lp-map-node #{'is-focus' if @life_area&.id == area.id}",
                style: "--lp-angle: #{angle}deg",
                role: "listitem" do %>
            <span class="lp-map-node__dot" aria-hidden="true"><%= area.number %></span>
            <span class="lp-map-node__label"><%= area.short_label %></span>
            <span class="lp-map-node__pct"><%= area.closer_percent %>%</span>
          <% end %>
        <% end %>
        <div class="lp-map-center">
          <%= image_tag current_user.character_image, alt: "", class: "lp-avatar-ring h-16 w-16 object-cover" %>
        </div>
      </div>
    </div>
    <div class="border-t border-[var(--lp-border)] px-4 py-3">
      <p class="text-sm font-semibold text-[var(--lp-ink)]">
        <%= t("game_ui.overall_gap") %>:
        <span class="text-[var(--lp-lime)]"><%= gap %>%</span>
      </p>
      <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("game_ui.gap_away", percent: gap) %></p>
      <% if @life_area %>
        <%= link_to t("game_ui.view_progress"), life_area_path(@life_area), class: "mt-2 inline-flex text-sm font-bold text-[var(--lp-mint)]" %>
      <% end %>
    </div>
  </section>

  <section id="todays-mission" class="lp-glass mt-4 overflow-hidden" aria-labelledby="mission-heading">
    <div class="px-4 pt-4">
      <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-[var(--lp-lime)]/80"><%= t("game_ui.todays_mission") %></p>
    </div>

    <% if focus_action %>
      <div class="px-4 pb-4 pt-2">
        <h2 id="mission-heading" class="text-xl font-semibold text-[var(--lp-ink)]"><%= focus_action.title %></h2>
        <% if @life_area %>
          <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= @life_area.short_label %> · <%= @goal.title %></p>
        <% end %>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="rounded-full bg-[var(--lp-elevated)] px-3 py-1 text-xs font-bold text-[var(--lp-gold)]">
            +<%= LifePointsAward::ACTION %> LP
          </span>
          <span class="rounded-full bg-[var(--lp-elevated)] px-3 py-1 text-xs font-bold text-[var(--lp-mint)]">
            +<%= t("game_ui.morale_chip") %>
          </span>
        </div>

        <% if focus_action.completed? %>
          <p class="lp-cta mt-4 w-full opacity-70"><%= t("game_ui.mission_done") %></p>
        <% else %>
          <%= button_to t("game_ui.start_mission"),
                complete_today_action_path(focus_action),
                method: :post,
                class: "lp-cta mt-4 w-full",
                data: { turbo: true } %>
        <% end %>
      </div>

      <% if @actions.size > 1 %>
        <ul class="space-y-2 border-t border-[var(--lp-border)] px-4 py-3">
          <% @actions.reject { |a| a.id == focus_action.id }.each do |action| %>
            <li class="flex items-center justify-between gap-2 text-sm <%= 'opacity-50' if action.completed? %>">
              <span class="text-[var(--lp-ink)]"><%= action.completed? ? "✓" : "○" %> <%= action.title %></span>
              <% unless action.completed? %>
                <%= button_to "+#{LifePointsAward::ACTION}",
                      complete_today_action_path(action),
                      method: :post,
                      class: "rounded-full bg-[var(--lp-elevated)] px-2 py-1 text-xs font-bold text-[var(--lp-lime)]" %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% else %>
      <div class="px-4 pb-4 pt-2">
        <h2 id="mission-heading" class="text-xl font-semibold text-[var(--lp-ink)]"><%= t("game_ui.no_mission") %></h2>
        <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("game_ui.no_mission_hint") %></p>
      </div>
    <% end %>
  </section>

  <div class="mt-4 grid grid-cols-2 gap-3">
    <section class="lp-glass p-4">
      <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--lp-muted)]"><%= t("game_ui.lp_trend") %></p>
      <p class="mt-2 text-lg font-bold text-[var(--lp-lime)]">+<%= number_with_delimiter(@lp_today) %> LP</p>
      <p class="text-xs text-[var(--lp-muted)]"><%= t("game_ui.today") %></p>
    </section>
    <section class="lp-glass p-4">
      <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--lp-muted)]"><%= t("game_ui.morale") %></p>
      <div class="lp-morale mt-3" style="--morale: <%= morale %>" aria-label="<%= morale %>%">
        <span class="lp-morale__fill"></span>
      </div>
      <p class="mt-2 text-xs text-[var(--lp-muted)]"><%= t("game_ui.morale_hint") %></p>
    </section>
  </div>

  <% if @life_area %>
    <div class="mt-4">
      <%= render "dashboard/area_progress", life_area: @life_area %>
    </div>
  <% end %>

  <section id="add-mission" class="lp-glass mt-4 p-4">
    <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--lp-muted)]"><%= t("game_ui.add_mission") %></p>
    <%= form_with url: today_actions_path, scope: :today_action, class: "mt-3 flex gap-2" do |f| %>
      <%= f.text_field :title,
            placeholder: t("studio.action_placeholder"),
            class: "lp-input flex-1",
            required: true,
            autocomplete: "off" %>
      <%= f.submit t("studio.add_action"), class: "lp-cta shrink-0 !px-4 !py-2 text-sm" %>
    <% end %>
  </section>

  <% unless current_user.character_chosen? %>
    <div class="lp-glass mt-4 p-4">
      <%= form_with model: current_user, url: settings_path, method: :patch do %>
        <%= render "shared/character_picker", selected: current_user.character %>
      <% end %>
    </div>
  <% end %>
</div>

<%= render "shared/lp_bottom_nav", active: :dashboard %>
