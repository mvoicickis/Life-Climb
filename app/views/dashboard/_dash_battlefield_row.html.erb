<%# Today V2 — single battle row or route mission. locals: todo, mission, journey, row_state (:open, :pending_won, :won) %>
<%
  todo = local_assigns[:todo]
  mission = local_assigns[:mission]
  row_state = local_assigns.fetch(:row_state, :open).to_sym
  qty_project = nil
  strategy_battle = nil
  if mission
    title = mission.title
    project = nil
    complete_url = mission_completion_path(mission)
    complete_params = { aspect_key: mission.aspect_key }
    row_id = dom_id(mission, :battlefield_row)
    win_form = true
  else
    title = todo.title
    project = todo.visible_path_project
    complete_url = complete_daily_todo_path(todo)
    complete_params = {}
    row_id = dom_id(todo, :battlefield_row)
    qty_project = todo.strategy_goal&.quantified_path_project
    strategy_battle = todo.strategy_goal
    win_form = row_state == :open
  end
  camp_style = battlefield_camp_style(project)
  camp_label = project&.title.presence || t("dash.battlefield.no_camp")
  row_classes = [ "lp-today-v2-row" ]
  row_classes << "is-struck" if row_state.in?(%i[pending_won won])
  row_classes << "is-pending-won" if row_state == :pending_won
  row_classes << "is-won-row" if row_state == :won
  controllers = [ "today-battle-row" ]
  controllers << "quantity-complete" if qty_project
  controllers << "inline-title-edit" if strategy_battle
  controllers << "today-battle-pending-win" if row_state == :pending_won
%>
<article class="<%= row_classes.join(" ") %>"
         id="<%= row_id %>"
         data-controller="<%= controllers.join(" ") %>"
         <% if strategy_battle %>
         data-inline-title-edit-update-url-value="<%= strategy_goal_path(strategy_battle) %>"
         data-inline-title-edit-mode-value="today"
         data-inline-title-edit-battle-id-value="<%= strategy_battle.id %>"
         data-inline-title-edit-todo-id-value="<%= todo.id %>"
         data-inline-title-edit-at-max-template-value="<%= t('title_limit.at_max') %>"
         <% end %>
         data-action="click->today-battle-row#activate"
         <% if todo %>
         data-todo-id="<%= todo.id %>"
         data-battle-day-target="item"
         data-lp="<%= todo.lp_reward %>"
         <% end %>>
  <% if project %>
    <span class="lp-today-v2-row__stripe" style="background: <%= camp_style[:color] %>" aria-hidden="true"></span>
  <% end %>

  <% if qty_project %>
    <%= button_to complete_url,
          method: :post,
          form: {
            class: "lp-today-v2-row__check-form",
            data: {
              turbo: true,
              turbo_stream: true,
              quantity_complete_target: "form",
              action: "submit->quantity-complete#intercept"
            }
          },
          class: "lp-today-v2-row__check",
          aria: { label: t("dash.battlefield.win_battle", title: title) } do %>
      <span class="lp-today-v2-row__tick-slot" aria-hidden="true"><span class="lp-today-v2-row__box"></span></span>
      <%= render "shared/push_endpoint_hidden" %>
    <% end %>
    <%= render "dashboard/dash_battlefield_quantity_sheet", todo: todo, project: qty_project %>
  <% elsif win_form %>
    <%= button_to complete_url,
          method: :post,
          params: complete_params,
          form: {
            class: "lp-today-v2-row__check-form",
            data: {
              turbo: true,
              turbo_stream: true,
              controller: "juicy-feedback",
              action: "submit->juicy-feedback#play turbo:submit-end->juicy-feedback#winSubmitEnd",
              juicy_feedback_suppress_reload_celebrate_value: true,
              juicy_feedback_defer_reward_value: true,
              juicy_feedback_strength_label_value: t("dash.action_points_hint"),
              juicy_feedback_win_not_saved_value: t("dash.battlefield.win_not_saved")
            }
          },
          class: "lp-today-v2-row__check",
          aria: { label: t("dash.battlefield.win_battle", title: title) } do %>
      <span class="lp-today-v2-row__tick-slot" aria-hidden="true"><span class="lp-today-v2-row__box"></span></span>
      <%= render "shared/push_endpoint_hidden" %>
    <% end %>
  <% else %>
    <%= button_to complete_url,
          method: :post,
          params: complete_params,
          form: {
            class: "lp-today-v2-row__check-form",
            data: { turbo: true, turbo_stream: true }
          },
          class: "lp-today-v2-row__check",
          aria: { label: t("dash.battlefield.unwin_battle", title: title) } do %>
      <span class="lp-today-v2-row__tick-slot" aria-hidden="true"><span class="lp-today-v2-row__box is-won"></span></span>
      <%= render "shared/push_endpoint_hidden" %>
    <% end %>
  <% end %>

  <div class="lp-today-v2-row__copy">
    <div class="lp-today-v2-row__title-line">
      <% if strategy_battle %>
        <button type="button"
                class="lp-today-v2-row__title lp-today-v2-row__title-btn"
                data-inline-title-edit-target="display"
                data-action="click->inline-title-edit#open">
          <%= title %>
        </button>
      <% else %>
        <p class="lp-today-v2-row__title"><%= title %></p>
      <% end %>

      <% unless row_state == :won %>
        <span class="lp-today-v2-row__camp-inline"><%= camp_label %></span>
        <span class="lp-today-v2-row__camp"
              style="color: <%= camp_style[:color] %>; background: <%= camp_style[:bg] %>">
          <%= camp_label %>
        </span>
      <% end %>
    </div>
  </div>

  <% if row_state == :pending_won %>
    <button type="button"
            class="lp-today-row__undo"
            hidden
            data-today-battle-pending-win-target="undo"
            data-action="click->today-battle-pending-win#undo">
      <%= t("dash.battlefield.undo") %>
    </button>
  <% end %>
</article>
