<%# Today V2 battlefield surface — plan-route coach OR HP + battlefield/end-of-day. %>
<% if @show_plan_route %>
  <%= render "dashboard/dash_plan_route",
        journey: @journey,
        mission: @mission,
        adventure_year: @adventure_year,
        strategy_goal: @strategy_goal,
        first_climb: @first_climb_needed %>
<% else %>
  <%= render "dashboard/dash_battlefield",
        health: @battlefield_health,
        open_todos: @open_todos,
        done_todos: @done_todos,
        journey: @journey,
        include_mission: @include_mission_in_battle,
        mission: @mission %>
  <%= render "dashboard/push_offer_host",
        show_on_connect: @push_offer_show_on_visit,
        compact: true,
        show_not_now: false,
        mark_shown_on_display: true %>
  <% if habits_enabled? %>
    <div id="today-anytime-host">
      <%= render "dashboard/dash_anytime", habits: @habits %>
    </div>
  <% end %>
<% end %>
