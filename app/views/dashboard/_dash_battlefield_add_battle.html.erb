<%# locals: health, journey %>
<% health = local_assigns.fetch(:health) %>
<% journey = local_assigns.fetch(:journey) { @journey } %>
<% show_add = today_inline_add_battle?(journey: journey) %>
<% all_clear = health.all_clear? %>
<% empty_attract = health.empty? && !all_clear %>
<% pressable_action = "pointerdown->pressable#press pointerup->pressable#release pointercancel->pressable#release pointerleave->pressable#release" %>
<% pressable_data = { controller: "pressable", action: pressable_action } %>
<% placeholder =
     if all_clear
       t("dash.battlefield.add_battle.placeholder_all_clear")
     else
       t("dash.battlefield.add_battle.placeholder")
     end %>

<div id="today-battlefield-add-host">
  <% if show_add %>
    <div class="lp-today-add-battle<%= " is-empty-attract" if empty_attract %><%= " is-all-clear" if all_clear %>"
         data-controller="today-add-battle"
         data-today-add-battle-url-value="<%= today_battles_path %>"
         data-today-add-battle-not-saved-value="<%= t('dash.battlefield.win_not_saved') %>"
         data-today-add-battle-all-clear-value="<%= all_clear %>">
      <button type="button"
              class="lp-today-add-battle__expand lp-pressable"
              <%= "hidden" if empty_attract %>
              data-controller="pressable"
              data-today-add-battle-target="expand"
              data-action="<%= pressable_action %> click->today-add-battle#expand">
        <%= t("dash.battlefield.add_battle.expand") %>
      </button>
      <div class="lp-today-add-battle__row<%= " is-open" if empty_attract %>"
           <%= "hidden" unless empty_attract %>
           data-today-add-battle-target="composer">
        <textarea class="lp-today-add-battle__field"
                  rows="1"
                  maxlength="<%= StrategyGoal::TITLE_MAX %>"
                  inputmode="text"
                  autocomplete="off"
                  spellcheck="true"
                  enterkeyhint="done"
                  placeholder="<%= placeholder %>"
                  aria-label="<%= t('dash.battlefield.add_battle.aria') %>"
                  data-today-add-battle-target="field"
                  data-action="input->today-add-battle#sync keydown->today-add-battle#keydown blur->today-add-battle#blurField"></textarea>
        <button type="button"
                class="lp-today-add-battle__add lp-btn-3d is-green<%= all_clear ? " is-ready" : " is-muted" %> lp-pressable"
                aria-label="<%= t('dash.battlefield.add_battle.submit') %>"
                <%= "disabled" unless all_clear %>
                data-controller="pressable"
                data-today-add-battle-target="submit"
                data-action="<%= pressable_action %> click->today-add-battle#save">
          <%= t("dash.battlefield.add_battle.submit") %>
        </button>
      </div>
      <button type="button"
              class="lp-today-add-battle__fail lp-pressable"
              hidden
              data-controller="pressable"
              data-today-add-battle-target="fail"
              data-action="<%= pressable_action %> click->today-add-battle#retry">
        <%= t("dash.battlefield.win_not_saved") %>
      </button>
    </div>
  <% end %>
</div>
