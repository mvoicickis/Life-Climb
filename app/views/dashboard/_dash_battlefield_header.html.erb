<%# Today V2 — frosted goal card. Camp name + lifetime wins from @goal_card_camp; bar = today's battles (@battlefield_health). %>
<% goal_title = active_goal_title(strategy_goal: @strategy_goal, journey: @journey) %>
<% camp = @goal_card_camp %>
<% camp_title = camp&.dig(:camp_title).to_s %>
<% camp_won = camp&.dig(:won).to_i %>
<% today_total = @battlefield_health&.total_count.to_i %>
<% today_won = @battlefield_health&.done_count.to_i %>
<% today_fill = today_total.positive? ? (today_won.to_f / today_total).clamp(0, 1) : 0 %>

<div class="lp-today-group-card lp-today-group-card--goal"
     data-controller="today-goal-card">
  <header class="lp-today-v2-header lp-today-v2-header--compact"
          aria-label="<%= t('dash.battlefield.goal_card.label') %>">
    <div class="lp-today-goal-kicker-row">
      <p class="lp-today-goal-kicker"><%= t("dash.battlefield.goal_card.label") %></p>
    </div>
    <p class="lp-today-v2-header__name" title="<%= goal_title %>"><%= goal_title %></p>

    <% if camp.present? %>
      <p class="lp-today-goal-camp" title="<%= camp_title %>"><%= camp_title %></p>
      <div class="lp-today-camp-bar-row">
        <% if today_total.positive? %>
          <div class="lp-today-camp-bar"
               role="progressbar"
               aria-valuemin="0"
               aria-valuemax="<%= today_total %>"
               aria-valuenow="<%= today_won %>"
               aria-label="<%= t('dash.battlefield.goal_card.today_battles_bar') %>">
            <span class="lp-today-camp-bar__fill"
                  data-today-goal-bar
                  style="--lp-fill: <%= today_fill %>"></span>
          </div>
        <% end %>
        <p class="lp-today-camp-won"<%= " hidden" unless camp_won.positive? %>>
          <%= t("dash.battlefield.goal_card.won", count: camp_won) %>
        </p>
      </div>
    <% end %>
  </header>
</div>