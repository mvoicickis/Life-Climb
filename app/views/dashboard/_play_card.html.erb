<% log = tracker.today_log %>
<% suggested = tracker.suggested_goal_for_today %>
<% goal = tracker.todays_goal_value %>
<% status = tracker.vs_yesterday %>
<% progress = tracker.goal_progress_percent %>

<article class="overflow-hidden rounded-3xl border-2 <%= vs_yesterday_classes(status) %> shadow-sm">
  <div class="p-5">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h2 class="text-2xl font-black tracking-tight"><%= tracker.name %></h2>
        <p class="text-sm font-medium opacity-70"><%= tracker.unit %></p>
      </div>
      <div class="rounded-2xl px-3 py-2 text-center <%= status == :up ? 'bg-emerald-500 text-white' : status == :not_up ? 'bg-rose-500 text-white' : 'bg-sky-500 text-white' %>">
        <p class="text-xs font-bold uppercase tracking-wide"><%= vs_yesterday_short(status) %></p>
      </div>
    </div>

    <div class="mt-5 flex items-end justify-between gap-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wide opacity-60">You did</p>
        <p class="text-5xl font-black leading-none"><%= format_amount(tracker.today_amount) %></p>
      </div>
      <div class="text-right">
        <p class="text-xs font-bold uppercase tracking-wide opacity-60">Goal</p>
        <p class="text-2xl font-black"><%= format_amount(goal) || "—" %></p>
        <p class="text-xs font-semibold opacity-70">Yesterday <%= format_amount(tracker.yesterday_amount) %></p>
      </div>
    </div>

    <div class="mt-5">
      <div class="mb-2 flex items-center justify-between text-xs font-bold uppercase tracking-wide opacity-70">
        <span>Goal bar</span>
        <span><%= progress %>%</span>
      </div>
      <div class="h-4 overflow-hidden rounded-full bg-black/10">
        <div class="h-full rounded-full transition-all <%= vs_yesterday_bar_class(status) %>" style="width: <%= progress %>%"></div>
      </div>
      <p class="mt-2 text-sm font-semibold"><%= tracker.vs_yesterday_label %></p>
    </div>

    <%= form_with url: daily_logs_path(habit_id: tracker.id), scope: :daily_log, class: "mt-5 space-y-3", data: { turbo: false } do |form| %>
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <%= form.label :amount, "You did today", class: "mb-1 block text-sm font-bold" %>
          <%= form.number_field :amount,
              value: log&.amount || suggested || 0,
              min: 0,
              step: :any,
              required: true,
              class: "w-full rounded-2xl border-2 border-black/10 bg-white px-4 py-3 text-xl font-black focus:border-emerald-500 focus:outline-none" %>
        </div>
        <div>
          <%= form.label :goal, "Today's goal", class: "mb-1 block text-sm font-bold" %>
          <%= form.number_field :goal,
              value: goal || "",
              min: 0,
              step: :any,
              placeholder: "First day",
              class: "w-full rounded-2xl border-2 border-black/10 bg-white px-4 py-3 text-xl font-black focus:border-emerald-500 focus:outline-none" %>
        </div>
      </div>

      <%= form.submit "Save today's number",
          class: "w-full cursor-pointer rounded-2xl bg-slate-900 px-4 py-4 text-base font-black text-white hover:bg-slate-800" %>
    <% end %>

    <p class="mt-3 text-xs font-medium opacity-60">
      <% if suggested.present? %>
        Goal grows a little each day (+1%). Change it if you want.
      <% else %>
        First day: type what you did. Tomorrow the goal can grow.
      <% end %>
    </p>
  </div>
</article>
