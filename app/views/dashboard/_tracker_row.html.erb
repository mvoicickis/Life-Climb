<% log = tracker.today_log %>
<% suggested = tracker.suggested_goal_for_today %>
<% status = tracker.status %>

<div class="rounded-xl border border-slate-200 bg-white p-4">
  <div class="mb-3 flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 class="font-semibold text-slate-900"><%= tracker.name %></h3>
      <p class="text-sm text-slate-500">Count: <%= tracker.unit %></p>
    </div>
    <span class="rounded-full border px-3 py-1 text-xs font-medium <%= vs_yesterday_classes(status) %>">
      <%= tracker.status_label %>
    </span>
  </div>

  <div class="mb-3 grid gap-2 text-sm text-slate-600 sm:grid-cols-3">
    <p>Yesterday: <strong class="text-slate-900"><%= format_amount(tracker.yesterday_amount) %></strong></p>
    <p>Today: <strong class="text-slate-900"><%= format_amount(tracker.today_amount) %></strong></p>
    <p>
      Today's goal:
      <strong class="text-slate-900">
        <%= format_amount(log&.goal || suggested) || "Set on first day" %>
      </strong>
    </p>
  </div>

  <%= form_with url: daily_logs_path(habit_id: tracker.id), scope: :daily_log, class: "flex flex-wrap items-end gap-3", data: { turbo: false } do |form| %>
    <div class="min-w-[8rem] flex-1">
      <%= form.label :amount, "You did today", class: "mb-1 block text-sm font-medium" %>
      <%= form.number_field :amount,
          value: log&.amount || suggested || 0,
          min: 0,
          step: :any,
          required: true,
          class: "w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200" %>
    </div>

    <% if suggested.present? || log&.goal.present? %>
      <div class="min-w-[8rem]">
        <%= form.label :goal, "Today's goal", class: "mb-1 block text-sm font-medium" %>
        <%= form.number_field :goal,
            value: log&.goal || suggested,
            min: 0,
            step: :any,
            class: "w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200" %>
      </div>
    <% end %>

    <%= form.submit "Save",
        class: "cursor-pointer rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700" %>
  <% end %>

  <% if suggested.present? %>
    <p class="mt-2 text-xs text-slate-500">Goal starts as a little more than yesterday (1%). You can change it.</p>
  <% elsif tracker.yesterday_amount.blank? %>
    <p class="mt-2 text-xs text-slate-500">First day: save what you did. Tomorrow the goal can grow a little.</p>
  <% end %>
</div>
