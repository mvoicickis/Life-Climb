<div id="dashboard-stats" class="mb-8 grid gap-4 sm:grid-cols-2">
  <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-6">
    <p class="text-sm font-medium text-emerald-700">Total points</p>
    <p class="mt-1 text-4xl font-bold text-emerald-900"><%= current_user.total_points %></p>
  </div>

  <div class="rounded-xl border border-sky-200 bg-sky-50 p-6">
    <p class="text-sm font-medium text-sky-700">Points today</p>
    <p class="mt-1 text-4xl font-bold text-sky-900"><%= current_user.points_today %></p>
  </div>
</div>
