<%# locals: health, day_ended: false %>
<% health = local_assigns.fetch(:health) %>
<% day_ended = local_assigns.fetch(:day_ended, false) %>
<% flow_started = Today::EodFlow.acknowledged?(session) %>
<% if health.all_clear? && !day_ended && !flow_started %>
  <%= button_to t("dash.battlefield.notch_end_day"),
        today_end_day_path,
        method: :post,
        form: { class: "lp-today-battlefield-end-day__form", data: { turbo: false } },
        class: "lp-today-battlefield-end-day__btn lp-today-v2-eod-card__primary" %>
<% end %>
