<%# locals: todos, open_todos, done_todos, mission, include_mission, reward, open_count, total_count, aspect_key, upcoming %>
<%
  open_todos = local_assigns.fetch(:open_todos) { todos.reject(&:completed?) }
  done_todos = local_assigns.fetch(:done_todos) { todos.select(&:completed?) }
  total_count = local_assigns.fetch(:total_count) { todos.size + (include_mission ? 1 : 0) }
  upcoming = local_assigns[:upcoming]
  battle_empty = open_todos.empty? && done_todos.empty? && !include_mission
  battle_won = !battle_empty && open_count.to_i.zero?
%>

<section class="lp-dash-battle" aria-label="<%= t('dash.battle_title') %>">
  <header class="lp-dash-battle__head">
    <h2 class="lp-dash-battle__title"><%= t("dash.battle_title") %></h2>
    <p class="lp-dash-battle__sub"><%= t("dash.battle_subtitle") %></p>
  </header>

  <% if battle_empty %>
    <% handoff = @strategy_handoff %>
    <div class="lp-dash-battle__empty">
      <p class="lp-dash-empty"><%= t("dash.battle_empty") %></p>
      <p class="lp-dash-battle__empty-cta">
        <%= link_to (handoff&.dig(:label) || t("dash.battle_empty_cta")),
              (handoff&.dig(:href) || (@journey ? life_journey_path(@journey) : new_life_journey_path)),
              class: "lp-dash-battle__link-cta" %>
      </p>
      <% if upcoming %>
        <p class="lp-dash-battle__tomorrow">
          <% if upcoming[:tomorrow] %>
            <%= t("dash.tomorrow_set", title: upcoming[:title]) %>
          <% else %>
            <%= t("dash.next_battle_set", title: upcoming[:title], date: l(upcoming[:scheduled_on], format: :short)) %>
          <% end %>
        </p>
      <% end %>
    </div>
  <% else %>
    <ul class="lp-dash-battle__list">
      <% if include_mission && mission %>
        <li class="lp-dash-battle__item"
            data-battle-day-target="item"
            data-open="true"
            data-lp="<%= mission.lp_reward %>">
          <%= button_to mission_completion_path(mission),
                method: :post,
                params: { aspect_key: mission.aspect_key.presence || aspect_key },
                class: "lp-dash-check",
                aria: { label: "Complete #{mission.title}" } do %>
            <span aria-hidden="true"></span>
          <% end %>
          <span class="lp-dash-battle__name"><%= mission.title %></span>
          <span class="lp-dash-battle__lp" aria-label="+<%= mission.lp_reward %> <%= t('dash.action_points_label') %>">+<%= mission.lp_reward %></span>
        </li>
      <% end %>

      <% open_todos.each do |todo| %>
        <li class="lp-dash-battle__item"
            data-battle-day-target="item"
            data-open="true"
            data-lp="<%= todo.lp_reward %>">
          <%= button_to complete_daily_todo_path(todo),
                method: :post,
                class: "lp-dash-check",
                aria: { label: "Complete #{todo.title}" } do %>
            <span aria-hidden="true"></span>
          <% end %>
          <span class="lp-dash-battle__name"><%= todo.title %></span>
          <span class="lp-dash-battle__lp" aria-label="+<%= todo.lp_reward %> <%= t('dash.action_points_label') %>">+<%= todo.lp_reward %></span>
        </li>
      <% end %>
    </ul>

    <% if done_todos.any? %>
      <details class="lp-dash-battle__done"<%= " open" if battle_won %>>
        <summary><%= t("dash.battle_done_summary", count: done_todos.size) %></summary>
        <ul class="lp-dash-battle__list lp-dash-battle__list--done">
          <% done_todos.each do |todo| %>
            <li class="lp-dash-battle__item is-done"
                data-battle-day-target="item"
                data-open="false"
                data-lp="<%= todo.lp_reward %>">
              <%= button_to complete_daily_todo_path(todo),
                    method: :post,
                    class: "lp-dash-check is-on",
                    aria: { label: "Undo #{todo.title}" } do %>
                <span aria-hidden="true"></span>
              <% end %>
              <span class="lp-dash-battle__name"><%= todo.title %></span>
              <span class="lp-dash-battle__lp" aria-label="+<%= todo.lp_reward %> <%= t('dash.action_points_label') %>">+<%= todo.lp_reward %></span>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>

    <div class="lp-dash-battle__footer">
      <% if open_count.positive? %>
        <p class="lp-dash-battle__ready"><%= t("dash.battle_ready_count", open: open_count, total: [ total_count, open_count ].max) %></p>
        <%= button_to t("dash.complete_battle"),
              battle_completion_path,
              method: :post,
              class: "lp-dash-cta lp-dash-cta--soft",
              data: { battle_day_target: "completeBtn", action: "click->battle-day#celebrate" } %>
        <p class="lp-dash-battle__reward" aria-live="polite">
          <span data-battle-day-target="reward">+<%= reward %></span>
          <span><%= t("dash.action_points_reward") %></span>
        </p>
      <% else %>
        <p class="lp-dash-battle__won"><%= t("dash.battle_won") %></p>
        <% if upcoming %>
          <p class="lp-dash-battle__tomorrow">
            <% if upcoming[:tomorrow] %>
              <%= t("dash.tomorrow_set", title: upcoming[:title]) %>
            <% else %>
              <%= t("dash.next_battle_set", title: upcoming[:title], date: l(upcoming[:scheduled_on], format: :short)) %>
            <% end %>
          </p>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
