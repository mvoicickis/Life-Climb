<%# locals: todos, open_todos, done_todos, mission, include_mission, open_count, total_count, aspect_key, upcoming %>
<%
  open_todos = local_assigns.fetch(:open_todos) { todos.reject(&:completed?) }
  done_todos = local_assigns.fetch(:done_todos) { todos.select(&:completed?) }
  total_count = local_assigns.fetch(:total_count) { todos.size + (include_mission ? 1 : 0) }
  upcoming = local_assigns[:upcoming]
  handoff = @strategy_handoff
  battle_empty = open_todos.empty? && done_todos.empty? && !include_mission
  battle_won = !battle_empty && open_count.to_i.zero?
  done_count = [ total_count.to_i - open_count.to_i, 0 ].max
  ring_pct = total_count.to_i.positive? ? ((done_count.to_f / total_count) * 100).round : 0
  ring_pct = 100 if battle_won
  coaching_below = @project_check.present? || (@battle_angle_project.present? && @battle_angles.present?)
%>

<section class="lp-dash-battle" aria-label="<%= t('dash.battle_title') %>">
  <header class="lp-dash-battle__head">
    <div class="lp-dash-battle__title-row">
      <h2 class="lp-dash-battle__title"><%= t("dash.battle_title") %></h2>
      <% unless battle_empty %>
        <div class="lp-dash-battle__ring"
             data-battle-day-target="ring"
             style="--lp-ring: <%= ring_pct %>"
             aria-hidden="true">
          <svg viewBox="0 0 36 36">
            <circle class="lp-dash-battle__ring-track" cx="18" cy="18" r="15.5" fill="none"/>
            <circle class="lp-dash-battle__ring-fill" cx="18" cy="18" r="15.5" fill="none"
                    pathLength="100"
                    stroke-dasharray="<%= ring_pct %> 100"/>
          </svg>
          <span class="lp-dash-battle__ring-label"><%= done_count %>/<%= [ total_count, 1 ].max %></span>
        </div>
      <% end %>
    </div>
    <p class="lp-dash-battle__sub"><%= t("dash.battle_subtitle") %></p>
  </header>

  <% if battle_empty %>
    <div class="lp-dash-battle__empty">
      <p class="lp-dash-empty"><%= t("dash.battle_empty") %></p>
      <p class="lp-dash-battle__empty-cta">
        <%= link_to (handoff&.dig(:label) || t("dash.battle_empty_cta")),
              (handoff&.dig(:href) || (@journey ? life_journey_path(@journey) : new_life_journey_path)),
              class: "lp-dash-battle__link-cta" %>
      </p>
      <% if upcoming %>
        <p class="lp-dash-battle__tomorrow">
          <% if upcoming[:tomorrow] %>
            <%= t("dash.tomorrow_set", title: upcoming[:title]) %>
          <% else %>
            <%= t("dash.next_battle_set", title: upcoming[:title], date: l(upcoming[:scheduled_on], format: :short)) %>
          <% end %>
        </p>
      <% end %>
    </div>
  <% else %>
    <ul class="lp-dash-battle__list">
      <% if include_mission && mission %>
        <li class="lp-dash-battle__item"
            data-battle-day-target="item"
            data-open="true"
            data-lp="<%= mission.lp_reward %>">
          <%= button_to mission_completion_path(mission),
                method: :post,
                params: { aspect_key: mission.aspect_key.presence || aspect_key },
                class: "lp-dash-check",
                aria: { label: "Complete #{mission.title}" } do %>
            <span aria-hidden="true"></span>
          <% end %>
          <span class="lp-dash-battle__name"><%= mission.title %></span>
          <span class="lp-dash-battle__lp" aria-label="+<%= mission.lp_reward %> <%= t('dash.action_points_label') %>">+<%= mission.lp_reward %></span>
        </li>
      <% end %>

      <% open_todos.each do |todo| %>
        <% checklist_tasks = todo.strategy_goal&.practice_tasks %>
        <% if checklist_tasks.present? %>
          <%= render "dashboard/dash_battle_checklist", todo: todo %>
        <% else %>
        <% qty_project = todo.strategy_goal&.quantified_path_project %>
        <li class="lp-dash-battle__item"
            data-battle-day-target="item"
            data-open="true"
            data-lp="<%= todo.lp_reward %>"
            <% if qty_project %>
              data-controller="quantity-complete"
            <% end %>>
          <%= button_to complete_daily_todo_path(todo),
                method: :post,
                form: (qty_project ? {
                  data: {
                    quantity_complete_target: "form",
                    action: "submit->quantity-complete#intercept"
                  }
                } : {}),
                class: "lp-dash-check",
                aria: { label: "Complete #{todo.title}" } do %>
            <span aria-hidden="true"></span>
          <% end %>
          <% if qty_project %>
            <dialog class="lp-strategy-sheet is-project lp-quantity-complete"
                    id="qty-complete-<%= todo.id %>"
                    data-quantity-complete-target="dialog"
                    data-action="click->quantity-complete#backdropClose">
              <div class="lp-strategy-sheet__panel">
                <header class="lp-strategy-sheet__head">
                  <p class="lp-strategy-sheet__kind"><%= todo.title %></p>
                  <h2 class="lp-strategy-sheet__title">
                    <%= t("strategy.quantity.how_many", unit: qty_project.unit) %>
                  </h2>
                  <button type="button"
                          class="lp-strategy-sheet__close"
                          data-action="click->quantity-complete#close"
                          aria-label="<%= t('strategy.sheet.close') %>">×</button>
                </header>
                <form class="lp-strategy-sheet__form lp-quantity-complete__form"
                      data-action="submit->quantity-complete#confirm">
                  <label class="lp-quantity-complete__field" for="qty-complete-input-<%= todo.id %>">
                    <span class="lp-quantity-complete__label"><%= qty_project.unit %></span>
                    <%= number_field_tag :dialog_amount, nil,
                          id: "qty-complete-input-#{todo.id}",
                          class: "lp-rpg-input lp-quantity-complete__input",
                          min: "0.01",
                          step: "any",
                          inputmode: "decimal",
                          required: true,
                          autocomplete: "off",
                          placeholder: "0",
                          data: { quantity_complete_target: "amount" } %>
                  </label>
                  <div class="lp-strategy-sheet__footer is-split">
                    <button type="button"
                            class="lp-strategy-sheet__btn is-cancel"
                            data-action="click->quantity-complete#close">
                      <%= t("strategy.rpg.cancel") %>
                    </button>
                    <button type="submit" class="lp-strategy-sheet__btn is-save">
                      <%= t("strategy.quantity.log_confirm") %>
                    </button>
                  </div>
                </form>
              </div>
            </dialog>
          <% end %>
          <span class="lp-dash-battle__name"><%= todo.title %></span>
          <span class="lp-dash-battle__lp" aria-label="+<%= todo.lp_reward %> <%= t('dash.action_points_label') %>">+<%= todo.lp_reward %></span>
        </li>
        <% end %>
      <% end %>
    </ul>

    <% if done_todos.any? %>
      <details class="lp-dash-battle__done"<%= " open" if battle_won %>>
        <summary><%= t("dash.battle_done_summary", count: done_todos.size) %></summary>
        <ul class="lp-dash-battle__list lp-dash-battle__list--done">
          <% done_todos.each do |todo| %>
            <% if todo.strategy_goal&.practice_tasks.present? %>
              <%= render "dashboard/dash_battle_checklist", todo: todo %>
            <% else %>
            <li class="lp-dash-battle__item is-done"
                data-battle-day-target="item"
                data-open="false"
                data-lp="<%= todo.lp_reward %>">
              <%= button_to complete_daily_todo_path(todo),
                    method: :post,
                    class: "lp-dash-check is-on",
                    aria: { label: "Undo #{todo.title}" } do %>
                <span aria-hidden="true"></span>
              <% end %>
              <span class="lp-dash-battle__name"><%= todo.title %></span>
              <span class="lp-dash-battle__lp" aria-label="+<%= todo.lp_reward %> <%= t('dash.action_points_label') %>">+<%= todo.lp_reward %></span>
            </li>
            <% end %>
          <% end %>
        </ul>
      </details>
    <% end %>

    <div class="lp-dash-battle__footer">
      <% if open_count.positive? %>
        <p class="lp-dash-battle__ready"><%= t("dash.battle_ready_count", open: open_count, total: [ total_count, open_count ].max) %></p>
      <% else %>
        <%# Forward momentum — not a finish line. Project check / angles may render below. %>
        <div class="lp-dash-battle__next">
          <p class="lp-dash-battle__next-kicker"><%= t("dash.battle_next_kicker") %></p>
          <% if coaching_below %>
            <p class="lp-dash-battle__next-hint"><%= t("dash.battle_next_coaching") %></p>
          <% elsif upcoming %>
            <p class="lp-dash-battle__tomorrow">
              <% if upcoming[:tomorrow] %>
                <%= t("dash.tomorrow_set", title: upcoming[:title]) %>
              <% else %>
                <%= t("dash.next_battle_set", title: upcoming[:title], date: l(upcoming[:scheduled_on], format: :short)) %>
              <% end %>
            </p>
            <p class="lp-dash-battle__empty-cta">
              <%= link_to t("climb.reward.back_to_trail"),
                    life_journey_path(@journey),
                    class: "lp-dash-battle__link-cta" %>
            </p>
          <% else %>
            <p class="lp-dash-battle__empty-cta">
              <%= link_to (handoff&.dig(:label) || t("dash.battle_empty_cta")),
                    (handoff&.dig(:href) || life_journey_path(@journey)),
                    class: "lp-dash-battle__link-cta" %>
            </p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
