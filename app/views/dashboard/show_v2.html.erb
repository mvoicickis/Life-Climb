<% content_for :title, t("game_ui.home_title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>

<%
  greeting =
    case Time.current.hour
    when 5..11 then t("game_ui.good_morning")
    when 12..17 then t("game_ui.good_afternoon")
    else t("game_ui.good_evening")
    end
%>

<div
  class="lp-dash<%= ' is-battle-won' if @battle_open_count.to_i.zero? && (@daily_todos.any? || @mission.present?) %>"
  data-controller="battle-day"
  data-battle-day-closer-value="<%= @closer %>"
  data-battle-day-celebrate-value="<%= @battle_celebrate %>"
>
  <header class="lp-dash__top">
    <div class="lp-dash__identity">
      <%= link_to dashboard_path, class: "lp-dash__brand" do %>
        <%= render "shared/lp_brand_mark", size: 30, class_name: "lp-dash__brand-mark" %>
        <span><%= t("app_name") %></span>
      <% end %>
      <div class="lp-dash__greeting">
        <h1><%= greeting %>, <%= current_user.display_name %></h1>
        <p><%= t("dash.promise") %></p>
      </div>
    </div>
    <div class="lp-dash__stats">
      <div class="lp-dash__stat-chip" aria-label="<%= t('dash.action_points_label') %>">
        <span class="lp-dash__stat-value" data-battle-day-target="lpTotal"><%= number_with_delimiter(@life_points) %></span>
        <span class="lp-dash__stat-name"><%= t("dash.action_points_label") %></span>
        <span class="lp-dash__stat-hint"><%= t("dash.action_points_hint") %></span>
      </div>
      <div class="lp-dash__stat-chip" aria-label="<%= t('strategy.sp_label') %>">
        <span class="lp-dash__stat-value"><%= number_with_delimiter(current_user.strategy_points) %></span>
        <span class="lp-dash__stat-name"><%= t("strategy.sp_label") %></span>
        <span class="lp-dash__stat-hint"><%= t("strategy.sp_hint") %></span>
      </div>
    </div>
  </header>

  <%= render "dashboard/dash_hero",
        journey: @journey,
        strategy_goal: @strategy_goal,
        mountain: @mountain,
        closer: @closer %>

  <% if @project_check %>
    <%= render "dashboard/dash_project_check", project: @project_check %>
  <% end %>

  <%= render "dashboard/dash_battle",
        todos: @daily_todos,
        open_todos: @open_todos,
        done_todos: @done_todos,
        mission: @mission,
        include_mission: @include_mission_in_battle,
        reward: @battle_reward,
        open_count: @battle_open_count,
        total_count: @battle_total_count,
        day_full: @battle_day_full,
        aspect_key: @journey.life_area.key,
        upcoming: @upcoming_battle %>

  <% if @targets.any? %>
    <%= render "dashboard/dash_targets", targets: @targets %>
  <% end %>

  <aside class="lp-dash-plan" aria-label="<%= t('dash.continue_planning_title') %>">
    <p class="lp-dash-plan__kicker"><%= t("dash.continue_planning_title") %></p>
    <p class="lp-dash-plan__copy"><%= t("dash.continue_planning_hint") %></p>
    <p class="lp-dash-plan__link">
      <%= link_to t("dash.open_strategy"), life_journey_path(@journey) %>
    </p>
  </aside>
</div>

<%= render "shared/lp_dash_nav", active: :today %>
