<% content_for :title, t("game_ui.home_title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>
<%
  @notice_stack = Today::NoticeStack.call(
    next_action: @next_action.present?,
    human_win: flash[:human_win].present?,
    level_up: @commitment_level_up && @journey.present?,
    shield_tip: !current_user.day_shield_tip_done?,
    install_offer: current_user.install_offer_eligible?
  )
%>

<div
  class="lp-dash<%= ' is-battle-won' if @battle_open_count.to_i.zero? && (@daily_todos.any? || @mission.present?) %>"
  data-controller="battle-day"
  data-battle-day-closer-value="<%= @closer %>"
  data-battle-day-celebrate-value="<%= @battle_celebrate %>"
  data-battle-day-ap-gained-value="<%= flash[:ap_gained].to_i %>"
  data-battle-day-boss-value="<%= flash[:climb_boss].present? %>"
>
  <%= render "dashboard/dash_hero",
        day_percent: @day_percent,
        habits_count: Array(@habits).size,
        battles_count: Array(@daily_todos).size,
        streak: @climb_streak,
        life_points: @life_points,
        commitment: @commitment,
        journey: @journey %>

  <% if @notice_stack.include?(:next_action) %>
    <div id="next-action-slot">
      <%= render "shared/next_action",
            next_action: @next_action,
            commitment: @commitment %>
    </div>
  <% else %>
    <div id="next-action-slot" hidden></div>
  <% end %>

  <% if @notice_stack.include?(:shield_tip) %>
    <div class="lp-dash-notice is-shield-tip" role="status" data-day-shield-tip="true">
      <p class="lp-dash-notice__body"><%= t("dash.shield.tip_line") %></p>
      <%= button_to t("dash.shield.tip_dismiss"),
            day_shield_tip_path,
            method: :delete,
            class: "lp-dash-notice__dismiss" %>
    </div>
  <% end %>

  <% if @notice_stack.include?(:install_offer) %>
    <div class="lp-dash-level-up is-install-tip is-compact"
         hidden
         role="status"
         data-controller="pwa-install"
         data-pwa-install-surface-value="tip"
         data-pwa-install-dismiss-url-value="<%= install_offer_path %>"
         data-pwa-install-installed-url-value="<%= install_offer_path %>"
         data-pwa-install-dismissed-message-value="<%= t('dash.install_offer.dismissed') %>"
         data-install-offer-tip="true">
      <p class="lp-dash-level-up__title" data-pwa-install-target="title"><%= t("dash.install_offer.headline") %></p>
      <p class="lp-dash-level-up__body" data-pwa-install-target="body"><%= t("dash.install_offer.body") %></p>
      <div class="lp-dash-level-up__actions" data-pwa-install-target="actions">
        <button type="button"
                class="lp-habits__btn is-primary"
                data-action="click->pwa-install#install">
          <%= t("dash.install_offer.cta") %>
        </button>
        <button type="button"
                class="lp-habits__btn is-quiet"
                data-action="click->pwa-install#dismiss">
          <%= t("dash.install_offer.dismiss") %>
        </button>
      </div>
    </div>
  <% end %>

  <% if @notice_stack.include?(:level_up) %>
    <% next_key = @journey.commitment_key.to_s == "easy" ? "medium" : "hard" %>
    <% next_preset = Today::Commitment::PRESETS[next_key] %>
    <div class="lp-dash-level-up" role="status" data-commitment-level-up="true">
      <p class="lp-dash-level-up__title"><%= t("dash.commitment.level_up_title") %></p>
      <p class="lp-dash-level-up__body">
        <%= t("dash.commitment.level_up_body", name: next_preset[:name]) %>
      </p>
      <div class="lp-dash-level-up__actions">
        <%= button_to t("dash.commitment.level_up_accept", name: next_preset[:name]),
              level_up_today_commitment_path,
              method: :patch,
              class: "lp-habits__btn is-primary" %>
        <%= button_to t("dash.commitment.level_up_keep", name: @journey.commitment_name),
              decline_today_commitment_path,
              method: :patch,
              class: "lp-habits__btn is-quiet" %>
      </div>
    </div>
  <% end %>

  <% if @notice_stack.include?(:human_win) %>
    <div class="lp-dash-human-win" role="status">
      <p class="lp-dash-human-win__body"><%= flash[:human_win] %></p>
      <p class="lp-dash-human-win__next"><%= t("strategy.first_climb.human_next") %></p>
    </div>
  <% end %>

  <div id="today-battle-surface">
    <%= render "dashboard/today_battle_surface" %>
  </div>

  <% if !@show_plan_route && @project_check %>
    <%= render "dashboard/dash_project_check", project: @project_check %>
  <% elsif !@show_plan_route && @battle_angle_project && @battle_angles.any? %>
    <%= render "dashboard/dash_battle_angles",
          project: @battle_angle_project,
          angles: @battle_angles,
          journey: @journey %>
  <% end %>

  <% if @targets.any? %>
    <%= render "dashboard/dash_targets", targets: @targets %>
  <% end %>

  <aside class="lp-dash-plan" aria-label="<%= t('climb.reward.back_to_trail') %>">
    <p class="lp-dash-plan__link">
      <%= link_to t("climb.reward.back_to_trail"), life_journey_path(@journey) %>
    </p>
  </aside>
</div>

<% if flash[:lp_toast].present? %>
  <% toast = flash[:lp_toast] %>
  <%= render "shared/lp_toast",
        icon: toast[:icon] || toast["icon"],
        title: toast[:title] || toast["title"],
        body: toast[:body] || toast["body"],
        undo_habit_id: toast[:undo_habit_id] || toast["undo_habit_id"] %>
<% end %>

<%= render "shared/lp_dash_nav", active: :today %>
<%= render "shared/climb_reward", reward: flash[:climb_reward] if flash[:climb_reward].present? %>
