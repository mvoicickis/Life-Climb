<%# locals: journey, closer %>
<% area = journey.life_area %>
<section class="lp-dash-hero" aria-label="<%= t('dash.goal_label') %>">
  <div class="lp-dash-hero__copy">
    <p class="lp-dash-kicker"><%= t("dash.goal_label") %></p>
    <h2 class="lp-dash-hero__title"><%= journey.title %></h2>
    <p class="lp-dash-hero__pct">
      <span data-battle-day-target="goalPct"><%= closer %></span>%
    </p>
    <div class="lp-dash-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= closer %>" aria-label="<%= t('dash.goal_label') %>">
      <div class="lp-dash-bar__fill" data-battle-day-target="goalBar" style="width: <%= closer %>%"></div>
    </div>
    <p class="lp-dash-hero__hint"><%= t("dash.goal_hint") %></p>
  </div>
  <div class="lp-dash-hero__art" aria-hidden="true">
    <div class="lp-dash-hero__area">
      <span class="lp-dash-hero__emoji"><%= area.emoji %></span>
      <span class="lp-dash-hero__area-name"><%= area.label %></span>
      <span class="lp-dash-hero__area-closer"><%= closer %>% closer</span>
    </div>
  </div>
</section>
