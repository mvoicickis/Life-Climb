<%# Today climb hero — DayPercent all day; overshoot absorbed (no separate card).
    locals: day_percent, habits_count, battles_count, streak, life_points, commitment, journey %>
<% percent = local_assigns[:day_percent] %>
<% habits_count = local_assigns.fetch(:habits_count) { Array(@habits).size } %>
<% battles_count = local_assigns.fetch(:battles_count) { Array(@daily_todos).size } %>
<% streak = local_assigns[:streak] || @climb_streak || strategy_climb_streak_status %>
<% life_points = local_assigns.fetch(:life_points) { @life_points } %>
<% commitment = local_assigns[:commitment] || @commitment %>
<% streak_days = streak.respond_to?(:days) ? streak.days.to_i : 0 %>
<% tier_name = commitment&.journey&.commitment_name.presence ||
               (local_assigns[:journey] || @journey)&.commitment_name.presence ||
               "Easy" %>
<% display_pct = percent.nil? ? 0 : percent.to_i %>
<% over = percent.is_a?(Numeric) && percent > 100 %>
<% hit = percent.is_a?(Numeric) && percent >= 100 && !over %>
<% cheer = Today::DayCheer.new(percent: percent) %>
<% cheer_result = cheer.call %>
<% bar_width = [ display_pct, 100 ].min %>

<header class="lp-dash-hero<%= ' is-over' if over %><%= ' is-hit' if hit %>"
        data-day-percent="<%= percent.nil? ? '' : display_pct %>"
        <%= 'data-day-overshoot=true'.html_safe if over %>
        aria-label="<%= t('dash.hero.of_day') %>">
  <div class="lp-dash-hero__row">
    <%= link_to settings_path, class: "lp-dash-hero__avatar", aria: { label: t("nav.settings") } do %>
      <%= companion_image_tag class: "lp-dash-hero__avatar-img", alt: "" %>
    <% end %>
    <div class="lp-dash-hero__who">
      <p class="lp-dash-hero__name"><%= current_user.display_name %></p>
      <p class="lp-dash-hero__meta">
        <span><%= l(Date.current, format: :dash_weekday).upcase %></span>
        <span aria-hidden="true"> · </span>
        <span data-commitment-tier="<%= tier_name %>"><%= tier_name.upcase %></span>
      </p>
    </div>
    <div class="lp-dash-hero__stat is-fire" title="<%= t('dash.timeline.stats_pill') %>">
      <%= render "shared/lp_icon", name: "fire", class_name: "lp-icon is-inline" %>
      <span><%= streak_days %></span>
    </div>
    <div class="lp-dash-hero__stat is-ap" title="<%= t('dash.action_points_label') %>">
      <%= render "shared/lp_icon", name: "bolt", class_name: "lp-icon is-inline" %>
      <span data-battle-day-target="lpTotal"><%= number_with_delimiter(life_points) %></span>
    </div>
  </div>

  <div class="lp-dash-hero__climb">
    <p class="lp-dash-hero__big<%= ' is-over' if over %><%= ' is-hit' if hit %>">
      <span class="lp-dash-hero__num"><%= display_pct %></span><span class="lp-dash-hero__pct">%</span>
    </p>
    <div class="lp-dash-hero__lab">
      <b><%= t("dash.hero.of_day") %></b>
      <em><%= t("dash.hero.mix", habits: habits_count, battles: battles_count) %></em>
    </div>
  </div>

  <div class="lp-dash-hero__track" role="progressbar"
       aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= bar_width %>"
       aria-label="<%= t('dash.hero.of_day') %>">
    <i class="<%= 'is-over' if over %>" style="width: <%= bar_width %>%"></i>
    <% if over %><span class="lp-dash-hero__mark" aria-hidden="true"></span><% end %>
  </div>

  <p class="lp-dash-hero__cheer is-<%= cheer_result.css %>">
    <span class="lp-dash-hero__cheer-ic" aria-hidden="true">
      <% if cheer_result.band == :idle %>○
      <% elsif cheer_result.band == :met %>★
      <% elsif cheer_result.band == :over %>✦
      <% else %>▲
      <% end %>
    </span>
    <%= cheer.message %>
  </p>
</header>
