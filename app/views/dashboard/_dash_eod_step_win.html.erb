<%# Step 1 — recap. locals: health, streak %>
<%
  health = local_assigns.fetch(:health)
  goal_title = active_goal_title(strategy_goal: @strategy_goal, journey: @journey)
  progress = end_of_day_mountain_progress(@strategy_goal, @mountain)
  camp_line = end_of_day_recap_camp_line(progress)
%>

<div class="lp-today-v2-eod-step lp-today-v2-eod-step--win">
  <div class="lp-today-group-card">
    <div class="lp-today-group-card__body lp-today-v2-eod-card__body">
      <p class="lp-today-v2-eod-card__kicker">
        <span class="lp-today-v2-eod-card__tick" aria-hidden="true">✓</span>
        <%= t("dash.end_of_day.steps.win.kicker") %>
      </p>
      <h2 class="lp-today-v2-eod-card__goal-title"><%= goal_title %></h2>
      <p class="lp-today-v2-eod-card__detail"><%= end_of_day_battles_won_line(health) %></p>
      <% if camp_line.present? %>
        <p class="lp-today-v2-eod-card__detail"><%= camp_line %></p>
      <% end %>
      <div class="lp-today-v2-eod-card__actions">
        <%= button_to t("dash.end_of_day.steps.win.continue"),
              today_eod_acknowledge_path,
              method: :post,
              form: { class: "lp-today-v2-eod-card__form" },
              class: "lp-today-v2-eod-card__primary" %>
        <button type="button"
                class="lp-today-v2-eod-card__share-pill"
                data-action="click->today-notch#shareRecap">
          <%= t("dash.end_of_day.steps.win.share_my_day") %>
        </button>
      </div>
    </div>
  </div>
</div>
