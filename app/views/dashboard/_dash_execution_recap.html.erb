<%# Today V2 — end-of-day recap card. locals: health, streak, journey %>
<% health = local_assigns.fetch(:health) %>
<% streak = local_assigns[:streak] || @climb_streak %>
<% streak_days = streak.respond_to?(:days) ? streak.days.to_i : 0 %>
<% band = battlefield_hp_band_class(health.band) %>
<% recap_color = health.band == :safe ? "#4ade80" : health.band == :warn ? "#f0a91b" : "#e8482f" %>

<section class="lp-today-v2-field" aria-label="<%= t('dash.battlefield.recap_label') %>">
  <div class="lp-today-v2-field__head">
    <h2 class="lp-today-v2-field__title"><%= t("dash.battlefield.title") %></h2>
    <span class="lp-today-v2-field__count">
      <%= t("dash.battlefield.count", done: health.done_count, total: health.total_count) %>
    </span>
  </div>

  <div class="lp-today-v2-recap" style="--today-recap-color: <%= recap_color %>">
    <p class="lp-today-v2-recap__kicker">
      <%= t("dash.battlefield.recap_kicker", day: streak_days.positive? ? streak_days : 1) %>
    </p>
    <h3 class="lp-today-v2-recap__title"><%= health.result_title %></h3>
    <p class="lp-today-v2-recap__stats">
      <%= t("dash.battlefield.recap_stats",
            done: health.done_count,
            total: health.total_count,
            hp: health.hp) %>
    </p>
    <div class="lp-today-v2-recap__actions">
      <button type="button"
              class="lp-today-v2-recap__btn is-share"
              data-action="click->today-notch#shareRecap">
        <%= t("dash.battlefield.share_recap") %>
      </button>
      <%= button_to t("dash.battlefield.next_day"),
            today_end_day_path,
            method: :delete,
            class: "lp-today-v2-recap__btn is-next",
            form: { data: { turbo: false } } %>
    </div>
  </div>
</section>
