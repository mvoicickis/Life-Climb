<%# Plan-route coach OR timeline + anytime — turbo-replaced after gap creates. %>
<% if @show_plan_route %>
  <%= render "dashboard/dash_plan_route",
        journey: @journey,
        mission: @mission,
        adventure_year: @adventure_year,
        strategy_goal: @strategy_goal,
        first_climb: @first_climb_needed %>
<% else %>
  <%# Battle day strip sits directly under the hero, above habits (it is about
      battles, not habits). Kept inside #today-battle-surface so it still
      turbo-refreshes on a win. Its own markup/logic is unchanged (#327). %>
  <%= render "dashboard/dash_day_strip", todos: @daily_todos %>
  <%# Habits are hidden while we focus on battles (GameRules.habits_enabled?). %>
  <%= render "dashboard/dash_anytime", habits: @habits if habits_enabled? %>
  <%= render "dashboard/dash_timeline",
        timeline: @timeline,
        open_count: @battle_open_count,
        total_count: @battle_total_count,
        upcoming: @upcoming_battle,
        handoff: @strategy_handoff,
        done_todos: @done_todos %>
<% end %>
