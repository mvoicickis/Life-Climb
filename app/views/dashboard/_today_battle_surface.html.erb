<%# Plan-route coach OR timeline + anytime — turbo-replaced after gap creates. %>
<% if @show_plan_route %>
  <%= render "dashboard/dash_plan_route",
        journey: @journey,
        mission: @mission,
        adventure_year: @adventure_year,
        strategy_goal: @strategy_goal,
        first_climb: @first_climb_needed %>
<% else %>
  <%= render "dashboard/dash_anytime", habits: @habits %>
  <%= render "dashboard/dash_timeline",
        timeline: @timeline,
        open_count: @battle_open_count,
        total_count: @battle_total_count,
        upcoming: @upcoming_battle,
        handoff: @strategy_handoff %>
<% end %>
