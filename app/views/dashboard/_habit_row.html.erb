<div id="<%= dom_id(habit) %>" class="flex items-center justify-between rounded-lg border border-slate-200 bg-white p-4">
  <div>
    <h3 class="font-semibold text-slate-900"><%= habit.name %></h3>
    <% if habit.description.present? %>
      <p class="mt-1 text-sm text-slate-600"><%= habit.description %></p>
    <% end %>
    <p class="mt-2 text-sm font-medium text-emerald-600"><%= habit.points %> points</p>
  </div>

  <div>
    <% if habit.completed_today? %>
      <span class="inline-flex items-center rounded-full bg-emerald-100 px-4 py-2 text-sm font-medium text-emerald-800">
        Done today
      </span>
    <% else %>
      <%= button_to "Complete",
          completions_path(habit_id: habit.id),
          method: :post,
          class: "cursor-pointer rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700" %>
    <% end %>
  </div>
</div>
