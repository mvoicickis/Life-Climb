<%# Locals: action (TodayAction or nil), reward (Integer) %>
<% action = local_assigns[:action] %>
<% reward = local_assigns.fetch(:reward, LifePointsAward::ACTION) %>

<section id="todays-quest" class="lp-glass lp-quest mt-6 p-6" aria-labelledby="quest-heading">
  <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-[var(--lp-lime)]/80">
    <%= t("game_ui.todays_quest") %>
  </p>

  <% if action %>
    <h2 id="quest-heading" class="mt-3 text-2xl font-semibold leading-snug text-[var(--lp-ink)]">
      <%= action.title %>
    </h2>

    <div class="mt-4 space-y-1 text-sm text-[var(--lp-muted)]">
      <p><%= t("game_ui.reward") %>: <span class="font-bold text-[var(--lp-gold)]">+<%= reward %> <%= t("game_ui.life_points_short") %></span></p>
      <p><%= t("game_ui.gap_shrinks") %></p>
    </div>

    <% if action.completed? %>
      <p class="lp-cta mt-6 w-full opacity-70"><%= t("game_ui.quest_done") %></p>
    <% else %>
      <%= button_to t("game_ui.complete_quest"),
            complete_today_action_path(action),
            method: :post,
            class: "lp-cta lp-quest__btn mt-6 w-full",
            data: { turbo: true } %>
    <% end %>
  <% else %>
    <h2 id="quest-heading" class="mt-3 text-2xl font-semibold text-[var(--lp-ink)]">
      <%= t("game_ui.no_quest") %>
    </h2>
    <p class="mt-2 text-sm text-[var(--lp-muted)]"><%= t("game_ui.no_quest_hint") %></p>
    <%= link_to t("game_ui.add_quest"), dashboard_path(anchor: "add-quest"), class: "lp-cta mt-6 inline-flex w-full justify-center" %>
  <% end %>
</section>
