<%# Step 3 — day closed. locals: streak, tomorrow_battles, mountain, strategy_goal %>
<%
  streak = local_assigns[:streak]
  tomorrow_battles = Array(local_assigns.fetch(:tomorrow_battles))
  mountain = local_assigns.fetch(:mountain) { @mountain }
  strategy_goal = local_assigns.fetch(:strategy_goal) { @strategy_goal }
  climb_days = streak.respond_to?(:days) ? streak.days.to_i : 0
  progress = end_of_day_mountain_progress(strategy_goal, mountain)
  goal_title = active_goal_title(strategy_goal: strategy_goal, journey: @journey)
%>

<div class="lp-today-v2-eod-step lp-today-v2-eod-step--closed">
  <div class="lp-today-group-card">
    <div class="lp-today-group-card__body lp-today-v2-eod-card__body">
      <p class="lp-today-v2-eod-card__kicker lp-today-v2-eod-card__kicker--moon">
        <span class="lp-today-v2-eod-card__moon" aria-hidden="true">🌙</span>
        <%= t("dash.end_of_day.steps.closed.title") %>
      </p>
      <h2 class="lp-today-v2-eod-card__goal-title"><%= goal_title %></h2>
      <div class="lp-today-v2-eod-card__goal-bar"
           role="progressbar"
           aria-valuenow="<%= progress[:percent] %>"
           aria-valuemin="0"
           aria-valuemax="100"
           aria-label="<%= goal_title %>">
        <span class="lp-today-v2-eod-card__goal-bar-fill" style="width: <%= progress[:percent] %>%"></span>
      </div>

      <% tomorrow_battles.each do |battle| %>
        <p class="lp-today-v2-eod-card__detail"><%= t("dash.end_of_day.steps.closed.tomorrow", title: battle.title) %></p>
      <% end %>

      <% if climb_days >= 2 %>
        <p class="lp-today-v2-eod-card__detail"><%= t("dash.end_of_day.steps.closed.streak_days", count: climb_days) %></p>
      <% end %>

      <%= link_to t("dash.end_of_day.reopen_day"),
            today_end_day_path,
            data: { turbo_method: :delete },
            class: "lp-today-v2-eod-card__link lp-today-v2-eod-card__link--reopen" %>
    </div>
  </div>
</div>
