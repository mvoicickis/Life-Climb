<%# Step 2 — plan tomorrow. locals: camps, tomorrow_battles %>
<%
  camps = Array(local_assigns.fetch(:camps))
  tomorrow_battles = Array(local_assigns.fetch(:tomorrow_battles))
  default_camp = camps.first
  has_saved = tomorrow_battles.any?
  goal_title = active_goal_title(strategy_goal: @strategy_goal, journey: @journey)
%>

<div class="lp-today-v2-eod-step lp-today-v2-eod-step--plan"
     data-controller="end-of-day-flow">
  <div class="lp-today-group-card">
    <div class="lp-today-group-card__body lp-today-v2-eod-card__body">
      <%= render "dashboard/dash_eod_goal_heading", goal_title: goal_title %>
      <p class="lp-today-v2-eod-card__command"><%= t("dash.end_of_day.steps.plan.goal_command") %></p>

      <% tomorrow_battles.each do |battle| %>
        <p class="lp-today-v2-eod-card__detail"><%= t("dash.end_of_day.steps.closed.tomorrow", title: battle.title) %></p>
      <% end %>

      <% if camps.any? %>
        <span class="lp-today-v2-eod-card__section-label"><%= t("dash.end_of_day.steps.plan.camp_label") %></span>
        <% if camps.size > 1 %>
          <div class="lp-today-v2-eod-plan__camps" role="list">
            <% camps.each_with_index do |camp, index| %>
              <button type="button"
                      class="lp-today-v2-eod-plan__camp<%= ' is-selected' if index.zero? %>"
                      role="listitem"
                      data-end-of-day-flow-target="camp"
                      data-project-id="<%= camp.id %>"
                      data-action="end-of-day-flow#selectCamp">
                <%= camp.title %>
              </button>
            <% end %>
          </div>
        <% end %>

        <%= form_with url: today_plan_tomorrow_battle_path,
              method: :post,
              class: "lp-today-v2-eod-plan__form" do %>
          <%= hidden_field_tag :project_id,
                default_camp&.id,
                data: { end_of_day_flow_target: "projectField" } %>
          <%= render layout: "shared/title_limit_wrap" do %>
            <%= text_field_tag :title, nil,
                  class: "lp-today-v2-eod-plan__input",
                  placeholder: t("dash.end_of_day.steps.plan.placeholder"),
                  aria: { label: t("dash.end_of_day.steps.plan.placeholder") },
                  required: true,
                  maxlength: StrategyGoal::TITLE_MAX,
                  autocomplete: "off" %>
          <% end %>
          <div class="lp-today-v2-eod-plan__actions">
            <%= button_tag t("dash.end_of_day.steps.plan.save_tomorrow"),
                  type: "submit",
                  name: "schedule",
                  value: "tomorrow",
                  class: has_saved ? "lp-today-v2-eod-card__share-pill" : "lp-today-v2-eod-card__primary" %>
          </div>
        <% end %>

        <% if has_saved %>
          <%= button_to t("dash.end_of_day.steps.plan.done_for_today"),
                today_end_day_path,
                method: :post,
                form: { class: "lp-today-v2-eod-card__form", data: { turbo: false } },
                class: "lp-today-v2-eod-card__primary" %>
        <% else %>
          <%= button_to t("dash.end_of_day.steps.plan.skip"),
                today_end_day_path,
                method: :post,
                form: { class: "lp-today-v2-eod-card__form lp-today-v2-eod-card__form--link", data: { turbo: false } },
                class: "lp-today-v2-eod-card__link" %>
        <% end %>
      <% else %>
        <p class="lp-today-v2-eod-plan__empty"><%= t("dash.end_of_day.bridge.no_camps") %></p>
        <% if has_saved %>
          <%= button_to t("dash.end_of_day.steps.plan.done_for_today"),
                today_end_day_path,
                method: :post,
                form: { class: "lp-today-v2-eod-card__form", data: { turbo: false } },
                class: "lp-today-v2-eod-card__primary" %>
        <% else %>
          <%= button_to t("dash.end_of_day.steps.plan.skip"),
                today_end_day_path,
                method: :post,
                form: { class: "lp-today-v2-eod-card__form lp-today-v2-eod-card__form--link", data: { turbo: false } },
                class: "lp-today-v2-eod-card__link" %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
