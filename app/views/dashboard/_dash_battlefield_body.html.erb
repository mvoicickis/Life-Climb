<%# locals: health, open_todos, done_todos, journey %>
<%
  health = local_assigns.fetch(:health)
  open_todos = Array(local_assigns.fetch(:open_todos) { @open_todos })
  done_todos = Array(local_assigns.fetch(:done_todos) { @done_todos })
  journey = local_assigns.fetch(:journey) { @journey }
  show_inline_add = today_inline_add_battle?(journey: journey)
  all_clear = health.all_clear?
%>
<div id="today-battlefield-body">
  <% if health.empty? && !show_inline_add %>
    <% empty_battlefield_cta = Today::EmptyBattleCta.for(
         journey: journey,
         handoff: @strategy_handoff,
         first_camp_setup: journey&.first_camp_reveal_pending?
       ) %>
    <%= render "dashboard/dash_battlefield_empty_cta", cta: empty_battlefield_cta %>
  <% elsif health.empty? && show_inline_add %>
    <div class="lp-today-ready" id="today-battlefield-rows" data-today-v2-target="rows">
      <%= image_tag hero_animal_image_path(current_user),
            class: "lp-today-ready__animal",
            alt: "",
            width: 120,
            height: 120,
            decoding: "async" %>
      <h2 class="lp-today-ready__title"><%= t("dash.battlefield.ready_title") %></h2>
    </div>
    <div id="today-battlefield-all-clear-line"></div>
    <div id="today-battlefield-end-day-host"></div>
  <% else %>
    <div class="lp-today-v2-rows" id="today-battlefield-rows" data-today-v2-target="rows">
      <% open_todos.each_with_index do |todo, index| %>
        <%= render "dashboard/dash_battlefield_row",
              todo: todo,
              mission: nil,
              journey: journey,
              row_state: :open,
              show_tap_hint: index.zero? && journey&.first_camp_win_nudge_pending? %>
      <% end %>
    </div>

    <div id="today-battlefield-all-clear-line"></div>

    <%= render "dashboard/dash_battlefield_won_shell",
          done_todos: done_todos,
          journey: journey %>
    <div id="today-battlefield-end-day-host">
      <%= render "dashboard/dash_battlefield_all_clear_actions", health: health %>
    </div>
  <% end %>
</div>
