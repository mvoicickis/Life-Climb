<%# locals: habit, quick %>
<% quick = local_assigns.fetch(:quick) { habit.quick_add_value } %>
<%= button_to "+#{number_with_delimiter(quick)}",
      daily_logs_path(habit_id: habit.id),
      method: :post,
      params: {
        mode: "add",
        return_to: "today",
        daily_log: { amount: quick }
      },
      class: "lp-dash-habit__qb is-big",
      aria: { label: t("dash.anytime.quick_add", n: number_with_delimiter(quick), unit: habit.unit) },
      data: {
        controller: "pressable",
        action: "pointerdown->pressable#press pointerup->pressable#release pointercancel->pressable#release pointerleave->pressable#release"
      },
      form: {
        id: dom_id(habit, :today_quick),
        data: {
          turbo: false,
          controller: "juicy-feedback",
          juicy_feedback_pop_amount_value: quick,
          action: "submit->juicy-feedback#play"
        }
      } %>
