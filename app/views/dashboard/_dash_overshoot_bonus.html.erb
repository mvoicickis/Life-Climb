<%# locals: percent, awarded_ap (optional) %>
<%
  percent = local_assigns.fetch(:percent).to_i
  awarded = local_assigns[:awarded_ap].to_i
  show_ap = awarded.positive?
%>
<% if percent > 100 %>
  <div class="lp-dash-overshoot" role="status" data-day-overshoot="true">
    <span class="lp-dash-overshoot__mark" aria-hidden="true">✦</span>
    <div class="lp-dash-overshoot__copy">
      <% if show_ap %>
        <p class="lp-dash-overshoot__title">
          <%= t("dash.overshoot.title", percent: percent, bonus: awarded) %>
        </p>
      <% else %>
        <p class="lp-dash-overshoot__title">
          <%= t("dash.overshoot.title_no_ap", percent: percent) %>
        </p>
      <% end %>
      <p class="lp-dash-overshoot__body"><%= t("dash.overshoot.body") %></p>
    </div>
  </div>
<% end %>
