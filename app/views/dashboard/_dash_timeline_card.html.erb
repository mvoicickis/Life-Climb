<%# locals: todo %>
<%
  todo = local_assigns.fetch(:todo)
  quest = todo.quest?
  day = todo.strategy_goal
  tasks = day&.practice_tasks&.sort_by { |t| [ t.position.to_i, t.id ] } || []
  tasks = [] unless quest
  shell_ready = !quest || tasks.all?(&:completed?)
  qty_project = (!quest && day&.quantified_path_project) || nil
  project = todo.visible_path_project
  color_key = project&.tagged_color_key
  icon = quest ? "map" : "sword"
  before_overdue = Time.current.hour < Strategy::NextAction::OVERDUE_AFTER_HOUR
  needs_time_chip = !todo.completed? && !todo.timed? && before_overdue
  card_class = [
    "lp-dash-tcard",
    ("has-color is-#{color_key}" if color_key),
    ("is-done" if todo.completed?),
    ("is-missed" if todo.missed?),
    ("is-shielded-miss" if todo.miss_shielded?),
    ("is-quest" if quest),
    ("is-needs-time" if needs_time_chip),
    ("is-ready" if !todo.completed? && todo.timed?)
  ].compact.join(" ")
  add_step_url = day ? strategy_goal_practice_tasks_path(day) : create_step_daily_todo_path(todo)
  controllers = [ "set-time", "add-step", "tcard-menu", ("quest-steps" if quest && tasks.any?) ].compact.join(" ")
%>
<article class="<%= card_class %>"
         id="<%= dom_id(todo, :tcard) %>"
         data-todo-id="<%= todo.id %>"
         data-battle-day-target="item"
         data-controller="<%= controllers %>"
         data-open="<%= todo.completed? ? 'false' : 'true' %>"
         data-lp="<%= todo.lp_reward %>">
  <div class="lp-dash-tcard__copy">
    <div class="lp-dash-tcard__head">
      <span class="lp-dash-tcard__icon" aria-hidden="true">
        <%= render "shared/lp_icon", name: icon, class_name: "lp-icon is-inline" %>
      </span>
      <div class="lp-dash-tcard__titles">
        <p class="lp-dash-tcard__title"><%= todo.title %></p>
        <% if project %>
          <p class="lp-dash-tcard__project">
            <span class="lp-dash-tcard__project-dot" aria-hidden="true"></span>
            <%= project.title %>
          </p>
        <% end %>
      </div>
      <span class="lp-dash-tcard__ap">
        <%= render "shared/lp_icon", name: "bolt", class_name: "lp-icon is-inline" %>
        <span><%= todo.lp_reward %> <%= t("dash.action_points_short") %></span>
      </span>
      <% if todo.miss_shielded? %>
        <span class="lp-dash-tcard__shield" title="<%= t('dash.shield.used_on_card') %>">
          <%= render "shared/lp_icon", name: "shield", class_name: "lp-icon is-inline" %>
        </span>
      <% end %>
    </div>

    <% if todo.timed? %>
      <span class="lp-dash-tcard__timechip is-set">
        <%= render "shared/lp_icon", name: "clock", class_name: "lp-icon is-inline" %>
        <span><%= t("dash.timeline.timechip_set", range: todo.time_range_label) %></span>
      </span>
    <% elsif needs_time_chip %>
      <button type="button"
              class="lp-dash-tcard__timechip"
              data-set-time-target="trigger"
              data-action="set-time#open">
        <%= render "shared/lp_icon", name: "clock", class_name: "lp-icon is-inline" %>
        <span><%= t("dash.timeline.timechip_add") %></span>
      </button>
    <% elsif !todo.completed? %>
      <span class="lp-dash-tcard__timechip is-muted">
        <%= t("dash.timeline.unscheduled_label") %>
      </span>
    <% end %>

    <% if quest && tasks.any? %>
      <div id="<%= dom_id(todo, :quest_next) %>" class="lp-dash-quest-next">
        <%= render "dashboard/dash_quest_next", todo: todo, day: day, tasks: tasks %>
      </div>
    <% end %>

    <% unless todo.completed? %>
      <div class="lp-dash-tcard__add-step-panel" data-add-step-target="panel" hidden>
        <%= form_with url: add_step_url,
              method: :post,
              class: "lp-dash-tcard__add-step-form",
              data: { turbo: false } do %>
          <% if day %>
            <%= hidden_field_tag :return_to, "today" %>
          <% end %>
          <label>
            <span class="sr-only"><%= t("dash.add_step.title_label") %></span>
            <%= text_field_tag :title, nil,
                  required: true,
                  maxlength: 120,
                  class: "lp-dash-tcard__add-step-input",
                  placeholder: t("dash.add_step.placeholder"),
                  autocomplete: "off",
                  data: { add_step_target: "title" } %>
          </label>
          <div class="lp-dash-tcard__add-step-actions">
            <%= submit_tag t("dash.add_step.save"), class: "lp-dash-tcard__win" %>
            <button type="button" class="lp-dash-tcard__add-step-cancel" data-action="add-step#close">
              <%= t("dash.timeline.cancel") %>
            </button>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if !todo.timed? && !todo.completed? && before_overdue %>
      <div class="lp-dash-tcard__set-time-panel" data-set-time-target="panel" hidden>
        <%= form_with model: todo,
              url: daily_todo_path(todo),
              method: :patch,
              class: "lp-dash-tcard__set-time-form",
              data: { turbo: false } do |form| %>
          <label>
            <span><%= t("dash.timeline.start_time") %></span>
            <%= form.time_field :start_time,
                  value: (todo.start_time || Time.current).strftime("%H:%M"),
                  required: true,
                  class: "lp-dash-tcard__time-input" %>
          </label>
          <label>
            <span><%= t("dash.timeline.end_time") %></span>
            <%= form.time_field :end_time, required: true, class: "lp-dash-tcard__time-input" %>
          </label>
          <div class="lp-dash-tcard__set-time-actions">
            <%= form.submit t("dash.timeline.save_time"), class: "lp-dash-tcard__win" %>
            <button type="button" class="lp-dash-tcard__set-time-cancel" data-action="set-time#close">
              <%= t("dash.timeline.cancel") %>
            </button>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if quest %>
    <%= render "dashboard/dash_quest_actions",
          todo: todo,
          shell_ready: shell_ready,
          before_overdue: before_overdue %>
  <% else %>
    <div class="lp-dash-tcard__actions">
      <% unless todo.completed? %>
        <details class="lp-dash-tcard__menu"
                 data-tcard-menu-target="details"
                 data-action="toggle->tcard-menu#toggled">
          <summary class="lp-dash-tcard__menu-summary" aria-label="<%= t('dash.timeline.more_actions') %>">
            <%= render "shared/lp_icon", name: "dots", class_name: "lp-icon is-inline" %>
          </summary>
          <div class="lp-dash-tcard__menulist">
            <% if !todo.timed? && before_overdue %>
              <button type="button"
                      class="lp-dash-tcard__menuitem"
                      data-action="set-time#open click->tcard-menu#close">
                <%= t("dash.timeline.set_time") %>
              </button>
            <% end %>
            <button type="button"
                    class="lp-dash-tcard__menuitem"
                    data-action="add-step#open click->tcard-menu#close">
              <%= t("dash.add_step.cta") %>
            </button>
            <%= button_to t("dash.timeline.remove"),
                  daily_todo_path(todo),
                  method: :delete,
                  class: "lp-dash-tcard__menuitem is-danger",
                  form: {
                    class: "lp-dash-tcard__menu-form",
                    data: { turbo_confirm: t("dash.timeline.remove_confirm") }
                  } %>
          </div>
        </details>
      <% end %>

      <% if todo.completed? %>
        <%= button_to t("dash.timeline.undo"),
              complete_daily_todo_path(todo),
              method: :post,
              class: "lp-dash-tcard__win is-done",
              aria: { label: "#{t('dash.timeline.undo')} #{todo.title}" } %>
      <% elsif qty_project %>
        <%= form_with url: complete_daily_todo_path(todo),
              method: :post,
              class: "lp-dash-tcard__qty",
              data: {
                turbo: false,
                controller: "juicy-feedback",
                action: "submit->juicy-feedback#play",
                juicy_feedback_suppress_reload_celebrate_value: true
              } do %>
          <%= number_field_tag :amount, nil,
                min: 0,
                step: :any,
                required: true,
                class: "lp-dash-tcard__amount",
                aria: { label: t("strategy.quantity.how_many", unit: qty_project.unit) },
                placeholder: qty_project.unit %>
          <%= submit_tag t("dash.timeline.log"), class: "lp-dash-tcard__win lp-dash-tcard__win--primary" %>
        <% end %>
      <% else %>
        <%= button_to t("dash.timeline.did_it"),
              complete_daily_todo_path(todo),
              method: :post,
              class: "lp-dash-tcard__win lp-dash-tcard__win--primary",
              aria: { label: "#{t('dash.timeline.did_it')} #{todo.title}" },
              form: {
                data: {
                  controller: "juicy-feedback",
                  action: "submit->juicy-feedback#play",
                  juicy_feedback_suppress_reload_celebrate_value: true
                }
              } %>
      <% end %>
    </div>
  <% end %>

  <% if quest && tasks.any? %>
    <dialog class="lp-strategy-sheet is-project lp-dash-quest-sheet"
            id="<%= dom_id(todo, :quest_sheet) %>"
            data-quest-steps-target="dialog"
            data-action="click->quest-steps#backdropClose">
      <div class="lp-strategy-sheet__panel">
        <header class="lp-strategy-sheet__head">
          <p class="lp-strategy-sheet__kind"><%= t("dash.checklist_objectives") %></p>
          <h2 class="lp-strategy-sheet__title"><%= todo.title %></h2>
          <button type="button"
                  class="lp-strategy-sheet__close"
                  data-action="click->quest-steps#close"
                  aria-label="<%= t('strategy.sheet.close') %>">×</button>
        </header>
        <div id="<%= dom_id(todo, :quest_sheet_body) %>" class="lp-dash-quest-sheet__body">
          <%= render "dashboard/dash_quest_objectives",
                todo: todo,
                day: day,
                tasks: tasks,
                turbo: true %>
        </div>
      </div>
    </dialog>
  <% end %>
</article>
