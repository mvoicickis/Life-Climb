<%# Locals: life_areas, focus_id, closer_percent, compact, journey_scoped %>
<% areas = Array(local_assigns.fetch(:life_areas)) %>
<% focus_id = local_assigns[:focus_id] %>
<% closer = local_assigns.fetch(:closer_percent, 0).to_i %>
<% compact = local_assigns.fetch(:compact, false) %>
<% journey_scoped = local_assigns.fetch(:journey_scoped, false) %>

<section class="lp-map-card mt-4 overflow-hidden <%= 'lp-map-card--compact' if compact %>"
         aria-label="<%= t('game_ui.life_map') %>"
         style="--map-bg: url('<%= asset_path('game/life-tree.png') %>')">
  <div class="lp-map-card__veil">
    <div class="lp-tree-stage">
      <div class="lp-tree" role="list">
        <svg class="lp-tree__lines" viewBox="0 0 100 100" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
          <% areas.each_with_index do |_area, index| %>
            <% angle = ((360.0 / [areas.size, 1].max) * index - 90) * Math::PI / 180.0 %>
            <% x = 50 + Math.cos(angle) * 34 %>
            <% y = 50 + Math.sin(angle) * 34 %>
            <line x1="50" y1="50" x2="<%= x.round(2) %>" y2="<%= y.round(2) %>" class="lp-tree__line" />
          <% end %>
        </svg>

        <% areas.each_with_index do |area, index| %>
          <% angle = (360.0 / [areas.size, 1].max) * index - 90 %>
          <% node_closer = area.closer_percent %>
          <% aria = if journey_scoped && area.journey_gap_percent
               t("game_ui.tree_node_aria", area: area.label, closer: node_closer, gap: area.journey_gap_percent.round)
             else
               "#{area.label} #{node_closer}%"
             end %>
          <%= link_to life_area_path(area),
                class: "lp-tree-node lp-tree-node--v#{area.vitality} #{'is-focus' if focus_id == area.id}",
                style: "--lp-angle: #{angle}deg",
                role: "listitem",
                aria: { label: aria } do %>
            <span class="lp-tree-node__emoji" aria-hidden="true"><%= area.emoji %></span>
            <span class="lp-tree-node__label"><%= area.short_label %></span>
            <% if journey_scoped %>
              <span class="lp-tree-node__pct"><%= node_closer %>%</span>
            <% else %>
              <span class="lp-tree-node__pct"><%= node_closer %>%</span>
            <% end %>
          <% end %>
        <% end %>

        <div class="lp-tree-center">
          <span class="lp-tree-center__you" aria-hidden="true">😊</span>
          <span class="lp-tree-center__label">
            <% if journey_scoped %>
              <%= t("game_ui.you") %>
            <% else %>
              <%= t("game_ui.you") %> <%= closer %>%
            <% end %>
          </span>
        </div>
      </div>
    </div>

    <% if compact %>
      <div class="px-4 pb-4 text-center">
        <%= link_to t("game_ui.open_life"), life_map_path, class: "text-sm font-bold text-[var(--lp-mint)]" %>
      </div>
    <% end %>
  </div>
</section>
