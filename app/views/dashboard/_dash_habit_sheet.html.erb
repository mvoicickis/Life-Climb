<%# locals: habit, amount, target, progress, undo, quick, sheet_target (optional) %>
<% amount = local_assigns.fetch(:amount) { habit.today_amount }
   target = local_assigns.fetch(:target) { habit.stretch_goal? ? habit.todays_goal_value : nil }
   progress = local_assigns.fetch(:progress) { habit.goal_progress_percent }
   undo = local_assigns.fetch(:undo) { habit.quantity_checkin? ? habit_log_undo_for(habit) : nil }
   quick = local_assigns.fetch(:quick) { habit.quantity_checkin? ? habit.quick_add_value : nil }
   suggestions = habit.quantity_checkin? ? habit.quick_add_suggestions : []
   sheet_attrs = local_assigns[:sheet_target] ? { data: { tcard_menu_target: "sheet" } } : {} %>
<%= tag.div(
      id: dom_id(habit, :today_sheet),
      class: "lp-dash-habit__sheet",
      **sheet_attrs) do %>
  <div class="lp-dash-habit__grab" aria-hidden="true"></div>
  <div class="lp-dash-habit__shd">
    <span class="lp-dash-habit__sig" aria-hidden="true"><%= habit_sigil(habit) %></span>
    <div class="lp-dash-habit__shd-txt">
      <b><%= habit.name %></b>
      <em>
        <% if habit.quantity_checkin? && habit.stretch_goal? && target.present? %>
          <%= t("dash.anytime.amount_of_target",
                amount: format_amount(amount),
                target: format_amount(target),
                unit: habit.unit) %>
        <% elsif habit.quantity_checkin? %>
          <%= format_amount(amount) %> <%= habit.unit %>
          <% if habit.standard? && habit.range_summary.present? %>
            · <%= habit.range_summary %>
          <% end %>
        <% else %>
          <%= t("dash.anytime.binary_subtitle") %>
        <% end %>
      </em>
    </div>
    <% if progress.is_a?(Numeric) && habit.stretch_goal? %>
      <span class="lp-dash-habit__shd-pc"><%= progress %>%</span>
    <% end %>
  </div>
  <% if progress.is_a?(Numeric) && habit.stretch_goal? %>
    <div class="lp-dash-habit__shbar" aria-hidden="true">
      <% habit_progress_segments(progress, count: 20).each do |klass| %>
        <i class="<%= klass %>"></i>
      <% end %>
    </div>
  <% end %>

  <% if habit.quantity_checkin? %>
    <div class="lp-dash-habit__minor">
      <%= form_with url: daily_logs_path(habit_id: habit.id),
            scope: :daily_log,
            class: "lp-dash-habit__exact-form lp-dash-tcard__qty",
            data: {
              turbo: false,
              controller: "quantity-win juicy-feedback",
              action: "input->quantity-win#sync submit->juicy-feedback#play"
            } do |form| %>
        <%= hidden_field_tag :mode, "add" %>
        <%= hidden_field_tag :return_to, "today" %>
        <label class="lp-dash-habit__sheet-label"><%= t("dash.anytime.enter_exact") %></label>
        <%= form.number_field :amount,
              value: nil,
              min: habit.decimal_quantity_unit? ? "0.01" : 1,
              step: habit.quantity_input_step,
              inputmode: habit.quantity_inputmode,
              required: true,
              placeholder: t("dash.anytime.add_placeholder"),
              class: "lp-dash-tcard__amount",
              data: { quantity_win_target: "amount" },
              aria: { label: t("dash.anytime.add_aria", unit: habit.unit) } %>
        <%= form.submit t("dash.anytime.add"),
              class: "lp-dash-habit__sheet-btn",
              disabled: true,
              data: { quantity_win_target: "submit" } %>
      <% end %>

      <%= form_with url: daily_logs_path(habit_id: habit.id),
            scope: :daily_log,
            class: "lp-dash-habit__set-form",
            data: { turbo: false } do |form| %>
        <%= hidden_field_tag :mode, "set" %>
        <%= hidden_field_tag :return_to, "today" %>
        <label class="lp-dash-habit__sheet-label"><%= t("dash.anytime.set_total") %></label>
        <%= form.number_field :amount,
              value: format_amount(amount),
              min: 0,
              step: habit.quantity_input_step,
              inputmode: habit.quantity_inputmode,
              required: true,
              class: "lp-dash-tcard__amount",
              aria: { label: t("dash.anytime.set_total") } %>
        <%= form.submit t("dash.anytime.save_total"),
              class: "lp-dash-habit__sheet-btn" %>
      <% end %>
      <% if undo %>
        <%= button_to t("dash.hero.menu_undo"),
              daily_logs_path(habit_id: habit.id),
              method: :post,
              params: { mode: "undo", return_to: "today" },
              class: "lp-dash-habit__sheet-btn is-undo",
              form: { data: { turbo: false } } %>
      <% end %>
      <%= link_to t("dash.hero.menu_edit"),
            habit_path(habit),
            class: "lp-dash-habit__sheet-btn is-quiet" %>
    </div>

    <p class="lp-dash-habit__lbl"><%= t("dash.anytime.quick_add_label") %></p>
    <div class="lp-dash-habit__chips">
      <% suggestions.each do |chip| %>
        <% on = chip.to_i == quick.to_i %>
        <%= button_to "+#{number_with_delimiter(chip)}",
              habit_path(habit),
              method: :patch,
              params: {
                return_to: "today",
                quick_add_sheet: "1",
                habit: { quick_add_amount: chip }
              },
              class: "lp-dash-habit__chip#{' is-on' if on}",
              aria: {
                label: t("dash.anytime.quick_add", n: number_with_delimiter(chip), unit: habit.unit),
                pressed: on
              },
              form: { data: { turbo: true } } %>
      <% end %>
    </div>
    <%= form_with model: habit,
          url: habit_path(habit),
          method: :patch,
          class: "lp-dash-habit__custom",
          data: { turbo: true } do |form| %>
      <%= hidden_field_tag :return_to, "today" %>
      <%= hidden_field_tag :quick_add_sheet, "1" %>
      <%= form.number_field :quick_add_amount,
            value: "",
            min: 1,
            max: 1_000_000,
            step: 1,
            required: true,
            inputmode: "numeric",
            autocomplete: "off",
            placeholder: t("dash.anytime.custom_amount"),
            class: "lp-dash-habit__custom-input",
            aria: { label: t("dash.anytime.custom_amount") } %>
      <%= form.submit t("dash.anytime.use_amount"), class: "lp-dash-habit__use" %>
    <% end %>
  <% else %>
    <%= link_to t("dash.hero.menu_edit"),
          habit_path(habit),
          class: "lp-dash-habit__sheet-btn is-quiet" %>
  <% end %>
<% end %>
