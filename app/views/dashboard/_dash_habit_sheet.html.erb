<%# locals: habit, amount, target, progress, undo, quick, sheet_target (optional) %>
<% amount = local_assigns.fetch(:amount) { habit.today_amount }
   quick = local_assigns.fetch(:quick) { habit.quantity_checkin? ? habit.quick_add_value : nil }
   sheet_attrs = local_assigns[:sheet_target] ? { data: { tcard_menu_target: "sheet" } } : {} %>
<% if habit.quantity_checkin? %>
  <%= tag.div(
        id: dom_id(habit, :today_sheet),
        class: "lp-dash-habit__sheet lp-dash-habit__sheet--basic-log",
        **sheet_attrs) do %>
    <%= render "dashboard/dash_basic_sheet_log", habit: habit, amount: amount, quick: quick %>
  <% end %>
<% else %>
  <% progress = habit.goal_progress_percent %>
  <%= tag.div(
        id: dom_id(habit, :today_sheet),
        class: "lp-dash-habit__sheet",
        **sheet_attrs) do %>
    <div class="lp-dash-habit__grab" aria-hidden="true"></div>
    <div class="lp-dash-habit__shd">
      <span class="lp-dash-habit__sig" aria-hidden="true"><%= habit_sigil(habit) %></span>
      <div class="lp-dash-habit__shd-txt">
        <b><%= habit.name %></b>
        <em><%= t("dash.anytime.binary_subtitle") %></em>
      </div>
    </div>
    <%= link_to t("dash.hero.menu_edit"),
          habit_path(habit),
          class: "lp-dash-habit__sheet-btn is-quiet" %>
  <% end %>
<% end %>
