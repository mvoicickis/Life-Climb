<% content_for :title, t("auth.register_title") %>

<div class="lp-auth-card mx-auto max-w-md">
  <%= render "shared/auth_topbar" %>

  <h1 class="lp-auth-title"><%= t("auth.register_title") %></h1>
  <p class="lp-auth-sub"><%= t("auth.register_subtitle") %></p>

  <%= form_with model: @user, url: registration_path, class: "space-y-4", data: { turbo: false } do |form| %>
    <% if @user.errors.any? %>
      <div class="rounded-2xl border-2 border-rose-300 bg-rose-50 px-4 py-3 font-bold text-rose-900">
        <ul class="list-inside list-disc">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, t("auth.name"), class: "lp-auth-label" %>
      <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", maxlength: 80,
          class: "lp-auth-input", placeholder: t("auth.name_placeholder") %>
    </div>

    <div>
      <%= form.label :email_address, t("auth.email"), class: "lp-auth-label" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username",
          class: "lp-auth-input" %>
    </div>

    <div>
      <%= form.label :password, t("auth.password"), class: "lp-auth-label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
          class: "lp-auth-input" %>
    </div>

    <div>
      <%= form.label :password_confirmation, t("auth.password_confirmation"), class: "lp-auth-label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
          class: "lp-auth-input" %>
    </div>

    <%= form.submit t("auth.register_submit"), class: "lp-auth-submit" %>
  <% end %>

  <p class="mt-6 text-center text-sm font-semibold text-[var(--lp-muted,#475569)]">
    <%= t("auth.already_have_account") %>
    <%= link_to t("auth.sign_in_submit"), new_session_path, class: "lp-auth-link" %>
  </p>
</div>

<%= render "shared/feedback_prompt", page: "registration" %>
