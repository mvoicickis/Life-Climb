<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Admin — LifePoints" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/favicon.ico?v=7" sizes="any">
    <link rel="icon" href="/icon.png?v=7" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/icon.png?v=7">
    <link rel="icon" href="/icon.svg?v=7" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800;900&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-slate-100 font-['Nunito',sans-serif] text-slate-900">
    <nav class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
        <p class="text-lg font-black text-slate-900">LifePoints Admin</p>
        <div class="flex items-center gap-3 text-sm font-bold">
          <%= link_to "App", dashboard_path, class: "text-slate-600 hover:text-emerald-700" %>
          <%= button_to "Sign out", session_path, method: :delete, class: "cursor-pointer text-rose-600" %>
        </div>
      </div>
    </nav>

    <main class="mx-auto max-w-5xl px-4 py-6">
      <% if flash[:notice] %>
        <div class="mb-4 rounded-2xl border-2 border-emerald-300 bg-emerald-50 px-4 py-3 text-sm font-bold text-emerald-900"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="mb-4 rounded-2xl border-2 border-rose-300 bg-rose-50 px-4 py-3 text-sm font-bold text-rose-900"><%= flash[:alert] %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
