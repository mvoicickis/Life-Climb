<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Admin · LifePoints" : "Admin · LifePoints" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/favicon.ico?v=7" sizes="any">
    <link rel="icon" href="/icon.png?v=7" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/icon.png?v=7">
    <link rel="icon" href="/icon.svg?v=7" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,800&family=Source+Sans+3:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen antialiased lp-game lp-admin text-[var(--lp-ink)]">
    <header class="lp-admin__top">
      <div class="lp-admin__top-inner">
        <div class="lp-admin__brand">
          <%= render "shared/lp_brand_mark", size: 28, class_name: "lp-admin__mark" %>
          <div>
            <p class="lp-admin__brand-kicker">LifePoints</p>
            <p class="lp-admin__brand-title"><%= t("admin.brand") %></p>
          </div>
        </div>
        <nav class="lp-admin__nav" aria-label="Admin">
          <%= link_to t("admin.nav.dashboard"), admin_root_path, class: "lp-admin__nav-link #{"is-active" if controller_name == "dashboard"}" %>
          <%= link_to t("admin.nav.users"), admin_users_path, class: "lp-admin__nav-link #{"is-active" if controller_name == "users"}" %>
          <%= link_to t("admin.nav.statistics"), admin_statistics_path, class: "lp-admin__nav-link #{"is-active" if controller_name == "statistics"}" %>
          <%= link_to t("admin.nav.feedback"), admin_feedbacks_path, class: "lp-admin__nav-link #{"is-active" if controller_name == "feedbacks"}" %>
          <%= link_to t("admin.nav.system"), admin_system_path, class: "lp-admin__nav-link #{"is-active" if controller_name == "systems"}" %>
          <%= link_to t("admin.nav.ops"), admin_ops_path, class: "lp-admin__nav-link #{"is-active" if controller_name == "ops"}" %>
          <%= link_to t("admin.nav.strategy"), admin_strategy_path, class: "lp-admin__nav-link #{"is-active" if controller_name == "strategy"}" %>
        </nav>
        <div class="lp-admin__actions">
          <%= link_to t("admin.nav.app"), dashboard_path, class: "lp-admin__ghost" %>
          <%= button_to t("nav.sign_out"), session_path, method: :delete, class: "lp-admin__ghost is-danger" %>
        </div>
      </div>
    </header>

    <main class="lp-admin__main">
      <% if flash[:notice].present? %>
        <div class="lp-admin__flash is-notice"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert].present? %>
        <div class="lp-admin__flash is-alert"><%= flash[:alert] %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
