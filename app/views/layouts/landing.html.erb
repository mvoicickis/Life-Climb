<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= page_meta_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#f8fafc">
    <meta name="application-name" content="Life Climb">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="app-version" content="<%= app_version %>">
    <%= render "shared/social_meta" %>
    <%= render "shared/landing_json_ld" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/favicon.ico?v=7" sizes="any">
    <link rel="icon" href="/icon.png?v=7" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/icon.png?v=7">
    <link rel="icon" href="/icon.svg?v=7" type="image/svg+xml">

    <%= render "shared/nunito_fonts", preload: true %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="lp-landing-body lp-min-h-screen antialiased">
    <% if flash[:notice].present? %>
      <p class="lp-landing-flash" role="status"><%= flash[:notice] %></p>
    <% end %>
    <%= yield %>
    <%= render "shared/feedback_fab", page: request.path %>
  </body>
</html>
