<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= page_meta_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="robots" content="<%= content_for?(:blog_robots) ? yield(:blog_robots) : "index, follow" %>">
    <meta name="application-name" content="Life Climb">
    <%= render "shared/social_meta" %>
    <%= yield :head %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/android_html_class" %>

    <link rel="icon" href="/favicon.ico?v=7" sizes="any">
    <link rel="icon" href="/icon.png?v=7" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/icon.png?v=7">
    <link rel="icon" href="/icon.svg?v=7" type="image/svg+xml">

    <%= render "shared/nunito_fonts", preload: true %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="lp-min-h-screen antialiased lp-public-blog-body">
    <% if flash[:notice].present? %>
      <p class="lp-beta-card-flash" role="status"><%= flash[:notice] %></p>
    <% elsif flash[:alert].present? %>
      <p class="lp-beta-card-flash lp-beta-card-flash--alert" role="alert"><%= flash[:alert] %></p>
    <% end %>
    <%= render "blog/header" %>
    <%= yield %>
  </body>
</html>