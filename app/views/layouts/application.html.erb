<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= page_meta_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="LifePoints">
    <meta name="mobile-web-app-capable" content="yes">
    <%= render "shared/social_meta" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <link rel="icon" href="/icon.png?v=2" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/icon.png?v=2">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800;900&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen font-['Nunito',sans-serif] text-slate-900" style="background: linear-gradient(180deg, #ecfdf5 0%, #f0f9ff 45%, #fff7ed 100%);">
    <% if authenticated? %>
      <nav class="border-b border-white/60 bg-white/80 backdrop-blur">
        <div class="container mx-auto flex items-center justify-between px-4 py-3">
          <%= link_to "LifePoints", dashboard_path, class: "text-xl font-black text-emerald-600 md:text-2xl" %>
          <div class="flex items-center gap-1 text-sm font-bold md:gap-2">
            <%= link_to "Today", dashboard_path, class: "rounded-xl px-2 py-2 text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 md:px-3" %>
            <%= link_to "Stats", habits_path, class: "rounded-xl px-2 py-2 text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 md:px-3" %>
            <%= link_to "Feedback", new_feedback_path, class: "rounded-xl px-2 py-2 text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 md:px-3" %>
            <%= link_to "Settings", settings_path, class: "rounded-xl px-2 py-2 text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 md:px-3" %>
            <% if current_user.admin? %>
              <%= link_to "Admin", admin_root_path, class: "rounded-xl px-2 py-2 text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 md:px-3" %>
            <% end %>
            <%= button_to "Out", session_path, method: :delete, class: "rounded-xl px-2 py-2 text-slate-500 hover:bg-rose-50 hover:text-rose-600 md:px-3" %>
          </div>
        </div>
      </nav>
    <% end %>

    <main class="container mx-auto px-4 py-4 md:px-5 md:py-6">
      <% if flash[:notice] %>
        <div class="mb-4 rounded-2xl border-2 border-emerald-300 bg-emerald-50 px-4 py-3 text-sm font-bold text-emerald-900 md:text-base">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="mb-4 rounded-2xl border-2 border-rose-300 bg-rose-50 px-4 py-3 text-sm font-bold text-rose-900 md:text-base">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
