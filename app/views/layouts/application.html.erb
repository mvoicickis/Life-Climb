<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= page_meta_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="theme-color" content="#FFFFFF">
    <meta name="application-name" content="LifePoints">
    <meta name="mobile-web-app-capable" content="yes">
    <%= render "shared/social_meta" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg?v=6" type="image/svg+xml">
    <link rel="icon" href="/icon.png?v=6" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/icon.png?v=6">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,800&family=Source+Sans+3:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen antialiased <%= authenticated? ? (content_for?(:lp_game) ? 'lp-game text-[var(--lp-ink)]' : 'studio-app text-[var(--studio-ink)]') : 'lp-auth text-[var(--lp-ink)]' %>">
    <% if authenticated? && content_for?(:lp_game) %>
      <% unless content_for?(:lp_hide_top_nav) %>
      <nav class="lp-top-nav" aria-label="Main">
        <div class="lp-top-nav__inner">
          <%= link_to dashboard_path, class: "lp-top-nav__brand" do %>
            <%= render "shared/lp_brand_mark", size: 28, class_name: "lp-top-nav__brand-mark" %>
            <span><%= t("app_name") %></span>
          <% end %>
          <div class="lp-top-nav__links">
            <% if current_user.planning_v2? %>
              <% journey = current_user.primary_focused_journey || current_user.life_journeys.active.order(:id).first %>
              <% if journey %>
                <%= link_to t("game_ui.nav.journey"), life_journey_path(journey) %>
              <% end %>
              <%= link_to t("game_ui.nav.you"), settings_path %>
            <% else %>
              <%= link_to t("nav.building"), building_path %>
              <%= link_to t("nav.finished"), finished_products_path %>
              <%= link_to t("nav.life_points"), life_points_path %>
              <%= link_to t("nav.settings"), settings_path %>
            <% end %>
          </div>
        </div>
      </nav>
      <% end %>
    <% elsif authenticated? %>
      <%= render "shared/app_nav" %>
    <% end %>

    <main class="<%= authenticated? ? (content_for?(:lp_game) ? 'lp-main' : 'studio-main') : 'container mx-auto px-4 py-4 md:px-5 md:py-6' %>">
      <% if flash[:notice] %>
        <div class="<%= authenticated? ? (content_for?(:lp_game) ? 'lp-flash lp-flash--notice' : 'studio-flash studio-flash--notice') : 'mb-4 rounded-2xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm font-bold text-emerald-800 md:text-base' %>" role="status">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="<%= authenticated? ? (content_for?(:lp_game) ? 'lp-flash lp-flash--alert' : 'studio-flash studio-flash--alert') : 'mb-4 rounded-2xl border border-rose-400/30 bg-rose-500/10 px-4 py-3 text-sm font-bold text-rose-800 md:text-base' %>" role="alert">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
