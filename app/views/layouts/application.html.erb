<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "LifePoints" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="LifePoints">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900">
    <% if authenticated? %>
      <nav class="border-b border-slate-200 bg-white">
        <div class="container mx-auto flex items-center justify-between px-5 py-4">
          <%= link_to "LifePoints", root_path, class: "text-xl font-bold text-emerald-600" %>
          <div class="flex items-center gap-4 text-sm font-medium">
            <%= link_to "Dashboard", root_path, class: "text-slate-600 hover:text-emerald-600" %>
            <%= link_to "Habits", habits_path, class: "text-slate-600 hover:text-emerald-600" %>
            <%= button_to "Sign out", session_path, method: :delete, class: "text-slate-600 hover:text-red-600" %>
          </div>
        </div>
      </nav>
    <% end %>

    <main class="container mx-auto px-5 py-8">
      <% if flash[:notice] %>
        <div class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-emerald-800">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-red-800">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
