<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= page_meta_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="LifePoints">
    <meta name="mobile-web-app-capable" content="yes">
    <%= render "shared/social_meta" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg?v=4" type="image/svg+xml">
    <link rel="icon" href="/icon.png?v=4" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/icon.png?v=4">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800;900&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen font-['Nunito',sans-serif] antialiased <%= authenticated? ? 'app-dark text-slate-100' : 'text-slate-900' %>"
        style="<%= authenticated? ? 'background: radial-gradient(1200px 600px at 10% -10%, rgba(16,185,129,0.18), transparent 55%), radial-gradient(900px 500px at 100% 0%, rgba(245,158,11,0.10), transparent 45%), #0b1220;' : 'background: linear-gradient(180deg, #ecfdf5 0%, #f0f9ff 45%, #fff7ed 100%);' %>">
    <% if authenticated? %>
      <nav class="app-nav border-b border-white/10 bg-[#0b1220]/80 backdrop-blur">
        <div class="container mx-auto flex items-center justify-between gap-3 px-4 py-3">
          <%= link_to dashboard_path, class: "flex items-center gap-2 text-xl font-black text-emerald-400 md:text-2xl" do %>
            <span class="grid h-8 w-8 place-items-center rounded-xl bg-emerald-500/20 text-base" aria-hidden="true">🌿</span>
            <span>LifePoints</span>
          <% end %>
          <div class="flex items-center gap-1 text-sm font-bold md:gap-2">
            <%= link_to "Today", dashboard_path, class: "rounded-xl px-2 py-2 text-emerald-300 hover:bg-white/5 md:px-3" %>
            <%= link_to "Stats", habits_path, class: "rounded-xl px-2 py-2 text-slate-300 hover:bg-white/5 hover:text-white md:px-3" %>
            <%= link_to "Feedback", new_feedback_path, class: "rounded-xl px-2 py-2 text-slate-300 hover:bg-white/5 hover:text-white md:px-3" %>
            <%= link_to "Settings", settings_path, class: "rounded-xl px-2 py-2 text-slate-300 hover:bg-white/5 hover:text-white md:px-3" %>
            <% if current_user.admin? %>
              <%= link_to "Admin", admin_root_path, class: "rounded-xl px-2 py-2 text-slate-300 hover:bg-white/5 hover:text-white md:px-3" %>
            <% end %>
            <%= button_to "Out", session_path, method: :delete, class: "rounded-xl px-2 py-2 text-slate-500 hover:bg-rose-500/10 hover:text-rose-300 md:px-3" %>
          </div>
        </div>
      </nav>
    <% end %>

    <main class="container mx-auto px-4 py-4 md:px-5 md:py-6">
      <% if flash[:notice] %>
        <div class="mb-4 rounded-2xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm font-bold text-emerald-200 md:text-base">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="mb-4 rounded-2xl border border-rose-400/30 bg-rose-500/10 px-4 py-3 text-sm font-bold text-rose-200 md:text-base">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
