<% content_for :title, t("game_ui.missions_title") %>
<% content_for :lp_game, true %>

<div class="lp-home mx-auto max-w-md px-5 pb-8 pt-8">
  <header class="space-y-1">
    <h1 class="text-3xl font-semibold text-[var(--lp-ink)]"><%= t("game_ui.missions_title") %></h1>
    <p class="text-sm text-[var(--lp-muted)]"><%= t("game_ui.missions_subtitle") %></p>
  </header>

  <% if @actions.any? %>
    <ul class="mt-6 space-y-3">
      <% @actions.each do |action| %>
        <li class="lp-glass p-4 <%= 'opacity-60' if action.completed? %>">
          <p class="text-lg font-semibold text-[var(--lp-ink)]"><%= action.title %></p>
          <p class="mt-1 text-sm text-[var(--lp-muted)]">
            <% if action.completed? %>
              <%= t("game_ui.quest_done") %>
            <% else %>
              +<%= LifePointsAward::ACTION %> <%= t("game_ui.life_points_short") %>
            <% end %>
          </p>
          <% unless action.completed? %>
            <%= button_to t("game_ui.complete_quest"),
                  complete_today_action_path(action),
                  method: :post,
                  class: "lp-cta mt-4 w-full" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="lp-glass mt-6 p-6 text-center">
      <p class="text-[var(--lp-ink)]"><%= t("game_ui.no_quest") %></p>
      <%= link_to t("game_ui.add_quest"), dashboard_path(anchor: "add-quest"), class: "lp-cta mt-4 inline-flex" %>
    </div>
  <% end %>
</div>

<%= render "shared/lp_bottom_nav", active: :missions %>
