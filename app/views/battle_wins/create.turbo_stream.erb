<% if @quiet_win && @project.present? %>
  <%= turbo_stream.remove "trail-battle-#{@battle.id}" %>
  <%= turbo_stream.update "trail-camp-win-toast-slot-#{@project.id}" do %>
    <%= render "life_journeys/trail_camp_win_toast", battle: @battle %>
  <% end %>
  <%= turbo_stream.replace "trail-battles-done-slot-#{@project.id}" do %>
    <%= render "life_journeys/trail_camp_done_section",
          project: @project,
          won_battles: @won_battles,
          area: @project.life_area,
          goal: @goal,
          plan: @plan,
          reveal: true %>
  <% end %>
  <% if @replace_camp_battles %>
    <%= turbo_stream.replace "trail-battles-#{@project.id}" do %>
      <%= render "life_journeys/trail_camp_battles",
            project: @project,
            goal: @goal,
            plan: @plan,
            area: @project.life_area %>
    <% end %>
  <% end %>
  <%= turbo_stream.replace "trail-camp-finish-#{@project.id}" do %>
    <%= render "life_journeys/trail_camp_finish_card",
          project: @project,
          plan: @plan,
          goal: @goal,
          visible: @show_finish_camp_card,
          first_win: @first_win_celebration %>
  <% end %>
  <%= turbo_stream.remove "trail-base-battle-#{@battle.id}" %>
  <%= render "life_journeys/trail_climber_stream" %>
  <%= render "life_journeys/trail_dock_stream" %>
<% else %>
  <%= turbo_stream.replace "trail-battle-#{@battle.id}" do %>
    <%= render "life_journeys/trail_battle_row", battle: @battle %>
  <% end %>
  <%= turbo_stream.remove "trail-base-battle-#{@battle.id}" %>
  <% unless @quiet_win %>
    <%= render "life_journeys/trail_climber_stream" %>
    <% if @battle %>
      <%= turbo_stream.update "trail-toast-host" do %>
        <%= render "life_journeys/trail_toast",
              title: t("strategy.rpg.trail.quick_win_toast", title: @battle.title),
              restore: false %>
      <% end %>
    <% end %>
  <% end %>
  <%= render "life_journeys/trail_dock_stream" if @dock_today_card.present? %>
<% end %>

<% if @awarded.to_i.positive? || @stream_push_offer_eligible %>
  <%= turbo_stream.append "strategy-world" do %>
    <%= render "shared/battle_day_stream_bridge",
          celebrate: true,
          ap_gained: @awarded.to_i,
          boss: false,
          win_number: @win_number.to_i,
          push_offer_eligible: @stream_push_offer_eligible %>
  <% end %>
<% end %>
