<%# locals: trends %>
<% if trends.present? && (trends[:camps].present? || trends[:battles].present? || trends[:habits].present?) %>
  <% battles_json = trends[:battles] ? trends[:battles][:weeks] : [] %>
  <% camps_json = Array(trends[:camps]).map { |camp|
       {
         project_id: camp[:project_id],
         title: camp[:title],
         kind: camp[:kind],
         unit: camp[:unit],
         target: camp[:target],
         accent_hex: camp[:accent_hex],
         series: camp[:series]
       }
     } %>
  <%= tag.section class: "lp-journey-trends",
        aria: { label: t("progress.trends.title") },
        data: {
          controller: "journey-trends",
          journey_trends_battles_value: battles_json,
          journey_trends_camps_value: camps_json,
          journey_trends_timeframe_value: "daily"
        } do %>
    <header class="lp-journey-section__head">
      <h2><%= t("progress.trends.title") %></h2>
      <p><%= t("progress.trends.hint") %></p>
    </header>

    <% if trends[:camps].present? %>
      <%= render "life_points/journey_trends_camps", camps: trends[:camps] %>
    <% end %>

    <% if trends[:battles].present? %>
      <%= render "life_points/journey_trends_battles", battles: trends[:battles] %>
    <% end %>

    <% if trends[:habits].present? && habits_enabled? %>
      <%= render "life_points/journey_trends_habits", habits: trends[:habits] %>
    <% end %>
  <% end %>
<% end %>
