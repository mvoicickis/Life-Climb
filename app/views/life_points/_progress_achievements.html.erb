<%# locals: achievements %>
<section class="lp-progress-card lp-progress-achievements" aria-label="<%= t('progress.achievements_title') %>">
  <header class="lp-progress-card__head">
    <h2><%= t("progress.achievements_title") %></h2>
    <p><%= t("progress.achievements_hint") %></p>
  </header>

  <% if achievements.any? %>
    <ul class="lp-progress-badges">
      <% achievements.each do |badge| %>
        <li>
          <button type="button"
                  class="lp-progress-badge <%= badge[:unlocked] ? 'is-glow' : 'is-locked' %>"
                  data-action="progress-achievements#open"
                  data-icon="<%= badge[:icon] %>"
                  data-title="<%= badge[:title] %>"
                  data-hint="<%= badge[:hint] %>"
                  aria-label="<%= badge[:title] %>: <%= badge[:unlocked] ? t('progress.achievements_earned') : t('progress.achievements_locked') %>">
            <span class="lp-progress-badge__hex" aria-hidden="true"><%= badge[:icon] %></span>
            <% if badge[:unlocked] %>
              <span class="lp-progress-badge__check" aria-hidden="true">✓</span>
            <% end %>
            <span class="lp-progress-badge__title"><%= badge[:title] %></span>
          </button>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="lp-progress-empty"><%= t("progress.achievements_empty") %></p>
  <% end %>

  <dialog class="lp-progress-dialog" data-progress-achievements-target="dialog">
    <div class="lp-progress-dialog__inner">
      <p class="lp-progress-dialog__icon" data-progress-achievements-target="icon" aria-hidden="true"></p>
      <h3 data-progress-achievements-target="title"></h3>
      <p data-progress-achievements-target="hint"></p>
      <button type="button" class="lp-dash-cta" data-action="progress-achievements#close"><%= t("progress.close") %></button>
    </div>
  </dialog>
</section>
