<%# locals: journey, strategy_goal, closer, action_points, strategy_points, summary %>
<% goal_title = strategy_goal&.title.presence || journey&.title || t("progress.lock_goal") %>
<% strategy_href = journey || current_user&.primary_focused_journey || current_user&.life_journeys&.active&.order(:id)&.first %>
<section class="stats-hero" aria-label="<%= t('progress.goal_label') %>">
  <p class="stats-hero__goal-label"><%= t("progress.goal_label") %></p>
  <p class="stats-hero__goal" title="<%= goal_title %>"><%= goal_title %></p>
  <div class="stats-hero__row">
    <p class="stats-hero__pct"><%= closer %>%</p>
    <p class="stats-hero__meta">
      <%= t("progress.hero_points",
            ap: number_with_delimiter(action_points),
            pp: number_with_delimiter(strategy_points)) %>
    </p>
  </div>
  <div class="lp-dash-bar stats-hero__bar"
       role="progressbar"
       aria-valuemin="0"
       aria-valuemax="100"
       aria-valuenow="<%= closer %>"
       aria-label="<%= t('progress.goal_label') %>">
    <div class="lp-dash-bar__fill" style="width: <%= closer %>%"></div>
  </div>
  <div class="stats-hero__foot">
    <% if summary&.dig(:present) %>
      <span><%= t("progress.hero_plans") %> <strong><%= summary[:plans_done] %>/<%= summary[:plans_total] %></strong></span>
      <span><%= t("progress.hero_camps") %> <strong><%= summary[:projects_done] %>/<%= summary[:projects_total] %></strong></span>
      <% if summary[:current_expedition].present? %>
        <span><%= t("progress.hero_now") %> <strong><%= summary[:current_expedition] %></strong></span>
      <% end %>
    <% end %>
    <% if strategy_href %>
      <%= link_to t("progress.hero_mountain"), life_journey_path(strategy_href), class: "stats-hero__link" %>
    <% else %>
      <%= link_to t("progress.hero_mountain"), new_life_journey_path, class: "stats-hero__link" %>
    <% end %>
  </div>
</section>
