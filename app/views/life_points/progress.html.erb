<% content_for :title, t("progress.title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>

<%= tag.div class: "lp-progress is-calm",
      data: {
        controller: "progress-charts progress-achievements",
        progress_charts_growth_value: @progress[:growth],
        progress_charts_categories_value: @progress[:categories]
      } do %>

  <header class="lp-progress__top">
    <div>
      <p class="lp-brand-kicker">
        <%= render "shared/lp_brand_mark", size: 22, class_name: "lp-brand-kicker__mark" %>
        <span><%= t("app_name") %></span>
      </p>
      <h1 class="lp-progress__title"><%= t("progress.title") %></h1>
      <p class="lp-progress__subtitle"><%= t("progress.subtitle") %></p>
    </div>
  </header>

  <%= render "life_points/journey_mountain",
        journey: @journey,
        strategy_goal: @strategy_goal,
        mountain: @mountain,
        closer: @closer %>

  <%= render "life_points/journey_points",
        action_points: @action_points,
        strategy_points: @strategy_points %>

  <%= render "life_points/journey_summary",
        summary: @mountain_summary,
        journey: @journey %>

  <%= render "life_points/journey_trends", trends: @journey_trends %>

  <div class="lp-progress__grid">
    <%= render "life_points/progress_achievements", achievements: @progress[:achievements] %>
  </div>

  <details class="lp-journey-details">
    <summary class="lp-journey-details__summary">
      <span class="lp-journey-details__title"><%= t("progress.details_summary") %></span>
      <span class="lp-journey-details__hint"><%= t("progress.details_hint") %></span>
    </summary>

    <section class="lp-journey-activity" aria-label="<%= t('progress.activity_title') %>">
      <header class="lp-journey-section__head">
        <h2><%= t("progress.activity_title") %></h2>
        <p><%= t("progress.activity_hint") %></p>
      </header>

      <%= render "life_points/progress_filters", progress: @progress %>
      <%= render "life_points/progress_kpis", kpis: @progress[:kpis] %>

      <div class="lp-progress__grid lp-progress__grid--charts">
        <%= render "life_points/progress_growth" %>
        <%= render "life_points/progress_categories", categories: @progress[:categories] %>
      </div>

      <%= render "life_points/progress_heatmap", heatmap: @progress[:heatmap] %>
    </section>

    <div class="lp-progress__grid">
      <%= render "life_points/progress_insights", insights: @progress[:insights] %>
    </div>
  </details>
<% end %>

<%= render "shared/lp_dash_nav", active: :journey %>
