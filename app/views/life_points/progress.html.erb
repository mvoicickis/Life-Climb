<% content_for :title, t("progress.title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>

<div class="lp-progress lp-stats is-calm">
  <%= render "life_points/stats_simple_hero",
        journey: @journey,
        strategy_goal: @strategy_goal,
        closer: @closer,
        battle_wins: @battle_wins,
        summary: @mountain_summary,
        mountain_progress: @mountain_progress %>

  <%= render "life_points/stats_this_week",
        week: @stats_week,
        best_weekday: @stats_best_weekday %>

  <%= render "life_points/stats_camps", camps: @stats_camps, journey: @journey %>

  <%= render "life_points/stats_milestones", milestones: @stats_milestones %>

  <%= render "life_points/stats_calendar",
        battle_wins: @battle_wins,
        calendar: @stats_calendar,
        calendar_month: @stats_calendar_month,
        journey: @journey %>
</div>

<%= render "shared/lp_dash_nav", active: :journey %>
