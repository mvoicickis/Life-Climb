<% content_for :title, t("strategy.companion_guide.shell.title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>

<div class="lp-home mx-auto max-w-lg space-y-5 px-4 pb-24 pt-5">
  <header class="space-y-3">
    <p class="lp-brand-kicker">
      <%= render "shared/lp_brand_mark", size: 22, class_name: "lp-brand-kicker__mark" %>
      <span><%= t("strategy.companion_guide.shell.kicker") %></span>
    </p>
    <div class="flex items-center gap-3">
      <% face = companion_image_tag(class: "h-14 w-14 rounded-full object-cover") %>
      <% if face %>
        <div class="shrink-0" aria-hidden="true"><%= face %></div>
      <% end %>
      <div class="min-w-0">
        <h1 class="text-2xl font-semibold text-[var(--lp-ink)]"><%= t("strategy.companion_guide.shell.title") %></h1>
        <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= @journey.title %></p>
      </div>
    </div>
  </header>

  <% if flash[:companion_ack].present? %>
    <p class="lp-glass rounded-xl px-4 py-3 text-sm font-semibold text-[var(--lp-ink)]"
       role="status"
       data-companion-guide-ack>
      <%= flash[:companion_ack] %>
    </p>
  <% end %>

  <% if @step.completed? %>
    <section class="lp-glass space-y-4 p-5" aria-labelledby="companion-guide-done">
      <h2 id="companion-guide-done" class="text-2xl font-semibold text-[var(--lp-ink)]">
        <%= t("strategy.companion_guide.shell.done_title") %>
      </h2>
      <p class="text-sm text-[var(--lp-muted)]"><%= t("strategy.companion_guide.shell.done_body") %></p>
      <%= link_to t("strategy.companion_guide.shell.done_cta"),
            life_journey_path(@journey),
            class: "lp-cta inline-flex w-full items-center justify-center" %>
    </section>
  <% else %>
    <%= render "step", step: @step %>
  <% end %>
</div>

<%= render "shared/lp_dash_nav", active: :you %>
