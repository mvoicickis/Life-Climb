<%# locals: user:, size: (optional :sm or :lg) %>
<%
  user = local_assigns.fetch(:user)
  size = local_assigns[:size]
  size_class =
    case size
    when :sm then " is-sm"
    when :lg then " is-lg"
    else ""
    end
  image = user.avatar_image
  initial = user.name.to_s.strip.first&.upcase.presence || "?"
%>
<% if image.present? %>
  <%= image_tag image,
        class: "lp-avatar-circle#{size_class}",
        alt: "",
        decoding: "async" %>
<% else %>
  <span class="lp-avatar-circle lp-avatar-circle--initial lp-you__avatar-initial<%= size_class %>" aria-hidden="true"><%= initial %></span>
<% end %>
