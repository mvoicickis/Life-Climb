<%= javascript_tag(nonce: true) do %>
(function () {
  var STORAGE_KEY = "lpAppWelcomeShown";
  var PAPER_THEME = "<%= theme_color_for_request %>";
  var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var DURATION_MS = reduced ? 200 : 2000;
  var EXIT_MS = reduced ? 200 : 300;

  function restoreThemeColors() {
    document.querySelectorAll('meta[name="theme-color"]').forEach(function (meta) {
      var restore = meta.getAttribute("data-lp-theme-restore");
      if (restore != null) meta.setAttribute("content", restore);
      meta.removeAttribute("data-lp-theme-restore");
    });
  }

  function finishDismiss() {
    var root = document.documentElement;
    root.classList.remove("lp-app-welcome-pending", "lp-app-welcome-skip-exit");
    restoreThemeColors();
    var overlay = document.getElementById("lp-app-welcome");
    if (overlay) overlay.setAttribute("hidden", "");
  }

  function dismiss() {
    if (window.__lpAppWelcomeTimer) {
      clearTimeout(window.__lpAppWelcomeTimer);
      window.__lpAppWelcomeTimer = null;
    }
    finishDismiss();
  }

  function skipWithExit() {
    if (window.__lpAppWelcomeTimer) {
      clearTimeout(window.__lpAppWelcomeTimer);
      window.__lpAppWelcomeTimer = null;
    }
    var root = document.documentElement;
    if (!root.classList.contains("lp-app-welcome-pending")) {
      finishDismiss();
      return;
    }
    root.classList.add("lp-app-welcome-skip-exit");
    window.__lpAppWelcomeTimer = window.setTimeout(finishDismiss, EXIT_MS);
  }

  window.__lpDismissAppWelcome = dismiss;
  window.__lpSkipAppWelcome = skipWithExit;

  window.__lpStartAppWelcomeTimer = function () {
    if (!document.documentElement.classList.contains("lp-app-welcome-pending")) return;
    if (window.__lpAppWelcomeTimer) return;
    window.__lpAppWelcomeTimer = window.setTimeout(dismiss, DURATION_MS);
  };

  function arm() {
    try {
      if (!window.matchMedia("(display-mode: standalone)").matches) return;
      if (sessionStorage.getItem(STORAGE_KEY)) return;
      var nav = window.performance && window.performance.getEntriesByType
        ? window.performance.getEntriesByType("navigation")[0]
        : null;
      if (nav && nav.type !== "navigate") return;

      sessionStorage.setItem(STORAGE_KEY, "1");
      document.documentElement.classList.add("lp-app-welcome-pending");

      document.querySelectorAll('meta[name="theme-color"]').forEach(function (meta) {
        if (!meta.hasAttribute("data-lp-theme-restore")) {
          meta.setAttribute("data-lp-theme-restore", meta.getAttribute("content") || PAPER_THEME);
        }
        meta.setAttribute("content", PAPER_THEME);
      });
    } catch (_error) {
      /* private mode / unsupported */
    }
  }

  window.addEventListener("pageshow", function (event) {
    if (event.persisted) dismiss();
  });

  arm();
})();
<% end %>
