<%# Companion radio grid — posts user[character].
    Locals:
      selected: (optional) one of User::CHARACTERS
      labelledby: (optional) id of heading that labels the radiogroup %>
<% selected = local_assigns.fetch(:selected, nil)
   selected = selected.presence_in(User::CHARACTERS)
   labelledby = local_assigns.fetch(:labelledby, "character-pick-title") %>

<div class="lp-character-grid mx-auto mt-4 grid max-w-lg grid-cols-2 gap-3 sm:grid-cols-3"
     role="radiogroup"
     aria-labelledby="<%= labelledby %>">
  <% User::CHARACTERS.each do |key| %>
    <label class="lp-character-pick lp-glass cursor-pointer p-3 transition">
      <input type="radio"
             name="user[character]"
             value="<%= key %>"
             class="sr-only"
             required
             <%= "checked" if selected == key %>>
      <%= image_tag "characters/#{key}.png",
            alt: t("game_ui.character.#{key}"),
            class: "lp-avatar-ring aspect-square w-full rounded-2xl object-cover" %>
      <p class="mt-3 text-center text-sm font-bold text-[var(--lp-ink)]"><%= t("game_ui.character.#{key}") %></p>
    </label>
  <% end %>
</div>
