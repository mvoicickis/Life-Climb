<style nonce="<%= content_security_policy_nonce %>">
  :root {
    --lp-paper: #f8fafc;
    --lp-ink: #0f172a;
    --lp-font-ui: "Nunito", system-ui, sans-serif;
    --lp-app-welcome-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --lp-app-welcome-icon: 200px;
    --lp-app-welcome-rise: -1.35rem;
    --lp-app-welcome-duration: 2s;
  }

  #lp-app-welcome {
    position: fixed;
    inset: 0;
    z-index: 10000;
    margin: 0;
    padding: 0;
    border: none;
    background: var(--lp-paper);
    display: grid;
    place-items: center;
    cursor: pointer;
    pointer-events: none;
    opacity: 1;
  }

  html.lp-app-welcome-pending #lp-app-welcome {
    display: grid !important;
    pointer-events: auto;
    animation: lp-app-welcome-overlay var(--lp-app-welcome-duration) var(--lp-app-welcome-ease) forwards;
  }

  .lp-app-welcome__stage {
    position: relative;
    width: var(--lp-app-welcome-icon);
    height: var(--lp-app-welcome-icon);
  }

  .lp-app-welcome__icon {
    width: var(--lp-app-welcome-icon);
    height: var(--lp-app-welcome-icon);
    transform: translateY(0) scale(1);
    opacity: 1;
    animation: lp-app-welcome-icon var(--lp-app-welcome-duration) var(--lp-app-welcome-ease) forwards;
  }

  .lp-app-welcome__icon img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .lp-app-welcome__headline {
    position: absolute;
    left: 50%;
    top: calc(100% + 1.15rem);
    margin: 0;
    width: max-content;
    max-width: calc(100vw - 2.5rem);
    text-align: center;
    font-family: var(--lp-font-ui);
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--lp-ink);
    transform: translateX(-50%) translateY(10px);
    opacity: 0;
    pointer-events: none;
    animation: lp-app-welcome-headline var(--lp-app-welcome-duration) var(--lp-app-welcome-ease) forwards;
  }

  @keyframes lp-app-welcome-overlay {
    0%,
    75% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      pointer-events: none;
    }
  }

  @keyframes lp-app-welcome-icon {
    0%,
    12.5% {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
    54.17% {
      transform: translateY(var(--lp-app-welcome-rise)) scale(0.88);
      opacity: 1;
    }
    75% {
      transform: translateY(var(--lp-app-welcome-rise)) scale(0.88);
      opacity: 1;
    }
    100% {
      transform: translateY(var(--lp-app-welcome-rise)) scale(1.04);
      opacity: 1;
    }
  }

  @keyframes lp-app-welcome-headline {
    0%,
    30% {
      transform: translateX(-50%) translateY(10px);
      opacity: 0;
    }
    40% {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }
    85% {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }
    100% {
      transform: translateX(-50%) translateY(0);
      opacity: 0;
    }
  }
</style>
