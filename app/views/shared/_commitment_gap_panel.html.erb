<%# locals: next_action, commitment, open_reveal (optional), planned_battles (optional), gap_notice (optional) %>
<% setup = next_action.setup_gap
   setup_mode = next_action.key.to_s == "setup_gap" && setup.present?
   elig = next_action.eligibility
   journey = current_user.primary_focused_journey
   habit_have = setup_mode ? setup.habit_have.to_i : elig&.habit_have.to_i
   habit_need = setup_mode ? setup.habit_need.to_i : elig&.habit_need.to_i
   battle_done = commitment&.battle_done.to_i
   battle_need = if setup_mode
                   setup.battle_need.to_i
                 else
                   commitment&.battle_required.to_i
                 end
   battle_have = setup_mode ? setup.battle_have.to_i : battle_done
   open = local_assigns[:open_reveal].to_s
   if setup_mode && open.blank?
     open = { habits: "habit", battles: "battle", set_time: "time" }[setup.kind.to_sym].to_s
   end
   planned = Array(local_assigns[:planned_battles])
   planned = current_user.daily_todos.for_day(Date.current).incomplete.ordered.to_a if planned.empty?
   gap_notice = local_assigns[:gap_notice].presence || @gap_notice
   default_end = (Time.current + 1.hour).strftime("%H:%M")
   panel_key = next_action.key.to_s
   aria = if setup_mode
            next_action.title
          else
            t("strategy.next_action.commitment_gap.title")
          end
   show_drop_easy = !setup_mode || journey&.commitment_key.to_s != "easy"
%>
<aside id="commitment-gap-panel"
       class="lp-glass lp-glass--pad lp-dash-next is-stuck lp-commitment-gap"
       data-controller="commitment-gap"
       data-commitment-gap-open-value="<%= open %>"
       data-next-action-key="<%= panel_key %>"
       data-next-action-tone="stuck"
       aria-label="<%= aria %>">
  <% if setup_mode %>
    <div class="lp-commitment-gap__setup">
      <p class="lp-dash-next__title"><%= next_action.title %></p>
      <% case setup.kind.to_sym %>
      <% when :habits %>
        <p class="lp-commitment-gap__body">
          <%= t("strategy.next_action.setup_gap.habits_body", need: habit_need, have: habit_have) %>
        </p>
        <div class="lp-commitment-gap__pillar">
          <div class="lp-commitment-gap__row">
            <div class="lp-commitment-gap__chip" data-habits-chip="true">
              <%= render "shared/lp_icon", name: "fire", class_name: "lp-icon is-inline" %>
              <span class="lp-commitment-gap__label"><%= t("strategy.next_action.commitment_gap.habits") %></span>
              <span class="lp-commitment-gap__count" data-habits-count="true"><%= habit_have %>/<%= habit_need %></span>
            </div>
          </div>
          <div class="lp-commitment-gap__reveal" data-commitment-gap-target="habitReveal">
            <%= form_with url: habits_path,
                  method: :post,
                  class: "lp-commitment-gap__form is-habit-stack",
                  data: { turbo: true } do %>
              <input type="hidden" name="source" value="commitment_gap">
              <input type="hidden" name="open_reveal" value="habit">
              <div class="lp-commitment-gap__form is-habit">
                <%= text_field_tag "habit[name]", nil,
                      placeholder: t("strategy.next_action.commitment_gap.habit_placeholder"),
                      class: "lp-input",
                      autocomplete: "off",
                      required: true,
                      maxlength: 80 %>
                <%= submit_tag t("strategy.next_action.commitment_gap.add"),
                      class: "lp-habits__btn is-primary" %>
              </div>
              <label class="lp-commitment-gap__qty-toggle">
                <input type="hidden" name="habit[quantity_checkin]" value="0">
                <input type="checkbox"
                       name="habit[quantity_checkin]"
                       value="1"
                       class="lp-commitment-gap__qty-check"
                       data-commitment-gap-quantity
                       data-action="change->commitment-gap#toggleQuantity">
                <span>
                  <span class="lp-commitment-gap__qty-title"><%= t("habits.quantity_checkin") %></span>
                  <span class="lp-commitment-gap__hint"><%= t("habits.quantity_checkin_hint") %></span>
                </span>
              </label>
              <div class="lp-commitment-gap__unit"
                   data-commitment-gap-target="quantityUnit"
                   hidden>
                <%= text_field_tag "habit[unit]", nil,
                      list: "gap-count-ideas",
                      placeholder: t("habits.unit_placeholder"),
                      class: "lp-input w-full",
                      autocomplete: "off" %>
                <datalist id="gap-count-ideas">
                  <% Habit::UNIT_IDEAS.each do |idea| %>
                    <option value="<%= idea %>"></option>
                  <% end %>
                </datalist>
              </div>
            <% end %>
            <% if gap_notice.present? %>
              <p class="lp-commitment-gap__notice" role="status"><%= gap_notice %></p>
            <% end %>
          </div>
        </div>
      <% when :battles %>
        <p class="lp-commitment-gap__body">
          <%= t("strategy.next_action.setup_gap.battles_body",
                count: battle_need,
                have: battle_have) %>
        </p>
        <div class="lp-commitment-gap__pillar">
          <div class="lp-commitment-gap__row">
            <div class="lp-commitment-gap__chip" data-battles-chip="true">
              <%= render "shared/lp_icon", name: "sword", class_name: "lp-icon is-inline" %>
              <span class="lp-commitment-gap__label"><%= t("strategy.next_action.commitment_gap.battles") %></span>
              <span class="lp-commitment-gap__count" data-battles-count="true"><%= battle_have %>/<%= battle_need %></span>
            </div>
          </div>
          <div class="lp-commitment-gap__reveal" data-commitment-gap-target="battleReveal">
            <%= form_with url: dashboard_quick_battles_path,
                  method: :post,
                  class: "lp-commitment-gap__form",
                  data: { turbo: true } do %>
              <input type="hidden" name="open_reveal" value="battle">
              <%= render layout: "shared/title_limit_wrap" do %>
                <%= text_field_tag :title, nil,
                      placeholder: t("strategy.next_action.commitment_gap.battle_placeholder"),
                      class: "lp-input w-full",
                      autocomplete: "off",
                      required: true,
                      maxlength: StrategyGoal::TITLE_MAX %>
              <% end %>
              <div class="lp-commitment-gap__time-row">
                <span class="lp-commitment-gap__hint"><%= t("strategy.next_action.commitment_gap.starts_now_ends") %></span>
                <%= time_field_tag :end_time, default_end, required: true, class: "lp-input" %>
                <%= submit_tag t("strategy.next_action.commitment_gap.plan_it"),
                      class: "lp-habits__btn is-primary" %>
              </div>
            <% end %>
          </div>
        </div>
      <% when :set_time %>
        <% todo = setup.todo %>
        <p class="lp-commitment-gap__body">
          <%= t("strategy.next_action.setup_gap.set_time_body", title: todo.title) %>
        </p>
        <p class="lp-commitment-gap__hint"><%= t("strategy.next_action.setup_gap.set_time_hint") %></p>
        <%= form_with model: todo,
              url: daily_todo_path(todo),
              method: :patch,
              class: "lp-commitment-gap__form lp-dash-tcard__set-time-form",
              data: { turbo: false } do |form| %>
          <label>
            <span><%= t("dash.timeline.start_time") %></span>
            <%= form.time_field :start_time,
                  value: (todo.start_time || Time.current).strftime("%H:%M"),
                  required: true,
                  class: "lp-dash-tcard__time-input" %>
          </label>
          <label>
            <span><%= t("dash.timeline.end_time") %></span>
            <%= form.time_field :end_time, required: true, class: "lp-dash-tcard__time-input" %>
          </label>
          <div class="lp-commitment-gap__time-row">
            <%= form.submit t("strategy.next_action.setup_gap.set_time_cta"),
                  class: "lp-habits__btn is-primary" %>
          </div>
        <% end %>
      <% end %>
      <% if commitment.present? %>
        <p class="lp-dash-next__progress" data-commitment-progress="true">
          <% if commitment.met? %>
            <%= t("dash.commitment.survived") %>
          <% elsif habits_enabled? %>
            <%= t("dash.commitment.progress",
                  battles_done: commitment.battle_done,
                  battles_total: commitment.battle_required,
                  habits_done: commitment.habit_done,
                  habits_total: commitment.habit_required) %>
          <% else %>
            <%= t("dash.commitment.progress_battles_only",
                  battles_done: commitment.battle_done,
                  battles_total: commitment.battle_required) %>
          <% end %>
        </p>
      <% end %>
    </div>
  <% else %>
    <div class="lp-commitment-gap__pillars">
      <div class="lp-commitment-gap__pillar">
        <div class="lp-commitment-gap__row">
          <div class="lp-commitment-gap__chip" data-battles-chip="true">
            <%= render "shared/lp_icon", name: "sword", class_name: "lp-icon is-inline" %>
            <span class="lp-commitment-gap__label"><%= t("strategy.next_action.commitment_gap.battles") %></span>
            <span class="lp-commitment-gap__count" data-battles-count="true"><%= battle_done %>/<%= battle_need %></span>
          </div>
          <button type="button"
                  class="lp-commitment-gap__plus<%= ' is-open' if open == 'battle' %>"
                  data-commitment-gap-target="battlePlus"
                  data-action="commitment-gap#toggleBattle"
                  data-add-label="<%= t("strategy.next_action.commitment_gap.add_battle") %>"
                  data-close-label="<%= t("strategy.next_action.commitment_gap.close_reveal") %>"
                  aria-expanded="<%= open == 'battle' %>"
                  aria-label="<%= open == 'battle' ? t("strategy.next_action.commitment_gap.close_reveal") : t("strategy.next_action.commitment_gap.add_battle") %>">
            <%= open == "battle" ? "×" : "+" %>
          </button>
        </div>
        <div class="lp-commitment-gap__reveal"
             data-commitment-gap-target="battleReveal"
             <%= "hidden" unless open == "battle" %>>
          <%= form_with url: dashboard_quick_battles_path,
                method: :post,
                class: "lp-commitment-gap__form",
                data: { turbo: true } do %>
            <input type="hidden" name="open_reveal" value="battle">
            <%= render layout: "shared/title_limit_wrap" do %>
              <%= text_field_tag :title, nil,
                    placeholder: t("strategy.next_action.commitment_gap.battle_placeholder"),
                    class: "lp-input w-full",
                    autocomplete: "off",
                    required: true,
                    maxlength: StrategyGoal::TITLE_MAX %>
            <% end %>
            <div class="lp-commitment-gap__time-row">
              <span class="lp-commitment-gap__hint"><%= t("strategy.next_action.commitment_gap.starts_now_ends") %></span>
              <%= time_field_tag :end_time, default_end, required: true, class: "lp-input" %>
              <%= submit_tag t("strategy.next_action.commitment_gap.plan_it"),
                    class: "lp-habits__btn is-primary" %>
            </div>
          <% end %>
          <% if planned.any? %>
            <ul class="lp-commitment-gap__planned">
              <% planned.each do |todo| %>
                <li>
                  <%= render "shared/lp_icon", name: "sword", class_name: "lp-icon is-inline" %>
                  <span><%= todo.title %> — <%= t("strategy.next_action.commitment_gap.planned_not_won") %></span>
                  <%= button_to t("dash.timeline.remove"),
                        daily_todo_path(todo),
                        method: :delete,
                        class: "lp-commitment-gap__link",
                        form: { data: { turbo_confirm: t("dash.timeline.remove_confirm") } } %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
      </div>

      <div class="lp-commitment-gap__pillar">
        <div class="lp-commitment-gap__row">
          <div class="lp-commitment-gap__chip" data-habits-chip="true">
            <%= render "shared/lp_icon", name: "fire", class_name: "lp-icon is-inline" %>
            <span class="lp-commitment-gap__label"><%= t("strategy.next_action.commitment_gap.habits") %></span>
            <span class="lp-commitment-gap__count" data-habits-count="true"><%= habit_have %>/<%= habit_need %></span>
          </div>
          <button type="button"
                  class="lp-commitment-gap__plus<%= ' is-open' if open == 'habit' %>"
                  data-commitment-gap-target="habitPlus"
                  data-action="commitment-gap#toggleHabit"
                  data-add-label="<%= t("strategy.next_action.commitment_gap.add_habit") %>"
                  data-close-label="<%= t("strategy.next_action.commitment_gap.close_reveal") %>"
                  aria-expanded="<%= open == 'habit' %>"
                  aria-label="<%= open == 'habit' ? t("strategy.next_action.commitment_gap.close_reveal") : t("strategy.next_action.commitment_gap.add_habit") %>">
            <%= open == "habit" ? "×" : "+" %>
          </button>
        </div>
        <div class="lp-commitment-gap__reveal"
             data-commitment-gap-target="habitReveal"
             <%= "hidden" unless open == "habit" %>>
          <%= form_with url: habits_path,
                method: :post,
                class: "lp-commitment-gap__form is-habit-stack",
                data: { turbo: true } do %>
            <input type="hidden" name="source" value="commitment_gap">
            <input type="hidden" name="open_reveal" value="habit">
            <div class="lp-commitment-gap__form is-habit">
              <%= text_field_tag "habit[name]", nil,
                    placeholder: t("strategy.next_action.commitment_gap.habit_placeholder"),
                    class: "lp-input",
                    autocomplete: "off",
                    required: true,
                    maxlength: 80 %>
              <%= submit_tag t("strategy.next_action.commitment_gap.add"),
                    class: "lp-habits__btn is-primary" %>
            </div>
            <label class="lp-commitment-gap__qty-toggle">
              <input type="hidden" name="habit[quantity_checkin]" value="0">
              <input type="checkbox"
                     name="habit[quantity_checkin]"
                     value="1"
                     class="lp-commitment-gap__qty-check"
                     data-commitment-gap-quantity
                     data-action="change->commitment-gap#toggleQuantity">
              <span>
                <span class="lp-commitment-gap__qty-title"><%= t("habits.quantity_checkin") %></span>
                <span class="lp-commitment-gap__hint"><%= t("habits.quantity_checkin_hint") %></span>
              </span>
            </label>
            <div class="lp-commitment-gap__unit"
                 data-commitment-gap-target="quantityUnit"
                 hidden>
              <%= text_field_tag "habit[unit]", nil,
                    list: "gap-count-ideas",
                    placeholder: t("habits.unit_placeholder"),
                    class: "lp-input w-full",
                    autocomplete: "off" %>
              <datalist id="gap-count-ideas">
                <% Habit::UNIT_IDEAS.each do |idea| %>
                  <option value="<%= idea %>"></option>
                <% end %>
              </datalist>
            </div>
          <% end %>
          <% if gap_notice.present? %>
            <p class="lp-commitment-gap__notice" role="status"><%= gap_notice %></p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% if show_drop_easy || (!setup_mode && elig&.missing_camps && journey.present?) %>
    <div class="lp-commitment-gap__footer">
      <% if show_drop_easy %>
        <%= button_to t("strategy.next_action.commitment_gap.drop_easy"),
              commitment_settings_path,
              method: :patch,
              params: { commitment_key: "easy", return_to: "today" },
              class: "lp-commitment-gap__link",
              form: { class: "lp-commitment-gap__drop", data: { turbo: false } } %>
      <% end %>
      <% if !setup_mode && elig&.missing_camps && journey.present? %>
        <%= link_to t("strategy.next_action.commitment_gap.need_room"),
              life_journey_path(journey),
              class: "lp-commitment-gap__link" %>
      <% end %>
    </div>
  <% end %>
</aside>
