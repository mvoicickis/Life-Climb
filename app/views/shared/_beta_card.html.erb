<%# locals: (source_path:, signup: nil, hero: false) %>
<% return unless beta_card_visible? %>

<% signup ||= BetaSignup.new %>
<% email_value = signup.email %>
<% hero = local_assigns.fetch(:hero, false) %>

<section id="beta-signup-card"
         class="lp-beta-card<%= " lp-beta-card--hero" if hero %>"
         data-controller="beta-card">
  <div class="lp-beta-card__inner">
    <div class="lp-beta-card__default" data-beta-card-target="defaultPanel">
      <%= link_to t("beta_card.start_climbing"), new_registration_path, class: "lp-beta-card__cta" %>
    </div>

    <div class="lp-beta-card__android" data-beta-card-target="androidPanel">
      <span class="lp-beta-card__chip"><%= t("beta_card.chip") %></span>
      <h2 class="lp-beta-card__title"><%= t("beta_card.android_heading") %></h2>
      <p class="lp-beta-card__lead"><%= t("beta_card.android_lead") %></p>

      <%= form_with url: beta_signups_path, scope: :beta_signup, method: :post, class: "lp-beta-card__form" do |f| %>
        <%= f.hidden_field :source_path, value: source_path %>
        <div class="lp-beta-card__honeypot" aria-hidden="true">
          <%= f.text_field :company, tabindex: "-1", autocomplete: "off" %>
        </div>

        <div class="lp-beta-card__field">
          <label class="lp-beta-card__label" for="beta_signup_email"><%= t("beta_card.email_label") %></label>
          <%= f.email_field :email,
                id: "beta_signup_email",
                value: email_value,
                required: true,
                autocomplete: "email",
                inputmode: "email",
                class: "lp-beta-card__input #{"is-invalid" if signup.errors[:email].any?}",
                placeholder: t("beta_card.email_placeholder") %>
          <% if signup.errors[:email].any? %>
            <p class="lp-beta-card__error" role="alert"><%= signup.errors.full_messages_for(:email).first %></p>
          <% end %>
        </div>

        <%= f.submit t("beta_card.join"), class: "lp-beta-card__cta" %>
      <% end %>

      <p class="lp-beta-card__fine"><%= t("beta_card.no_spam") %></p>
    </div>
  </div>
</section>

<% if hero %>
  <%= link_to t("beta_card.browser_link"), new_registration_path, class: "lp-beta-browser-link" %>
<% end %>
