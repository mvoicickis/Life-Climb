<%# Soft one-time companion re-pick for blank / legacy man·woman users. %>
<% return unless current_user&.needs_companion_pick? %>
<% return if controller_name == "v2_onboardings" %>

<div class="lp-companion-pick lp-ob"
     id="companion-pick-prompt"
     role="dialog"
     aria-labelledby="companion-pick-prompt-title"
     aria-modal="true">
  <div class="lp-ob__mountain-bg" aria-hidden="true">
    <%= image_tag "mountain_trail_default.webp", class: "lp-ob__mountain-photo", alt: "", decoding: "async" %>
  </div>

  <div class="lp-ob__body">
    <section class="lp-ob__card lp-ob__card--goal lp-companion-pick__card"
             aria-labelledby="companion-pick-prompt-title">
      <h1 id="companion-pick-prompt-title" class="lp-ob__title"><%= t("companion.prompt_title") %></h1>

      <%= form_with model: current_user,
            url: companion_pick_path,
            method: :patch,
            data: {
              controller: "character-picker",
              character_picker_auto_submit_value: true
            },
            class: "lp-companion-pick__form" do %>
        <div class="lp-companion-pick__grid"
             role="radiogroup"
             aria-labelledby="companion-pick-prompt-title">
          <% User::PICKABLE_CHARACTERS.each do |key| %>
            <label class="lp-companion-pick__option">
              <input type="radio"
                     name="user[character]"
                     value="<%= key %>"
                     class="sr-only"
                     required
                     data-action="change->character-picker#submit">
              <%= image_tag "characters/#{key}.png",
                    alt: t("game_ui.character.#{key}"),
                    class: "lp-companion-pick__avatar" %>
              <span class="lp-companion-pick__label"><%= t("game_ui.character.#{key}") %></span>
            </label>
          <% end %>
        </div>
      <% end %>
    </section>
  </div>
</div>
