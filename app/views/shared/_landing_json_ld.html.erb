<%# JSON-LD for landing — Organization + SoftwareApplication %>
<script type="application/ld+json">
<%= raw({
  "@context" => "https://schema.org",
  "@graph" => [
    {
      "@type" => "Organization",
      "name" => "Life Climb",
      "url" => absolute_url("/"),
      "logo" => absolute_url("/branding/lifepoints-mark.png?v=7"),
      "slogan" => "Most goals die in your notes app."
    },
    {
      "@type" => "SoftwareApplication",
      "name" => "Life Climb",
      "applicationCategory" => "LifestyleApplication",
      "operatingSystem" => "Web",
      "url" => absolute_url("/"),
      "description" => page_meta_description,
      "offers" => {
        "@type" => "Offer",
        "price" => "0",
        "priceCurrency" => "USD"
      }
    }
  ]
}.to_json) %>
</script>
