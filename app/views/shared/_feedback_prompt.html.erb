<%# Testing-phase inline prompt. locals: page (required label), prompt (optional) %>
<%
  page = local_assigns.fetch(:page)
  prompt = local_assigns[:prompt].presence || t("feedback.prompt_title")
%>
<aside class="lp-feedback-prompt"
       data-controller="feedback-prompt"
       data-feedback-prompt-page-value="<%= page %>"
       aria-label="<%= prompt %>">
  <div class="lp-feedback-prompt__inner">
    <div class="lp-feedback-prompt__copy">
      <p class="lp-feedback-prompt__title"><%= prompt %></p>
      <p class="lp-feedback-prompt__sub"><%= t("feedback.prompt_sub") %></p>
    </div>
    <button type="button"
            class="lp-feedback-prompt__dismiss"
            data-action="feedback-prompt#dismiss"
            aria-label="<%= t("feedback.prompt_dismiss") %>">×</button>
  </div>

  <%= form_with url: feedbacks_path, scope: :feedback, class: "lp-feedback-prompt__form",
        data: { turbo: false, feedback_prompt_target: "form" } do |form| %>
    <%= form.hidden_field :page_context, value: page %>
    <div class="lp-feedback-prompt__ratings" role="group" aria-label="<%= t("feedback.rating_label") %>">
      <% Feedback::RATINGS.each do |score| %>
        <label class="lp-feedback-prompt__rating">
          <%= form.radio_button :rating, score, class: "lp-feedback-prompt__rating-input" %>
          <span><%= t("feedback.rating_faces.#{score}") %></span>
        </label>
      <% end %>
    </div>
    <%= form.text_area :body,
          rows: 2,
          required: true,
          maxlength: 2000,
          placeholder: t("feedback.prompt_placeholder"),
          class: "lp-feedback-prompt__input",
          data: { feedback_prompt_target: "body" } %>
    <%= form.submit t("feedback.prompt_send"), class: "lp-feedback-prompt__send" %>
  <% end %>
</aside>
