<%# Shared header for sign-in / register / password pages %>
<header class="auth-topbar">
  <%= link_to root_path, class: "auth-topbar-brand", aria: { label: t("app_name") } do %>
    <span class="auth-topbar-mark" aria-hidden="true">🌿</span>
    <span><%= t("app_name") %></span>
  <% end %>

  <div class="auth-topbar-actions">
    <%= render "shared/locale_switcher", variant: :auth %>
    <%= link_to t("landing.back_home"), root_path, class: "auth-back-btn" %>
  </div>
</header>
