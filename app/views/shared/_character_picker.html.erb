<%# Character / companion picker — posts user[character].
    Locals:
      selected: (optional) one of User::CHARACTERS
      submit_label: (optional) button text
      show_brand: (optional, default true)
      show_heading: (optional, default true)
      compact: (optional, default false) tighter grid for 360px
      auto_submit: (optional, default false) advance on tap, no Continue %>
<% selected = local_assigns.fetch(:selected, nil)
   selected = selected.presence_in(User::CHARACTERS)
   submit_label = local_assigns.fetch(:submit_label, t("game_ui.continue"))
   show_brand = local_assigns.fetch(:show_brand, true)
   show_heading = local_assigns.fetch(:show_heading, true)
   compact = local_assigns.fetch(:compact, false)
   auto_submit = local_assigns.fetch(:auto_submit, false)
   picker_class = compact ? "lp-character-picker--compact" : "" %>

<section class="lp-character-picker px-1 py-2<%= " #{picker_class}" if picker_class.present? %>"
         aria-labelledby="character-pick-title"
         <% if auto_submit %>
           data-controller="character-picker"
           data-character-picker-auto-submit-value="true"
         <% end %>>
  <% if show_brand %>
    <p class="text-center text-xs font-bold uppercase tracking-[0.2em] text-[var(--lp-lime)]/80"><%= t("app_name") %></p>
  <% end %>
  <% if show_heading %>
    <h2 id="character-pick-title" class="lp-character-picker__title mt-3 text-center text-2xl font-semibold text-[var(--lp-ink)]">
      <%= t("game_ui.choose_character") %>
    </h2>
    <p class="lp-character-picker__hint mt-2 text-center text-sm text-[var(--lp-muted)]"><%= t("game_ui.choose_character_hint") %></p>
  <% else %>
    <h2 id="character-pick-title" class="sr-only"><%= t("game_ui.choose_character") %></h2>
  <% end %>

  <div class="lp-character-picker__grid mx-auto mt-6 grid max-w-lg grid-cols-2 gap-3 sm:grid-cols-3"
       role="radiogroup"
       aria-labelledby="character-pick-title">
    <% User::PICKABLE_CHARACTERS.each do |key| %>
      <label class="lp-character-pick lp-glass cursor-pointer p-3 transition">
        <input type="radio"
               name="user[character]"
               value="<%= key %>"
               class="sr-only"
               required
               <%= "checked" if selected == key %>
               <% if auto_submit %>
                 data-action="change->character-picker#submit"
               <% end %>>
        <%= image_tag "characters/#{key}.png",
              alt: t("game_ui.character.#{key}"),
              class: "lp-avatar-ring aspect-square w-full rounded-full object-cover" %>
        <p class="lp-character-pick__label mt-3 text-center text-sm font-bold text-[var(--lp-ink)]"><%= t("game_ui.character.#{key}") %></p>
      </label>
    <% end %>
  </div>

  <% unless auto_submit %>
    <div class="mx-auto mt-6 max-w-md">
      <button type="submit" class="lp-cta w-full"><%= submit_label %></button>
    </div>
  <% end %>
</section>
