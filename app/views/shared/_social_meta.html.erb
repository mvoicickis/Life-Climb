<%# Social / SEO preview tags for link shares (iMessage, Slack, Discord, WhatsApp, etc.) %>
<meta name="description" content="<%= page_meta_description %>">
<meta name="theme-color" content="<%= theme_color_for_request %>">
<link rel="canonical" href="<%= absolute_url(request.path) %>">
<link rel="icon" href="/favicon.ico?v=7" sizes="any">

<meta property="og:site_name" content="Life Climb">
<meta property="og:type" content="website">
<meta property="og:locale" content="en_US">
<meta property="og:url" content="<%= absolute_url(request.path) %>">
<meta property="og:title" content="<%= page_meta_title %>">
<meta property="og:description" content="<%= social_meta_description %>">
<%# New filename (not query-string) so WhatsApp/Facebook re-fetch the image. %>
<meta property="og:image" content="<%= absolute_url(social_og_image_path) %>">
<meta property="og:image:secure_url" content="<%= absolute_url(social_og_image_path) %>">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Life Climb — <%= social_meta_description %>">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= page_meta_title %>">
<meta name="twitter:description" content="<%= social_meta_description %>">
<meta name="twitter:image" content="<%= absolute_url(social_og_image_path) %>">
<meta name="twitter:image:alt" content="Life Climb — <%= social_meta_description %>">
