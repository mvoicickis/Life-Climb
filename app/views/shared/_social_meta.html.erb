<%# Social / SEO preview tags for link shares (iMessage, Slack, Discord, WhatsApp, etc.) %>
<meta name="description" content="<%= page_meta_description %>">
<meta name="theme-color" content="<%= theme_color_for_request %>">
<link rel="canonical" href="<%= absolute_url(request.path) %>">
<link rel="icon" href="/favicon.ico?v=7" sizes="any">

<meta property="og:site_name" content="Life Climb">
<meta property="og:type" content="<%= social_share_type %>">
<meta property="og:locale" content="en_US">
<meta property="og:url" content="<%= absolute_url(request.path) %>">
<meta property="og:title" content="<%= social_share_title %>">
<meta property="og:description" content="<%= social_share_description %>">
<meta property="og:image" content="<%= social_share_image_url %>">
<meta property="og:image:secure_url" content="<%= social_share_image_url %>">
<meta property="og:image:type" content="<%= social_share_image_type %>">
<meta property="og:image:width" content="<%= social_share_image_width %>">
<meta property="og:image:height" content="<%= social_share_image_height %>">
<meta property="og:image:alt" content="<%= social_share_image_alt %>">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= social_share_title %>">
<meta name="twitter:description" content="<%= social_share_description %>">
<meta name="twitter:image" content="<%= social_share_image_url %>">
<meta name="twitter:image:alt" content="<%= social_share_image_alt %>">