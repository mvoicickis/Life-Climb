<%# Social / SEO preview tags for link shares (Facebook, LinkedIn, X, WhatsApp, Telegram, etc.) %>
<% og_image = social_og_image_url %>
<% og_locale = social_og_locale %>
<meta name="application-name" content="<%= t('app_name') %>">
<meta name="description" content="<%= social_description %>">
<meta name="theme-color" content="#059669">
<link rel="canonical" href="<%= absolute_url(request.path == '/' ? '/' : request.path) %>">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/icon.png">

<% I18n.available_locales.each do |locale| %>
  <link rel="alternate" hreflang="<%= locale %>" href="<%= locale_alternate_url(locale) %>">
<% end %>
<link rel="alternate" hreflang="x-default" href="<%= absolute_url('/') %>">

<meta property="og:site_name" content="<%= t('app_name') %>">
<meta property="og:type" content="website">
<meta property="og:locale" content="<%= og_locale %>">
<% I18n.available_locales.each do |locale| %>
  <% next if locale.to_sym == I18n.locale.to_sym %>
  <meta property="og:locale:alternate" content="<%= social_og_locale(locale) %>">
<% end %>
<meta property="og:url" content="<%= absolute_url(request.path == '/' ? "/?locale=#{I18n.locale}" : request.fullpath) %>">
<meta property="og:title" content="<%= social_title %>">
<meta property="og:description" content="<%= social_description %>">
<%# Locale-specific filename so Facebook/WhatsApp re-fetch when language changes. %>
<meta property="og:image" content="<%= og_image %>">
<meta property="og:image:secure_url" content="<%= og_image %>">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="<%= social_image_alt %>">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= social_title %>">
<meta name="twitter:description" content="<%= social_description %>">
<meta name="twitter:image" content="<%= og_image %>">
<meta name="twitter:image:alt" content="<%= social_image_alt %>">
