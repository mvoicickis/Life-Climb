<%#
  One question · one answer · one CTA.
  locals: form_url, scope, field, value, label, hint, placeholder, cta, hidden,
          input (:text|:textarea|:range), rows, required (default true),
          skip_url (optional), skip_label, min, max, range_suffix
%>
<%
  scope = local_assigns.fetch(:scope, "onboarding")
  field = local_assigns.fetch(:field)
  input = local_assigns.fetch(:input, :textarea)
  rows = local_assigns.fetch(:rows, 4)
  value = local_assigns[:value].to_s
  hidden = local_assigns.fetch(:hidden, {})
  required = local_assigns.fetch(:required, true)
  min = local_assigns.fetch(:min, 0)
  max = local_assigns.fetch(:max, 100)
%>

<header>
  <% if local_assigns[:eyebrow].present? %>
    <p class="text-sm text-[var(--lp-muted)]"><%= local_assigns[:eyebrow] %></p>
  <% end %>
  <h1 class="text-3xl font-semibold text-[var(--lp-ink)]"><%= label %></h1>
  <% if local_assigns[:hint].present? %>
    <p class="mt-2 text-sm text-[var(--lp-muted)]"><%= hint %></p>
  <% end %>
</header>

<%= form_with url: form_url, method: :patch, class: "space-y-4" do %>
  <% hidden.each do |name, val| %>
    <%= hidden_field_tag "#{scope}[#{name}]", val %>
  <% end %>

  <div class="lp-glass space-y-2 p-4">
    <% if input == :text %>
      <input type="text" name="<%= scope %>[<%= field %>]" value="<%= value %>"
        <%= "required" if required %>
        class="lp-input w-full" placeholder="<%= placeholder %>" autocomplete="off" />
    <% elsif input == :range %>
      <% range_value = value.presence || "5" %>
      <div class="flex items-center justify-between gap-3">
        <span class="text-sm text-[var(--lp-muted)]"><%= min %>%</span>
        <output id="<%= scope %>_<%= field %>_out" class="text-3xl font-semibold text-[var(--lp-ink)]"><%= range_value %>%</output>
        <span class="text-sm text-[var(--lp-muted)]"><%= max %>%</span>
      </div>
      <input type="range" name="<%= scope %>[<%= field %>]" min="<%= min %>" max="<%= max %>" step="1"
        value="<%= range_value %>" class="mt-3 w-full"
        oninput="document.getElementById('<%= scope %>_<%= field %>_out').textContent = this.value + '%'" />
    <% else %>
      <textarea name="<%= scope %>[<%= field %>]" rows="<%= rows %>" <%= "required" if required %>
        class="lp-input w-full" placeholder="<%= placeholder %>"><%= value %></textarea>
    <% end %>
  </div>

  <%= submit_tag cta, class: "lp-cta w-full" %>
<% end %>

<% if local_assigns[:skip_url].present? %>
  <%= button_to local_assigns.fetch(:skip_label, t("coach.skip")),
        skip_url,
        method: :patch,
        params: { skip: 1 },
        class: "mt-3 w-full text-center text-sm font-bold text-[var(--lp-muted)]" %>
<% end %>
