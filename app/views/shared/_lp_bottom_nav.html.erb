<%# LifePoints calm MVP bottom nav — Home · Life · + · Missions · Profile %>
<% active = local_assigns.fetch(:active, :home).to_s %>

<nav class="lp-bottom-nav" aria-label="Primary">
  <%= link_to dashboard_path, class: "lp-bottom-nav__link #{'is-active' if active.in?(%w[home dashboard])}" do %>
    <span class="lp-bottom-nav__icon" aria-hidden="true">🏠</span>
    <span><%= t("game_ui.nav.home") %></span>
  <% end %>

  <%= link_to life_map_path, class: "lp-bottom-nav__link #{'is-active' if active == 'life'}" do %>
    <span class="lp-bottom-nav__icon" aria-hidden="true">🌳</span>
    <span><%= t("game_ui.nav.life") %></span>
  <% end %>

  <%= link_to dashboard_path(anchor: "add-quest"), class: "lp-fab", aria: { label: t("game_ui.nav.quick_add") } do %>
    <span aria-hidden="true">+</span>
  <% end %>

  <%= link_to missions_path, class: "lp-bottom-nav__link #{'is-active' if active == 'missions'}" do %>
    <span class="lp-bottom-nav__icon" aria-hidden="true">🎯</span>
    <span><%= t("game_ui.nav.missions") %></span>
  <% end %>

  <%= link_to settings_path, class: "lp-bottom-nav__link #{'is-active' if active == 'profile'}" do %>
    <span class="lp-bottom-nav__icon" aria-hidden="true">👤</span>
    <span><%= t("game_ui.nav.profile") %></span>
  <% end %>
</nav>
