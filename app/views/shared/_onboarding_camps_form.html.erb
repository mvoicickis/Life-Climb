<%# locals: back_path, back_label, goal_title, camp_rows, form_url, form_data, add_input_id, submit_label, submit_data, setup_step_index, setup_step_total, data_controller, extra_data (hash), summit_error (optional) %>
<% step_titles = Array(camp_rows).map { |title| title.to_s.strip }.reject(&:blank?) %>
<% goal_title = goal_title.to_s %>
<% goal_long = goal_title.length > 30 %>
<% empty_steps = step_titles.empty? %>
<div class="lp-ob lp-ob--camps"
     data-controller="<%= data_controller %>"
     data-onboarding-camps-max-length-value="<%= StrategyGoal::TITLE_MAX %>"
     data-onboarding-camps-first-placeholder-value="<%= t("v2_onboarding.camps_add_placeholder_first") %>"
     data-onboarding-camps-next-placeholder-value="<%= t("v2_onboarding.camps_add_placeholder_next") %>"
     <% extra_data&.each do |key, value| %>
     data-<%= key.to_s.dasherize %>="<%= value %>"
     <% end %>>
  <div class="lp-ob__mountain-bg lp-ob__mountain-bg--steps" aria-hidden="true">
    <%= image_tag "onboarding_path.webp", class: "lp-ob__mountain-photo", alt: "", decoding: "async" %>
  </div>

  <div class="lp-ob__body lp-ob__body--camps">
    <header class="lp-ob-steps__head lp-ob-steps__head--chrome">
      <div class="lp-ob__step-head">
        <%= link_to back_label, back_path, class: "lp-ob__back" %>
        <span class="lp-ob__progress-label"><%= t("v2_onboarding.step_progress", current: setup_step_index, total: setup_step_total) %></span>
      </div>
      <div class="lp-ob__progress-track" role="progressbar" aria-valuemin="1" aria-valuenow="<%= setup_step_index %>" aria-valuemax="<%= setup_step_total %>">
        <span class="lp-ob__progress-fill" style="width: <%= ((setup_step_index.to_f / setup_step_total) * 100).round %>%"></span>
      </div>
    </header>

    <%= form_with url: form_url,
          method: :patch,
          class: "lp-ob-steps",
          data: form_data do %>
      <% if local_assigns[:summit_error] %>
        <p class="lp-ob-steps__error"
           role="alert"
           hidden
           data-summit-next-goal-submit-target="error"></p>
      <% end %>

      <div class="lp-ob-steps__card">
        <div class="lp-ob-trail">
          <div class="lp-ob-trail__goal-row">
            <div class="lp-ob-trail__stem" aria-hidden="true">
              <span class="lp-ob-trail__flag">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 3v18M5 5h11.5L13 9l3.5 4H5"/></svg>
              </span>
              <span class="lp-ob-trail__line"></span>
            </div>
            <div class="lp-ob-trail__goal-copy">
              <p class="lp-ob-steps__goal-eyebrow"><%= t("v2_onboarding.camps_goal_label") %></p>
              <p class="lp-ob-steps__goal-title<%= " lp-ob-steps__goal-title--long" if goal_long %>"><%= goal_title %></p>
            </div>
            <span class="lp-ob-trail__grip-spacer" aria-hidden="true"></span>
          </div>
          <div class="lp-ob-trail__subtitle-row">
            <div class="lp-ob-trail__stem lp-ob-trail__stem--connector" aria-hidden="true"><span class="lp-ob-trail__line"></span></div>
            <p class="lp-ob__lead lp-ob__lead--single"><%= t("v2_onboarding.camps_subtitle") %></p>
            <span class="lp-ob-trail__grip-spacer" aria-hidden="true"></span>
          </div>

          <div class="lp-ob-steps__scroll" data-onboarding-camps-target="scrollBody">
            <div class="lp-ob-steps__ghosts<%= " is-hidden" unless empty_steps %>" data-onboarding-camps-target="ghosts" aria-hidden="true">
              <% t("v2_onboarding.camps_ghost_examples").each_with_index do |example, index| %>
                <div class="lp-ob-trail__item lp-ob-trail__item--ghost">
                  <div class="lp-ob-trail__stem" aria-hidden="true">
                    <span class="lp-ob-trail__marker lp-ob-trail__marker--dashed"><%= index + 1 %></span>
                    <span class="lp-ob-trail__line"></span>
                  </div>
                  <span class="lp-ob-trail__label"><%= example %></span>
                  <span class="lp-ob-trail__grip-spacer" aria-hidden="true"></span>
                </div>
              <% end %>
            </div>
            <ul class="lp-ob-steps__list" data-onboarding-camps-target="list" aria-label="<%= t("v2_onboarding.camps_list_label") %>"></ul>
          </div>

          <div class="lp-ob-trail__item lp-ob-trail__add-row" data-onboarding-camps-target="addRow">
            <div class="lp-ob-trail__stem" aria-hidden="true">
              <span class="lp-ob-trail__line lp-ob-trail__line--into-add"></span>
              <span class="lp-ob-trail__marker lp-ob-trail__marker--dashed lp-ob-trail__marker--empty" aria-hidden="true"></span>
            </div>
            <label class="sr-only" for="<%= add_input_id %>"><%= t("v2_onboarding.camps_add_label") %></label>
            <input type="text"
                   id="<%= add_input_id %>"
                   class="lp-input lp-ob-trail__add-field"
                   autocomplete="off"
                   maxlength="<%= StrategyGoal::TITLE_MAX %>"
                   enterkeyhint="go"
                   placeholder="<%= empty_steps ? t("v2_onboarding.camps_add_placeholder_first") : t("v2_onboarding.camps_add_placeholder_next") %>"
                   data-onboarding-camps-target="addInput"
                   data-action="keydown->onboarding-camps#addFromEnter pointerdown->onboarding-camps#focusAddInput">
            <button type="button"
                    class="lp-ob-steps__add-btn<%= " lp-ob-steps__add-btn--primary" if empty_steps %>"
                    aria-label="<%= t("v2_onboarding.camps_add_button") %>"
                    data-onboarding-camps-target="addButton"
                    data-action="click->onboarding-camps#addFromButton">+</button>
          </div>
        </div>
      </div>

      <div data-onboarding-camps-target="hiddenFields">
        <% step_titles.each do |title| %>
          <%= hidden_field_tag "onboarding[camp_titles][]", title %>
        <% end %>
      </div>

      <footer class="lp-ob-steps__dock">
        <%= submit_tag submit_label,
              class: "lp-cta w-full#{" lp-cta--ready" unless empty_steps}",
              disabled: empty_steps,
              data: submit_data %>
      </footer>
    <% end %>
  </div>
</div>
