<div id="lp-app-welcome"
     class="lp-app-welcome"
     hidden
     aria-hidden="true"
     data-controller="app-welcome"
     data-action="click->app-welcome#skip">
  <div class="lp-app-welcome__stage">
    <div class="lp-app-welcome__icon">
      <img src="/icon.png?v=8"
           width="200"
           height="200"
           alt="">
    </div>
    <p class="lp-app-welcome__headline"><%= t("landing.hero_title") %></p>
  </div>
</div>
<%= javascript_tag(nonce: true) do %>
(function () {
  if (!document.documentElement.classList.contains("lp-app-welcome-pending")) return;
  var overlay = document.getElementById("lp-app-welcome");
  if (overlay) overlay.removeAttribute("hidden");
  if (typeof window.__lpStartAppWelcomeTimer === "function") {
    window.__lpStartAppWelcomeTimer();
  }
})();
<% end %>
