<%# Today V2 bottom nav — dark glass + center notch FAB. %>
<% active = local_assigns.fetch(:active, :today).to_s %>
<% strategy_journey = current_user&.primary_focused_journey || current_user&.life_journeys&.active&.order(:id)&.first %>
<% notch = local_assigns.fetch(:notch) %>
<% open_count = notch[:open_count].to_i %>
<% day_ended = notch[:day_ended] %>
<% all_clear = notch[:all_clear] %>

<% notch_mode =
     if day_ended
       :day_closed
     elsif open_count.positive?
       :fight
     else
       :end_day
     end %>

<% mountain_href = strategy_journey ? life_journey_path(strategy_journey) : new_life_journey_path %>

<nav class="lp-dash-nav is-today-v2"
     aria-label="Primary"
     data-controller="today-notch"
     data-today-notch-fight-toast-value="<%= t('dash.battlefield.fight_toast') %>"
     data-today-notch-share-toast-value="<%= t('dash.battlefield.share_toast') %>"
     data-today-notch-recap-text-value="<%= notch[:recap_share_text] %>">
  <%= link_to dashboard_path, class: "lp-dash-nav__link #{'is-active' if active == 'today'}" do %>
    <span class="lp-dash-nav__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.4 7.5 8.8 4.4-1.4 7.5-4.5 7.5-8.8V6L12 3Z"/>
      </svg>
    </span>
    <span><%= t("dash.nav.today") %></span>
  <% end %>

  <%= link_to mountain_href, class: "lp-dash-nav__link #{'is-active' if active == 'mountain'}" do %>
    <span class="lp-dash-nav__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 19 L9.5 8.5 L13 14 L16 10 L21 19 Z"/>
        <path d="M12 5.5 V8"/>
      </svg>
    </span>
    <span><%= t("dash.nav.mountain") %></span>
  <% end %>

  <div class="lp-dash-nav__fab-slot">
    <% if notch_mode == :fight %>
      <button type="button"
              class="lp-today-v2-notch is-fight"
              aria-label="<%= t('dash.battlefield.notch_fight') %>"
              data-action="click->today-notch#fight">
        <svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="#fff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14.5 3.5 5 13l1.5 1.5m3.5-11L19 13l-1.5 1.5M7 16.5h10M9 20h6"/>
        </svg>
        <% if open_count.positive? %>
          <span class="lp-today-v2-notch__badge"><%= open_count %></span>
        <% end %>
      </button>
      <span class="lp-today-v2-notch-label is-fight"><%= t("dash.battlefield.notch_fight") %></span>
    <% elsif notch_mode == :end_day %>
      <%= button_to today_end_day_path,
            method: :post,
            form: { class: "lp-today-v2-notch-form", data: { turbo: false } },
            class: "lp-today-v2-notch is-end-day",
            aria: { label: t("dash.battlefield.notch_end_day") } do %>
        <svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="#fff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 6 9 17l-5-5"/>
        </svg>
      <% end %>
      <span class="lp-today-v2-notch-label is-end-day"><%= t("dash.battlefield.notch_end_day") %></span>
    <% else %>
      <span class="lp-today-v2-notch is-day-closed" aria-label="<%= t('dash.battlefield.notch_day_closed') %>">
        <svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="#fff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 6 9 17l-5-5"/>
        </svg>
      </span>
      <span class="lp-today-v2-notch-label is-day-closed"><%= t("dash.battlefield.notch_day_closed") %></span>
    <% end %>
  </div>

  <%= link_to life_points_path, class: "lp-dash-nav__link #{'is-active' if active == 'journey'}" do %>
    <span class="lp-dash-nav__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 17 L9 11 L13 14.5 L20 7"/>
        <path d="M15 7 H20 V12"/>
      </svg>
    </span>
    <span><%= t("dash.nav.journey") %></span>
  <% end %>

  <%= link_to settings_path, class: "lp-dash-nav__link #{'is-active' if active == 'you'}" do %>
    <span class="lp-dash-nav__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="8" r="3.2"/>
        <path d="M5.5 19.2 C6.8 15.8 9 14 12 14 C15 14 17.2 15.8 18.5 19.2"/>
      </svg>
    </span>
    <span><%= t("dash.nav.you") %></span>
  <% end %>
</nav>
