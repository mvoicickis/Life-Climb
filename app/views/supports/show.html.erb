<% content_for :title, t("support.title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>

<%= tag.div class: "lp-support",
      data: {
        controller: "share",
        share_text_value: invite_share_message_body,
        share_url_value: share_landing_url,
        share_title_value: t("share.invite.title")
      } do %>
  <header class="lp-support__hero">
    <p class="lp-brand-kicker">
      <%= render "shared/lp_brand_mark", size: 24, class_name: "lp-brand-kicker__mark" %>
      <span><%= t("app_name") %></span>
    </p>
    <p class="lp-support__kicker"><%= t("support.kicker") %></p>
    <h1 class="lp-support__title"><%= t("support.title") %></h1>
    <p class="lp-support__subtitle"><%= t("support.subtitle") %></p>
    <p class="lp-support__body"><%= t("support.body") %></p>
  </header>

  <section class="lp-support-invite" aria-label="<%= t('share.invite.section_title') %>">
    <p class="lp-support-invite__kicker"><%= t("share.invite.cta_short") %></p>
    <h2 class="lp-support-invite__title"><%= t("share.invite.section_title") %></h2>
    <p class="lp-support-invite__body"><%= t("share.invite.section_body") %></p>
    <button type="button"
            class="lp-support-invite__cta"
            data-action="click->share#open">
      <%= t("share.invite.cta") %>
    </button>
  </section>

  <section class="lp-support__actions" aria-label="<%= t('support.title') %>">
    <% if @primary %>
      <a href="<%= @primary[:url] %>"
         class="lp-support__primary"
         target="<%= @primary[:url].to_s.start_with?('mailto:') ? nil : '_blank' %>"
         rel="<%= @primary[:url].to_s.start_with?('mailto:') ? nil : 'noopener noreferrer' %>">
        <%= t(@primary[:i18n_key]) %>
      </a>
    <% end %>

    <% secondary = @providers.reject { |p| p == @primary } %>
    <% if secondary.any? %>
      <div class="lp-support__secondary">
        <% secondary.each do |provider| %>
          <a href="<%= provider[:url] %>"
             class="lp-support__secondary-link"
             target="_blank"
             rel="noopener noreferrer">
            <%= t(provider[:i18n_key]) %>
          </a>
        <% end %>
      </div>
    <% end %>

    <% if @coming_soon.any? %>
      <div class="lp-support__soon">
        <p class="lp-support__soon-label"><%= t("support.coming_soon") %></p>
        <ul>
          <% @coming_soon.each do |provider| %>
            <li class="lp-support__soon-item" aria-disabled="true">
              <%= t(provider[:i18n_key]) %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>

  <p class="lp-support__footnote"><%= t("support.footnote") %></p>

  <p class="lp-support__links">
    <%= link_to t("about.title"), about_path %>
    <span aria-hidden="true">·</span>
    <%= link_to t("settings.title"), settings_path %>
    <span aria-hidden="true">·</span>
    <%= link_to t("nav.today"), dashboard_path %>
  </p>

  <%= render "shared/share_sheet",
        title: t("share.invite.title"),
        subtitle: t("share.invite.subtitle") %>
<% end %>

<%= render "shared/lp_dash_nav", active: :you %>
