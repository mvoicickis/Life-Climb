<% content_for :title, t("support.title") %>

<div class="studio-support">
  <header class="studio-support__hero">
    <p class="studio-kicker"><%= t("support.kicker") %></p>
    <h1 class="studio-dream"><%= t("support.title") %></h1>
    <p class="studio-support__subtitle"><%= t("support.subtitle") %></p>
    <p class="studio-muted mt-4 max-w-xl"><%= t("support.body") %></p>
  </header>

  <section class="studio-support__actions" aria-label="<%= t('support.title') %>">
    <% if @primary %>
      <a href="<%= @primary[:url] %>"
         class="studio-btn studio-btn--strong studio-support__primary"
         target="<%= @primary[:url].to_s.start_with?('mailto:') ? nil : '_blank' %>"
         rel="<%= @primary[:url].to_s.start_with?('mailto:') ? nil : 'noopener noreferrer' %>">
        <%= t(@primary[:i18n_key]) %>
      </a>
    <% end %>

    <% secondary = @providers.reject { |p| p == @primary } %>
    <% if secondary.any? %>
      <div class="studio-support__secondary">
        <% secondary.each do |provider| %>
          <a href="<%= provider[:url] %>"
             class="studio-btn"
             target="_blank"
             rel="noopener noreferrer">
            <%= t(provider[:i18n_key]) %>
          </a>
        <% end %>
      </div>
    <% end %>

    <% if @coming_soon.any? %>
      <div class="studio-support__soon">
        <p class="studio-label"><%= t("support.coming_soon") %></p>
        <ul>
          <% @coming_soon.each do |provider| %>
            <li class="studio-support__soon-item" aria-disabled="true">
              <%= t(provider[:i18n_key]) %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>

  <p class="studio-muted mt-10 text-sm max-w-lg"><%= t("support.footnote") %></p>

  <p class="mt-8 flex flex-wrap gap-4">
    <%= link_to t("about.title"), about_path, class: "studio-link" %>
    <%= link_to t("nav.settings"), settings_path, class: "studio-link" %>
    <%= link_to t("nav.today"), dashboard_path, class: "studio-link" %>
  </p>
</div>
