<%# locals: rings %>
<% first_add_ring = rings.find { |r| r[:journeys].empty? && r[:creatable] }&.dig(:key) %>
<ul class="lp-my-world-list">
  <% rings.each do |ring| %>
    <% count = ring[:journeys].size %>
    <% show_week = count.positive? && ring[:week_dates].present? %>
    <% show_add = ring[:key] == first_add_ring %>
    <li>
      <% if show_add %>
        <%= link_to new_life_journey_path(ring: ring[:key]),
              class: "lp-my-world-list__row is-add#{' has-week' if show_week}",
              data: { ring: ring[:key] } do %>
          <span class="lp-my-world-list__dot<%= ' is-live' if ring[:live] %>"
                <% if ring[:live] %>style="--dot-color: var(--lp-world-<%= ring[:color_index] %>)"<% end %>
                aria-hidden="true"></span>
          <span class="lp-my-world-list__icon" aria-hidden="true"><%= my_world_ring_icon(ring[:key]) %></span>
          <span class="lp-my-world-list__copy">
            <span class="lp-my-world-list__name-row">
              <span class="lp-my-world-list__name"><%= t("my_world.rings.#{ring[:key]}.name") %></span>
            </span>
            <span class="lp-my-world-list__hint"><%= t("my_world.rings.#{ring[:key]}.hint") %></span>
          </span>
          <span class="lp-my-world-list__add"><%= t("my_world.add_goal_row") %></span>
        <% end %>
      <% else %>
        <button type="button"
                class="lp-my-world-list__row<%= ' has-week' if show_week %>"
                data-action="click->world-ring-sheet#open"
                data-ring="<%= ring[:key] %>"
                aria-haspopup="dialog">
          <span class="lp-my-world-list__dot<%= ' is-live' if ring[:live] %>"
                <% if ring[:live] %>style="--dot-color: var(--lp-world-<%= ring[:color_index] %>)"<% end %>
                aria-hidden="true"></span>
          <span class="lp-my-world-list__icon" aria-hidden="true"><%= my_world_ring_icon(ring[:key]) %></span>
          <span class="lp-my-world-list__copy">
            <span class="lp-my-world-list__name-row">
              <span class="lp-my-world-list__name"><%= t("my_world.rings.#{ring[:key]}.name") %></span>
              <% if count.positive? %>
                <span class="lp-my-world-list__count"><%= t("my_world.goals_count", count: count) %></span>
              <% end %>
            </span>
            <span class="lp-my-world-list__hint"><%= t("my_world.rings.#{ring[:key]}.hint") %></span>
            <% if show_week %>
              <span class="lp-my-world-list__heat is-week" aria-hidden="true">
                <% ring[:week_dates].each_with_index do |date, i| %>
                  <% wins = ring[:week_wins][i].to_i %>
                  <% today = i == ring[:week_dates].size - 1 %>
                  <span class="lp-my-world-list__heat-col">
                    <span class="lp-my-world-list__heat-cell<%= ' is-today' if today %>"
                          style="background: <%= my_world_day_cell_background(ring[:color_index], wins) %>"></span>
                    <span class="lp-my-world-list__heat-day"><%= my_world_weekday_letter(date) %></span>
                  </span>
                <% end %>
              </span>
            <% end %>
          </span>
          <span class="lp-my-world-list__chev" aria-hidden="true">›</span>
        </button>
      <% end %>
    </li>
  <% end %>
</ul>
