<% content_for :title, t("summit_next_goal.title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>

<% if @step == "goal" %>
  <div class="lp-ob lp-ob--goal">
    <div class="lp-ob__mountain-bg" aria-hidden="true">
      <%= image_tag MountainTrailHelper::BUILTIN_DAY_PHOTO, class: "lp-ob__mountain-photo", alt: "", decoding: "async" %>
    </div>

    <div class="lp-ob__body">
      <section class="lp-ob__card lp-ob__card--goal" aria-labelledby="summit-goal-title">
        <div class="lp-ob__step-head">
          <%= link_to t("summit_next_goal.back"), life_journey_path(@journey), class: "lp-ob__back" %>
          <span class="lp-ob__progress-label"><%= t("v2_onboarding.step_progress", current: @setup_step_index, total: @setup_step_total) %></span>
        </div>
        <div class="lp-ob__progress-track" role="progressbar" aria-valuemin="1" aria-valuenow="<%= @setup_step_index %>" aria-valuemax="<%= @setup_step_total %>">
          <span class="lp-ob__progress-fill" style="width: <%= ((@setup_step_index.to_f / @setup_step_total) * 100).round %>%"></span>
        </div>

        <h1 id="summit-goal-title" class="lp-ob__title"><%= t("summit_next_goal.mountain_name_title") %></h1>

        <%= form_with url: summit_next_goal_path(step: "goal"), method: :patch, class: "lp-ob__form", data: { turbo: false } do %>
          <label class="sr-only" for="summit_onboarding_goal"><%= t("summit_next_goal.mountain_name_title") %></label>
          <%= text_field_tag "onboarding[goal]", @draft["goal"],
                id: "summit_onboarding_goal",
                required: true,
                maxlength: 120,
                class: "lp-input w-full",
                autocomplete: "off",
                autofocus: true,
                placeholder: t("summit_next_goal.mountain_name_placeholder") %>
          <%= submit_tag t("v2_onboarding.continue"), class: "lp-cta w-full" %>
        <% end %>
      </section>
    </div>
  </div>

<% elsif @step == "camps" %>
  <%= render "shared/onboarding_camps_form",
        back_path: summit_next_goal_path(step: "goal"),
        back_label: t("summit_next_goal.back"),
        goal_title: @draft["goal"],
        camp_rows: Array(@draft["camp_titles"]).map { |title| title.to_s.strip }.reject(&:blank?),
        form_url: summit_next_goal_path(step: "camps"),
        form_data: {
          turbo: false,
          onboarding_camps_target: "form",
          summit_next_goal_submit_target: "form",
          action: "submit->onboarding-camps#beforeSubmit submit->summit-next-goal-submit#submit"
        },
        add_input_id: "summit_onboarding_camp_add",
        submit_label: t("summit_next_goal.start_climbing"),
        submit_data: { onboarding_camps_target: "submit", summit_next_goal_submit_target: "submit" },
        setup_step_index: @setup_step_index,
        setup_step_total: @setup_step_total,
        data_controller: "onboarding-camps summit-next-goal-submit",
        extra_data: { "summit-next-goal-submit-not-saved-value" => t("dash.battlefield.win_not_saved") },
        summit_error: true %>
<% end %>
