<% content_for :title, t("feedback.title") %>
<% content_for :lp_game, true if authenticated? %>
<% content_for :lp_hide_top_nav, true if authenticated? %>
<%
  page_label = @feedback.page_context.presence || params[:page].presence
  logged_in = authenticated?
  contact_default = @feedback.contact_info.presence || (logged_in ? current_user.email_address : nil)
%>

<section class="lp-feedback" aria-labelledby="lp-feedback-heading">
  <header class="lp-feedback__hero">
    <p class="lp-brand-kicker">
      <%= render "shared/lp_brand_mark", size: 24, class_name: "lp-brand-kicker__mark" %>
      <span><%= t("app_name") %></span>
    </p>
    <h1 id="lp-feedback-heading" class="lp-feedback__title"><%= t("feedback.title") %></h1>
    <p class="lp-feedback__subtitle"><%= t("feedback.subtitle") %></p>
  </header>

  <%= form_with model: @feedback, url: feedbacks_path, class: "lp-feedback__form",
        data: { turbo: false, controller: "feedback-contact" } do |form| %>
    <% if @feedback.errors.any? %>
      <div class="lp-feedback__errors">
        <ul>
          <% @feedback.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.hidden_field :page_context, value: page_label %>
    <%= form.hidden_field :app_version,
          value: app_version,
          data: { feedback_contact_target: "appVersion" } %>

    <div class="lp-feedback__field">
      <p class="lp-feedback__label"><%= t("feedback.page_label") %></p>
      <p class="lp-feedback__page">
        <%= page_label.presence || t("feedback.page_unknown") %>
      </p>
    </div>

    <fieldset class="lp-feedback__field">
      <legend class="lp-feedback__label"><%= t("feedback.rating_label") %></legend>
      <div class="lp-feedback__ratings" role="radiogroup" aria-label="<%= t("feedback.rating_label") %>">
        <% Feedback::RATINGS.each do |score| %>
          <label class="lp-feedback__rating">
            <%= form.radio_button :rating, score, class: "lp-feedback__rating-input" %>
            <span class="lp-feedback__rating-face" aria-hidden="true"><%= t("feedback.rating_faces.#{score}") %></span>
            <span class="lp-feedback__rating-num"><%= score %></span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div class="lp-feedback__field">
      <%= form.label :body, t("feedback.body_label"), class: "lp-feedback__label" %>
      <%= form.text_area :body,
            rows: 6,
            required: true,
            maxlength: 2000,
            placeholder: t("feedback.body_placeholder"),
            class: "lp-feedback__textarea" %>
    </div>

    <div class="lp-feedback__field lp-feedback__contact" data-feedback-contact-target="wrap">
      <label class="lp-feedback__opt-in">
        <%= form.check_box :ok_to_contact,
              class: "lp-feedback__checkbox",
              data: {
                feedback_contact_target: "optIn",
                action: "change->feedback-contact#sync"
              } %>
        <span><%= t("feedback.ok_to_contact") %></span>
      </label>

      <div class="lp-feedback__contact-panel"
           data-feedback-contact-target="panel"
           <%= "hidden" unless @feedback.ok_to_contact? %>>
        <% if logged_in %>
          <%= form.label :contact_info, t("feedback.contact_logged_in_label"), class: "lp-feedback__label" %>
          <%= form.text_field :contact_info,
                value: contact_default,
                maxlength: 120,
                placeholder: t("feedback.contact_logged_in_placeholder"),
                class: "lp-feedback__input",
                data: {
                  feedback_contact_target: "input",
                  keep_default: "true"
                } %>
          <p class="lp-feedback__hint"><%= t("feedback.contact_logged_in_hint", email: current_user.email_address) %></p>
        <% else %>
          <%= form.label :contact_info, t("feedback.contact_anon_label"), class: "lp-feedback__label" %>
          <%= form.text_field :contact_info,
                maxlength: 120,
                placeholder: t("feedback.contact_anon_placeholder"),
                class: "lp-feedback__input",
                data: { feedback_contact_target: "input" } %>
        <% end %>
      </div>
    </div>

    <%= form.submit t("feedback.submit"), class: "lp-feedback__submit" %>
  <% end %>

  <p class="lp-feedback__alt">
    <%= t("feedback.or_contact") %>
    <% if contact_whatsapp? %>
      <%= link_to "WhatsApp", contact_whatsapp_url, target: "_blank", rel: "noopener noreferrer" %>
      <span aria-hidden="true">·</span>
    <% end %>
    <%= link_to t("share.email"), contact_mailto_url %>
  </p>

  <% if authenticated? %>
    <%= render "shared/lp_dash_nav", active: :you %>
  <% end %>
</section>
