<% content_for :title, t("coach.title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>

<section class="lp-support" aria-labelledby="lp-coach-heading">
  <header class="lp-support__hero">
    <p class="lp-brand-kicker">
      <%= render "shared/lp_brand_mark", size: 24, class_name: "lp-brand-kicker__mark" %>
      <span><%= t("app_name") %></span>
    </p>
    <h1 id="lp-coach-heading" class="lp-support__title"><%= t("coach.title") %></h1>
    <p class="lp-support__subtitle"><%= t("coach.subtitle") %></p>
  </header>

  <div class="lp-support__contacts">
    <% if contact_whatsapp? %>
      <a href="<%= coach_whatsapp_url(current_user) %>"
         target="_blank"
         rel="noopener noreferrer"
         class="lp-support__contact">
        <span class="lp-support__contact-copy">
          <span class="lp-support__contact-name">WhatsApp</span>
          <span class="lp-support__contact-meta"><%= contact_whatsapp_display %></span>
        </span>
        <span class="lp-support__contact-go"><%= t("coach.open") %></span>
      </a>
    <% end %>

    <a href="<%= coach_mailto_url(current_user) %>" class="lp-support__contact">
      <span class="lp-support__contact-copy">
        <span class="lp-support__contact-name"><%= t("share.email") %></span>
        <span class="lp-support__contact-meta"><%= contact_email %></span>
      </span>
      <span class="lp-support__contact-go"><%= t("coach.write") %></span>
    </a>
  </div>

  <p class="lp-support__footnote"><%= t("coach.footnote") %></p>

  <p class="lp-support__links">
    <%= link_to t("nav.today"), dashboard_path %>
    <span aria-hidden="true">·</span>
    <%= link_to t("nav.settings"), settings_path %>
  </p>
</section>

<%= render "shared/lp_dash_nav", active: :you %>
