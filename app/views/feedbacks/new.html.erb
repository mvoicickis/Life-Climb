<% content_for :title, t("coach.title") %>

<div class="mx-auto max-w-lg studio-life">
  <h1 class="studio-dream"><%= t("coach.title") %></h1>
  <p class="mt-2 studio-muted"><%= t("coach.subtitle") %></p>

  <div class="mt-8 space-y-3">
    <% if contact_whatsapp? %>
      <a href="<%= coach_whatsapp_url(current_user) %>"
         target="_blank"
         rel="noopener noreferrer"
         class="studio-rail-card flex items-center justify-between gap-4 no-underline">
        <span>
          <span class="block font-bold text-lg text-[var(--studio-ink)]">WhatsApp</span>
          <span class="studio-muted text-sm">+353 87 234 6580</span>
        </span>
        <span class="studio-link"><%= t("coach.open") %></span>
      </a>
    <% end %>

    <a href="<%= coach_mailto_url(current_user) %>"
       class="studio-rail-card flex items-center justify-between gap-4 no-underline">
      <span>
        <span class="block font-bold text-lg text-[var(--studio-ink)]"><%= t("share.email") %></span>
        <span class="studio-muted text-sm"><%= contact_email %></span>
      </span>
      <span class="studio-link"><%= t("coach.write") %></span>
    </a>
  </div>

  <p class="mt-6 studio-muted text-sm"><%= t("coach.footnote") %></p>
  <p class="mt-8"><%= link_to t("nav.today"), dashboard_path, class: "studio-link" %></p>
</div>
