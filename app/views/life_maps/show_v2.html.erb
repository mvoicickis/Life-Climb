<% content_for :title, t("game_ui.life_title") %>
<% content_for :lp_game, true %>

<div class="lp-home mx-auto max-w-md space-y-5 px-4 pb-24 pt-5">
  <header class="space-y-1">
    <h1 class="text-3xl font-semibold text-[var(--lp-ink)]"><%= t("game_ui.life_title") %></h1>
    <p class="text-sm text-[var(--lp-muted)]"><%= t("game_ui.life_subtitle_v2") %></p>
  </header>

  <%= render "dashboard/gap_progress", gap_percent: @gap %>

  <%= render "dashboard/life_tree",
        life_areas: @life_areas,
        focus_id: @focus_area_id,
        closer_percent: current_user.overall_closer_percent,
        compact: false %>

  <% if @journey = current_user.primary_focused_journey %>
    <section class="lp-glass space-y-2 p-4">
      <p class="text-xs font-bold uppercase tracking-wide text-[var(--lp-muted)]"><%= t("dashboard_v2.working_on") %></p>
      <p class="font-semibold text-[var(--lp-ink)]"><%= @journey.title %></p>
      <% if @journey.next_win.present? %>
        <p class="text-sm text-[var(--lp-muted)]"><%= t("dashboard_v2.next_win") %> <%= @journey.next_win %></p>
      <% end %>
      <%= link_to t("coach.open_journey"), life_journey_path(@journey), class: "mt-2 inline-flex text-sm font-bold text-[var(--lp-lime)]" %>
    </section>
  <% end %>

  <div class="flex flex-wrap gap-3">
    <%= link_to t("dashboard_v2.today"), dashboard_path, class: "lp-cta inline-flex" %>
  </div>
</div>

<%= render "shared/lp_bottom_nav", active: :life %>
