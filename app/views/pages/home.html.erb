<% content_for :title, "LifePoints — Grow a little every day" %>
<% content_for :meta_description, "Track what matters. See if today is better than yesterday. Green means up. Red means not up." %>

<div data-controller="landing">
  <section class="landing-hero relative min-h-[100dvh] overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/lifepoints-landing-hero.jpg"
        alt=""
        class="h-full w-full object-cover"
        data-landing-target="heroImage">
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/75 via-slate-900/45 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/50 via-transparent to-slate-900/20"></div>
    </div>

    <header class="relative z-10 mx-auto flex w-full max-w-6xl items-center justify-between px-5 py-5 md:px-8 md:py-6">
      <p class="text-2xl font-black tracking-tight text-white md:text-3xl" data-landing-target="brand">LifePoints</p>
      <div class="flex items-center gap-2 md:gap-3">
        <%= link_to "Sign in", new_session_path,
            class: "rounded-2xl px-4 py-2 text-sm font-bold text-white/90 hover:bg-white/10 md:text-base" %>
        <%= link_to "Start free", new_registration_path,
            class: "rounded-2xl bg-emerald-500 px-4 py-2 text-sm font-black text-white shadow-lg shadow-emerald-900/30 hover:bg-emerald-400 md:text-base" %>
      </div>
    </header>

    <div class="relative z-10 mx-auto flex min-h-[calc(100dvh-5.5rem)] w-full max-w-6xl flex-col justify-center px-5 pb-16 pt-8 md:px-8 md:pb-24">
      <div class="max-w-xl" data-landing-target="heroCopy">
        <h1 class="text-5xl font-black leading-[1.05] tracking-tight text-white md:text-7xl">
          Grow a little<br>every day.
        </h1>
        <p class="mt-5 max-w-md text-lg font-semibold leading-relaxed text-white/85 md:text-xl">
          Count what matters. See if today is better than yesterday.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <%= link_to "Start free", new_registration_path,
              class: "inline-flex rounded-2xl bg-emerald-500 px-6 py-4 text-base font-black text-white shadow-xl shadow-emerald-950/30 hover:bg-emerald-400 md:text-lg" %>
          <%= link_to "I have an account", new_session_path,
              class: "inline-flex rounded-2xl border-2 border-white/30 bg-white/10 px-6 py-4 text-base font-bold text-white backdrop-blur hover:bg-white/20 md:text-lg" %>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f7faf8] px-5 py-20 md:px-8 md:py-28">
    <div class="mx-auto max-w-5xl">
      <h2 class="max-w-2xl text-3xl font-black tracking-tight text-slate-900 md:text-5xl" data-landing-target="fade">
        Three easy steps.
      </h2>
      <p class="mt-4 max-w-xl text-lg font-semibold text-slate-600" data-landing-target="fade">
        No hard words. Just your day, your numbers, and a clear color.
      </p>

      <div class="mt-12 grid gap-8 md:grid-cols-3 md:gap-10">
        <div data-landing-target="fade">
          <p class="text-sm font-black uppercase tracking-widest text-emerald-600">1</p>
          <h3 class="mt-3 text-2xl font-black text-slate-900">Pick what to count</h3>
          <p class="mt-3 text-base font-semibold leading-relaxed text-slate-600">
            Steps, sleep, water, pages, money — or anything you care about.
          </p>
        </div>
        <div data-landing-target="fade">
          <p class="text-sm font-black uppercase tracking-widest text-sky-600">2</p>
          <h3 class="mt-3 text-2xl font-black text-slate-900">Save today's number</h3>
          <p class="mt-3 text-base font-semibold leading-relaxed text-slate-600">
            Type what you did. Your goal can grow a little each day.
          </p>
        </div>
        <div data-landing-target="fade">
          <p class="text-sm font-black uppercase tracking-widest text-orange-500">3</p>
          <h3 class="mt-3 text-2xl font-black text-slate-900">See green or red</h3>
          <p class="mt-3 text-base font-semibold leading-relaxed text-slate-600">
            Green means more than yesterday. Red means same or less.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-slate-900 px-5 py-20 md:px-8 md:py-28">
    <div class="pointer-events-none absolute -right-20 top-0 h-72 w-72 rounded-full bg-emerald-500/20 blur-3xl"></div>
    <div class="pointer-events-none absolute -left-16 bottom-0 h-64 w-64 rounded-full bg-sky-500/15 blur-3xl"></div>

    <div class="relative mx-auto max-w-5xl" data-landing-target="fade">
      <h2 class="max-w-2xl text-3xl font-black tracking-tight text-white md:text-5xl">
        Your life on one screen.
      </h2>
      <p class="mt-4 max-w-xl text-lg font-semibold text-white/75">
        Home shows your stats as bright cards. Tap one to add today's number.
      </p>

      <div class="mt-10 grid max-w-lg grid-cols-2 gap-3" aria-hidden="true">
        <div class="rounded-3xl border-2 border-emerald-400 bg-emerald-50 p-4 shadow-lg">
          <div class="flex items-start justify-between">
            <p class="font-black text-emerald-950">Move</p>
            <span class="rounded-lg bg-emerald-500 px-2 py-1 text-[10px] font-black text-white">UP</span>
          </div>
          <p class="mt-4 text-4xl font-black text-emerald-950">8,420</p>
          <p class="mt-1 text-xs font-bold text-emerald-800/70">steps</p>
        </div>
        <div class="rounded-3xl border-2 border-rose-400 bg-rose-50 p-4 shadow-lg">
          <div class="flex items-start justify-between">
            <p class="font-black text-rose-950">Water</p>
            <span class="rounded-lg bg-rose-500 px-2 py-1 text-[10px] font-black text-white">NOT UP</span>
          </div>
          <p class="mt-4 text-4xl font-black text-rose-950">5</p>
          <p class="mt-1 text-xs font-bold text-rose-800/70">glasses</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#fff8f1] px-5 py-20 md:px-8 md:py-28">
    <div class="mx-auto max-w-3xl text-center" data-landing-target="fade">
      <p class="text-4xl font-black tracking-tight text-emerald-600 md:text-5xl">LifePoints</p>
      <h2 class="mt-4 text-3xl font-black tracking-tight text-slate-900 md:text-5xl">
        Ready to go up today?
      </h2>
      <p class="mx-auto mt-4 max-w-md text-lg font-semibold text-slate-600">
        Make a free account and start with Move, Sleep, Water — or your own stats.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <%= link_to "Start free", new_registration_path,
            class: "inline-flex rounded-2xl bg-emerald-500 px-6 py-4 text-base font-black text-white hover:bg-emerald-400 md:text-lg" %>
        <%= link_to "Sign in", new_session_path,
            class: "inline-flex rounded-2xl border-2 border-slate-300 bg-white px-6 py-4 text-base font-bold text-slate-800 hover:bg-slate-50 md:text-lg" %>
      </div>
    </div>
  </section>

  <footer class="border-t border-slate-200 bg-white px-5 py-8 md:px-8">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3">
      <p class="font-black text-emerald-600">LifePoints</p>
      <p class="text-sm font-semibold text-slate-500">Grow a little every day.</p>
    </div>
  </footer>
</div>
