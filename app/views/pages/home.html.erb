<% content_for :title, t("landing.meta_title") %>
<% content_for :meta_description, t("landing.meta_description") %>

<div class="lp-landing" data-controller="landing">
  <section class="lp-landing-hero landing-hero">
    <div class="lp-landing-hero__media" aria-hidden="true">
      <picture>
        <source srcset="/branding/landing-hero-mountain.webp" type="image/webp">
        <img
          class="lp-landing-hero__img"
          src="/branding/landing-hero-mountain.jpg"
          alt=""
          width="900"
          height="1350"
          decoding="async"
          fetchpriority="high"
          data-landing-target="heroImage">
      </picture>
      <div class="lp-landing-hero__veil"></div>
    </div>

    <header class="lp-landing-nav">
      <p class="lp-landing-brand" data-landing-target="brand">
        <img class="lp-landing-brand__mark" src="/branding/lifepoints-mark.png?v=7" width="40" height="40" alt="" aria-hidden="true">
        <span class="lp-landing-brand__name"><%= t("app_name") %></span>
      </p>
      <div class="lp-landing-nav__actions">
        <%= render "shared/locale_switcher", variant: :compact %>
        <%= link_to t("landing.sign_in"), new_session_path, class: "lp-landing-link" %>
        <%= link_to t("landing.start_free"), new_registration_path, class: "lp-landing-cta lp-landing-cta--nav" %>
      </div>
    </header>

    <div class="lp-landing-hero__copy" data-landing-target="heroCopy">
      <h1 class="lp-landing-hero__title"><%= t("landing.hero_title") %></h1>
      <p class="lp-landing-hero__body"><%= t("landing.hero_body") %></p>
      <p class="lp-landing-hero__proof"><%= t("landing.hero_proof") %></p>
      <div class="lp-landing-hero__ctas">
        <%= link_to t("landing.start_free"), new_registration_path,
            class: "lp-landing-cta",
            data: { landing_target: "cta" } %>
        <%= link_to t("landing.sign_in"), new_session_path, class: "lp-landing-cta lp-landing-cta--ghost" %>
      </div>
      <p class="lp-landing-hero__note"><%= t("landing.hero_note") %></p>
    </div>
  </section>

  <section class="lp-landing-section lp-landing-section--light">
    <div class="lp-landing-section__inner lp-landing-section__inner--wide" data-landing-target="fade">
      <h2 class="lp-landing-heading"><%= t("landing.areas_title") %></h2>
      <p class="lp-landing-lead"><%= t("landing.areas_body") %></p>
      <ul class="lp-landing-chips" aria-label="<%= t("landing.areas_title") %>">
        <% [
          ["self", "self", t("life_area_catalog.self.short")],
          ["career", "career", t("life_area_catalog.career.short")],
          ["money", "money", t("life_area_catalog.money.short")],
          ["love", "love", t("life_area_catalog.relationships.name")],
          ["growth", "growth", t("life_area_catalog.purpose.short")]
        ].each do |tone, icon, label| %>
          <li class="lp-landing-chip lp-landing-chip--<%= tone %>">
            <%= render "shared/lp_icon", name: icon, class_name: "lp-icon is-chip" %>
            <span><%= label %></span>
          </li>
        <% end %>
        <li class="lp-landing-chip lp-landing-chip--more"><%= t("landing.areas_more") %></li>
      </ul>
    </div>
  </section>

  <section class="lp-landing-section lp-landing-section--soft">
    <div class="lp-landing-split" data-landing-target="fade">
      <div class="lp-landing-split__copy">
        <h2 class="lp-landing-heading"><%= t("landing.how_title") %></h2>
        <ol class="lp-landing-steps">
          <li class="lp-landing-step">
            <span class="lp-landing-step__icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 26 V10"/>
                <path d="M8 10 L22 7 V16 L8 13"/>
              </svg>
            </span>
            <div>
              <p class="lp-landing-step__num">1. <%= t("landing.how_step1_title") %></p>
              <p class="lp-landing-step__body"><%= t("landing.how_step1_body") %></p>
              <p class="lp-landing-step__example"><%= t("landing.how_step1_example") %></p>
            </div>
          </li>
          <li class="lp-landing-step">
            <span class="lp-landing-step__icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 24 L12 14 L18 19 L28 8"/>
                <path d="M22 8 H28 V14"/>
              </svg>
            </span>
            <div>
              <p class="lp-landing-step__num">2. <%= t("landing.how_step2_title") %></p>
              <p class="lp-landing-step__body"><%= t("landing.how_step2_body") %></p>
              <p class="lp-landing-step__example"><%= t("landing.how_step2_example") %></p>
            </div>
          </li>
          <li class="lp-landing-step">
            <span class="lp-landing-step__icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="16" cy="16" r="11"/>
                <path d="M10 16.5 L14 20.5 L22 12"/>
              </svg>
            </span>
            <div>
              <p class="lp-landing-step__num">3. <%= t("landing.how_step3_title") %></p>
              <p class="lp-landing-step__body"><%= t("landing.how_step3_body") %></p>
              <p class="lp-landing-step__example"><%= t("landing.how_step3_example") %></p>
            </div>
          </li>
        </ol>
      </div>
      <figure class="lp-landing-split__art">
        <picture>
          <source srcset="/branding/landing-scene-climb.webp" type="image/webp">
          <img src="/branding/landing-scene-climb.jpg" alt="" width="1100" height="733" loading="lazy" decoding="async">
        </picture>
      </figure>
    </div>
  </section>

  <section class="lp-landing-section lp-landing-section--light">
    <div class="lp-landing-why" data-landing-target="fade">
      <div class="lp-landing-why__visual" aria-hidden="true">
        <div class="lp-landing-lp">
          <img class="lp-landing-lp__mark" src="/branding/lifepoints-mark.png?v=7" width="56" height="56" alt="">
          <p class="lp-landing-lp__count">
            <span data-landing-target="lpCount">0</span>
          </p>
          <p class="lp-landing-lp__label">
            <%= t("landing.why_ap_label") %>
            <span class="lp-landing-lp__abbr"><%= t("landing.why_ap_abbr") %></span>
          </p>
          <p class="lp-landing-lp__chip"><%= t("landing.why_ap_chip") %></p>
        </div>
      </div>
      <div class="lp-landing-why__copy">
        <h2 class="lp-landing-heading"><%= t("landing.why_title") %></h2>
        <p class="lp-landing-lead"><%= t("landing.why_body") %></p>
      </div>
    </div>
  </section>

  <section class="lp-landing-section lp-landing-section--soft">
    <div class="lp-landing-section__inner" data-landing-target="fade">
      <h2 class="lp-landing-heading"><%= t("landing.progress_title") %></h2>
      <p class="lp-landing-lead"><%= t("landing.progress_body") %></p>
      <div class="lp-landing-progress" aria-hidden="true">
        <div class="lp-landing-progress__track">
          <div class="lp-landing-progress__fill"></div>
        </div>
        <span class="lp-landing-progress__pct">64%</span>
      </div>
    </div>
  </section>

  <section class="lp-landing-cta-band">
    <div class="lp-landing-cta-band__inner" data-landing-target="fade">
      <p class="lp-landing-brand lp-landing-brand--centered">
        <img class="lp-landing-brand__mark" src="/branding/lifepoints-mark.png?v=7" width="40" height="40" alt="" aria-hidden="true">
        <span class="lp-landing-brand__name"><%= t("app_name") %></span>
      </p>
      <h2 class="lp-landing-heading"><%= t("landing.cta_title") %></h2>
      <p class="lp-landing-lead"><%= t("landing.cta_body") %></p>
      <div class="lp-landing-hero__ctas lp-landing-hero__ctas--center">
        <%= link_to t("landing.start_free"), new_registration_path, class: "lp-landing-cta" %>
        <%= link_to t("landing.sign_in"), new_session_path, class: "lp-landing-cta lp-landing-cta--ghost" %>
      </div>
    </div>
  </section>

  <footer class="lp-landing-footer">
    <p class="lp-landing-footer__brand">
      <%= render "shared/lp_brand_mark", size: 22, class_name: "lp-landing-footer__mark" %>
      <span><%= t("app_name") %></span>
    </p>
    <p class="lp-landing-footer__tag"><%= t("landing.footer_tagline") %></p>
  </footer>

</div>
