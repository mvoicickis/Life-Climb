<% if @updated&.day? && @project.present? %>
  <%= turbo_stream.replace "trail-battles-#{@project.id}" do %>
    <%= render "life_journeys/trail_camp_battles",
          project: @project.reload,
          goal: @goal,
          plan: @plan,
          area: @project.life_area %>
  <% end %>
  <%= turbo_stream.replace "trail-base-sheet" do %>
    <%= render "life_journeys/trail_base_sheet",
          projects: mountain_trail_open_camps(@plan),
          area: @project.life_area,
          plan: @plan,
          goal: @goal,
          journey: @updated.life_journey %>
  <% end %>
  <% if @today_todo.present? %>
    <%= turbo_stream.replace dom_id(@today_todo, :battlefield_row) do %>
      <%= render "dashboard/dash_battlefield_row",
            todo: @today_todo,
            mission: nil,
            journey: @journey %>
    <% end %>
  <% end %>
<% else %>
  <%= turbo_stream.append "strategy-world" do %>
    <meta data-rpg-refresh="1">
  <% end %>
<% end %>
