<% if @created.day? && @project.present? %>
  <% if @seed_win || @created.completed? %>
    <%= turbo_stream.replace "trail-battles-#{@project.id}" do %>
      <%= render "life_journeys/trail_camp_battles",
            project: @project,
            goal: @goal,
            plan: @plan,
            area: @project.life_area %>
    <% end %>
  <% else %>
    <%= turbo_stream.remove "trail-battle-suggestion-#{@project.id}" %>
    <%= turbo_stream.remove "trail-battles-seed-hint-#{@project.id}" %>
    <%= turbo_stream.append "trail-battles-list-#{@project.id}" do %>
      <%= render "life_journeys/trail_battle_row",
            battle: @created,
            done: false,
            show_move_up: @prior_open_count.positive?,
            show_move_down: false %>
    <% end %>
  <% end %>
  <% if @created.repeat_daily? %>
    <%= turbo_stream.replace "trail-base-sheet" do %>
      <%= render "life_journeys/trail_base_sheet",
            projects: mountain_trail_open_camps(@plan),
            area: @project.life_area,
            plan: @plan,
            goal: @goal,
            journey: @journey %>
    <% end %>
  <% end %>
<% else %>
  <%= turbo_stream.append "climb-path-projects" do %>
    <%= render "life_journeys/rpg_project_card",
          project: @created,
          goal: @goal,
          plan: @plan,
          area: @created.life_area %>
  <% end %>
  <%= turbo_stream.remove "climb-path-empty" %>
  <%= turbo_stream.replace "rpg-add-section-#{@plan.id}" do %>
    <%= render "life_journeys/rpg_add_project",
          plan: @plan,
          area: @created.life_area,
          goal: @goal %>
  <% end %>
  <% if @created.project? && !@created.holding? %>
    <%= turbo_stream.append "trail-camps" do %>
      <%= render "life_journeys/trail_camp",
            project: @created,
            index: [ @plan.children.count { |c| c.project? && !c.holding? } - 1, 0 ].max,
            total: [ @plan.children.count { |c| c.project? && !c.holding? }, 1 ].max %>
    <% end %>
    <%= turbo_stream.append "trail-sheet-title-row" do %>
      <div id="trail-sheet-menu-<%= @created.id %>"
           class="lp-trail-sheet__camp-menu"
           data-controller="plan-card-menu"
           data-camp-menu-panel="<%= @created.id %>"
           hidden>
        <%= render "life_journeys/trail_camp_sheet_menu", project: @created %>
      </div>
    <% end %>
    <%= turbo_stream.append "trail-sheet-body" do %>
      <div class="lp-trail-sheet__camp"
           id="trail-sheet-camp-<%= @created.id %>"
           data-camp-panel="<%= @created.id %>"
           hidden>
        <%= render "life_journeys/trail_camp_battles",
              project: @created,
              goal: @goal,
              plan: @plan,
              area: @created.life_area %>
      </div>
    <% end %>
  <% end %>
<% end %>
