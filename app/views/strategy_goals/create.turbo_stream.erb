<%= turbo_stream.replace "strategy-world-map" do %>
  <%= render "life_journeys/strategy_mountain", mountain: @mountain || { stage: :empty, progress: 0, flags: 0, label: "" } %>
<% end %>

<%= turbo_stream.replace "strategy-camp-notebook-root" do %>
  <div id="strategy-camp-notebook-root">
    <%= render "life_journeys/strategy_camp_notebook" %>
  </div>
<% end %>

<% if @created %>
  <%= turbo_stream.append "strategy-world" do %>
    <%= render "life_journeys/strategy_pin_menu", node: @created %>
    <%= render "life_journeys/strategy_node_sheet", node: @created %>
  <% end %>
<% end %>
