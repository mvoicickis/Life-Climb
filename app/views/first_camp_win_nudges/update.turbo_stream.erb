<%= turbo_stream.replace "trail-sheet-camp-#{@project.id}" do %>
  <div class="lp-trail-sheet__camp"
       id="trail-sheet-camp-<%= @project.id %>"
       data-camp-panel="<%= @project.id %>"
       hidden>
    <%= render "life_journeys/camp_sheet_battles",
          project: @project,
          goal: @goal,
          plan: @plan,
          area: @area,
          journey: @journey %>
  </div>
<% end %>
