<% content_for :title, t("auth.update_title") %>

<div class="mx-auto max-w-md">
  <%= render "shared/auth_topbar" %>

  <h1 class="mb-2 mt-8 text-4xl font-black tracking-tight text-slate-900"><%= t("auth.update_title") %></h1>
  <p class="mb-8 font-semibold text-slate-600"><%= t("auth.update_subtitle") %></p>

  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4", data: { turbo: false } do |form| %>
    <div>
      <%= form.label :password, t("auth.new_password"), class: "mb-1 block text-sm font-bold text-slate-800" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
          class: "w-full rounded-2xl border-2 border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 focus:border-emerald-500 focus:outline-none" %>
    </div>
    <div>
      <%= form.label :password_confirmation, t("auth.repeat_password"), class: "mb-1 block text-sm font-bold text-slate-800" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
          class: "w-full rounded-2xl border-2 border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 focus:border-emerald-500 focus:outline-none" %>
    </div>
    <%= form.submit t("auth.save_password"),
        class: "w-full cursor-pointer rounded-2xl bg-emerald-500 px-4 py-3 font-black text-white hover:bg-emerald-600" %>
  <% end %>
</div>
