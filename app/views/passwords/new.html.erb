<% content_for :title, "Forgot password" %>

<div class="mx-auto max-w-md">
  <p class="mb-6">
    <%= link_to t("landing.back_home"), root_path, class: "text-sm font-bold text-emerald-600 hover:text-emerald-500" %>
  </p>

  <h1 class="mb-2 text-4xl font-black">Forgot your password?</h1>
  <p class="mb-8 text-slate-600">We’ll email you a reset link.</p>

  <%= form_with url: passwords_path, class: "space-y-4", data: { turbo: false } do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "mb-1 block text-sm font-bold" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          value: params[:email_address],
          class: "w-full rounded-2xl border-2 border-slate-200 px-4 py-3 font-semibold focus:border-emerald-500 focus:outline-none" %>
    </div>
    <%= form.submit "Email reset instructions",
        class: "w-full cursor-pointer rounded-2xl bg-emerald-500 px-4 py-3 font-black text-white hover:bg-emerald-600" %>
  <% end %>

  <p class="mt-6 text-center text-sm text-slate-600">
    <%= link_to t("landing.sign_in"), new_session_path, class: "font-bold text-emerald-700" %>
  </p>
</div>
