<% content_for :title, t("auth.forgot_title") %>

<% if authenticated? %>
  <% content_for :lp_game, true %>
  <% content_for :lp_hide_top_nav, true %>

  <div class="lp-home mx-auto max-w-lg space-y-6 px-4 pb-24 pt-5">
    <header class="flex items-center gap-3">
      <%= link_to settings_path, class: "rounded-xl border border-[var(--lp-border)] px-3 py-2 text-sm font-bold text-[var(--lp-ink)]" do %>
        ← <%= t("settings.back") %>
      <% end %>
      <div class="min-w-0">
        <h1 class="truncate text-xl font-semibold text-[var(--lp-ink)]"><%= t("settings.change_password") %></h1>
        <p class="text-sm text-[var(--lp-muted)]"><%= t("auth.forgot_subtitle") %></p>
      </div>
    </header>

    <section class="lp-glass p-5">
      <%= form_with url: passwords_path, class: "space-y-3", data: { turbo: false } do |form| %>
        <%= form.label :email_address, t("auth.email"), class: "lp-auth-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            value: params[:email_address].presence || Current.user&.email_address,
            class: "lp-input w-full" %>
        <%= form.submit t("auth.forgot_submit"), class: "lp-cta mt-2 w-full" %>
      <% end %>
    </section>
  </div>

  <%= render "shared/lp_dash_nav", active: :you %>
<% else %>
  <div class="mx-auto max-w-md">
    <%= render "shared/auth_topbar" %>

    <h1 class="mb-2 mt-8 text-4xl font-black tracking-tight text-slate-900"><%= t("auth.forgot_title") %></h1>
    <p class="mb-8 font-semibold text-slate-600"><%= t("auth.forgot_subtitle") %></p>

    <%= form_with url: passwords_path, class: "space-y-4", data: { turbo: false } do |form| %>
      <div>
        <%= form.label :email_address, t("auth.email"), class: "mb-1 block text-sm font-bold text-slate-800" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            value: params[:email_address],
            class: "w-full rounded-2xl border-2 border-slate-200 bg-white px-4 py-3 font-semibold text-slate-900 focus:border-emerald-500 focus:outline-none" %>
      </div>
      <%= form.submit t("auth.forgot_submit"),
          class: "w-full cursor-pointer rounded-2xl bg-emerald-500 px-4 py-3 font-black text-white hover:bg-emerald-600" %>
    <% end %>

    <p class="mt-6 text-center text-sm font-semibold text-slate-600">
      <%= link_to t("auth.sign_in_submit"), new_session_path, class: "font-bold text-emerald-700 hover:text-emerald-600" %>
    </p>
  </div>
<% end %>
