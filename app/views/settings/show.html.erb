<% content_for :title, t("settings.title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>
<% focus_area = @focus_life_area || current_user.focus_life_area %>
<% row_class = "flex items-center justify-between gap-3 rounded-xl border border-[var(--lp-border)] bg-[var(--lp-elevated)] px-4 py-3 text-sm font-bold text-[var(--lp-ink)] transition hover:border-[var(--lp-lime)]" %>

<div class="lp-home mx-auto max-w-lg space-y-6 px-4 pb-24 pt-5">
  <header>
    <p class="lp-brand-kicker">
      <%= render "shared/lp_brand_mark", size: 22, class_name: "lp-brand-kicker__mark" %>
      <span><%= t("app_name") %></span>
    </p>
    <h1 class="text-3xl font-semibold text-[var(--lp-ink)]"><%= t("settings.title") %></h1>
    <p class="mt-2 text-sm text-[var(--lp-muted)]"><%= t("settings.subtitle") %></p>
  </header>

  <section class="lp-glass p-5">
    <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("settings.make_yours_title") %></h2>
    <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("settings.make_yours_hint") %></p>

    <div class="mt-4 space-y-2">
      <%= link_to edit_today_count_settings_path, class: row_class do %>
        <span><%= t("settings.change_today_count") %></span>
        <span class="shrink-0 font-semibold text-[var(--lp-muted)]"><%= current_user.home_stat_count %></span>
      <% end %>

      <%= link_to edit_name_settings_path, class: row_class do %>
        <span><%= t("settings.change_name") %></span>
        <span class="min-w-0 truncate font-semibold text-[var(--lp-muted)]"><%= current_user.name.presence || "—" %></span>
      <% end %>

      <%= link_to life_area_selections_path, class: row_class do %>
        <span><%= t("settings.life_area_label") %></span>
        <span class="min-w-0 truncate font-semibold text-[var(--lp-muted)]">
          <%= focus_area&.label.presence || t("settings.choose_life_area") %>
        </span>
      <% end %>
    </div>
  </section>

  <section class="lp-glass p-5"
           data-controller="share"
           data-share-text-value="<%= invite_share_message_body %>"
           data-share-url-value="<%= share_landing_url %>"
           data-share-title-value="<%= t('share.invite.title') %>">
    <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("support.title") %></h2>
    <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("settings.support_body") %></p>
    <%= link_to t("support.cta_short"), support_path, class: "lp-cta mt-4 inline-flex" %>
    <div class="mt-4 flex flex-wrap gap-3">
      <button type="button"
              class="rounded-xl border border-[var(--lp-border)] px-4 py-2 text-sm font-bold text-[var(--lp-ink)]"
              data-action="click->share#open">
        <%= t("share.invite.cta_short") %>
      </button>
      <%= link_to t("settings.contact_me"), new_feedback_path, class: "rounded-xl border border-[var(--lp-border)] px-4 py-2 text-sm font-bold text-[var(--lp-ink)]" %>
      <%= link_to t("about.title"), about_path, class: "rounded-xl border border-[var(--lp-border)] px-4 py-2 text-sm font-bold text-[var(--lp-ink)]" %>
    </div>
    <%= render "shared/share_sheet",
          title: t("share.invite.title"),
          subtitle: t("share.invite.subtitle") %>
  </section>

  <section class="lp-glass p-5">
    <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--lp-muted)]"><%= t("settings.account") %></h2>
    <div class="mt-3 flex flex-wrap gap-3">
      <%= link_to t("settings.change_password"), new_password_path, class: "rounded-xl border border-[var(--lp-border)] px-4 py-2 text-sm font-bold text-[var(--lp-ink)]" %>
      <% if current_user.admin? %>
        <%= link_to t("nav.admin"), admin_root_path, class: "rounded-xl bg-[var(--lp-elevated)] px-4 py-2 text-sm font-bold text-[var(--lp-ink)]" %>
      <% end %>
      <%= button_to t("nav.sign_out"), session_path, method: :delete, class: "cursor-pointer rounded-xl border border-[var(--lp-rose)]/40 px-4 py-2 text-sm font-bold text-[var(--lp-rose)]" %>
    </div>
  </section>

  <p>
    <%= link_to t("habits.back_today"), dashboard_path, class: "font-bold text-[var(--lp-lime)]" %>
  </p>
</div>

<%= render "shared/lp_dash_nav", active: :you %>
