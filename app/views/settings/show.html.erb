<% content_for :title, t("settings.title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>
<% highlight = params[:highlight].to_s %>
<% open_panel = highlight == "name" ? highlight : nil %>

<div class="lp-you"
     data-controller="you-page"
     data-you-page-open="<%= open_panel %>">
  <h1 class="lp-you-sr"><%= t("settings.title") %></h1>

  <div class="lp-you__scroll">
    <div class="lp-you__hero">
      <div class="lp-you__cover" aria-hidden="true">
        <%= image_tag mountain_trail_photo_url(@commitment_journey),
              class: "lp-you__cover-img",
              alt: "",
              decoding: "async" %>
      </div>

      <header class="lp-you__profile is-hero<%= ' lp-you-row--flash' if highlight == 'name' %>">
        <%= render "settings/avatar_picker", user: current_user, size: :lg %>

        <div class="lp-you__profile-copy is-hero">
          <div class="lp-you__profile-meta" <%= "hidden" if highlight == "name" %> data-you-page-target="nameButton">
            <p class="lp-you__name-text is-hero"><%= current_user.name.presence || t("settings.change_name") %></p>
            <p class="lp-you__since">
              <span><%= t("settings.climbing_since", date: l(@climbing_since_on, format: "%B %Y")) %></span>
              <button type="button"
                      class="lp-you__edit"
                      data-action="click->you-page#editName">
                <%= t("settings.edit") %>
              </button>
            </p>
          </div>
          <%= form_with model: current_user, url: settings_path, method: :patch,
                html: { class: "lp-you__name-form is-hero", hidden: highlight != "name",
                        data: { you_page_target: "nameForm", turbo: false } } do %>
            <%= text_field_tag "user[name]", current_user.name,
                  class: "lp-you__name-input is-hero",
                  maxlength: 40,
                  autocomplete: "name",
                  data: { you_page_target: "nameInput", action: "keydown->you-page#nameKey" } %>
          <% end %>
        </div>

        <div class="lp-you__stats" aria-label="<%= t('settings.profile_stats_label') %>">
          <div class="lp-you__stat">
            <span class="lp-you__stat-icon" aria-hidden="true">⚔️</span>
            <strong class="lp-you__stat-number"><%= @you_battles_won %></strong>
            <span class="lp-you__stat-label"><%= t("settings.stats.battles_won") %></span>
          </div>
          <div class="lp-you__stat">
            <span class="lp-you__stat-icon" aria-hidden="true">⛺</span>
            <strong class="lp-you__stat-number"><%= @you_camps_finished %></strong>
            <span class="lp-you__stat-label"><%= t("settings.stats.camps_finished") %></span>
          </div>
          <div class="lp-you__stat">
            <span class="lp-you__stat-icon" aria-hidden="true">📅</span>
            <strong class="lp-you__stat-number"><%= @you_days_won %></strong>
            <span class="lp-you__stat-label"><%= t("settings.stats.days_won") %></span>
          </div>
        </div>
      </header>
    </div>

    <div class="lp-you__groups">
      <section class="lp-you-card lp-you-card--partner" id="you-climb-together">
        <% if @climb_partner %>
          <%= link_to climb_together_path, class: "lp-you-partner lp-pressable", id: "you-row-climb-together" do %>
            <%= render "shared/avatar_circle", user: @climb_partner, size: :sm %>
            <span class="lp-you-partner__label">
              <%= t("climb_together.you.partnered", name: @climb_partner.display_name) %>
            </span>
            <span class="lp-you-row__chev" aria-hidden="true">›</span>
          <% end %>
        <% else %>
          <div data-controller="climb-together-invite share"
               data-share-text-value="<%= t('climb_together.share.text') %>"
               data-share-url-value="<%= absolute_url(climb_invite_path(@climb_invite.token)) %>"
               data-share-title-value="<%= t('climb_together.share.title') %>">
            <button type="button"
                    class="lp-you-partner lp-pressable"
                    id="you-row-climb-together"
                    data-action="click->climb-together-invite#open">
              <span class="lp-you-row__icon" aria-hidden="true">🤝</span>
              <span class="lp-you-partner__label"><%= t("climb_together.you.row_title") %></span>
              <span class="lp-you-row__chev" aria-hidden="true">›</span>
            </button>
            <%= render "shared/climb_together_sheet" %>
            <%= render "shared/share_sheet",
                  title: t("climb_together.share.title"),
                  subtitle: t("climb_together.share.subtitle") %>
          </div>
        <% end %>
      </section>

      <div class="lp-you-group">
        <h2 class="lp-you-group__title"><%= t("settings.groups.app") %></h2>
        <section class="lp-you-card"
                 <% unless play_app? %>
                 data-controller="billing-checkout"
                 data-billing-checkout-checkout-url-value="<%= billing_checkout_path %>"
                 data-billing-checkout-portal-url-value="<%= billing_portal_path %>"
                 <% end %>>
          <div id="you-reminders"
               data-controller="push-reminders"
               data-push-reminders-vapid-url-value="<%= push_config_path(format: :json) %>"
               data-push-reminders-subscribe-url-value="<%= push_subscription_path %>"
               data-push-reminders-unsubscribe-url-value="<%= push_subscription_path %>"
               data-status-on="<%= t('settings.reminders_status_on') %>"
               data-status-off="<%= t('settings.reminders_status_off') %>"
               data-enabled-message="<%= t('settings.reminders_enabled') %>"
               data-disabled-message="<%= t('settings.reminders_disabled') %>"
               data-denied-message="<%= t('settings.reminders_denied') %>"
               data-unsupported-message="<%= t('settings.reminders_unsupported') %>"
               data-error-message="<%= t('settings.reminders_error') %>"
               data-setting-up-message="<%= t('settings.reminders_setting_up') %>"
               data-off-phone-message="<%= t('settings.reminders_off_phone') %>"
               data-blocked-phone-message="<%= t('settings.reminders_blocked_phone') %>"
               data-unsupported-chrome-message="<%= t('settings.reminders_unsupported_chrome') %>"
               data-fix-step-apps="<%= t('settings.reminders_fix_step_apps') %>"
               data-fix-step-battery="<%= t('settings.reminders_fix_step_battery') %>"
               data-browser-fallback="<%= t('settings.reminders_browser_fallback') %>">
            <div class="lp-you-row lp-you-row--static">
              <span class="lp-you-row__icon" aria-hidden="true">🔔</span>
              <span class="lp-you-row__label"><%= t("settings.reminders_title") %></span>
              <button type="button"
                      class="lp-you-switch"
                      role="switch"
                      aria-checked="false"
                      aria-label="<%= t('settings.reminders_title') %>"
                      data-push-reminders-target="switch"
                      data-action="click->push-reminders#toggleSwitch">
                <span class="lp-you-switch__knob"></span>
              </button>
            </div>
            <div class="lp-you-reminders-hint" data-push-reminders-target="hint" hidden>
              <p class="lp-you-reminders-hint__text" data-push-reminders-target="hintText"></p>
              <button type="button"
                      class="lp-you-reminders-hint__action"
                      data-push-reminders-target="turnOn"
                      data-action="click->push-reminders#turnOn"
                      hidden>
                <%= t("settings.reminders_turn_on") %>
              </button>
              <button type="button"
                      class="lp-you-reminders-hint__action"
                      data-push-reminders-target="howToFix"
                      data-action="click->push-reminders#toggleDeniedHelp"
                      hidden>
                <%= t("settings.reminders_how_to_fix") %>
              </button>
              <a class="lp-you-reminders-hint__action"
                 data-push-reminders-target="openChrome"
                 hidden>
                <%= t("settings.reminders_open_chrome") %>
              </a>
              <ol class="lp-you-reminders-hint__steps" data-push-reminders-target="deniedSteps" hidden>
                <li data-push-reminders-target="fixStepApps"></li>
                <li data-push-reminders-target="fixStepBattery"></li>
              </ol>
            </div>
            <button type="button" class="lp-you-sr" data-push-reminders-target="enable" data-action="click->push-reminders#enable">
              <%= t("settings.reminders_enable") %>
            </button>
            <button type="button" class="lp-you-sr" hidden data-push-reminders-target="disable" data-action="click->push-reminders#disable">
              <%= t("settings.reminders_disable") %>
            </button>
            <% unless play_app? || current_user.install_offer_installed_at? %>
              <div id="you-row-install-offer"
                   class="lp-you-row lp-you-row--install"
                   data-controller="pwa-install"
                   data-pwa-install-surface-value="settings"
                   data-pwa-install-dismiss-url-value="<%= install_offer_path %>"
                   data-pwa-install-installed-url-value="<%= install_offer_path %>"
                   data-pwa-install-browser-menu-message-value="<%= t('settings.install_offer.browser_menu') %>">
                <button type="button"
                        class="lp-you-row__tap"
                        data-pwa-install-target="row"
                        data-action="click->pwa-install#install">
                  <span class="lp-you-row__icon" aria-hidden="true">📲</span>
                  <span class="lp-you-row__label"><%= t("settings.install_offer.row_label") %></span>
                  <span class="lp-you-row__chev" aria-hidden="true">›</span>
                </button>
                <p class="lp-you-sr" data-pwa-install-target="message"></p>
              </div>
            <% end %>
            <p class="lp-you-sr" hidden data-push-reminders-target="message"></p>
          </div>
          <div id="you-sound"
               class="lp-you-row lp-you-row--static"
               data-controller="sound-setting"
               data-sound-setting-url-value="<%= settings_path(format: :json) %>"
               data-sound-setting-enabled-value="<%= current_user.sound_enabled? %>"
               data-sound-setting-not-saved-value="<%= t('settings.sound_not_saved') %>">
            <span class="lp-you-row__icon" aria-hidden="true">🔊</span>
            <span class="lp-you-row__label"><%= t("settings.sound_title") %></span>
            <button type="button"
                    class="lp-you-switch<%= ' is-on' if current_user.sound_enabled? %>"
                    role="switch"
                    aria-checked="<%= current_user.sound_enabled? %>"
                    aria-label="<%= t('settings.sound_title') %>"
                    data-sound-setting-target="switch"
                    data-action="click->sound-setting#toggle">
              <span class="lp-you-switch__knob"></span>
            </button>
          </div>
          <% unless play_app? %>
            <%= link_to pricing_path, class: "lp-you-row lp-pressable" do %>
              <span class="lp-you-row__icon" aria-hidden="true">⭐</span>
              <span class="lp-you-row__label"><%= t("pricing.premium_title") %></span>
              <span class="lp-you-row__trail">
                <span class="lp-you-row__value is-strong">
                  <%= current_user.premium? ? t("pricing.already_premium") : t("pricing.upgrade_cta") %>
                </span>
                <span class="lp-you-row__chev" aria-hidden="true">›</span>
              </span>
            <% end %>
            <% if current_user.stripe_customer_id.present? && StripeConfig.configured? %>
              <button type="button"
                      class="lp-you-row"
                      data-action="billing-checkout#portal"
                      data-billing-checkout-target="button">
                <span class="lp-you-row__icon" aria-hidden="true">💳</span>
                <span class="lp-you-row__label"><%= t("pricing.manage_billing") %></span>
                <span class="lp-you-row__chev" aria-hidden="true">›</span>
              </button>
            <% end %>
          <% end %>
        </section>
      </div>

      <div class="lp-you-group">
        <h2 class="lp-you-group__title"><%= t("settings.groups.friends") %></h2>
        <section class="lp-you-card"
                 data-controller="share"
                 data-share-text-value="<%= invite_share_message_body %>"
                 data-share-url-value="<%= referral_share_url %>"
                 data-share-title-value="<%= t('share.invite.title') %>">
          <button type="button" class="lp-you-row" data-action="click->share#open">
            <span class="lp-you-row__icon" aria-hidden="true">💌</span>
            <span class="lp-you-row__label"><%= t("settings.invite_short") %></span>
            <span class="lp-you-row__chev" aria-hidden="true">›</span>
          </button>
          <%= link_to new_feedback_path, class: "lp-you-row", id: "you-row-feedback" do %>
            <span class="lp-you-row__icon" aria-hidden="true">💬</span>
            <span class="lp-you-row__label"><%= t("settings.send_feedback") %></span>
            <span class="lp-you-row__chev" aria-hidden="true">›</span>
          <% end %>
          <%= render "shared/share_sheet",
                title: t("share.invite.title"),
                subtitle: t("share.invite.subtitle") %>
        </section>
      </div>

      <div class="lp-you-group">
        <h2 class="lp-you-group__title"><%= t("settings.groups.account") %></h2>
        <section class="lp-you-card">
          <%= link_to new_password_path, class: "lp-you-row" do %>
            <span class="lp-you-row__icon" aria-hidden="true">🔑</span>
            <span class="lp-you-row__label"><%= t("settings.change_password") %></span>
            <span class="lp-you-row__chev" aria-hidden="true">›</span>
          <% end %>
          <% if current_user.privileged_for_2fa? && !impersonating? %>
            <%= link_to settings_two_factor_path, class: "lp-you-row", id: "you-two-factor" do %>
              <span class="lp-you-row__icon" aria-hidden="true">🛡️</span>
              <span class="lp-you-row__label"><%= t("settings.two_step_login") %></span>
              <span class="lp-you-row__trail">
                <span class="lp-you-row__value">
                  <%= current_user.otp_enabled? ? t("two_factor.status_on") : t("two_factor.status_off") %>
                </span>
                <span class="lp-you-row__chev" aria-hidden="true">›</span>
              </span>
            <% end %>
          <% end %>
        </section>
        <%= button_to session_path,
              method: :delete,
              class: "lp-you-signout lp-you-row--signout",
              form: { class: "lp-you-signout-form", data: { turbo: false, action: "submit->offline-page-cache#clearBeforeSignOut" } } do %>
          <%= t("nav.sign_out") %>
        <% end %>
      </div>

      <% if (current_user.admin? && !impersonating?) || (developer? && !impersonating?) %>
        <div class="lp-you-group" id="you-admin-group">
          <h2 class="lp-you-group__title"><%= t("settings.groups.admin") %></h2>
          <section class="lp-you-card">
            <% if current_user.admin? && !impersonating? %>
              <%= link_to admin_root_path, class: "lp-you-row" do %>
                <span class="lp-you-row__icon" aria-hidden="true">⚙️</span>
                <span class="lp-you-row__label"><%= t("nav.admin") %></span>
                <span class="lp-you-row__chev" aria-hidden="true">›</span>
              <% end %>
            <% end %>
            <% if developer? && !impersonating? %>
              <%= button_to restart_new_player_experience_developer_tools_path,
                    method: :post,
                    class: "lp-you-row",
                    form: {
                      data: {
                        turbo_confirm: t("developer.tools.restart_npe_confirm"),
                        action: "submit->offline-page-cache#clearBeforeRestart"
                      }
                    } do %>
                <span class="lp-you-row__icon" aria-hidden="true">↻</span>
                <span class="lp-you-row__label"><%= t("developer.tools.restart_npe") %></span>
                <span class="lp-you-row__chev" aria-hidden="true">›</span>
              <% end %>
            <% end %>
          </section>
        </div>
      <% end %>
    </div>

    <% if developer? && !impersonating? %>
      <p class="lp-you-sr"><%= t("developer.tools.title") %></p>
    <% end %>

    <% unless impersonating? %>
      <div class="lp-you__delete"
           data-controller="delete-account"
           data-delete-account-open-value="<%= @account_delete_open %>">
        <button type="button"
                class="lp-you__delete-link"
                data-action="click->delete-account#open">
          <%= t("account_delete.open") %>
        </button>
        <%= render "shared/delete_account_sheet",
              open: @account_delete_open,
              error_key: @account_delete_sheet_error %>
      </div>
    <% end %>

    <p class="lp-you-foot">
      <%= t("settings.footer_mark") %>
      · <span data-you-page-target="version" aria-label="<%= t('settings.version_label') %>"></span>
    </p>
    <%= render "shared/legal_footer_links" %>
  </div>
</div>

<%= render "shared/lp_dash_nav", active: :you %>

<%= render "shared/first_tip_layer", page: :you %>
