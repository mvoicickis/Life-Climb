<% content_for :title, "Settings" %>

<div class="mx-auto max-w-lg">
  <h1 class="text-4xl font-black text-slate-900">Settings</h1>
  <p class="mt-2 text-slate-600">How Home looks for you.</p>

  <%= form_with model: current_user, url: settings_path, method: :patch, class: "mt-6 rounded-3xl border-2 border-slate-200 bg-white p-5 shadow-sm", data: { turbo: false } do |form| %>
    <%= form.label :home_stat_count, "How many stats to show on Home?", class: "block text-sm font-bold text-slate-800" %>
    <%= form.number_field :home_stat_count,
        min: 1,
        max: 20,
        class: "mt-2 w-full rounded-2xl border-2 border-slate-200 px-4 py-3 text-xl font-black focus:border-emerald-500 focus:outline-none" %>
    <p class="mt-2 text-xs font-semibold text-slate-500">Pick a number from 1 to 20.</p>

    <%= form.submit "Save", class: "mt-4 w-full cursor-pointer rounded-2xl bg-emerald-500 px-4 py-3 font-black text-white hover:bg-emerald-600" %>
  <% end %>

  <section class="mt-8">
    <h2 class="text-xl font-black text-slate-900">Order on Home</h2>
    <p class="mt-1 text-sm font-semibold text-slate-600">Drag to change the order. Top ones show first.</p>

    <% if @home_habits.any? %>
      <ul id="home-order-list"
          class="mt-4 space-y-2"
          data-controller="sortable"
          data-sortable-url-value="<%= reorder_settings_path %>">
        <% @home_habits.each do |habit| %>
          <li class="flex cursor-grab items-center justify-between rounded-2xl border-2 border-slate-200 bg-white px-4 py-3 shadow-sm active:cursor-grabbing"
              data-id="<%= habit.id %>"
              draggable="true"
              data-sortable-target="item">
            <div>
              <p class="font-black text-slate-900"><%= habit.name %></p>
              <p class="text-xs font-bold text-slate-500"><%= habit.unit %></p>
            </div>
            <span class="text-xs font-black text-slate-400">DRAG</span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 rounded-2xl border-2 border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
        Nothing marked “On Home” yet.
      </p>
    <% end %>
  </section>

  <p class="mt-6">
    <%= link_to "← Home", root_path, class: "font-bold text-emerald-700" %>
  </p>
</div>
