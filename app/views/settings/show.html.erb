<% content_for :title, "Settings" %>

<div class="mx-auto max-w-lg space-y-8">
  <header>
    <h1 class="text-4xl font-black tracking-tight text-slate-900">Settings</h1>
    <p class="mt-2 text-base font-semibold text-slate-600">Shape Home so it stays simple and motivating.</p>
  </header>

  <section class="rounded-3xl border-2 border-slate-200/80 bg-white/90 p-6 shadow-sm">
    <h2 class="text-lg font-black text-slate-900">How many on Home</h2>
    <p class="mt-1 text-sm font-semibold text-slate-500">Fewer cards = clearer focus.</p>

    <%= form_with model: current_user, url: settings_path, method: :patch, class: "mt-4", data: { turbo: false } do |form| %>
      <%= form.number_field :home_stat_count,
          min: 1,
          max: 20,
          class: "w-full rounded-2xl border-2 border-slate-200 px-4 py-3 text-xl font-black focus:border-emerald-500 focus:outline-none" %>
      <%= form.submit "Save", class: "mt-4 w-full cursor-pointer rounded-2xl bg-emerald-500 px-4 py-3 font-black text-white hover:bg-emerald-600" %>
    <% end %>
  </section>

  <section>
    <h2 class="text-lg font-black text-slate-900">What appears on Home</h2>
    <p class="mt-1 text-sm font-semibold text-slate-500">Turn items on or off. Drag to change order.</p>

    <% if @all_habits.any? %>
      <ul class="mt-4 space-y-2">
        <% @all_habits.each do |habit| %>
          <li class="flex items-center justify-between gap-3 rounded-2xl border-2 border-slate-200/80 bg-white/90 px-4 py-3 shadow-sm">
            <div class="min-w-0">
              <p class="truncate font-black text-slate-900"><%= habit.name %></p>
              <p class="text-xs font-bold text-slate-500"><%= habit.unit %> · <%= habit.evaluation_label %></p>
            </div>
            <%= button_to (habit.show_on_home? ? "On Home" : "Hidden"),
                settings_habit_path(habit),
                method: :patch,
                params: { show_on_home: !habit.show_on_home? },
                class: "shrink-0 cursor-pointer rounded-xl px-3 py-2 text-xs font-black #{habit.show_on_home? ? 'bg-emerald-500 text-white' : 'border-2 border-slate-200 text-slate-600'}" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 rounded-2xl border-2 border-dashed border-slate-300 bg-white/80 p-6 text-center text-slate-600">
        Nothing to show yet. <%= link_to "Add something", new_habit_path, class: "font-bold text-emerald-700" %>.
      </p>
    <% end %>
  </section>

  <section>
    <h2 class="text-lg font-black text-slate-900">Order on Home</h2>
    <p class="mt-1 text-sm font-semibold text-slate-500">Top ones show first.</p>

    <% if @home_habits.any? %>
      <ul id="home-order-list"
          class="mt-4 space-y-2"
          data-controller="sortable"
          data-sortable-url-value="<%= reorder_settings_path %>">
        <% @home_habits.each do |habit| %>
          <li class="flex cursor-grab items-center justify-between rounded-2xl border-2 border-slate-200/80 bg-white/90 px-4 py-3 shadow-sm active:cursor-grabbing"
              data-id="<%= habit.id %>"
              draggable="true"
              data-sortable-target="item">
            <div>
              <p class="font-black text-slate-900"><%= habit.name %></p>
              <p class="text-xs font-bold text-slate-500"><%= habit.unit %></p>
            </div>
            <span class="text-xs font-black text-slate-400">DRAG</span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 rounded-2xl border-2 border-dashed border-slate-300 bg-white/80 p-6 text-center text-slate-600">
        Nothing marked for Home yet.
      </p>
    <% end %>
  </section>

  <section class="rounded-3xl border-2 border-emerald-100 bg-emerald-50/50 p-5">
    <h2 class="text-lg font-black text-slate-900">Feedback</h2>
    <p class="mt-1 text-sm font-semibold text-slate-600">Tell us what’s working or what would help.</p>
    <%= link_to "Send feedback", new_feedback_path,
        class: "mt-4 inline-flex rounded-2xl bg-emerald-500 px-4 py-3 text-sm font-black text-white hover:bg-emerald-600" %>
  </section>

  <section class="rounded-3xl border-2 border-slate-100 bg-slate-50/80 p-5">
    <h2 class="text-sm font-black uppercase tracking-wide text-slate-500">Account</h2>
    <div class="mt-3 flex flex-wrap gap-3">
      <%= link_to "Change password", new_password_path, class: "rounded-xl border-2 border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700" %>
      <% if current_user.admin? %>
        <%= link_to "Admin", admin_root_path, class: "rounded-xl border-2 border-slate-900 bg-slate-900 px-4 py-2 text-sm font-bold text-white" %>
      <% end %>
      <%= button_to "Sign out", session_path, method: :delete, class: "cursor-pointer rounded-xl border-2 border-rose-200 bg-white px-4 py-2 text-sm font-bold text-rose-700" %>
    </div>
  </section>

  <p>
    <%= link_to "← Home", dashboard_path, class: "font-bold text-emerald-700" %>
  </p>
</div>
