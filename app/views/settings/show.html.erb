<% content_for :title, t("settings.title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>
<% highlight = params[:highlight].to_s %>
<% row_class = "group flex items-center justify-between gap-3 rounded-xl border border-[var(--lp-border)] bg-[var(--lp-elevated)] px-4 py-3 text-sm font-bold text-[var(--lp-ink)] transition hover:border-[var(--lp-lime)]" %>
<% chevron = tag.span("›", class: "shrink-0 text-lg leading-none text-[var(--lp-muted)] transition group-hover:text-[var(--lp-lime)]", "aria-hidden": true) %>

<div class="lp-home mx-auto max-w-lg">
  <header>
    <p class="lp-brand-kicker">
      <%= render "shared/lp_brand_mark", size: 22, class_name: "lp-brand-kicker__mark" %>
      <span><%= t("app_name") %></span>
    </p>
    <h1 class="lp-home__title"><%= t("settings.title") %></h1>
    <p class="lp-home__subtitle"><%= t("settings.subtitle") %></p>
  </header>

  <section class="lp-glass lp-glass--pad<%= ' lp-you-row--flash' if highlight == 'character' %>" id="you-character">
    <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("settings.make_yours_title") %></h2>
    <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("settings.make_yours_hint") %></p>

    <div class="mt-4 space-y-2">
      <%= link_to edit_name_settings_path,
            id: "you-row-name",
            class: [row_class, ("lp-you-row--flash" if highlight == "name")] do %>
        <span><%= t("settings.change_name") %></span>
        <span class="flex min-w-0 items-center gap-2">
          <span class="min-w-0 truncate font-semibold text-[var(--lp-muted)]"><%= current_user.name.presence || "—" %></span>
          <%= chevron %>
        </span>
      <% end %>
    </div>

    <div class="mt-6 border-t border-[var(--lp-border)] pt-5">
      <h3 class="text-base font-semibold text-[var(--lp-ink)]"><%= t("settings.character_title") %></h3>
      <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("settings.character_hint") %></p>
      <%= form_with model: current_user, url: settings_path, method: :patch, class: "mt-4", data: { turbo: false } do %>
        <%= render "shared/character_picker",
              selected: current_user.character_key,
              show_brand: false,
              show_heading: false,
              submit_label: t("settings.character_save") %>
      <% end %>
    </div>
  </section>

  <section class="lp-glass lp-glass--pad<%= ' lp-you-row--flash' if highlight == 'theme' %>" id="you-theme">
    <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("settings.theme_title") %></h2>
    <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("settings.theme_hint") %></p>
    <div class="lp-theme-switch mt-4" role="group" aria-label="<%= t('settings.theme_title') %>">
      <% User::THEMES.each do |theme_key| %>
        <% active = current_user.theme_key == theme_key %>
        <%= button_to settings_path,
              method: :patch,
              params: { user: { theme: theme_key } },
              class: "lp-theme-switch__btn#{' is-active' if active}",
              form: { class: "lp-theme-switch__form", data: { turbo: false } } do %>
          <%= t("settings.theme_#{theme_key}") %>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="lp-glass lp-glass--pad" id="you-language">
    <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("settings.language_title") %></h2>
    <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("settings.language_hint") %></p>
    <div class="mt-4">
      <%= render "shared/locale_switcher", variant: :settings %>
    </div>
  </section>

  <% if @commitment_journey %>
    <section class="lp-glass lp-glass--pad<%= ' lp-you-row--flash' if highlight == 'commitment' %>" id="you-commitment">
      <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("settings.commitment.title") %></h2>
      <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("settings.commitment.hint") %></p>

      <div class="lp-settings-commitment__presets mt-4">
        <% Today::Commitment::PRESETS.each do |key, preset| %>
          <% active = @commitment_journey.commitment_key == key %>
          <%= button_to t("settings.commitment.preset_label",
                name: t("v2_onboarding.commitment_presets.#{key}"),
                habits: preset[:habit_count],
                battles: preset[:battle_count]),
                commitment_settings_path,
                method: :patch,
                params: { commitment_key: key },
                class: "lp-settings-commitment__btn#{' is-active' if active}",
                form: { data: { turbo: false } } %>
        <% end %>
      </div>

      <%= form_with url: commitment_settings_path, method: :patch, class: "lp-settings-commitment__custom mt-5", data: { turbo: false } do %>
        <p class="text-sm font-semibold text-[var(--lp-ink)]"><%= t("settings.commitment.custom_title") %></p>
        <label class="lp-adventure__label mt-3" for="commitment_name"><%= t("settings.commitment.name_label") %></label>
        <%= text_field_tag :commitment_name, @commitment_journey.commitment_name,
              id: "commitment_name",
              maxlength: 40,
              class: "lp-input w-full" %>
        <div class="lp-settings-commitment__counts">
          <div>
            <label class="lp-adventure__label" for="commitment_habit_count"><%= t("settings.commitment.habits_label") %></label>
            <%= number_field_tag :commitment_habit_count, @commitment_journey.commitment_habit_count,
                  id: "commitment_habit_count", min: 0, max: 20, class: "lp-input w-full" %>
          </div>
          <div>
            <label class="lp-adventure__label" for="commitment_battle_count"><%= t("settings.commitment.battles_label") %></label>
            <%= number_field_tag :commitment_battle_count, @commitment_journey.commitment_battle_count,
                  id: "commitment_battle_count", min: 0, max: 20, class: "lp-input w-full" %>
          </div>
        </div>
        <%= submit_tag t("settings.commitment.save_custom"), class: "lp-cta mt-4" %>
      <% end %>
    </section>
  <% end %>

  <section class="lp-glass lp-glass--pad"
           id="you-reminders"
           data-controller="push-reminders"
           data-push-reminders-vapid-url-value="<%= push_config_path(format: :json) %>"
           data-push-reminders-subscribe-url-value="<%= push_subscription_path %>"
           data-push-reminders-unsubscribe-url-value="<%= push_subscription_path %>"
           data-push-reminders-test-url-value="<%= test_push_subscription_path %>"
           data-status-on="<%= t('settings.reminders_status_on') %>"
           data-status-off="<%= t('settings.reminders_status_off') %>"
           data-enabled-message="<%= t('settings.reminders_enabled') %>"
           data-disabled-message="<%= t('settings.reminders_disabled') %>"
           data-test-sent-message="<%= t('settings.reminders_test_sent') %>"
           data-denied-message="<%= t('settings.reminders_denied') %>"
           data-unsupported-message="<%= t('settings.reminders_unsupported') %>"
           data-error-message="<%= t('settings.reminders_error') %>">
    <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("settings.reminders_title") %></h2>
    <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("settings.reminders_hint") %></p>

    <p class="mt-3 text-sm font-semibold text-[var(--lp-ink)]">
      <%= t("settings.reminders_status_label") %>:
      <span data-push-reminders-target="status"><%= t("settings.reminders_status_off") %></span>
    </p>

    <div class="mt-4 flex flex-wrap gap-2">
      <button type="button"
              class="lp-cta"
              data-push-reminders-target="enable"
              data-action="click->push-reminders#enable">
        <%= t("settings.reminders_enable") %>
      </button>
      <button type="button"
              class="lp-cta"
              hidden
              data-push-reminders-target="disable"
              data-action="click->push-reminders#disable">
        <%= t("settings.reminders_disable") %>
      </button>
      <button type="button"
              class="rounded-xl border border-[var(--lp-border)] bg-[var(--lp-elevated)] px-4 py-2 text-sm font-bold text-[var(--lp-ink)]"
              data-push-reminders-target="test"
              data-action="click->push-reminders#sendTest"
              disabled>
        <%= t("settings.reminders_test") %>
      </button>
    </div>

    <p class="mt-3 text-sm text-[var(--lp-muted)]"
       hidden
       data-push-reminders-target="message"></p>

    <% pref = current_user.notification_preference %>
    <% notifications_status =
         if pref&.vacation_active?
           t("settings.notifications.status_paused")
         elsif pref
           t("settings.notifications.frequency.#{pref.frequency}")
         else
           t("settings.notifications.frequency.sometimes")
         end %>
    <div class="mt-5 border-t border-[var(--lp-border)] pt-4">
      <%= link_to settings_notifications_path,
            id: "you-row-notifications",
            class: row_class do %>
        <span><%= t("settings.notifications.row_label") %></span>
        <span class="flex min-w-0 items-center gap-2">
          <span class="min-w-0 truncate font-semibold text-[var(--lp-muted)]"><%= notifications_status %></span>
          <%= chevron %>
        </span>
      <% end %>
    </div>
  </section>

  <section class="lp-glass lp-glass--pad"
           data-controller="share"
           data-share-text-value="<%= invite_share_message_body %>"
           data-share-url-value="<%= share_landing_url %>"
           data-share-title-value="<%= t('share.invite.title') %>">
    <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("support.title") %></h2>
    <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("settings.support_body") %></p>
    <%= link_to t("support.cta_short"), support_path, class: "lp-cta mt-4 inline-flex" %>
    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
      <button type="button"
              class="text-sm font-bold text-[var(--lp-ink)] underline-offset-2 hover:underline"
              data-action="click->share#open">
        <%= t("share.invite.cta_short") %>
      </button>
      <%= link_to t("settings.contact_me"), new_feedback_path, class: "text-sm font-bold text-[var(--lp-ink)] underline-offset-2 hover:underline" %>
    </div>
    <%= render "shared/share_sheet",
          title: t("share.invite.title"),
          subtitle: t("share.invite.subtitle") %>
  </section>

  <% if current_user.privileged_for_2fa? && !impersonating? %>
    <section class="lp-glass lp-glass--pad" id="you-two-factor">
      <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("two_factor.settings_title") %></h2>
      <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("two_factor.settings_card_body") %></p>
      <div class="mt-4">
        <%= link_to settings_two_factor_path, class: row_class do %>
          <span>
            <%= current_user.otp_enabled? ? t("two_factor.manage") : t("two_factor.set_up") %>
          </span>
          <span class="flex min-w-0 items-center gap-2">
            <span class="min-w-0 truncate font-semibold text-[var(--lp-muted)]">
              <%= current_user.otp_enabled? ? t("two_factor.status_on") : t("two_factor.status_off") %>
            </span>
            <%= chevron %>
          </span>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if developer? && !impersonating? %>
    <section class="lp-glass lp-glass--pad" aria-label="<%= t('developer.tools.title') %>">
      <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--lp-muted)]"><%= t("developer.tools.title") %></h2>
      <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("developer.tools.subtitle") %></p>
      <div class="mt-3 space-y-2">
        <%= button_to restart_new_player_experience_developer_tools_path,
              method: :post,
              class: "group flex w-full cursor-pointer items-center justify-between gap-3 rounded-xl border border-[var(--lp-border)] bg-[var(--lp-elevated)] px-4 py-3 text-left text-sm font-bold text-[var(--lp-ink)] transition hover:border-[var(--lp-lime)]",
              form: {
                data: {
                  turbo_confirm: t("developer.tools.restart_npe_confirm")
                }
              } do %>
          <span><%= t("developer.tools.restart_npe") %></span>
          <span class="text-lg leading-none text-[var(--lp-muted)]" aria-hidden="true">›</span>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="lp-glass lp-glass--pad">
    <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--lp-muted)]"><%= t("settings.account") %></h2>
    <div class="mt-3 space-y-2">
      <%= link_to new_password_path, class: row_class do %>
        <span><%= t("settings.change_password") %></span>
        <%= chevron %>
      <% end %>
      <% if current_user.admin? && !impersonating? %>
        <%= link_to admin_root_path, class: row_class do %>
          <span><%= t("nav.admin") %></span>
          <%= chevron %>
        <% end %>
      <% end %>
      <%= button_to session_path,
            method: :delete,
            class: "group flex w-full cursor-pointer items-center justify-between gap-3 rounded-xl border border-[var(--lp-rose)]/40 bg-[var(--lp-elevated)] px-4 py-3 text-left text-sm font-bold text-[var(--lp-rose)]" do %>
        <span><%= t("nav.sign_out") %></span>
        <span class="text-lg leading-none" aria-hidden="true">›</span>
      <% end %>
    </div>
  </section>
</div>

<%= render "shared/lp_dash_nav", active: :you %>
