<% content_for :title, t("settings.title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>
<% highlight = params[:highlight].to_s %>
<% row_class = "group flex items-center justify-between gap-3 rounded-xl border border-[var(--lp-border)] bg-[var(--lp-elevated)] px-4 py-3 text-sm font-bold text-[var(--lp-ink)] transition hover:border-[var(--lp-lime)]" %>
<% chevron = tag.span("›", class: "shrink-0 text-lg leading-none text-[var(--lp-muted)] transition group-hover:text-[var(--lp-lime)]", "aria-hidden": true) %>

<div class="lp-home mx-auto max-w-lg space-y-6 px-4 pb-24 pt-5">
  <header>
    <p class="lp-brand-kicker">
      <%= render "shared/lp_brand_mark", size: 22, class_name: "lp-brand-kicker__mark" %>
      <span><%= t("app_name") %></span>
    </p>
    <h1 class="text-3xl font-semibold text-[var(--lp-ink)]"><%= t("settings.title") %></h1>
    <p class="mt-2 text-sm text-[var(--lp-muted)]"><%= t("settings.subtitle") %></p>
  </header>

  <section class="lp-glass p-5<%= ' lp-you-row--flash' if highlight == 'character' %>" id="you-character">
    <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("settings.make_yours_title") %></h2>
    <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("settings.make_yours_hint") %></p>

    <div class="mt-4 space-y-2">
      <%= link_to edit_name_settings_path,
            id: "you-row-name",
            class: [row_class, ("lp-you-row--flash" if highlight == "name")] do %>
        <span><%= t("settings.change_name") %></span>
        <span class="flex min-w-0 items-center gap-2">
          <span class="min-w-0 truncate font-semibold text-[var(--lp-muted)]"><%= current_user.name.presence || "—" %></span>
          <%= chevron %>
        </span>
      <% end %>
    </div>

    <div class="mt-6 border-t border-[var(--lp-border)] pt-5">
      <h3 class="text-base font-semibold text-[var(--lp-ink)]"><%= t("settings.character_title") %></h3>
      <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("settings.character_hint") %></p>
      <%= form_with model: current_user, url: settings_path, method: :patch, class: "mt-4", data: { turbo: false } do %>
        <%= render "shared/character_picker",
              selected: current_user.character_key,
              show_brand: false,
              show_heading: false,
              submit_label: t("settings.character_save") %>
      <% end %>
    </div>
  </section>

  <section class="lp-glass p-5" id="you-language">
    <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("settings.language_title") %></h2>
    <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("settings.language_hint") %></p>
    <div class="mt-4">
      <%= render "shared/locale_switcher", variant: :settings %>
    </div>
  </section>

  <section class="lp-glass p-5"
           data-controller="share"
           data-share-text-value="<%= invite_share_message_body %>"
           data-share-url-value="<%= share_landing_url %>"
           data-share-title-value="<%= t('share.invite.title') %>">
    <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("support.title") %></h2>
    <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("settings.support_body") %></p>
    <%= link_to t("support.cta_short"), support_path, class: "lp-cta mt-4 inline-flex" %>
    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
      <button type="button"
              class="text-sm font-bold text-[var(--lp-ink)] underline-offset-2 hover:underline"
              data-action="click->share#open">
        <%= t("share.invite.cta_short") %>
      </button>
      <%= link_to t("settings.contact_me"), new_feedback_path, class: "text-sm font-bold text-[var(--lp-ink)] underline-offset-2 hover:underline" %>
    </div>
    <%= render "shared/share_sheet",
          title: t("share.invite.title"),
          subtitle: t("share.invite.subtitle") %>
  </section>

  <% if developer? && !impersonating? %>
    <section class="lp-glass p-5" aria-label="<%= t('developer.tools.title') %>">
      <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--lp-muted)]"><%= t("developer.tools.title") %></h2>
      <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("developer.tools.subtitle") %></p>
      <div class="mt-3 space-y-2">
        <%= button_to restart_new_player_experience_developer_tools_path,
              method: :post,
              class: "group flex w-full cursor-pointer items-center justify-between gap-3 rounded-xl border border-[var(--lp-border)] bg-[var(--lp-elevated)] px-4 py-3 text-left text-sm font-bold text-[var(--lp-ink)] transition hover:border-[var(--lp-lime)]",
              form: {
                data: {
                  turbo_confirm: t("developer.tools.restart_npe_confirm")
                }
              } do %>
          <span><%= t("developer.tools.restart_npe") %></span>
          <span class="text-lg leading-none text-[var(--lp-muted)]" aria-hidden="true">›</span>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="lp-glass p-5">
    <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--lp-muted)]"><%= t("settings.account") %></h2>
    <div class="mt-3 space-y-2">
      <%= link_to new_password_path, class: row_class do %>
        <span><%= t("settings.change_password") %></span>
        <%= chevron %>
      <% end %>
      <% if current_user.admin? && !impersonating? %>
        <%= link_to admin_root_path, class: row_class do %>
          <span><%= t("nav.admin") %></span>
          <%= chevron %>
        <% end %>
      <% end %>
      <%= button_to session_path,
            method: :delete,
            class: "group flex w-full cursor-pointer items-center justify-between gap-3 rounded-xl border border-[var(--lp-rose)]/40 bg-[var(--lp-elevated)] px-4 py-3 text-left text-sm font-bold text-[var(--lp-rose)]" do %>
        <span><%= t("nav.sign_out") %></span>
        <span class="text-lg leading-none" aria-hidden="true">›</span>
      <% end %>
    </div>
  </section>
</div>

<%= render "shared/lp_dash_nav", active: :you %>
