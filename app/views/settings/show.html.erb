<% content_for :title, t("settings.title") %>
<% content_for :lp_game, true %>

<div class="lp-home mx-auto max-w-lg space-y-6 px-4 pb-24 pt-5">
  <header>
    <h1 class="text-3xl font-semibold text-[var(--lp-ink)]"><%= t("settings.title") %></h1>
    <p class="mt-2 text-sm text-[var(--lp-muted)]"><%= t("settings.subtitle") %></p>
  </header>

  <section class="lp-glass p-4">
    <%= form_with model: current_user, url: settings_path, method: :patch do %>
      <%= render "shared/character_picker", selected: current_user.character %>
    <% end %>
  </section>

  <section class="lp-glass p-6">
    <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("settings.count_title") %></h2>
    <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("settings.count_hint") %></p>

    <%= form_with model: current_user, url: settings_path, method: :patch, class: "mt-4", data: { turbo: false } do |form| %>
      <%= form.number_field :home_stat_count,
          min: 1,
          max: 20,
          class: "lp-input w-full" %>
      <%= form.submit t("settings.save"), class: "lp-cta mt-4 w-full" %>
    <% end %>
  </section>

  <section class="lp-glass p-6">
    <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("settings.visibility_title") %></h2>
    <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("settings.visibility_hint") %></p>

    <% if @all_habits.any? %>
      <ul class="mt-4 space-y-2">
        <% @all_habits.each do |habit| %>
          <li class="flex items-center justify-between gap-3 rounded-2xl border border-[var(--lp-border)] bg-[var(--lp-elevated)] px-4 py-3">
            <div class="min-w-0">
              <p class="truncate font-semibold text-[var(--lp-ink)]"><%= habit.name %></p>
              <p class="text-xs text-[var(--lp-muted)]"><%= habit.unit %> · <%= habit.evaluation_label %></p>
            </div>
            <%= button_to (habit.show_on_home? ? t("settings.on_today") : t("settings.hidden")),
                settings_habit_path(habit),
                method: :patch,
                params: { show_on_home: !habit.show_on_home? },
                class: "shrink-0 cursor-pointer rounded-xl px-3 py-2 text-xs font-bold #{habit.show_on_home? ? 'bg-[var(--lp-lime)] text-[var(--lp-void)]' : 'border border-[var(--lp-border)] text-[var(--lp-muted)]'}" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 rounded-2xl border border-dashed border-[var(--lp-border)] p-6 text-center text-[var(--lp-muted)]">
        <%= t("settings.empty") %> <%= link_to t("settings.empty_cta"), new_habit_path, class: "font-bold text-[var(--lp-lime)]" %>.
      </p>
    <% end %>
  </section>

  <section class="lp-glass p-6">
    <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("settings.order_title") %></h2>
    <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("settings.order_hint") %></p>

    <% if @home_habits.any? %>
      <ul id="home-order-list"
          class="mt-4 space-y-2"
          data-controller="sortable"
          data-sortable-url-value="<%= reorder_settings_path %>">
        <% @home_habits.each do |habit| %>
          <li class="flex cursor-grab items-center justify-between rounded-2xl border border-[var(--lp-border)] bg-[var(--lp-elevated)] px-4 py-3 active:cursor-grabbing"
              data-id="<%= habit.id %>"
              draggable="true"
              data-sortable-target="item">
            <div>
              <p class="font-semibold text-[var(--lp-ink)]"><%= habit.name %></p>
              <p class="text-xs text-[var(--lp-muted)]"><%= habit.unit %></p>
            </div>
            <span class="text-xs font-bold text-[var(--lp-muted)]"><%= t("settings.drag") %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 rounded-2xl border border-dashed border-[var(--lp-border)] p-6 text-center text-[var(--lp-muted)]">
        <%= t("settings.order_empty") %>
      </p>
    <% end %>
  </section>

  <section class="lp-glass p-5">
    <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("settings.feedback_title") %></h2>
    <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("settings.feedback_body") %></p>
    <%= link_to t("settings.contact_me"), new_feedback_path, class: "lp-cta mt-4 inline-flex" %>
  </section>

  <section class="lp-glass p-5">
    <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("life_area_selections.title") %></h2>
    <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("life_area_selections.subtitle") %></p>
    <div class="mt-4">
      <%= link_to t("life_area_selections.link"), life_area_selections_path, class: "lp-cta inline-flex" %>
    </div>
  </section>

  <section class="lp-glass p-5">
    <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("support.title") %></h2>
    <p class="mt-1 text-sm text-[var(--lp-muted)]"><%= t("settings.support_body") %></p>
    <div class="mt-4 flex flex-wrap gap-3">
      <%= link_to t("support.cta_short"), support_path, class: "lp-cta inline-flex" %>
      <%= link_to t("about.title"), about_path, class: "rounded-full border border-[var(--lp-border)] px-4 py-2 text-sm font-bold text-[var(--lp-ink)]" %>
    </div>
  </section>

  <section class="lp-glass p-5">
    <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--lp-muted)]"><%= t("settings.account") %></h2>
    <div class="mt-3 flex flex-wrap gap-3">
      <%= link_to t("settings.change_password"), new_password_path, class: "rounded-xl border border-[var(--lp-border)] px-4 py-2 text-sm font-bold text-[var(--lp-ink)]" %>
      <% if current_user.admin? %>
        <%= link_to t("nav.admin"), admin_root_path, class: "rounded-xl bg-[var(--lp-elevated)] px-4 py-2 text-sm font-bold text-[var(--lp-ink)]" %>
      <% end %>
      <%= button_to t("nav.sign_out"), session_path, method: :delete, class: "cursor-pointer rounded-xl border border-[var(--lp-rose)]/40 px-4 py-2 text-sm font-bold text-[var(--lp-rose)]" %>
    </div>
  </section>

  <p>
    <%= link_to t("habits.back_today"), dashboard_path, class: "font-bold text-[var(--lp-lime)]" %>
  </p>
</div>

