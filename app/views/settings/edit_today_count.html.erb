<% content_for :title, t("settings.count_title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>

<div class="lp-home mx-auto max-w-lg">
  <header class="flex items-center gap-3">
    <%= link_to settings_path, class: "rounded-xl border border-[var(--lp-border)] px-3 py-2 text-sm font-bold text-[var(--lp-ink)]" do %>
      ← <%= t("settings.back") %>
    <% end %>
    <div class="min-w-0">
      <h1 class="truncate lp-home__title"><%= t("settings.count_title") %></h1>
    </div>
  </header>

  <section class="lp-glass lp-glass--pad">
    <%= form_with model: current_user, url: settings_path, method: :patch, class: "space-y-4", data: { turbo: false } do |form| %>
      <div class="flex items-center justify-center gap-4"
           data-controller="number-stepper"
           data-number-stepper-min-value="1"
           data-number-stepper-max-value="20">
        <button type="button"
                class="flex h-12 w-12 items-center justify-center rounded-xl border border-[var(--lp-border)] text-2xl font-bold text-[var(--lp-ink)]"
                data-action="click->number-stepper#decrease"
                aria-label="Decrease">−</button>
        <%= form.number_field :home_stat_count,
            min: 1,
            max: 20,
            autofocus: true,
            class: "lp-input w-24 text-center text-xl font-bold",
            data: { number_stepper_target: "input" } %>
        <button type="button"
                class="flex h-12 w-12 items-center justify-center rounded-xl border border-[var(--lp-border)] text-2xl font-bold text-[var(--lp-ink)]"
                data-action="click->number-stepper#increase"
                aria-label="Increase">+</button>
      </div>
      <p class="text-center text-sm text-[var(--lp-muted)]"><%= t("settings.count_hint") %></p>
      <%= form.submit t("settings.save"), class: "lp-cta w-full" %>
    <% end %>
  </section>
</div>

<%= render "shared/lp_dash_nav", active: :you %>
