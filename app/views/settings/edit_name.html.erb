<% content_for :title, t("settings.profile_title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>

<div class="lp-home mx-auto max-w-lg space-y-6 px-4 pb-24 pt-5">
  <header>
    <p class="lp-brand-kicker">
      <%= render "shared/lp_brand_mark", size: 22, class_name: "lp-brand-kicker__mark" %>
      <span><%= t("app_name") %></span>
    </p>
    <h1 class="text-3xl font-semibold text-[var(--lp-ink)]"><%= t("settings.profile_title") %></h1>
    <p class="mt-2 text-sm text-[var(--lp-muted)]"><%= t("settings.profile_hint") %></p>
  </header>

  <section class="lp-glass p-5">
    <%= form_with model: current_user, url: settings_path, method: :patch, class: "space-y-3", data: { turbo: false } do |form| %>
      <%= form.label :name, t("auth.name"), class: "lp-auth-label" %>
      <%= form.text_field :name, required: true, maxlength: 80, autofocus: true, autocomplete: "name",
          class: "lp-input w-full", placeholder: t("auth.name_placeholder") %>
      <%= form.submit t("settings.save"), class: "lp-cta mt-2 w-full" %>
    <% end %>
  </section>

  <p>
    <%= link_to t("settings.back"), settings_path, class: "font-bold text-[var(--lp-lime)]" %>
  </p>
</div>

<%= render "shared/lp_dash_nav", active: :you %>
