<%# Lit hiking-trail mountain — focus path only; pins; conquest flags. locals: mountain %>
<% mountain ||= @mountain || { stage: :empty, progress: 0, flags: 0, label: "" } %>
<% stage = mountain[:stage].to_s %>
<% camp = strategy_camp_percent(mountain) %>
<% plans = @goal ? @goal.children.select(&:plan?).sort_by(&:position) : [] %>
<% selected_plan = @branch_plan %>
<% other_plans = plans.reject { |p| selected_plan && p.id == selected_plan.id } %>
<% projects = selected_plan ? selected_plan.children.select(&:project?).sort_by(&:position) : [] %>
<% visible_projects = strategy_visible_nodes(projects, @branch_project&.id) %>
<% hidden_project_count = [projects.size - visible_projects.size, 0].max %>
<% selected_project = @branch_project %>
<% sibling_projects = visible_projects.reject { |p| selected_project && p.id == selected_project.id } %>
<% battles = selected_project ? selected_project.children.select(&:day?).sort_by(&:position) : [] %>
<% spine_battle = @today_battle || (battles.find { |b| b.id == @focus&.id }) || battles.first %>
<% visible_battles = strategy_visible_nodes(battles, spine_battle&.id) %>
<% hidden_battle_count = [battles.size - visible_battles.size, 0].max %>
<% sibling_battles = visible_battles.reject { |b| spine_battle && b.id == spine_battle.id } %>
<% today_id = @today_battle&.id %>
<% goal_slot = strategy_trail_slot(:goal) %>
<% plan_slot = strategy_trail_slot(:selected_plan) %>
<% project_slot = strategy_trail_slot(:selected_project) %>
<% battle_slot = strategy_trail_slot(:selected_battle) %>
<% camp_slot = strategy_trail_slot(:camp) %>
<% trail_points = [goal_slot] %>
<% trail_points << plan_slot if selected_plan %>
<% trail_points << project_slot if selected_project %>
<% trail_points << battle_slot if spine_battle %>
<% trail_points << camp_slot %>
<% completed_flags = strategy_completed_flags(@goal) %>

<figure class="lp-strategy-mountain is-living is-scenic is-trailmap is-focuspath is-lit-trail is-<%= stage %>"
        data-strategy-celebrate-target="mountain"
        style="--lp-camp: <%= camp %>; --lp-scenic: url('/images/strategy-mountain-scenic.jpg')"
        aria-label="<%= mountain[:label] %>">
  <div class="lp-strategy-mountain__photo" aria-hidden="true"></div>
  <div class="lp-strategy-mountain__scrim is-top" aria-hidden="true"></div>
  <div class="lp-strategy-mountain__scrim is-bottom" aria-hidden="true"></div>

  <svg class="lp-strategy-mountain__wires" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <% if trail_points.size >= 2 %>
      <% trail_points.each_cons(2).with_index do |(from, to), i| %>
        <% segment =
             case i
             when 0 then "is-goal"
             when 1 then "is-plan"
             when 2 then "is-project"
             else "is-battle"
             end %>
        <path class="lp-strategy-wire is-trail-spine <%= segment %>"
              d="<%= strategy_trail_wire(from, to) %>"
              fill="none"/>
      <% end %>
    <% end %>
  </svg>

  <div class="lp-strategy-mountain__map">
    <% completed_flags.each do |flag| %>
      <% slot = strategy_flag_slot(flag[:kind]) %>
      <div class="lp-strategy-mountain__flag is-<%= flag[:kind] %>"
           style="--lp-x: <%= slot[:left] %>%; --lp-y: <%= slot[:top] %>%"
           title="<%= flag[:title] %>"
           aria-label="<%= t('strategy.climb.conquered', title: flag[:title]) %>">
        <span class="lp-strategy-mountain__flag-mark" aria-hidden="true"></span>
      </div>
    <% end %>

    <% if @goal %>
      <div class="lp-strategy-mountain__slot is-goal"
           style="--lp-x: <%= goal_slot[:left] %>%; --lp-y: <%= goal_slot[:top] %>%">
        <%= render "life_journeys/strategy_marker",
              node: @goal,
              lit: @focus&.id == @goal.id,
              today: false,
              on_spine: true,
              whisper: nil %>
      </div>
    <% else %>
      <div class="lp-strategy-mountain__slot is-goal"
           style="--lp-x: <%= goal_slot[:left] %>%; --lp-y: <%= goal_slot[:top] %>%">
        <span class="lp-strategy-mountain__empty-pin"><%= t("strategy.zones.empty_goal") %></span>
      </div>
    <% end %>

    <% if selected_plan %>
      <div class="lp-strategy-mountain__slot is-plan is-focus"
           style="--lp-x: <%= plan_slot[:left] %>%; --lp-y: <%= plan_slot[:top] %>%">
        <%= render "life_journeys/strategy_marker",
              node: selected_plan,
              lit: true,
              today: false,
              on_spine: true,
              whisper: nil %>
      </div>
    <% end %>

    <% other_plans.each_with_index do |plan, i| %>
      <% slot = strategy_trail_slot(:pill, i) %>
      <div class="lp-strategy-mountain__slot is-pill"
           style="--lp-x: <%= slot[:left] %>%; --lp-y: <%= slot[:top] %>%">
        <%= render "life_journeys/strategy_pill", node: plan %>
      </div>
    <% end %>

    <% if @goal && plans.empty? %>
      <p class="lp-strategy-mountain__whisper is-map"
         style="--lp-x: 50%; --lp-y: 28%"><%= t("strategy.zones.add_plan_hint") %></p>
    <% end %>

    <% if selected_project %>
      <div class="lp-strategy-mountain__slot is-project is-focus"
           style="--lp-x: <%= project_slot[:left] %>%; --lp-y: <%= project_slot[:top] %>%">
        <%= render "life_journeys/strategy_marker",
              node: selected_project,
              lit: true,
              today: false,
              on_spine: true,
              whisper: nil %>
      </div>
    <% end %>

    <% sibling_projects.each_with_index do |project, i| %>
      <% slot = strategy_trail_slot(:project, i) %>
      <div class="lp-strategy-mountain__slot is-project is-side"
           style="--lp-x: <%= slot[:left] %>%; --lp-y: <%= slot[:top] %>%">
        <%= render "life_journeys/strategy_marker",
              node: project,
              lit: false,
              today: false,
              on_spine: false,
              side: true,
              whisper: nil %>
      </div>
    <% end %>

    <% if hidden_project_count.positive? && selected_plan %>
      <% slot = strategy_trail_slot(:project_overflow) %>
      <div class="lp-strategy-mountain__slot is-overflow"
           style="--lp-x: <%= slot[:left] %>%; --lp-y: <%= slot[:top] %>%">
        <%= render "life_journeys/strategy_overflow",
              count: hidden_project_count,
              href: life_journey_path(@journey, focus_id: selected_plan.id, sheet: 1),
              kind: "project",
              label: t("strategy.zones.more_count", count: hidden_project_count) %>
      </div>
    <% end %>

    <% if selected_plan && projects.empty? %>
      <p class="lp-strategy-mountain__whisper is-map"
         style="--lp-x: 50%; --lp-y: 48%"><%= t("strategy.zones.add_project_hint") %></p>
    <% elsif @goal && selected_plan.nil? && plans.any? %>
      <p class="lp-strategy-mountain__whisper is-map is-dim"
         style="--lp-x: 50%; --lp-y: 48%"><%= t("strategy.zones.pick_plan") %></p>
    <% end %>

    <% if spine_battle %>
      <div class="lp-strategy-mountain__slot is-battle is-focus"
           style="--lp-x: <%= battle_slot[:left] %>%; --lp-y: <%= battle_slot[:top] %>%">
        <%= render "life_journeys/strategy_marker",
              node: spine_battle,
              lit: true,
              today: spine_battle.id == today_id,
              on_spine: true,
              whisper: nil %>
      </div>
    <% end %>

    <% sibling_battles.each_with_index do |battle, i| %>
      <% slot = strategy_trail_slot(:battle, i) %>
      <div class="lp-strategy-mountain__slot is-battle is-side"
           style="--lp-x: <%= slot[:left] %>%; --lp-y: <%= slot[:top] %>%">
        <%= render "life_journeys/strategy_marker",
              node: battle,
              lit: false,
              today: battle.id == today_id,
              on_spine: false,
              side: true,
              whisper: nil %>
      </div>
    <% end %>

    <% if hidden_battle_count.positive? && selected_project %>
      <% slot = strategy_trail_slot(:battle_overflow) %>
      <div class="lp-strategy-mountain__slot is-overflow"
           style="--lp-x: <%= slot[:left] %>%; --lp-y: <%= slot[:top] %>%">
        <%= render "life_journeys/strategy_overflow",
              count: hidden_battle_count,
              href: life_journey_path(@journey, focus_id: selected_project.id, sheet: 1),
              kind: "battle",
              label: t("strategy.zones.more_count", count: hidden_battle_count) %>
      </div>
    <% end %>

    <% if selected_project && battles.empty? %>
      <p class="lp-strategy-mountain__whisper is-map"
         style="--lp-x: 50%; --lp-y: 70%"><%= t("strategy.zones.add_battle_hint") %></p>
    <% elsif @goal && selected_project.nil? && selected_plan.present? %>
      <p class="lp-strategy-mountain__whisper is-map is-dim"
         style="--lp-x: 50%; --lp-y: 70%"><%= t("strategy.zones.pick_project") %></p>
    <% end %>

    <div class="lp-strategy-mountain__camp is-you"
         style="--lp-x: <%= camp_slot[:left] %>%; --lp-y: <%= camp_slot[:top] %>%"
         aria-label="<%= t('strategy.zones.camp') %>">
      <span class="lp-strategy-mountain__camp-tent" aria-hidden="true"></span>
      <span class="lp-strategy-mountain__camp-label"><%= strategy_camp_you_label %></span>
    </div>
  </div>

  <div class="lp-strategy__bar lp-strategy-mountain__bar" aria-hidden="true" data-strategy-celebrate-target="progressBar">
    <span style="width: <%= mountain[:progress] %>%"></span>
  </div>

  <div class="lp-strategy-radial" data-strategy-mountain-target="radial" hidden>
    <button type="button" class="lp-strategy-radial__btn is-edit" data-action="strategy-mountain#radialEdit" aria-label="<%= t('strategy.sheet.edit') %>">✎</button>
    <button type="button" class="lp-strategy-radial__btn is-help" data-action="strategy-mountain#radialHelp" aria-label="<%= t('strategy.help.cta') %>">?</button>
    <button type="button" class="lp-strategy-radial__btn is-add" data-action="strategy-mountain#radialAdd" aria-label="<%= t('strategy.sheet.add_child') %>">+</button>
    <button type="button" class="lp-strategy-radial__btn is-delete" data-action="strategy-mountain#radialDelete" aria-label="<%= t('strategy.remove') %>">⌫</button>
  </div>
</figure>
