<%# Living world map — capped pins per band + camera zoom. locals: mountain %>
<% mountain ||= @mountain || { stage: :empty, progress: 0, flags: 0, label: "" } %>
<% stage = mountain[:stage].to_s %>
<% camp = strategy_camp_percent(mountain) %>
<% plans = @goal ? @goal.children.select(&:plan?).sort_by(&:position) : [] %>
<% selected_plan = @branch_plan || plans.first %>
<% other_plans = plans.reject { |p| selected_plan && p.id == selected_plan.id } %>
<% visible_other_plans = other_plans.first(StrategyHelper::PILL_SLOTS.length) %>
<% hidden_plan_count = [ other_plans.size - visible_other_plans.size, 0 ].max %>
<% projects_by_plan = plans.to_h { |plan| [ plan.id, plan.children.select(&:project?).sort_by(&:position) ] } %>
<% all_projects = projects_by_plan.values.flatten %>
<% selected_project = @branch_project || (selected_plan && projects_by_plan[selected_plan.id]&.first) %>
<% battles_by_project = all_projects.to_h { |project| [ project.id, project.children.select(&:day?).sort_by(&:position) ] } %>
<% today_id = @today_battle&.id %>
<% goal_slot = strategy_trail_slot(:goal) %>
<% camp_slot = strategy_camp_slot(camp) %>
<% completed_flags = strategy_completed_flags(@goal) %>
<% streak = @climb_streak || strategy_climb_streak_status %>

<figure class="lp-strategy-mountain is-living is-scenic is-trailmap is-focuspath is-lit-trail is-fog is-world is-<%= stage %>"
        data-strategy-celebrate-target="mountain"
        data-strategy-camera-target="viewport"
        style="--lp-camp: <%= camp %>; --lp-camp-y: <%= camp_slot[:top] %>%; --lp-scenic: url('/images/strategy-mountain-scenic.jpg')"
        aria-label="<%= mountain[:label] %>">
  <div class="lp-strategy-mountain__photo" aria-hidden="true"></div>
  <div class="lp-strategy-mountain__scrim is-top" aria-hidden="true"></div>
  <div class="lp-strategy-mountain__scrim is-bottom" aria-hidden="true"></div>
  <div class="lp-strategy-mountain__fog" aria-hidden="true"></div>

  <div class="lp-strategy-mountain__camera" data-strategy-camera-target="stage">
    <svg class="lp-strategy-mountain__wires" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <% if @goal && selected_plan %>
        <% plan_slot = strategy_trail_slot(:selected_plan) %>
        <% project_slot = strategy_trail_slot(:selected_project) %>
        <% battle_slot = strategy_trail_slot(:selected_battle) %>
        <% spine_battle = @today_battle || (selected_project && battles_by_project[selected_project.id]&.find { |b| !b.completed? }) || (selected_project && battles_by_project[selected_project.id]&.first) %>
        <% trail_points = [ goal_slot, plan_slot ] %>
        <% trail_points << project_slot if selected_project %>
        <% trail_points << battle_slot if spine_battle %>
        <% trail_points << camp_slot %>
        <% trail_points.each_cons(2).with_index do |(from, to), i| %>
          <% cleared = strategy_segment_cleared?(to, camp_slot) %>
          <% segment = %w[is-goal is-plan is-project is-battle][i] || "is-battle" %>
          <path class="lp-strategy-wire is-trail-spine <%= segment %> <%= cleared ? 'is-cleared' : 'is-fogged' %>"
                d="<%= strategy_trail_wire(from, to) %>"
                fill="none"/>
        <% end %>
      <% end %>
    </svg>

    <div class="lp-strategy-mountain__map">
      <% completed_flags.each do |flag| %>
        <% slot = strategy_flag_slot(flag[:kind]) %>
        <div class="lp-strategy-mountain__flag is-<%= flag[:kind] %> is-monument"
             style="--lp-x: <%= slot[:left] %>%; --lp-y: <%= slot[:top] %>%"
             title="<%= flag[:title] %>"
             aria-label="<%= t('strategy.climb.conquered', title: flag[:title]) %>">
          <span class="lp-strategy-mountain__flag-mark" aria-hidden="true"></span>
        </div>
      <% end %>

      <% if @goal %>
        <div class="lp-strategy-mountain__slot is-goal"
             data-camera-layer="1"
             style="--lp-x: <%= goal_slot[:left] %>%; --lp-y: <%= goal_slot[:top] %>%">
          <%= render "life_journeys/strategy_marker",
                node: @goal,
                lit: @focus&.id == @goal.id,
                today: false,
                on_spine: true,
                whisper: nil %>
        </div>
      <% else %>
        <div class="lp-strategy-mountain__slot is-goal"
             data-camera-layer="1"
             style="--lp-x: <%= goal_slot[:left] %>%; --lp-y: <%= goal_slot[:top] %>%">
          <span class="lp-strategy-mountain__empty-pin"><%= t("strategy.zones.empty_goal") %></span>
        </div>
      <% end %>

      <% if selected_plan %>
        <% plan_slot = strategy_trail_slot(:selected_plan) %>
        <div class="lp-strategy-mountain__slot is-plan is-focus"
             data-camera-layer="1"
             data-camera-plan-id="<%= selected_plan.id %>"
             style="--lp-x: <%= plan_slot[:left] %>%; --lp-y: <%= plan_slot[:top] %>%">
          <%= render "life_journeys/strategy_marker",
                node: selected_plan,
                lit: true,
                today: false,
                on_spine: true,
                side: false,
                whisper: nil %>
        </div>
      <% end %>

      <% visible_other_plans.each_with_index do |plan, i| %>
        <% slot = strategy_trail_slot(:pill, i) %>
        <div class="lp-strategy-mountain__slot is-plan is-pill"
             data-camera-layer="1"
             data-camera-plan-id="<%= plan.id %>"
             style="--lp-x: <%= slot[:left] %>%; --lp-y: <%= slot[:top] %>%">
          <%= render "life_journeys/strategy_marker",
                node: plan,
                lit: false,
                today: false,
                on_spine: false,
                side: true,
                quiet: true,
                whisper: nil %>
        </div>
      <% end %>

      <% if hidden_plan_count.positive? && @goal %>
        <% slot = strategy_trail_slot(:plan_overflow) %>
        <div class="lp-strategy-mountain__slot is-overflow is-plan-overflow"
             data-camera-layer="1"
             style="--lp-x: <%= slot[:left] %>%; --lp-y: <%= slot[:top] %>%">
          <%= render "life_journeys/strategy_overflow",
                count: hidden_plan_count,
                kind: "plan",
                label: t("strategy.zones.more_count", count: hidden_plan_count),
                sheet_id: "strategy-sheet-#{@goal.id}",
                menu_id: "strategy-menu-#{@goal.id}" %>
        </div>
      <% end %>

      <% if @goal && plans.empty? %>
        <p class="lp-strategy-mountain__whisper is-map"
           data-camera-layer="1"
           style="--lp-x: 50%; --lp-y: 28%"><%= t("strategy.zones.add_plan_hint") %></p>
      <% end %>

      <% plans.each do |plan| %>
        <% plan_projects = projects_by_plan[plan.id] || [] %>
        <% focus_project = (selected_plan&.id == plan.id) ? selected_project : nil %>
        <% visible_projects = strategy_visible_nodes(plan_projects, focus_project&.id) %>
        <% hidden_project_count = [ plan_projects.size - visible_projects.size, 0 ].max %>
        <% spine_project = focus_project && visible_projects.find { |p| p.id == focus_project.id } %>
        <% sibling_projects = visible_projects.reject { |p| spine_project && p.id == spine_project.id } %>

        <% if spine_project %>
          <% slot = strategy_trail_slot(:selected_project) %>
          <div class="lp-strategy-mountain__slot is-project is-focus"
               data-camera-layer="2"
               data-camera-plan-id="<%= plan.id %>"
               data-camera-project-id="<%= spine_project.id %>"
               style="--lp-x: <%= slot[:left] %>%; --lp-y: <%= slot[:top] %>%">
            <%= render "life_journeys/strategy_marker",
                  node: spine_project,
                  lit: true,
                  today: false,
                  on_spine: true,
                  side: false,
                  whisper: nil %>
          </div>
        <% end %>

        <% sibling_projects.each_with_index do |project, i| %>
          <% next if i >= StrategyHelper::SIBLING_PROJECT_SLOTS.length %>
          <% slot = strategy_trail_slot(:project, i) %>
          <div class="lp-strategy-mountain__slot is-project is-side"
               data-camera-layer="2"
               data-camera-plan-id="<%= plan.id %>"
               data-camera-project-id="<%= project.id %>"
               style="--lp-x: <%= slot[:left] %>%; --lp-y: <%= slot[:top] %>%">
            <%= render "life_journeys/strategy_marker",
                  node: project,
                  lit: false,
                  today: false,
                  on_spine: false,
                  side: true,
                  quiet: true,
                  whisper: nil %>
          </div>
        <% end %>

        <% if hidden_project_count.positive? %>
          <% slot = strategy_trail_slot(:project_overflow) %>
          <div class="lp-strategy-mountain__slot is-overflow is-project-overflow"
               data-camera-layer="2"
               data-camera-plan-id="<%= plan.id %>"
               style="--lp-x: <%= slot[:left] %>%; --lp-y: <%= slot[:top] %>%">
            <%= render "life_journeys/strategy_overflow",
                  count: hidden_project_count,
                  kind: "project",
                  label: t("strategy.zones.more_count", count: hidden_project_count),
                  sheet_id: "strategy-sheet-#{plan.id}",
                  menu_id: "strategy-menu-#{plan.id}" %>
          </div>
        <% end %>

        <% if plan_projects.empty? %>
          <p class="lp-strategy-mountain__whisper is-map"
             data-camera-layer="2"
             data-camera-plan-id="<%= plan.id %>"
             style="--lp-x: 50%; --lp-y: 48%"><%= t("strategy.zones.add_project_hint") %></p>
        <% end %>
      <% end %>

      <% all_projects.each do |project| %>
        <% project_battles = battles_by_project[project.id] || [] %>
        <% spine_battle =
             if selected_project&.id == project.id
               @today_battle ||
                 project_battles.find { |b| b.id == @focus&.id } ||
                 project_battles.find { |b| !b.completed? } ||
                 project_battles.first
             end %>
        <% visible_battles = strategy_visible_nodes(project_battles, spine_battle&.id) %>
        <% hidden_battle_count = [ project_battles.size - visible_battles.size, 0 ].max %>
        <% spine_visible = spine_battle && visible_battles.find { |b| b.id == spine_battle.id } %>
        <% sibling_battles = visible_battles.reject { |b| spine_visible && b.id == spine_visible.id } %>

        <% if spine_visible %>
          <% slot = strategy_trail_slot(:selected_battle) %>
          <div class="lp-strategy-mountain__slot is-battle is-focus"
               data-camera-layer="3"
               data-camera-plan-id="<%= project.parent_id %>"
               data-camera-project-id="<%= project.id %>"
               style="--lp-x: <%= slot[:left] %>%; --lp-y: <%= slot[:top] %>%">
            <%= render "life_journeys/strategy_marker",
                  node: spine_visible,
                  lit: true,
                  today: spine_visible.id == today_id,
                  on_spine: true,
                  side: false,
                  whisper: nil %>
          </div>
        <% end %>

        <% sibling_battles.each_with_index do |battle, i| %>
          <% next if i >= StrategyHelper::SIBLING_BATTLE_SLOTS.length %>
          <% slot = strategy_trail_slot(:battle, i) %>
          <div class="lp-strategy-mountain__slot is-battle is-side"
               data-camera-layer="3"
               data-camera-plan-id="<%= project.parent_id %>"
               data-camera-project-id="<%= project.id %>"
               style="--lp-x: <%= slot[:left] %>%; --lp-y: <%= slot[:top] %>%">
            <%= render "life_journeys/strategy_marker",
                  node: battle,
                  lit: false,
                  today: battle.id == today_id,
                  on_spine: false,
                  side: true,
                  quiet: true,
                  whisper: nil %>
          </div>
        <% end %>

        <% if hidden_battle_count.positive? %>
          <% slot = strategy_trail_slot(:battle_overflow) %>
          <div class="lp-strategy-mountain__slot is-overflow is-battle-overflow"
               data-camera-layer="3"
               data-camera-plan-id="<%= project.parent_id %>"
               data-camera-project-id="<%= project.id %>"
               style="--lp-x: <%= slot[:left] %>%; --lp-y: <%= slot[:top] %>%">
            <%= render "life_journeys/strategy_overflow",
                  count: hidden_battle_count,
                  kind: "battle",
                  label: t("strategy.zones.more_count", count: hidden_battle_count),
                  sheet_id: "strategy-sheet-#{project.id}",
                  menu_id: "strategy-menu-#{project.id}" %>
          </div>
        <% end %>

        <% if project_battles.empty? %>
          <p class="lp-strategy-mountain__whisper is-map"
             data-camera-layer="3"
             data-camera-plan-id="<%= project.parent_id %>"
             data-camera-project-id="<%= project.id %>"
             style="--lp-x: 50%; --lp-y: 70%"><%= t("strategy.zones.add_battle_hint") %></p>
        <% end %>
      <% end %>

      <div class="lp-strategy-mountain__camp is-you"
           data-camera-layer="1"
           style="--lp-x: <%= camp_slot[:left] %>%; --lp-y: <%= camp_slot[:top] %>%"
           data-strategy-celebrate-target="camp"
           aria-label="<%= t('strategy.zones.camp') %>">
        <span class="lp-strategy-mountain__camp-tent" aria-hidden="true"></span>
        <span class="lp-strategy-mountain__camp-label"><%= strategy_camp_you_label %></span>
      </div>
    </div>
  </div>

  <div class="lp-strategy-mountain__stage-chip" aria-live="polite">
    <span class="lp-strategy-mountain__stage-label"><%= mountain[:label] %></span>
    <%= render "shared/climb_streak_chip", status: streak, compact: true %>
  </div>

  <div class="lp-strategy__bar lp-strategy-mountain__bar" aria-hidden="true" data-strategy-celebrate-target="progressBar">
    <span style="width: <%= mountain[:progress] %>%"></span>
  </div>

  <div class="lp-strategy-radial" data-strategy-mountain-target="radial" hidden>
    <button type="button" class="lp-strategy-radial__btn is-edit" data-action="strategy-mountain#radialEdit" aria-label="<%= t('strategy.sheet.edit') %>">✎</button>
    <button type="button" class="lp-strategy-radial__btn is-help" data-action="strategy-mountain#radialHelp" aria-label="<%= t('strategy.help.cta') %>">?</button>
    <button type="button" class="lp-strategy-radial__btn is-add" data-action="strategy-mountain#radialAdd" aria-label="<%= t('strategy.sheet.add_child') %>">+</button>
    <button type="button" class="lp-strategy-radial__btn is-delete" data-action="strategy-mountain#radialDelete" aria-label="<%= t('strategy.remove') %>">⌫</button>
  </div>
</figure>
