<%# Exact mockup trail map — frosted cards on scenic photo, parent→child wires. locals: mountain %>
<% mountain ||= @mountain || { stage: :empty, progress: 0, flags: 0, label: "" } %>
<% stage = mountain[:stage].to_s %>
<% camp = strategy_camp_percent(mountain) %>
<% plans = @goal ? @goal.children.select(&:plan?).sort_by(&:position) : [] %>
<% projects = @branch_plan ? @branch_plan.children.select(&:project?).sort_by(&:position) : [] %>
<% battles = @branch_project ? @branch_project.children.select(&:day?).sort_by(&:position) : [] %>
<% today_id = @today_battle&.id %>
<% off_plans = plans.reject { |p| p.id == @branch_plan&.id } %>
<% off_projects = projects.reject { |p| p.id == @branch_project&.id } %>
<% goal_slot = strategy_trail_slot(:goal) %>
<% plan_slots = plans.each_with_index.to_h { |plan, i| [plan.id, strategy_trail_slot(:plan, i)] } %>
<% project_slots = projects.each_with_index.to_h { |project, i| [project.id, strategy_trail_slot(:project, i)] } %>
<% battle_slots = battles.each_with_index.to_h { |battle, i| [battle.id, strategy_trail_slot(:battle, i)] } %>
<% camp_slot = strategy_trail_slot(:camp) %>
<% branch_plan_slot = @branch_plan ? plan_slots[@branch_plan.id] : goal_slot %>
<% branch_project_slot = @branch_project ? project_slots[@branch_project.id] : branch_plan_slot %>

<figure class="lp-strategy-mountain is-living is-scenic is-trailmap is-<%= stage %>"
        data-strategy-celebrate-target="mountain"
        style="--lp-camp: <%= camp %>; --lp-scenic: url('/images/strategy-mountain-scenic.jpg')"
        aria-label="<%= mountain[:label] %>">
  <div class="lp-strategy-mountain__photo" aria-hidden="true"></div>
  <div class="lp-strategy-mountain__scrim is-top" aria-hidden="true"></div>
  <div class="lp-strategy-mountain__scrim is-bottom" aria-hidden="true"></div>

  <svg class="lp-strategy-mountain__wires" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <% if @goal && plans.any? %>
      <% plans.each do |plan| %>
        <path class="lp-strategy-wire is-plan"
              d="<%= strategy_trail_wire(goal_slot, plan_slots[plan.id]) %>"
              fill="none"/>
      <% end %>
    <% end %>
    <% if @branch_plan && projects.any? %>
      <% projects.each do |project| %>
        <path class="lp-strategy-wire is-project"
              d="<%= strategy_trail_wire(branch_plan_slot, project_slots[project.id]) %>"
              fill="none"/>
      <% end %>
    <% end %>
    <% if @branch_project && battles.any? %>
      <% battles.each do |battle| %>
        <path class="lp-strategy-wire is-battle"
              d="<%= strategy_trail_wire(branch_project_slot, battle_slots[battle.id]) %>"
              fill="none"/>
      <% end %>
    <% end %>
    <% if @goal %>
      <path class="lp-strategy-wire is-goal is-trail"
            d="<%= strategy_trail_wire(goal_slot, camp_slot) %>"
            fill="none"/>
    <% end %>
  </svg>

  <div class="lp-strategy-mountain__map">
    <% if @goal %>
      <div class="lp-strategy-mountain__slot is-goal"
           style="--lp-x: <%= goal_slot[:left] %>%; --lp-y: <%= goal_slot[:top] %>%">
        <%= render "life_journeys/strategy_marker",
              node: @goal,
              lit: @focus&.id == @goal.id,
              today: false,
              whisper: nil %>
      </div>
    <% else %>
      <div class="lp-strategy-mountain__slot is-goal"
           style="--lp-x: <%= goal_slot[:left] %>%; --lp-y: <%= goal_slot[:top] %>%">
        <span class="lp-strategy-mountain__empty-pin"><%= t("strategy.zones.empty_goal") %></span>
      </div>
    <% end %>

    <% plans.each_with_index do |plan, i| %>
      <% slot = plan_slots[plan.id] %>
      <div class="lp-strategy-mountain__slot is-plan"
           style="--lp-x: <%= slot[:left] %>%; --lp-y: <%= slot[:top] %>%">
        <%= render "life_journeys/strategy_marker",
              node: plan,
              lit: @branch_plan&.id == plan.id,
              today: false,
              whisper: nil %>
      </div>
    <% end %>

    <% if @goal && plans.empty? %>
      <p class="lp-strategy-mountain__whisper is-map"
         style="--lp-x: 50%; --lp-y: 28%"><%= t("strategy.zones.add_plan_hint") %></p>
    <% end %>

    <% projects.each do |project| %>
      <% slot = project_slots[project.id] %>
      <div class="lp-strategy-mountain__slot is-project"
           style="--lp-x: <%= slot[:left] %>%; --lp-y: <%= slot[:top] %>%">
        <%= render "life_journeys/strategy_marker",
              node: project,
              lit: @branch_project&.id == project.id,
              today: false,
              whisper: nil %>
      </div>
    <% end %>

    <% off_plans.each_with_index do |plan, i| %>
      <% count = strategy_projects_count(plan) %>
      <% next unless count.positive? %>
      <% base = strategy_trail_slot(:project, projects.size + i) %>
      <div class="lp-strategy-mountain__slot is-collapse"
           style="--lp-x: <%= base[:left] %>%; --lp-y: <%= base[:top] %>%">
        <%= render "life_journeys/strategy_collapse",
              count: count,
              href: life_journey_path(@journey, focus_id: plan.id),
              kind: "plan",
              label: t("strategy.zones.projects_count", count: count) %>
      </div>
    <% end %>

    <% if @branch_plan && projects.empty? && off_plans.none? { |p| strategy_projects_count(p).positive? } %>
      <p class="lp-strategy-mountain__whisper is-map"
         style="--lp-x: 50%; --lp-y: 48%"><%= t("strategy.zones.add_project_hint") %></p>
    <% elsif @goal && @branch_plan.nil? && plans.any? %>
      <p class="lp-strategy-mountain__whisper is-map is-dim"
         style="--lp-x: 50%; --lp-y: 48%"><%= t("strategy.zones.pick_plan") %></p>
    <% end %>

    <% battles.each do |battle| %>
      <% slot = battle_slots[battle.id] %>
      <div class="lp-strategy-mountain__slot is-battle"
           style="--lp-x: <%= slot[:left] %>%; --lp-y: <%= slot[:top] %>%">
        <%= render "life_journeys/strategy_marker",
              node: battle,
              lit: battle.id == @focus&.id || battle.id == today_id,
              today: battle.id == today_id,
              whisper: nil %>
      </div>
    <% end %>

    <% off_projects.each_with_index do |project, i| %>
      <% count = strategy_battles_count(project) %>
      <% next unless count.positive? %>
      <% base = strategy_trail_slot(:battle, battles.size + i) %>
      <div class="lp-strategy-mountain__slot is-collapse"
           style="--lp-x: <%= base[:left] %>%; --lp-y: <%= base[:top] %>%">
        <%= render "life_journeys/strategy_collapse",
              count: count,
              href: life_journey_path(@journey, focus_id: project.id),
              kind: "project",
              label: t("strategy.zones.battles_count", count: count) %>
      </div>
    <% end %>

    <% if @branch_project && battles.empty? && off_projects.none? { |p| strategy_battles_count(p).positive? } %>
      <p class="lp-strategy-mountain__whisper is-map"
         style="--lp-x: 50%; --lp-y: 70%"><%= t("strategy.zones.add_battle_hint") %></p>
    <% elsif @goal && @branch_project.nil? && @branch_plan.present? %>
      <p class="lp-strategy-mountain__whisper is-map is-dim"
         style="--lp-x: 50%; --lp-y: 70%"><%= t("strategy.zones.pick_project") %></p>
    <% end %>

    <div class="lp-strategy-mountain__camp is-pin"
         style="--lp-x: <%= camp_slot[:left] %>%; --lp-y: calc(<%= camp_slot[:top] %>% - <%= camp * 0.12 %>px)"
         aria-label="<%= t('strategy.zones.camp') %>">
      <span class="lp-strategy-mountain__camp-pin" aria-hidden="true"></span>
      <span class="lp-strategy-mountain__camp-label"><%= t("strategy.zones.you") %></span>
    </div>
  </div>

  <div class="lp-strategy__bar lp-strategy-mountain__bar" aria-hidden="true" data-strategy-celebrate-target="progressBar">
    <span style="width: <%= mountain[:progress] %>%"></span>
  </div>

  <div class="lp-strategy-radial" data-strategy-mountain-target="radial" hidden>
    <button type="button" class="lp-strategy-radial__btn is-edit" data-action="strategy-mountain#radialEdit" aria-label="<%= t('strategy.sheet.edit') %>">✎</button>
    <button type="button" class="lp-strategy-radial__btn is-help" data-action="strategy-mountain#radialHelp" aria-label="<%= t('strategy.help.cta') %>">?</button>
    <button type="button" class="lp-strategy-radial__btn is-add" data-action="strategy-mountain#radialAdd" aria-label="<%= t('strategy.sheet.add_child') %>">+</button>
    <button type="button" class="lp-strategy-radial__btn is-delete" data-action="strategy-mountain#radialDelete" aria-label="<%= t('strategy.remove') %>">⌫</button>
  </div>
</figure>
