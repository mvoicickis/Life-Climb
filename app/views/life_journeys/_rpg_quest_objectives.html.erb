<%# Objectives list body inside quest_objectives_<folder_id> frame.
    locals: folder, host, tasks, create_url, qty_project
    Empty + create_url: skip padded empty copy — the add row below is the affordance. %>
<% tasks = local_assigns.fetch(:tasks) %>
<% create_url = local_assigns[:create_url] %>
<% qty_project = local_assigns[:qty_project] %>
<% if tasks.empty? %>
  <% if create_url.blank? %>
    <p class="lp-qs-detail__empty"><%= t("strategy.rpg.objectives_empty_short") %></p>
  <% end %>
<% else %>
  <% tasks.each do |task| %>
    <%= render "life_journeys/rpg_quest_objective_row",
          task: task,
          create_url: create_url,
          qty_project: qty_project %>
  <% end %>
<% end %>
