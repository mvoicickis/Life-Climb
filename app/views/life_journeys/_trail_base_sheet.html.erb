<%# Daily / repeating work for Base camp. locals: projects, area, plan, goal, journey %>
<% projects = local_assigns.fetch(:projects) %>
<% area = local_assigns[:area] %>
<% plan = local_assigns[:plan] %>
<% goal = local_assigns[:goal] %>
<% groups = mountain_trail_daily_battles(projects) %>
<% add_parent = projects.find { |project| !project.pages_mode? } || projects.first %>
<% daily_count = groups.sum { |group| group[:battles].size } %>

<div class="lp-trail-battles lp-trail-base-sheet" id="trail-base-sheet">
  <p class="lp-trail-battles__kind is-daily"><%= t("strategy.rpg.trail.base_camp.kind") %></p>
  <p class="lp-trail-battles__stats"><%= t("strategy.rpg.trail.base_camp.sub", count: daily_count) %></p>

  <% if groups.any? %>
    <% groups.each do |group| %>
      <p class="lp-trail-base-sheet__grp"><%= group[:project].title %></p>
      <ul class="lp-trail-battles__list">
        <% group[:battles].each do |battle| %>
          <li class="lp-trail-battles__row is-check" id="trail-base-battle-<%= battle.id %>">
            <%= button_to battle_win_path(battle),
                  method: :post,
                  class: "lp-trail-battles__check",
                  form: { class: "lp-trail-battles__check-form" } do %>
              <span class="lp-trail-battles__box" aria-hidden="true"></span>
              <span class="lp-trail-battles__name"><%= battle.title %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% else %>
    <p class="lp-trail-battles__empty"><%= t("strategy.rpg.trail.base_camp.empty") %></p>
  <% end %>

  <% if add_parent && area %>
    <%= form_with url: strategy_goals_path,
          method: :post,
          class: "lp-trail-battles__add lp-trail-battles__add--dock",
          data: { turbo: true } do %>
      <%= hidden_field_tag :life_area_id, area.id %>
      <%= hidden_field_tag :life_journey_id, add_parent.life_journey_id.presence || local_assigns[:journey]&.id %>
      <%= hidden_field_tag :parent_id, add_parent.id %>
      <%= hidden_field_tag :horizon, "day" %>
      <%= hidden_field_tag :scheduled_on, Date.current %>
      <%= hidden_field_tag :repeat, "daily" %>
      <%= hidden_field_tag :add_position, "top" %>
      <div class="lp-trail-battles__add-row">
        <label class="lp-trail-battles__field">
          <span class="sr-only"><%= t("strategy.rpg.trail.base_camp.add_placeholder") %></span>
          <%= text_field_tag :title, nil,
                required: true,
                maxlength: 120,
                class: "lp-trail-battles__input",
                placeholder: t("strategy.rpg.trail.base_camp.add_placeholder"),
                autocomplete: "off" %>
        </label>
        <%= submit_tag t("strategy.rpg.trail.add_battle"), class: "lp-trail-battles__submit" %>
      </div>
    <% end %>
  <% end %>
</div>
