<%# Daily / repeating work for Base camp. locals: projects, area, plan, goal, journey %>
<% area = local_assigns[:area] %>
<% plan = local_assigns[:plan] %>
<% goal = local_assigns[:goal] %>
<% journey = local_assigns[:journey] %>
<% basics = journey.present? ?
     mountain_trail_base_habits(journey: journey, user: current_user) : [] %>
<% submitted_name = local_assigns[:submitted_name].presence || @submitted_habit_name %>
<% form_error = local_assigns[:form_error].presence || flash.now[:alert] %>
<% qty_on = local_assigns.fetch(:submitted_quantity_checkin) { @submitted_quantity_checkin } %>
<% submitted_unit = local_assigns[:submitted_unit].presence || @submitted_unit %>
<% unit_value = submitted_unit.presence || t("strategy.rpg.trail.default_unit_times") %>

<div class="lp-trail-battles lp-trail-base-sheet"
     id="trail-base-sheet"
     data-controller="trail-battles"
     data-trail-battles-need-days-value="<%= t('strategy.rpg.trail.first_camp_reveal.need_days') %>">
  <div class="lp-trail-base-sheet__groups">
    <% if basics.any? %>
      <section class="lp-trail-base-sheet__group">
        <ul class="lp-trail-battles__list lp-trail-base-sheet__basics">
          <% basics.each do |habit| %>
            <%= render "life_journeys/trail_base_habit_row",
                  habit: habit,
                  journey: journey,
                  goal: goal,
                  plan: plan %>
          <% end %>
        </ul>
      </section>
    <% elsif journey && goal && plan %>
      <section class="lp-trail-base-sheet__group">
        <%= render "life_journeys/trail_base_starter" %>
      </section>
    <% end %>
  </div>

  <% if journey && goal && plan %>
    <div class="lp-trail-battles__dock-spacer" aria-hidden="true"></div>
    <div class="lp-trail-battles__composer is-dock">
    <% if form_error.present? %>
      <p class="lp-trail-base-sheet__form-error"
         role="alert"
         aria-labelledby="trail-base-form-error"><%= form_error %></p>
      <span id="trail-base-form-error" class="sr-only"><%= t("strategy.rpg.trail.base_camp.form_error_aria") %></span>
    <% end %>
    <%= form_with url: habits_path,
          method: :post,
          class: "lp-trail-battles__add",
          data: {
            turbo: true,
            action: "submit->trail-battles#parseDraft turbo:submit-end->trail-battles#battleAdded"
          } do %>
      <%= hidden_field_tag :return_to, "mountain" %>
      <%= hidden_field_tag :life_journey_id, journey.id %>
      <%= hidden_field_tag :goal_id, goal.id %>
      <%= hidden_field_tag :plan_id, plan.id %>
      <%= hidden_field_tag "habit[frequency]", "daily" %>
      <%= hidden_field_tag "habit[life_journey_id]", journey.id %>
      <input type="hidden" name="habit[quantity_checkin]" value="0">
      <div class="lp-trail-battles__add-row is-base" data-trail-battles-target="addRow">
        <label class="lp-trail-battles__field">
          <span class="sr-only"><%= t("strategy.rpg.trail.base_camp.add_placeholder") %></span>
          <%= text_field_tag "habit[name]", submitted_name,
                required: true,
                maxlength: 120,
                class: "lp-trail-battles__input",
                placeholder: t("strategy.rpg.trail.base_camp.add_placeholder"),
                autocomplete: "off",
                enterkeyhint: "done",
                data: { trail_battles_target: "titleField" } %>
        </label>
        <label class="lp-trail-battles__daily-switch is-qty">
          <input type="checkbox"
                 class="lp-trail-battles__daily-check sr-only"
                 name="habit[quantity_checkin]"
                 value="1"
                 <%= "checked" if qty_on %>
                 data-trail-battles-target="quantityToggle"
                 data-action="change->trail-battles#toggleQuantity">
          <span class="lp-trail-battles__switch" aria-hidden="true"></span>
          <span class="lp-trail-battles__daily-label"><%= t("strategy.rpg.trail.base_camp.count_toggle") %></span>
        </label>
        <%= text_field_tag "habit[unit]", unit_value,
              maxlength: 40,
              class: "lp-trail-battles__unit sr-only",
              autocomplete: "off",
              data: { trail_battles_target: "unitField" },
              aria: { hidden: true } %>
        <label class="lp-trail-battles__unit-field" data-trail-battles-target="unitWrap" <%= qty_on ? nil : "hidden" %>>
          <span class="sr-only"><%= t("strategy.rpg.trail.unit_placeholder") %></span>
          <input type="text"
                 maxlength="40"
                 class="lp-trail-battles__unit"
                 value="<%= unit_value if qty_on %>"
                 placeholder="<%= t("strategy.rpg.trail.unit_placeholder") %>"
                 autocomplete="off"
                 data-trail-battles-target="unitMirrorField"
                 data-action="input->trail-battles#syncUnitMirror">
        </label>
        <%= submit_tag t("strategy.rpg.trail.base_camp.add_habit"), class: "lp-trail-battles__submit" %>
      </div>
    <% end %>
    </div>
  <% end %>

  <%= render "life_journeys/trail_battle_pick_days_dialog" %>
</div>
