<%# Daily / repeating work for Base camp. locals: projects, area, plan, goal, journey %>
<% projects = local_assigns.fetch(:projects) %>
<% area = local_assigns[:area] %>
<% plan = local_assigns[:plan] %>
<% goal = local_assigns[:goal] %>
<% groups = mountain_trail_daily_battles(projects) %>
<% add_parent = projects.find { |project| !project.pages_mode? } || projects.first %>
<% daily_count = groups.sum { |group| group[:battles].size } %>

<div class="lp-trail-battles lp-trail-base-sheet"
     id="trail-base-sheet"
     data-controller="trail-battles"
     data-trail-battles-keep-daily-value="true">
  <p class="lp-trail-battles__kind is-daily"><%= t("strategy.rpg.trail.base_camp.kind") %></p>
  <p class="lp-trail-battles__stats"><%= t("strategy.rpg.trail.base_camp.sub", count: daily_count) %></p>

  <% if groups.any? %>
    <% groups.each do |group| %>
      <p class="lp-trail-base-sheet__grp"><%= group[:project].title %></p>
      <ul class="lp-trail-battles__list">
        <% group[:battles].each do |battle| %>
          <li class="lp-trail-battles__row is-check" id="trail-base-battle-<%= battle.id %>"
              data-battle-id="<%= battle.id %>"
              data-update-url="<%= strategy_goal_path(battle) %>">
            <%= render "life_journeys/trail_battle_check", battle: battle, rename: true %>
            <details class="lp-trail-battles__kebab">
              <summary class="lp-trail-battles__kebab-btn" aria-label="<%= t('strategy.rpg.trail.battle_menu') %>">⋯</summary>
              <div class="lp-trail-battles__kebab-menu">
                <button type="button"
                        data-action="click->trail-battles#renameBattle"
                        data-update-url="<%= strategy_goal_path(battle) %>"><%= t("strategy.rpg.trail.battle_rename") %></button>
                <%= render "life_journeys/trail_battle_repeat_menu", battle: battle %>
                <%= button_to t("strategy.rpg.delete_checkpoint"),
                      strategy_goal_path(battle),
                      method: :delete,
                      class: "is-danger",
                      form: {
                        data: {
                          turbo: true,
                          turbo_confirm: t("strategy.rpg.delete_checkpoint_body", title: battle.title),
                          action: "submit->trail-battles#stashBattleDelete"
                        }
                      } %>
              </div>
            </details>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% else %>
    <p class="lp-trail-battles__empty"><%= t("strategy.rpg.trail.base_camp.empty") %></p>
  <% end %>

  <% if add_parent && area %>
    <%= form_with url: strategy_goals_path,
          method: :post,
          class: "lp-trail-battles__add lp-trail-battles__add--dock",
          data: {
            turbo: true,
            action: "submit->trail-battles#parseDraft turbo:submit-end->trail-battles#battleAdded"
          } do %>
      <%= hidden_field_tag :life_area_id, area.id %>
      <%= hidden_field_tag :life_journey_id, add_parent.life_journey_id.presence || local_assigns[:journey]&.id %>
      <%= hidden_field_tag :parent_id, add_parent.id %>
      <%= hidden_field_tag :horizon, "day" %>
      <%= hidden_field_tag :scheduled_on, Date.current %>
      <%= hidden_field_tag :repeat, "daily", data: { trail_battles_target: "repeatField" } %>
      <%= hidden_field_tag :track_quantity, "0", data: { trail_battles_target: "quantityField" } %>
      <%= hidden_field_tag :quantity_kind, "up" %>
      <%= hidden_field_tag :add_position, "top" %>
      <div class="lp-trail-battles__add-row is-base" data-trail-battles-target="addRow">
        <label class="lp-trail-battles__field">
          <span class="sr-only"><%= t("strategy.rpg.trail.base_camp.add_placeholder") %></span>
          <%= text_field_tag :title, nil,
                required: true,
                maxlength: 120,
                class: "lp-trail-battles__input",
                placeholder: t("strategy.rpg.trail.base_camp.add_placeholder"),
                autocomplete: "off",
                data: { trail_battles_target: "titleField" } %>
        </label>
        <label class="lp-trail-battles__daily-switch">
          <input type="checkbox"
                 class="lp-trail-battles__daily-check sr-only"
                 checked
                 data-trail-battles-target="dailyToggle"
                 data-action="change->trail-battles#toggleDaily">
          <span class="lp-trail-battles__switch" aria-hidden="true"></span>
          <span class="lp-trail-battles__daily-label"><%= t("strategy.rpg.trail.daily") %></span>
        </label>
        <label class="lp-trail-battles__daily-switch is-qty">
          <input type="checkbox"
                 class="lp-trail-battles__daily-check sr-only"
                 data-trail-battles-target="quantityToggle"
                 data-action="change->trail-battles#toggleQuantity">
          <span class="lp-trail-battles__switch" aria-hidden="true"></span>
          <span class="lp-trail-battles__daily-label"><%= t("strategy.rpg.trail.log_a_number") %></span>
        </label>
        <label class="lp-trail-battles__unit-field" data-trail-battles-target="unitWrap" hidden>
          <span class="sr-only"><%= t("strategy.rpg.trail.unit_placeholder") %></span>
          <%= text_field_tag :unit, "pages",
                maxlength: 40,
                class: "lp-trail-battles__unit",
                placeholder: t("strategy.rpg.trail.unit_placeholder"),
                autocomplete: "off",
                data: { trail_battles_target: "unitField" } %>
        </label>
        <%= submit_tag t("strategy.rpg.trail.add_battle"), class: "lp-trail-battles__submit" %>
      </div>
    <% end %>
  <% end %>
</div>
