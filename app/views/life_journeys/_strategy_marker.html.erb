<%# Pin marker on the lit trail — tap opens peek card. locals: node:, lit:, today:, whisper:, on_spine:, side: %>
<% node = local_assigns.fetch(:node) %>
<% lit = local_assigns.fetch(:lit, false) %>
<% today = local_assigns.fetch(:today, false) %>
<% whisper = local_assigns[:whisper] %>
<% on_spine = local_assigns.fetch(:on_spine, false) %>
<% side = local_assigns.fetch(:side, false) %>
<% kind = strategy_kind_css(node) %>
<% state = strategy_pin_state(node: node, today: today) %>
<% ap = node.day? ? GameRules::BATTLE_TODO_LP : nil %>
<% focus_href =
     if node.day?
       life_journey_path(@journey, focus_id: node.parent_id, node_id: node.id, peek: 1)
     else
       life_journey_path(@journey, focus_id: node.id, peek: 1)
     end %>

<button type="button"
      class="<%= [
        "lp-strategy-marker is-pin is-#{kind} is-state-#{state}",
        ("is-spine" if on_spine),
        ("is-side" if side),
        ("is-lit" if lit),
        ("is-today" if today),
        ("is-done" if node.completed?)
      ].compact.join(" ") %>"
      title="<%= node.title %>"
      data-action="click->strategy-mountain#peek pointerdown->strategy-mountain#press pointerup->strategy-mountain#release pointerleave->strategy-mountain#cancel pointercancel->strategy-mountain#cancel contextmenu->strategy-mountain#menu"
      data-strategy-mountain-target="marker"
      data-node-id="<%= node.id %>"
      data-node-kind="<%= kind %>"
      data-can-add="<%= strategy_child_horizon(node).present? %>"
      data-sheet-id="strategy-sheet-<%= node.id %>"
      data-peek-id="strategy-peek-<%= node.id %>"
      data-focus-href="<%= focus_href %>">
  <span class="lp-strategy-marker__badge" aria-hidden="true">
    <span class="lp-strategy-marker__icon"></span>
  </span>
  <span class="lp-strategy-marker__body">
    <span class="lp-strategy-marker__title"><%= node.title.truncate(22) %></span>
    <% if node.progress_percent.positive? && !node.day? && on_spine %>
      <span class="lp-strategy-marker__pct"><%= node.progress_percent %>%</span>
    <% elsif ap.present? && !node.completed? %>
      <span class="lp-strategy-marker__ap">+<%= ap %> <%= t("dash.action_points_short") %></span>
    <% elsif whisper.present? %>
      <span class="lp-strategy-marker__whisper"><%= whisper %></span>
    <% elsif node.completed? %>
      <span class="lp-strategy-marker__check" aria-hidden="true">✓</span>
    <% end %>
  </span>
</button>
