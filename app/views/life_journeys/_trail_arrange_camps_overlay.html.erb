<%# Full-screen arrange camps overlay. locals: journey, plan, projects, open_stage %>
<% journey = local_assigns.fetch(:journey) %>
<% plan = local_assigns.fetch(:plan) %>
<% projects = local_assigns.fetch(:projects) %>
<% open_stage = local_assigns.fetch(:open_stage) %>
<% focus_stage = local_assigns[:focus_stage] %>
<% open_overlay = local_assigns.fetch(:open_overlay, false) %>
<% groups = mountain_trail_arrange_groups(projects) %>
<div id="trail-arrange-camps"
     class="lp-trail-arrange"
     data-trail-ignore
     data-controller="arrange-camps"
     data-arrange-camps-url-value="<%= life_journey_camp_arrangement_path(journey) %>"
     data-arrange-camps-reopen-url-value="<%= reopen_life_journey_camp_arrangement_path(journey) %>"
     data-arrange-camps-stage-camp-url-value="<%= stage_camp_life_journey_camp_arrangement_path(journey) %>"
     data-arrange-camps-plan-id-value="<%= plan.id %>"
     data-arrange-camps-csrf-value="<%= form_authenticity_token %>"
     data-arrange-camps-saved-value="<%= t('strategy.rpg.trail.arrange.saved') %>"
     data-arrange-camps-next-value="<%= t('strategy.rpg.trail.arrange.next') %>"
     data-arrange-camps-new-stage-value="<%= t('strategy.rpg.trail.arrange.new_stage_drop') %>"
     data-arrange-camps-max-length-value="<%= StrategyGoal::TITLE_MAX %>"
     <% if focus_stage.present? %>data-arrange-camps-focus-stage-value="<%= focus_stage %>"<% end %>
     <%= "hidden" unless open_overlay %>
     aria-hidden="<%= open_overlay ? 'false' : 'true' %>">
  <header class="lp-trail-arrange__top">
    <div class="lp-trail-arrange__title-row">
      <button type="button"
              class="lp-trail-arrange__back"
              data-action="click->trail-canvas#closeArrangeCamps"
              aria-label="<%= t('strategy.rpg.trail.arrange.back') %>">
        <span aria-hidden="true">‹</span>
      </button>
      <h1 class="lp-trail-arrange__title"><%= t("strategy.rpg.trail.arrange.title") %></h1>
      <button type="button"
              class="lp-trail-arrange__done"
              data-action="click->trail-canvas#closeArrangeCamps">
        <%= t("strategy.rpg.trail.arrange.done") %>
      </button>
    </div>
    <p class="lp-trail-arrange__hint"><%= t("strategy.rpg.trail.arrange.hint") %></p>
  </header>

  <div class="lp-trail-arrange__scroll" data-arrange-camps-target="scroll">
    <% groups.each do |group| %>
      <section class="lp-trail-arrange-group <%= 'lp-trail-arrange-group--here' if group[:open] %>"
               data-stage="<%= group[:stage] %>">
        <h2 class="lp-trail-arrange-group__heading">
          <% if group[:finished] %>
            <span class="lp-trail-arrange-group__tick" aria-label="<%= t('strategy.rpg.trail.arrange.stage_complete') %>">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="14" height="14" aria-hidden="true">
                <path d="M9.55 17.6 4.9 12.95l1.4-1.4 3.25 3.25L17.7 6.65l1.4 1.4z"/>
              </svg>
            </span>
          <% end %>
          <% if group[:open] %>
            <%= t("strategy.rpg.trail.arrange.stage_here", stage: mountain_trail_stage_label(group[:stage])) %>
          <% else %>
            <%= t("strategy.rpg.trail.arrange.stage", stage: mountain_trail_stage_label(group[:stage])) %>
          <% end %>
        </h2>
        <ul class="lp-trail-arrange-list" data-arrange-camps-target="list" data-arrange-list>
          <% group[:camps].each_with_index do |camp, index| %>
            <li class="lp-trail-arrange-row lp-pointer-reorder__row <%= 'lp-trail-arrange-row--done' if camp.completed? %>"
                data-id="<%= camp.id %>"
                data-camp-id="<%= camp.id %>"
                data-completed="<%= camp.completed? %>"
                data-update-url="<%= strategy_goal_path(camp) %>">
              <% if group[:open] && index.zero? %>
                <span class="lp-trail-arrange-row__next" data-arrange-camps-target="nextTag"><%= t("strategy.rpg.trail.arrange.next") %></span>
              <% end %>
              <button type="button"
                      class="lp-trail-arrange-row__label-btn"
                      data-action="click->arrange-camps#beginRename"
                      data-arrange-rename>
                <%= camp.title %>
              </button>
              <% if group[:finished] && camp.completed? && !camp.quantified? %>
                <button type="button"
                        class="lp-trail-arrange-row__open-again"
                        data-action="click->arrange-camps#openAgain"
                        data-camp-id="<%= camp.id %>">
                  <%= t("strategy.rpg.trail.arrange.open_again") %>
                </button>
              <% elsif !camp.completed? %>
                <button type="button"
                        class="lp-trail-arrange-row__handle lp-pointer-reorder__handle"
                        aria-label="<%= t('strategy.rpg.trail.arrange.drag') %>">
                  <%= raw('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="9" cy="7" r="1.5"/><circle cx="15" cy="7" r="1.5"/><circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="9" cy="17" r="1.5"/><circle cx="15" cy="17" r="1.5"/></svg>') %>
                </button>
              <% end %>
            </li>
          <% end %>
        </ul>
        <% if group[:finished] %>
          <div class="lp-trail-arrange-add-camp" data-arrange-add-stage="<%= group[:stage] %>">
            <label class="sr-only" for="arrange-add-camp-<%= group[:stage] %>"><%= t("strategy.rpg.trail.arrange.add_camp_here") %></label>
            <input id="arrange-add-camp-<%= group[:stage] %>"
                   type="text"
                   class="lp-trail-arrange-add-camp__input"
                   maxlength="<%= StrategyGoal::TITLE_MAX %>"
                   placeholder="<%= t('strategy.rpg.trail.arrange.add_camp_placeholder') %>"
                   autocomplete="off"
                   data-action="keydown->arrange-camps#addStageCampKeydown"
                   data-stage="<%= group[:stage] %>">
            <span class="lp-trail-arrange-add-camp__hint" aria-hidden="true"><%= t("strategy.rpg.trail.arrange.add_camp_here") %></span>
          </div>
        <% end %>
      </section>
    <% end %>

    <section class="lp-trail-arrange-new-stage" hidden data-arrange-camps-target="newStage">
      <p class="lp-trail-arrange-new-stage__label"><%= t("strategy.rpg.trail.arrange.new_stage_drop") %></p>
      <ul class="lp-trail-arrange-list" data-arrange-new-stage-list></ul>
    </section>
  </div>

  <p class="lp-trail-arrange__toast"
     role="status"
     aria-live="polite"
     data-arrange-camps-target="toast"
     hidden></p>
</div>
