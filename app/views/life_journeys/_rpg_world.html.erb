<%# Scenic trail with tent camps. locals: mountain, progress, stage, plans, focus_plan, alive %>
<% mountain ||= { stage: :empty, progress: 0, flags: 0, label: "" } %>
<% progress = local_assigns.fetch(:progress, mountain[:progress].to_i) %>
<% camps = [
     { key: "base", pct: 0, y: 88, label: t("strategy.rpg.camps.base") },
     { key: "camp2", pct: 25, y: 70, label: t("strategy.rpg.camps.camp2") },
     { key: "camp3", pct: 50, y: 52, label: t("strategy.rpg.camps.camp3") },
     { key: "camp4", pct: 75, y: 34, label: t("strategy.rpg.camps.camp4") },
     { key: "summit", pct: 100, y: 12, label: t("strategy.rpg.camps.summit") }
   ] %>
<section class="lp-rpg-world"
         data-strategy-rpg-target="world"
         data-strategy-celebrate-target="mountain"
         aria-label="<%= t('strategy.rpg.world_label') %>">
  <div class="lp-rpg-world__birds" aria-hidden="true"></div>

  <div class="lp-rpg-trail">
    <svg class="lp-rpg-trail__path" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path d="M52 90 C 38 74, 62 60, 46 46 C 34 34, 58 24, 50 10"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-dasharray="2.5 2.2"
            vector-effect="non-scaling-stroke" />
      <path class="lp-rpg-trail__lit"
            data-strategy-rpg-target="trailLit"
            d="M52 90 C 38 74, 62 60, 46 46 C 34 34, 58 24, 50 10"
            fill="none"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"
            pathLength="100"
            stroke-dasharray="<%= progress %> 100"
            vector-effect="non-scaling-stroke" />
    </svg>

    <% camps.each do |camp| %>
      <% reached = progress >= camp[:pct] %>
      <% current =
           if camp[:key] == "summit"
             progress >= 100
           elsif camp[:pct] == 0
             progress < 25
           else
             progress >= camp[:pct] && progress < camp[:pct] + 25
           end %>
      <div class="lp-rpg-node is-camp is-<%= camp[:key] %> <%= 'is-done' if reached %> <%= 'is-here' if current %> <%= 'is-locked' if camp[:key] == 'summit' && progress < 100 %>"
           style="--lp-y: <%= camp[:y] %>%"
           data-strategy-rpg-target="flag">
        <span class="lp-rpg-node__marker" aria-hidden="true">
          <% if camp[:key] == "summit" %>
            <span class="lp-rpg-node__flag">⚑</span>
            <% if progress < 100 %>
              <span class="lp-rpg-node__lock">🔒</span>
            <% end %>
          <% else %>
            <span class="lp-rpg-node__tent">⛺</span>
          <% end %>
        </span>
        <span class="lp-rpg-node__label">
          <strong><%= camp[:label] %></strong>
          <% if current && camp[:key] != "summit" %>
            <em><%= progress %>% · <%= t("strategy.rpg.current_position") %></em>
          <% elsif camp[:key] == "summit" %>
            <em><%= t("strategy.rpg.camps.summit") %> 100%</em>
          <% else %>
            <em><%= camp[:pct] %>%</em>
          <% end %>
        </span>
      </div>
    <% end %>
  </div>

  <% if @goal.blank? %>
    <div class="lp-rpg-empty-goal">
      <%= form_with url: strategy_goals_path, method: :post, class: "lp-rpg-empty-goal__form", data: { turbo: false } do %>
        <%= hidden_field_tag :life_area_id, @journey.life_area_id %>
        <%= hidden_field_tag :life_journey_id, @journey.id %>
        <%= hidden_field_tag :horizon, "goal" %>
        <label class="lp-rpg-empty-goal__label" for="rpg-goal-title"><%= t("strategy.questions.goal") %></label>
        <%= text_field_tag :title, nil,
              id: "rpg-goal-title",
              required: true,
              maxlength: 120,
              class: "lp-rpg-input",
              placeholder: t("strategy.goal_placeholder"),
              autocomplete: "off" %>
        <%= submit_tag t("strategy.next_up.create_goal_cta"), class: "lp-rpg-btn" %>
      <% end %>
    </div>
  <% end %>
</section>
