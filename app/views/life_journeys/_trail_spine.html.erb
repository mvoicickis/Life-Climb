<%# Drawn trail spine on the photo (mockup glow + white line). %>
<svg class="lp-trail__spine"
     viewBox="0 0 100 100"
     preserveAspectRatio="none"
     aria-hidden="true"
     data-trail-canvas-target="spine">
  <path class="lp-trail__spine-glow" d="<%= mountain_trail_spine_path_d %>" fill="none"></path>
  <path class="lp-trail__spine-line" d="<%= mountain_trail_spine_path_d %>" fill="none"></path>
</svg>
