<%# Collapsible battle sheet — leaf: Now snap row; branch: Camps snap row. locals: current_project, plan, goal, trail %>
<% current_project = local_assigns[:current_project] %>
<% plan = local_assigns[:plan] %>
<% goal = local_assigns[:goal] %>
<% battle_xp = GameRules::BATTLE_TODO_LP %>
<% area = @journey.life_area %>
<% is_branch = current_project&.branch_checkpoint? %>
<% child_checkpoints = is_branch ? current_project.children.select(&:project?).sort_by { |c| [ c.position.to_i, c.id ] } : [] %>
<% battles = (!is_branch && current_project) ? current_project.children.select(&:day?).sort_by { |b| [ b.scheduled_on || Date.new(9999), b.position.to_i, b.id ] } : [] %>
<% now = battles.select { |b| !b.completed? && b.scheduled_on == Date.current } %>
<% later = battles.select { |b| !b.completed? && b.scheduled_on != Date.current } %>
<% done = battles.select(&:completed?) %>
<% split_eligible = current_project&.split_eligible? %>
<% # XOR: Now for leaf, Camps for branch. Empty leaf (neither yet) shows both so the player can choose. %>
<% show_now = current_project.present? && !is_branch %>
<% show_camps = current_project.present? && (is_branch || split_eligible) %>
<% goal_id = goal&.id || current_project&.root_goal&.id %>
<% plan_id = plan&.id || (current_project&.parent&.plan? ? current_project.parent_id : current_project&.ancestor_chain&.reverse&.find(&:plan?)&.id) %>

<% if current_project %>
  <section class="lp-rpg-sheet is-dominant <%= 'is-branch' if is_branch %>"
           data-controller="strategy-sheet"
           data-strategy-sheet-expanded-value="false"
           aria-label="<%= t('strategy.rpg.sheet.label') %>">
    <button type="button"
            class="lp-rpg-sheet__handle"
            data-action="strategy-sheet#toggle"
            aria-expanded="false"
            data-strategy-sheet-target="toggle">
      <span class="lp-rpg-sheet__grip" aria-hidden="true"></span>
      <span class="lp-rpg-sheet__head">
        <span class="lp-rpg-sheet__kicker"><%= t("strategy.rpg.sheet.next_steps") %></span>
        <strong class="lp-rpg-sheet__title"><%= current_project.title %></strong>
      </span>
      <span class="lp-rpg-sheet__cue"><%= current_project.progress_percent.to_i %>%</span>
    </button>

    <% if show_now %>
      <div class="lp-rpg-sheet-rail is-now"
           data-controller="strategy-plan-rail"
           data-strategy-plan-rail-scope-value="sheet-now-<%= current_project.id %>"
           data-strategy-plan-rail-goal-value="<%= goal_id.to_i %>"
           data-strategy-plan-rail-journey-value="<%= @journey.id %>">
        <p class="lp-rpg-sheet-rail__label"><%= t("strategy.rpg.sheet.now_scroll_label") %></p>
        <ul class="lp-rpg-sheet-rail__track"
            data-strategy-plan-rail-target="track"
            aria-label="<%= t('strategy.rpg.sheet.now') %>">
          <% now.each do |battle| %>
            <li class="lp-rpg-sheet-rail__item">
              <div class="lp-rpg-now-card" data-strategy-rpg-target="battleRow">
                <%= button_to battle_win_path(battle),
                      method: :post,
                      class: "lp-rpg-now-card__win",
                      form: { data: { turbo: false } } do %>
                  <span class="lp-rpg-now-card__box" aria-hidden="true"></span>
                  <span class="lp-rpg-now-card__title"><%= battle.title %></span>
                <% end %>
                <span class="lp-rpg-now-card__xp">+<%= battle_xp %> xp</span>
              </div>
            </li>
          <% end %>
          <li class="lp-rpg-sheet-rail__item is-add">
            <details class="lp-rpg-add is-ghost is-step" id="rpg-sheet-add-step">
              <summary aria-label="<%= t('strategy.rpg.add_step') %>">
                <span class="lp-rpg-add__label lp-rpg-add__label--short" aria-hidden="true">+</span>
              </summary>
              <%= form_with url: strategy_goals_path, method: :post, class: "lp-rpg-add__form", data: { turbo: false } do %>
                <%= hidden_field_tag :life_area_id, area.id %>
                <%= hidden_field_tag :life_journey_id, @journey.id %>
                <%= hidden_field_tag :horizon, "day" %>
                <%= hidden_field_tag :parent_id, current_project.id %>
                <%= hidden_field_tag :scheduled_on, Date.current %>
                <%= text_field_tag :title, nil,
                      required: true,
                      maxlength: 120,
                      class: "lp-rpg-input",
                      placeholder: t("strategy.battle_placeholder"),
                      autocomplete: "off" %>
                <%= submit_tag t("strategy.sheet.add_battle"), class: "lp-rpg-btn is-small" %>
              <% end %>
            </details>
          </li>
        </ul>
      </div>
    <% end %>

    <% if show_camps %>
      <div class="lp-rpg-sheet-rail is-camps"
           data-controller="strategy-plan-rail"
           data-strategy-plan-rail-scope-value="sheet-camps-<%= current_project.id %>"
           data-strategy-plan-rail-goal-value="<%= goal_id.to_i %>"
           data-strategy-plan-rail-journey-value="<%= @journey.id %>">
        <p class="lp-rpg-sheet-rail__label">
          <span class="lp-rpg-sheet-rail__flag" aria-hidden="true">⚑</span>
          <%= t("strategy.rpg.sheet.camps_scroll_label") %>
        </p>
        <ul class="lp-rpg-sheet-rail__track"
            data-strategy-plan-rail-target="track"
            aria-label="<%= t('strategy.rpg.sheet.camps') %>">
          <% child_checkpoints.each do |child| %>
            <% focused = params[:focus_id].to_i == child.id %>
            <li class="lp-rpg-sheet-rail__item <%= 'is-focus' if focused %>">
              <%= link_to life_journey_path(@journey, goal_id: goal_id, plan_id: plan_id, focus_id: child.id),
                    class: "lp-rpg-camp-card #{'is-done' if child.completed?} #{'is-focus' if focused}",
                    data: { turbo: true } do %>
                <span class="lp-rpg-camp-card__icon" aria-hidden="true">⛰</span>
                <span class="lp-rpg-camp-card__title"><%= child.title %></span>
                <span class="lp-rpg-camp-card__pct"><%= child.progress_percent.to_i %>%</span>
              <% end %>
            </li>
          <% end %>
          <li class="lp-rpg-sheet-rail__item is-add">
            <details class="lp-rpg-add is-ghost is-checkpoint" id="rpg-sheet-add-camp">
              <summary aria-label="<%= t('strategy.rpg.add_child_checkpoint') %>">
                <span class="lp-rpg-add__label lp-rpg-add__label--short" aria-hidden="true">+</span>
              </summary>
              <%= form_with url: strategy_goals_path, method: :post, class: "lp-rpg-add__form", data: { turbo: false } do %>
                <%= hidden_field_tag :life_area_id, area.id %>
                <%= hidden_field_tag :life_journey_id, @journey.id %>
                <%= hidden_field_tag :horizon, "project" %>
                <%= hidden_field_tag :parent_id, current_project.id %>
                <%= text_field_tag :title, nil,
                      required: true,
                      maxlength: 120,
                      class: "lp-rpg-input",
                      placeholder: t("strategy.rpg.split_checkpoint_placeholder"),
                      autocomplete: "off" %>
                <%= submit_tag t("strategy.rpg.split_checkpoint_cta"), class: "lp-rpg-btn is-small" %>
              <% end %>
            </details>
          </li>
        </ul>
      </div>
    <% end %>

    <% if show_now && (later.any? || done.any?) %>
      <div class="lp-rpg-sheet__body" data-strategy-sheet-target="body" hidden>
        <% [
             [ :later, t("strategy.rpg.sheet.later"), later ],
             [ :done, t("strategy.rpg.sheet.done"), done ]
           ].each do |key, label, group| %>
          <% next if group.empty? %>
          <div class="lp-rpg-sheet__group is-<%= key %>">
            <p class="lp-rpg-sheet__group-title"><%= label %></p>
            <ul class="lp-rpg-battles">
              <% group.each do |battle| %>
                <li class="lp-rpg-battle <%= 'is-done' if battle.completed? %>"
                    data-strategy-rpg-target="battleRow">
                  <% if battle.completed? %>
                    <span class="lp-rpg-battle__check" aria-hidden="true">✓</span>
                    <span class="lp-rpg-battle__body">
                      <span class="lp-rpg-battle__title"><%= battle.title %></span>
                    </span>
                  <% else %>
                    <%= button_to battle_win_path(battle),
                          method: :post,
                          class: "lp-rpg-battle__win",
                          form: { data: { turbo: false } } do %>
                      <span class="lp-rpg-battle__box" aria-hidden="true"></span>
                      <span class="lp-rpg-battle__body">
                        <span class="lp-rpg-battle__title"><%= battle.title %></span>
                      </span>
                    <% end %>
                  <% end %>
                  <span class="lp-rpg-battle__xp">+<%= battle_xp %></span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
<% elsif plan %>
  <section class="lp-rpg-sheet is-quiet">
    <p class="lp-rpg-panel__empty"><%= t("strategy.rpg.trail.need_checkpoint") %></p>
  </section>
<% end %>
