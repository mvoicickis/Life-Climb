<%# Planning sheet — Expedition drill-down: Path → Practice Category → Today's Practice. locals: current_project, plan, goal, trail, focus %>
<% current_project = local_assigns[:current_project] %>
<% plan = local_assigns[:plan] %>
<% goal = local_assigns[:goal] %>
<% trail = local_assigns[:trail] %>
<% focus = local_assigns[:focus] %>
<% battle_xp = GameRules::BATTLE_TODO_LP %>
<% area = @journey.life_area %>
<% goal_id = goal&.id || current_project&.root_goal&.id %>
<% plan_id = plan&.id || (current_project&.parent&.plan? ? current_project.parent_id : current_project&.ancestor_chain&.reverse&.find(&:plan?)&.id) %>
<%# Scope = Path, branch camp, or empty Path-level camp (split-first before dailies). %>
<% path_level_split_first =
     focus&.path_level_camp? && focus.leaf_checkpoint? && focus.children.none?(&:day?) %>
<% category_scope =
     if focus&.day? && focus.parent&.project?
       parent = focus.parent
       parent.parent&.project? ? parent.parent : plan
     elsif focus&.plan?
       plan
     elsif focus&.project? && focus.branch_checkpoint?
       focus
     elsif focus&.project? && focus.parent&.project?
       focus.parent
     elsif path_level_split_first
       focus
     elsif focus&.project? && focus.parent&.plan?
       plan
     elsif current_project&.branch_checkpoint?
       current_project
     elsif current_project&.project? && !current_project.branch_checkpoint? && current_project.parent&.project?
       current_project.parent
     else
       plan
     end %>
<% categories = if category_scope
                  category_scope.children.select(&:project?).sort_by { |c| [ c.position.to_i, c.id ] }
                else
                  []
                end %>
<% leaf_categories = categories.reject(&:branch_checkpoint?) %>
<%# Empty branch / empty Path-level camp → Level A + add smaller camp; empty Path stays quiet. %>
<% use_category_focus = category_scope.present? && (categories.any? || category_scope.project?) %>
<%# Enter Level B for nested leaves, or legacy Path-level camps that already have days. %>
<% wanted_category_id =
     if use_category_focus && focus && !focus.plan?
       if focus.day? && leaf_categories.any? { |c| c.id == focus.parent_id }
         focus.parent_id
       elsif focus.project? && !focus.branch_checkpoint? && leaf_categories.any? { |c| c.id == focus.id }
         focus.id
       end
     end %>
<% initial_category_id = wanted_category_id %>
<% category_entered = initial_category_id.present? %>
<% scope_title = category_scope&.title || plan&.title %>
<% branch_level_a = category_scope&.project? && !category_entered %>
<% crumb_focus_id = category_entered ? category_scope&.id : plan&.id %>
<% crumb_label = category_entered ? scope_title : plan&.title %>
<% show_crumb = category_entered || branch_level_a %>
<% scope_add_label =
     if category_scope&.path_level_camp?
       t("strategy.rpg.add_smaller_camp")
     else
       t("strategy.rpg.add_checkpoint")
     end %>

<% if use_category_focus %>
  <section class="lp-rpg-sheet is-dominant is-planning <%= category_entered ? 'is-category-focus' : 'is-categories' %>"
           aria-label="<%= t('strategy.rpg.sheet.label') %>"
           data-controller="category-focus"
           data-category-focus-initial-id-value="<%= initial_category_id %>"
           <% if category_entered %>data-focus-category-id="<%= initial_category_id %>"<% end %>>
    <header class="lp-rpg-current-path is-expedition">
      <p class="lp-rpg-current-path__kicker is-quiet"><%= t("strategy.rpg.current_path") %></p>
      <% if branch_level_a && plan %>
        <%= link_to life_journey_path(@journey, goal_id: goal_id, plan_id: plan_id || plan.id, focus_id: plan.id),
              class: "lp-rpg-current-path__crumb is-up",
              data: { turbo: true } do %>
          <span class="lp-rpg-current-path__crumb-mark" aria-hidden="true">←</span>
          <span><%= plan.title %></span>
        <% end %>
      <% end %>
      <% if scope_title.present? %>
        <h2 class="lp-rpg-current-path__plan"
            data-category-focus-target="pathTitle"
            <%= "hidden" if category_entered %>><%= scope_title %></h2>
      <% end %>
      <% if category_entered && category_scope && crumb_label.present? %>
        <%= link_to life_journey_path(@journey, goal_id: goal_id, plan_id: plan_id || plan&.id, focus_id: category_scope.id),
              class: "lp-rpg-current-path__crumb",
              data: { turbo: true, category_focus_target: "crumb" } do %>
          <span class="lp-rpg-current-path__crumb-mark" aria-hidden="true">←</span>
          <span><%= crumb_label %></span>
        <% end %>
      <% end %>
    </header>

    <div class="lp-rpg-practice-cats<%= ' is-exited' if category_entered %>"
         data-category-focus-target="list"
         aria-label="<%= t('strategy.rpg.practice_categories') %>"
         <%= "hidden" if category_entered %>
         aria-hidden="<%= category_entered ? 'true' : 'false' %>">
      <% if path_level_split_first %>
        <p class="lp-rpg-practice-cats__hint"><%= t("strategy.rpg.nest_before_dailies") %></p>
      <% end %>
      <% categories.each do |cat| %>
        <% if cat.branch_checkpoint? %>
          <% camp_count = cat.children.count(&:project?) %>
          <%= link_to life_journey_path(@journey, goal_id: goal_id, plan_id: plan_id || plan&.id, focus_id: cat.id),
                class: "lp-rpg-practice-cat is-branch",
                data: { turbo: true, category_id: cat.id } do %>
            <span class="lp-rpg-practice-cat__title"><%= cat.title %></span>
            <span class="lp-rpg-practice-cat__count"><%= camp_count %></span>
            <span class="lp-rpg-practice-cat__meta">
              <%= t("strategy.rpg.camps_count", count: camp_count) %>
            </span>
          <% end %>
        <% else %>
          <% days = cat.children.select(&:day?).reject(&:completed?) %>
          <% planned = days.count { |d| d.scheduled_on == Date.current } %>
          <%= link_to life_journey_path(@journey, goal_id: goal_id, plan_id: plan_id || plan&.id, focus_id: cat.id),
                class: "lp-rpg-practice-cat",
                data: { turbo: true, category_id: cat.id } do %>
            <span class="lp-rpg-practice-cat__title"><%= cat.title %></span>
            <span class="lp-rpg-practice-cat__count"><%= days.size %></span>
            <span class="lp-rpg-practice-cat__meta">
              <%= t("strategy.rpg.practice_planned_short", selected: planned, total: days.size) %>
            </span>
          <% end %>
        <% end %>
      <% end %>

      <% if category_scope&.project? %>
        <details class="lp-rpg-node__add is-practice-add is-scope-add"
                 id="rpg-add-camp-<%= category_scope.id %>"
                 data-controller="floating-create"
                 data-action="toggle->floating-create#onToggle">
          <summary class="lp-rpg-practice-add"
                   aria-label="<%= scope_add_label %>">
            <span aria-hidden="true">+</span>
            <span><%= scope_add_label %></span>
          </summary>
          <div class="lp-rpg-float-create" data-floating-create-target="shell" hidden>
            <button type="button"
                    class="lp-rpg-float-create__backdrop"
                    data-action="click->floating-create#close"
                    tabindex="-1"
                    aria-label="<%= t('strategy.rpg.cancel') %>"></button>
            <div class="lp-rpg-float-create__card"
                 data-floating-create-target="card"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="rpg-add-camp-title-<%= category_scope.id %>">
              <header class="lp-rpg-float-create__head">
                <p class="lp-rpg-float-create__kicker"><%= category_scope.title %></p>
                <h2 class="lp-rpg-float-create__heading" id="rpg-add-camp-title-<%= category_scope.id %>">
                  <%= t("strategy.rpg.create_checkpoint") %>
                </h2>
              </header>
              <%= form_with url: strategy_goals_path,
                    method: :post,
                    class: "lp-rpg-float-create__form",
                    data: { turbo: false } do %>
                <%= hidden_field_tag :life_area_id, area.id %>
                <%= hidden_field_tag :life_journey_id, @journey.id %>
                <%= hidden_field_tag :horizon, "project" %>
                <%= hidden_field_tag :parent_id, category_scope.id %>
                <label class="lp-rpg-float-create__field">
                  <span class="lp-rpg-float-create__label"><%= t("strategy.rpg.checkpoint_name") %></span>
                  <%= text_field_tag :title, nil,
                        required: true,
                        maxlength: 120,
                        class: "lp-rpg-float-create__input",
                        placeholder: t("strategy.rpg.split_checkpoint_placeholder"),
                        autocomplete: "off",
                        data: { floating_create_target: "title" } %>
                </label>
                <div class="lp-rpg-float-create__actions">
                  <button type="button"
                          class="lp-rpg-float-create__btn is-cancel"
                          data-action="click->floating-create#close">
                    <%= t("strategy.rpg.cancel") %>
                  </button>
                  <%= submit_tag t("strategy.rpg.create_checkpoint"),
                        class: "lp-rpg-float-create__btn is-create" %>
                </div>
              <% end %>
            </div>
          </div>
        </details>
      <% end %>
    </div>

    <% leaf_categories.each do |cat| %>
      <% days = cat.children.select(&:day?).sort_by { |b| [ b.completed? ? 1 : 0, b.scheduled_on || Date.new(9999), b.position.to_i, b.id ] } %>
      <% open_days = days.reject(&:completed?) %>
      <% planned = open_days.count { |d| d.scheduled_on == Date.current } %>
      <% total = open_days.size %>
      <% entered = category_entered && cat.id == initial_category_id %>
      <% cat_idx = leaf_categories.index { |c| c.id == cat.id } %>
      <% prev_cat = cat_idx&.positive? ? leaf_categories[cat_idx - 1] : nil %>
      <% next_cat = cat_idx && cat_idx < leaf_categories.size - 1 ? leaf_categories[cat_idx + 1] : nil %>
      <div class="lp-rpg-practice-focus<%= ' is-entered' if entered %>"
           data-category-focus-target="panel"
           data-category-id="<%= cat.id %>"
           <%= "hidden" unless entered %>
           aria-hidden="<%= entered ? 'false' : 'true' %>">
        <div class="lp-rpg-practice-focus__head">
          <div class="lp-rpg-practice-focus__switch"
               role="navigation"
               aria-label="<%= t('strategy.rpg.camp_switcher') %>">
            <% if prev_cat %>
              <%= link_to life_journey_path(@journey, goal_id: goal_id, plan_id: plan_id || plan&.id, focus_id: prev_cat.id),
                    class: "lp-rpg-practice-focus__nav is-prev",
                    data: { turbo: true },
                    aria: { label: t("strategy.rpg.trail.prev_camp", title: prev_cat.title) } do %>
                <span aria-hidden="true">▲</span>
              <% end %>
            <% end %>
            <h3 class="lp-rpg-practice-focus__title"><%= cat.title %></h3>
            <% if next_cat %>
              <%= link_to life_journey_path(@journey, goal_id: goal_id, plan_id: plan_id || plan&.id, focus_id: next_cat.id),
                    class: "lp-rpg-practice-focus__nav is-next",
                    data: { turbo: true },
                    aria: { label: t("strategy.rpg.trail.next_camp", title: next_cat.title) } do %>
                <span aria-hidden="true">▼</span>
              <% end %>
            <% end %>
          </div>
          <p class="lp-rpg-practice-focus__progress">
            <% if total.zero? %>
              <%= t("strategy.rpg.practice_empty") %>
            <% else %>
              <%= t("strategy.rpg.practice_planned", selected: planned, total: total) %>
            <% end %>
          </p>
        </div>

        <div class="lp-rpg-todays-practice">
          <p class="lp-rpg-todays-practice__kicker"><%= t("strategy.rpg.todays_practice") %></p>
          <% if open_days.empty? %>
            <p class="lp-rpg-todays-practice__empty"><%= t("strategy.rpg.practice_empty") %></p>
          <% end %>
          <ul class="lp-rpg-todays-practice__list" aria-label="<%= t('strategy.rpg.todays_practice') %>">
            <% open_days.each do |battle| %>
              <% selected_today = battle.scheduled_on == Date.current %>
              <li class="lp-rpg-practice-row <%= 'is-selected' if selected_today %> <%= 'is-daily' if battle.repeat_daily? %>">
                <div class="lp-rpg-practice-row__bar">
                  <%= form_with url: strategy_goal_path(battle),
                        method: :patch,
                        class: "lp-rpg-practice-row__form",
                        data: { turbo: true } do %>
                    <%= hidden_field_tag :scheduled_on, selected_today ? "later" : Date.current %>
                    <label class="lp-rpg-practice-row__label">
                      <input type="checkbox"
                             class="lp-rpg-practice-row__check"
                             <%= "checked" if selected_today %>
                             onchange="this.form.requestSubmit()"
                             aria-label="<%= battle.title %>">
                      <span class="lp-rpg-practice-row__title">
                        <%= battle.title %>
                        <% if battle.repeat_daily? %>
                          <em class="lp-rpg-practice-row__repeat"><%= t("strategy.rpg.practice_repeat_badge") %></em>
                        <% end %>
                      </span>
                      <span class="lp-rpg-practice-row__xp">+<%= battle_xp %> XP</span>
                    </label>
                  <% end %>

                  <details class="lp-rpg-practice-row__edit"
                           id="rpg-edit-practice-<%= battle.id %>"
                           data-controller="floating-create"
                           data-action="toggle->floating-create#onToggle">
                    <summary class="lp-rpg-practice-row__edit-btn"
                             aria-label="<%= t('strategy.rpg.edit_practice') %>">
                      <span aria-hidden="true">✎</span>
                    </summary>
                    <div class="lp-rpg-float-create" data-floating-create-target="shell" hidden>
                      <button type="button"
                              class="lp-rpg-float-create__backdrop"
                              data-action="click->floating-create#close"
                              tabindex="-1"
                              aria-label="<%= t('strategy.rpg.cancel') %>"></button>
                      <div class="lp-rpg-float-create__card"
                           data-floating-create-target="card"
                           role="dialog"
                           aria-modal="true"
                           aria-labelledby="rpg-edit-practice-title-<%= battle.id %>">
                        <header class="lp-rpg-float-create__head">
                          <p class="lp-rpg-float-create__kicker"><%= cat.title %></p>
                          <h2 class="lp-rpg-float-create__heading" id="rpg-edit-practice-title-<%= battle.id %>">
                            <%= t("strategy.rpg.edit_practice") %>
                          </h2>
                        </header>
                        <%= form_with url: strategy_goal_path(battle),
                              method: :patch,
                              class: "lp-rpg-float-create__form",
                              data: { turbo: false } do %>
                          <label class="lp-rpg-float-create__field">
                            <span class="lp-rpg-float-create__label"><%= t("strategy.rpg.practice_name") %></span>
                            <%= text_field_tag :title, battle.title,
                                  required: true,
                                  maxlength: 120,
                                  class: "lp-rpg-float-create__input",
                                  placeholder: t("strategy.rpg.practice_name_placeholder"),
                                  autocomplete: "off",
                                  data: { floating_create_target: "title" } %>
                          </label>
                          <fieldset class="lp-rpg-float-create__repeat">
                            <legend class="lp-rpg-float-create__label"><%= t("strategy.rpg.practice_repeat_label") %></legend>
                            <div class="lp-rpg-practice-repeat" role="radiogroup" aria-label="<%= t('strategy.rpg.practice_repeat_label') %>">
                              <label class="lp-rpg-practice-repeat__option">
                                <%= radio_button_tag :repeat, "none", !battle.repeat_daily?, class: "lp-rpg-practice-repeat__input" %>
                                <span><%= t("strategy.rpg.practice_repeat_one_time") %></span>
                              </label>
                              <label class="lp-rpg-practice-repeat__option">
                                <%= radio_button_tag :repeat, "daily", battle.repeat_daily?, class: "lp-rpg-practice-repeat__input" %>
                                <span><%= t("strategy.rpg.practice_repeat_daily") %></span>
                              </label>
                            </div>
                          </fieldset>
                          <div class="lp-rpg-float-create__actions">
                            <button type="button"
                                    class="lp-rpg-float-create__btn is-cancel"
                                    data-action="click->floating-create#close">
                              <%= t("strategy.rpg.cancel") %>
                            </button>
                            <%= submit_tag t("strategy.save_changes"),
                                  class: "lp-rpg-float-create__btn is-create" %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </details>
                </div>
              </li>
            <% end %>
          </ul>

          <% if cat.nested_leaf_camp? %>
            <details class="lp-rpg-node__add is-practice-add"
                     id="rpg-add-practice-<%= cat.id %>"
                     data-controller="floating-create"
                     data-action="toggle->floating-create#onToggle">
              <summary class="lp-rpg-practice-add"
                       aria-label="<%= t('strategy.rpg.add_practice') %>">
                <span aria-hidden="true">+</span>
                <span><%= t("strategy.rpg.add_practice") %></span>
              </summary>
              <div class="lp-rpg-float-create" data-floating-create-target="shell" hidden>
                <button type="button"
                        class="lp-rpg-float-create__backdrop"
                        data-action="click->floating-create#close"
                        tabindex="-1"
                        aria-label="<%= t('strategy.rpg.cancel') %>"></button>
                <div class="lp-rpg-float-create__card"
                     data-floating-create-target="card"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="rpg-add-practice-title-<%= cat.id %>">
                  <header class="lp-rpg-float-create__head">
                    <p class="lp-rpg-float-create__kicker"><%= cat.title %></p>
                    <h2 class="lp-rpg-float-create__heading" id="rpg-add-practice-title-<%= cat.id %>">
                      <%= t("strategy.rpg.add_practice") %>
                    </h2>
                  </header>
                  <%= form_with url: strategy_goals_path,
                        method: :post,
                        class: "lp-rpg-float-create__form",
                        data: { turbo: false } do %>
                    <%= hidden_field_tag :life_area_id, area.id %>
                    <%= hidden_field_tag :life_journey_id, @journey.id %>
                    <%= hidden_field_tag :horizon, "day" %>
                    <%= hidden_field_tag :parent_id, cat.id %>
                    <%= hidden_field_tag :scheduled_on, Date.current %>
                    <label class="lp-rpg-float-create__field">
                      <span class="lp-rpg-float-create__label"><%= t("strategy.rpg.practice_name") %></span>
                      <%= text_field_tag :title, nil,
                            required: true,
                            maxlength: 120,
                            class: "lp-rpg-float-create__input",
                            placeholder: t("strategy.rpg.practice_name_placeholder"),
                            autocomplete: "off",
                            data: { floating_create_target: "title" } %>
                    </label>
                    <fieldset class="lp-rpg-float-create__repeat">
                      <legend class="lp-rpg-float-create__label"><%= t("strategy.rpg.practice_repeat_label") %></legend>
                      <div class="lp-rpg-practice-repeat" role="radiogroup" aria-label="<%= t('strategy.rpg.practice_repeat_label') %>">
                        <label class="lp-rpg-practice-repeat__option">
                          <%= radio_button_tag :repeat, "none", true, class: "lp-rpg-practice-repeat__input" %>
                          <span><%= t("strategy.rpg.practice_repeat_one_time") %></span>
                        </label>
                        <label class="lp-rpg-practice-repeat__option">
                          <%= radio_button_tag :repeat, "daily", false, class: "lp-rpg-practice-repeat__input" %>
                          <span><%= t("strategy.rpg.practice_repeat_daily") %></span>
                        </label>
                      </div>
                    </fieldset>
                    <div class="lp-rpg-float-create__actions">
                      <button type="button"
                              class="lp-rpg-float-create__btn is-cancel"
                              data-action="click->floating-create#close">
                        <%= t("strategy.rpg.cancel") %>
                      </button>
                      <%= submit_tag t("strategy.rpg.create_practice"),
                            class: "lp-rpg-float-create__btn is-create" %>
                    </div>
                  <% end %>
                </div>
              </div>
            </details>
          <% end %>
        </div>

        <%= link_to t("strategy.rpg.open_in_today"),
              dashboard_path,
              class: "lp-rpg-practice-focus__cta",
              data: { turbo: false } %>
      </div>
    <% end %>
  </section>

<% elsif current_project || plan %>
  <section class="lp-rpg-sheet is-quiet is-planning">
    <p class="lp-rpg-panel__empty"><%= t("strategy.rpg.trail.need_checkpoint") %></p>
  </section>
<% end %>
