<%# Quiet context for the current checkpoint. locals: trail, current_project, plan %>
<% trail = local_assigns[:trail] %>
<% current_project = local_assigns[:current_project] %>
<% plan = local_assigns[:plan] %>
<% node = trail&.current_node %>

<% if current_project || node || plan %>
  <aside class="lp-rpg-context" aria-label="<%= t('strategy.rpg.trail.current_checkpoint') %>">
    <% if current_project || node %>
      <p class="lp-rpg-context__kicker"><%= plan&.title %></p>
      <h2 class="lp-rpg-context__title"><%= current_project&.title || node&.title %></h2>
      <div class="lp-rpg-context__bar" aria-hidden="true">
        <% pct = current_project ? current_project.progress_percent.to_i : node&.pct.to_i %>
        <span class="lp-rpg-context__fill" style="width: <%= pct %>%"></span>
      </div>
    <% end %>
    <% if plan %>
      <details class="lp-rpg-add is-checkpoint" id="rpg-add-checkpoint">
        <summary aria-label="<%= t('strategy.rpg.add_checkpoint') %>">
          <span class="lp-rpg-add__label lp-rpg-add__label--short" aria-hidden="true">+</span>
          <span class="lp-rpg-add__label lp-rpg-add__label--long"><%= t("strategy.rpg.add_checkpoint") %></span>
        </summary>
        <%= form_with url: strategy_goals_path, method: :post, class: "lp-rpg-add__form", data: { turbo: false } do %>
          <%= hidden_field_tag :life_area_id, @journey.life_area_id %>
          <%= hidden_field_tag :life_journey_id, @journey.id %>
          <%= hidden_field_tag :horizon, "project" %>
          <%= hidden_field_tag :parent_id, plan.id %>
          <%= text_field_tag :title, nil,
                required: true,
                maxlength: 120,
                class: "lp-rpg-input",
                placeholder: t("strategy.project_placeholder"),
                autocomplete: "off" %>
          <%= submit_tag t("strategy.sheet.add_project"), class: "lp-rpg-btn is-small" %>
        <% end %>
      </details>
    <% end %>
  </aside>
<% end %>
