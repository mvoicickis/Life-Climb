<%# Slide-in Quest Space detail. locals: folder, area, journey, goal_id, plan_id %>
<% folder = local_assigns.fetch(:folder) %>
<% area = local_assigns.fetch(:area) %>
<% goal_id = local_assigns[:goal_id] %>
<% plan_id = local_assigns[:plan_id] %>
<% host = Strategy::EnsureFolderQuest.call(folder: folder) %>
<% tasks = host ? host.practice_tasks.ordered.to_a : [] %>
<% create_url = host ? strategy_goal_practice_tasks_path(host) : nil %>
<% qty_project = host&.quantified_path_project %>
<% board_path = life_journey_path(@journey, goal_id: goal_id, plan_id: plan_id, focus_id: folder.parent_id || folder.id) %>
<% color_key = folder.tagged_color_key %>

<div class="lp-qs-detail__head <%= "has-color is-#{color_key}" if color_key %>"
     data-controller="plan-card-menu">
  <%= link_to board_path,
        class: "lp-qs-detail__back",
        data: { action: "click->quest-space#close", turbo: true },
        aria: { label: t("strategy.rpg.quest_space_back") } do %>
    ←
  <% end %>
  <div class="lp-qs-detail__head-copy">
    <h2 class="lp-qs-detail__title"><%= folder.title %></h2>
    <p class="lp-qs-detail__progress" id="quest_progress_<%= folder.id %>">
      <%= render "life_journeys/rpg_quest_progress", folder: folder, tasks: tasks %>
    </p>
  </div>
  <button type="button"
          class="lp-qs-detail__edit"
          data-plan-card-menu-target="button"
          data-action="click->plan-card-menu#edit"
          aria-label="<%= t('strategy.rpg.edit_checkpoint') %>">
    <span aria-hidden="true">✎</span>
  </button>
  <dialog class="lp-strategy-sheet is-project"
          id="quest-edit-<%= folder.id %>"
          data-plan-card-menu-target="editDialog">
    <div class="lp-strategy-sheet__panel">
      <header class="lp-strategy-sheet__head">
        <p class="lp-strategy-sheet__kind"><%= t("strategy.rpg.new_quest") %></p>
        <h2 class="lp-strategy-sheet__title"><%= t("strategy.rpg.edit_checkpoint") %></h2>
        <button type="button"
                class="lp-strategy-sheet__close"
                data-action="click->plan-card-menu#closeEdit"
                aria-label="<%= t('strategy.sheet.close') %>">×</button>
      </header>
      <div class="lp-strategy-sheet__actions">
        <div class="lp-strategy-sheet__edit">
          <%= form_with url: strategy_goal_path(folder), method: :patch,
                class: "lp-strategy-sheet__form",
                data: { turbo: false } do %>
            <%= text_field_tag :title, folder.title,
                  required: true,
                  maxlength: 120,
                  id: "quest-edit-title-#{folder.id}",
                  class: "lp-rpg-input",
                  autocomplete: "off",
                  aria: { label: t("strategy.rpg.quest_name_label") } %>
            <%= render "life_journeys/color_swatch_fields",
                  selected: color_key,
                  form_id: "quest-edit-#{folder.id}" %>
            <div class="lp-strategy-sheet__footer">
              <%= submit_tag t("strategy.save_changes"),
                    class: "lp-strategy-sheet__btn is-save",
                    data: { plan_card_menu_target: "saveButton" } %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </dialog>
</div>

<div class="lp-qs-detail__objectives" data-quest-space-target="objectives">
  <turbo-frame id="quest_objectives_<%= folder.id %>">
    <%= render "life_journeys/rpg_quest_objectives",
          folder: folder,
          host: host,
          tasks: tasks,
          create_url: create_url,
          qty_project: qty_project %>
  </turbo-frame>
</div>

<div class="lp-qs-detail__add">
  <div class="lp-qs-detail__add-wrap">
    <span class="lp-qs-detail__add-plus" aria-hidden="true">+</span>
    <% if create_url %>
      <div class="lp-qs-detail__add-fields">
        <input type="text"
               class="lp-qs-detail__add-input"
               placeholder="<%= t('strategy.rpg.add_objective_placeholder') %>"
               maxlength="120"
               autocomplete="off"
               data-quest-space-target="addInput"
               data-create-url="<%= create_url %>"
               data-action="keydown->quest-space#addObjective"
               aria-label="<%= t('strategy.rpg.add_objective') %>">
        <% if qty_project %>
          <label class="lp-qs-detail__add-track" for="qs-add-track">
            <input type="checkbox"
                   id="qs-add-track"
                   class="lp-qs-detail__add-track-check"
                   data-quest-space-target="addTrack"
                   value="1">
            <span><%= t("strategy.quantity.track_objective", unit: qty_project.unit) %></span>
          </label>
        <% end %>
      </div>
      <button type="button"
              class="lp-qs-detail__add-btn"
              data-action="click->quest-space#addObjective"
              aria-label="<%= t('strategy.rpg.add_objective_submit') %>">
        <%= t("strategy.rpg.add_objective_submit") %>
      </button>
    <% else %>
      <p class="lp-qs-detail__empty"><%= t("strategy.rpg.nest_before_dailies") %></p>
    <% end %>
  </div>
</div>
