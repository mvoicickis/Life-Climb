<%# Tick or log: checkbox only. Title is not a control (rename lives on ⋯). locals: battle, camp_sheet: %>
<% battle = local_assigns.fetch(:battle) %>
<% camp_sheet = local_assigns.fetch(:camp_sheet, false) %>
<% qty_project = battle.quantified_path_project %>
<% if qty_project %>
  <button type="button"
          class="lp-trail-battles__tick"
          data-action="click->trail-canvas#openLog"
          data-project-id="<%= qty_project.id %>"
          data-battle-id="<%= battle.id %>"
          data-project-title="<%= battle.title %>"
          data-unit="<%= qty_project.unit %>"
          data-quantity-kind="<%= qty_project.try(:quantity_kind).presence || 'up' %>"
          data-range-min="<%= qty_project.try(:range_min) %>"
          data-range-max="<%= qty_project.try(:range_max) %>"
          data-last-log="<%= mountain_trail_last_log_amount(qty_project) %>"
          aria-label="<%= t('strategy.rpg.trail.win_battle') %>">
    <span class="lp-trail-battles__box" aria-hidden="true"></span>
  </button>
<% else %>
  <%= button_to battle_win_path(battle),
        method: :post,
        params: { source: "camp_sheet" },
        class: "lp-trail-battles__tick",
        form: {
          class: "lp-trail-battles__tick-form",
          data: {
            turbo: true,
            turbo_stream: true,
            action: "submit->trail-battles#prepareWin"
          }
        } do %>
    <span class="lp-trail-battles__box" aria-hidden="true"></span>
    <span class="sr-only"><%= t("strategy.rpg.trail.win_battle") %></span>
  <% end %>
<% end %>
<% if camp_sheet %>
  <span class="lp-trail-battles__body">
    <span class="lp-trail-battles__name"><%= battle.title %></span>
    <%= render "life_journeys/trail_battle_repeat_chip", battle: battle, camp_sheet: true %>
    <% if qty_project&.unit.present? %>
      <span class="lp-trail-battles__qty-chip"><%= qty_project.unit %></span>
    <% end %>
  </span>
<% else %>
  <span class="lp-trail-battles__copy">
    <span class="lp-trail-battles__name"><%= battle.title %></span>
    <%= render "life_journeys/trail_battle_repeat_chip", battle: battle %>
    <% if qty_project&.unit.present? %>
      <span class="lp-trail-battles__qty-chip"><%= qty_project.unit %></span>
    <% end %>
  </span>
<% end %>
