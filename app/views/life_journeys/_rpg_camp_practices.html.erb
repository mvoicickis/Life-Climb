<%# Practices inside an expanded camp folder. locals: cat, accent, area, battle_xp %>
<% cat = local_assigns.fetch(:cat) %>
<% accent = local_assigns.fetch(:accent) %>
<% area = local_assigns.fetch(:area) %>
<% battle_xp = local_assigns.fetch(:battle_xp) %>
<% days = cat.children.select(&:day?).sort_by { |d| [ d.completed? ? 1 : 0, d.scheduled_on || Date.new(9999), d.position.to_i, d.id ] } %>
<% tasks_by_practice = days.any? ? PracticeTask.where(strategy_goal_id: days.map(&:id)).ordered.group_by(&:strategy_goal_id) : {} %>
<% all_open = days.reject(&:completed?) %>
<% all_done = days.select(&:completed?) %>
<% can_prepare = cat.nested_leaf_camp? %>

<div class="lp-rpg-camp-folder__body lp-rpg-camp-workspace is-<%= accent %>"
     data-controller="camp-workspace"
     <% if can_prepare %>data-prepare-id="<%= cat.id %>"<% end %>>
  <div class="lp-rpg-camp-workspace__rail" aria-hidden="true"></div>
  <div class="lp-rpg-camp-workspace__surface">
    <section class="lp-rpg-camp-practices is-active"
             aria-label="<%= t('strategy.rpg.quest_board_label') %>">
      <% if days.empty? %>
        <div class="lp-rpg-camp-empty">
          <div class="lp-rpg-camp-empty__seal" aria-hidden="true">
            <span class="lp-rpg-camp-empty__seal-icon">📜</span>
          </div>
          <div class="lp-rpg-camp-empty__banner">
            <span class="lp-rpg-camp-empty__rule" aria-hidden="true"></span>
            <p class="lp-rpg-camp-empty__camp">
              <span aria-hidden="true">🏕</span>
              <%= cat.title %>
            </p>
            <span class="lp-rpg-camp-empty__rule" aria-hidden="true"></span>
          </div>
          <p class="lp-rpg-camp-empty__title"><%= t("strategy.rpg.all_empty_title") %></p>
          <p class="lp-rpg-camp-empty__body"><%= t("strategy.rpg.all_empty_body") %></p>
          <% if can_prepare %>
            <button type="button"
                    class="lp-rpg-camp-empty__prepare"
                    data-action="click->camp-workspace#prepare"
                    data-camp-workspace-id-param="<%= cat.id %>">
              <span class="lp-rpg-camp-empty__prepare-plus" aria-hidden="true">＋</span>
              <%= t("strategy.rpg.prepare_new_practice") %>
            </button>
          <% end %>
        </div>
      <% else %>
        <header class="lp-rpg-quest-board__head">
          <p class="lp-rpg-quest-board__kicker"><%= t("strategy.rpg.quest_board_label") %></p>
        </header>
        <ul class="lp-rpg-practice-folders" aria-label="<%= t('strategy.rpg.quest_board_label') %>">
          <% (all_open + all_done).each do |battle| %>
            <% tasks = tasks_by_practice[battle.id] || [] %>
            <% done_count = tasks.count(&:completed?) %>
            <% total_count = tasks.size %>
            <% obj_pct = total_count.positive? ? ((done_count * 100.0) / total_count).round : 0 %>
            <% selected_today = !battle.completed? && battle.scheduled_on == Date.current %>
            <% show_finish = !battle.completed? && tasks.any? && tasks.all?(&:completed?) %>
            <% start_open = !battle.completed? && (tasks.any? || selected_today) %>
            <li class="lp-rpg-practice-folders__item">
              <details class="lp-rpg-practice-folder <%= 'is-ready' if selected_today %> <%= 'is-complete' if battle.completed? %> <%= 'is-daily' if battle.repeat_daily? %>"
                       data-controller="practice-folder"
                       <%= "open" if start_open %>>
                <summary class="lp-rpg-practice-folder__summary">
                  <span class="lp-rpg-practice-folder__mark" aria-hidden="true">
                    <span class="lp-rpg-practice-folder__icon"></span>
                  </span>
                  <span class="lp-rpg-practice-folder__copy">
                    <span class="lp-rpg-practice-folder__title"><%= battle.title %></span>
                    <span class="lp-rpg-practice-folder__meta">
                      <% if battle.completed? %>
                        <span class="lp-rpg-practice-folder__status"><%= t("strategy.rpg.quest_completed") %></span>
                        <span class="lp-rpg-practice-folder__xp is-done">+<%= battle_xp %> XP</span>
                      <% else %>
                        <% if battle.repeat_daily? %>
                          <em class="lp-rpg-practice-folder__badge"><%= t("strategy.rpg.practice_repeat_badge") %></em>
                        <% end %>
                        <span class="lp-rpg-practice-folder__xp" aria-label="<%= battle_xp %> XP">
                          <span aria-hidden="true">⭐</span> +<%= battle_xp %> XP
                        </span>
                      <% end %>
                    </span>
                    <% unless battle.completed? %>
                      <span class="lp-rpg-practice-folder__progress">
                        <span class="lp-rpg-practice-folder__progress-label">
                          <%= t("strategy.rpg.objectives_progress", done: done_count, total: total_count) %>
                        </span>
                        <span class="lp-rpg-practice-folder__bar" aria-hidden="true">
                          <span class="lp-rpg-practice-folder__bar-fill" style="width: <%= obj_pct %>%"></span>
                        </span>
                      </span>
                    <% end %>
                  </span>
                  <span class="lp-rpg-practice-folder__chevron" aria-hidden="true"></span>
                </summary>

                <div class="lp-rpg-practice-folder__body">
                  <% if tasks.any? %>
                    <ul class="lp-rpg-practice-tasks" aria-label="<%= t('strategy.rpg.objectives_label') %>">
                      <% tasks.each do |task| %>
                        <li class="lp-rpg-practice-task <%= 'is-done' if task.completed? %>">
                          <%= form_with url: practice_task_path(task),
                                method: :patch,
                                class: "lp-rpg-practice-task__form",
                                data: { turbo: true } do %>
                            <%= hidden_field_tag :completed, task.completed? ? "0" : "1" %>
                            <label class="lp-rpg-practice-task__label">
                              <input type="checkbox"
                                     class="lp-rpg-practice-task__check"
                                     <%= "checked" if task.completed? %>
                                     <%= "disabled" if battle.completed? %>
                                     onchange="this.form.requestSubmit()"
                                     aria-label="<%= task.title %>">
                              <span class="lp-rpg-practice-task__title"><%= task.title %></span>
                            </label>
                          <% end %>
                        </li>
                      <% end %>
                    </ul>
                  <% elsif !battle.completed? %>
                    <p class="lp-rpg-practice-folder__empty"><%= t("strategy.rpg.objectives_empty") %></p>
                  <% end %>

                  <% if show_finish %>
                    <div class="lp-rpg-practice-finish" role="status">
                      <p class="lp-rpg-practice-finish__copy"><%= t("strategy.rpg.objectives_finish_prompt") %></p>
                      <div class="lp-rpg-practice-finish__actions">
                        <%= button_to t("strategy.rpg.complete_practice"),
                              battle_win_path(battle),
                              method: :post,
                              class: "lp-rpg-practice-finish__btn is-complete",
                              form: { data: { turbo: false } } %>
                        <button type="button"
                                class="lp-rpg-practice-finish__btn is-more"
                                data-action="click->practice-folder#revealAdd">
                          <%= t("strategy.rpg.add_more_objectives") %>
                        </button>
                      </div>
                    </div>
                  <% end %>

                  <% unless battle.completed? %>
                    <div class="lp-rpg-practice-folder__add-wrap"
                         data-practice-folder-target="addWrap">
                      <button type="button"
                              class="lp-rpg-practice-folder__add-reveal"
                              data-action="click->practice-folder#revealAdd"
                              data-practice-folder-target="reveal">
                        <span aria-hidden="true">＋</span>
                        <%= t("strategy.rpg.add_objective") %>
                      </button>
                      <%= form_with url: strategy_goal_practice_tasks_path(battle),
                            method: :post,
                            class: "lp-rpg-practice-folder__add",
                            data: { turbo: false, practice_folder_target: "form" },
                            html: { hidden: true } do %>
                        <label class="lp-rpg-practice-folder__add-field">
                          <span class="sr-only"><%= t("strategy.rpg.objective_name") %></span>
                          <%= text_field_tag :title, nil,
                                required: true,
                                maxlength: 120,
                                class: "lp-rpg-practice-folder__add-input",
                                placeholder: t("strategy.rpg.objective_name_placeholder"),
                                autocomplete: "off",
                                data: { practice_folder_target: "title" } %>
                        </label>
                        <%= submit_tag t("strategy.rpg.save_objective"),
                              class: "lp-rpg-practice-folder__add-btn" %>
                      <% end %>
                    </div>

                    <%= form_with url: strategy_goal_path(battle),
                          method: :patch,
                          class: "lp-rpg-practice-folder__plan",
                          data: { turbo: true } do %>
                      <%= hidden_field_tag :scheduled_on, selected_today ? "later" : Date.current %>
                      <label class="lp-rpg-practice-folder__plan-label">
                        <input type="checkbox"
                               class="lp-rpg-practice-folder__plan-check"
                               <%= "checked" if selected_today %>
                               onchange="this.form.requestSubmit()"
                               aria-label="<%= t('strategy.rpg.plan_for_today_aria', title: battle.title) %>">
                        <span class="lp-rpg-practice-folder__plan-copy">
                          <span class="lp-rpg-practice-folder__plan-title"><%= t("strategy.rpg.plan_for_today") %></span>
                          <span class="lp-rpg-practice-folder__plan-hint"><%= t("strategy.rpg.plan_for_today_hint") %></span>
                        </span>
                      </label>
                    <% end %>
                  <% end %>
                </div>
              </details>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <footer class="lp-rpg-camp-workspace__footer">
      <% if can_prepare %>
        <details class="lp-rpg-node__add is-practice-add"
                 id="rpg-add-practice-<%= cat.id %>"
                 data-controller="floating-create"
                 data-action="toggle->floating-create#onToggle">
          <summary class="lp-rpg-practice-add is-folder"
                   aria-label="<%= t('strategy.rpg.prepare_new_practice') %>">
            <span class="lp-rpg-practice-add__plus" aria-hidden="true">＋</span>
            <span><%= t("strategy.rpg.prepare_new_practice") %></span>
          </summary>
          <div class="lp-rpg-float-create" data-floating-create-target="shell" hidden>
            <button type="button"
                    class="lp-rpg-float-create__backdrop"
                    data-action="click->floating-create#close"
                    tabindex="-1"
                    aria-label="<%= t('strategy.rpg.cancel') %>"></button>
            <div class="lp-rpg-float-create__card"
                 data-floating-create-target="card"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="rpg-add-practice-title-<%= cat.id %>">
              <header class="lp-rpg-float-create__head">
                <p class="lp-rpg-float-create__kicker"><%= cat.title %></p>
                <h2 class="lp-rpg-float-create__heading" id="rpg-add-practice-title-<%= cat.id %>">
                  <%= t("strategy.rpg.prepare_new_practice") %>
                </h2>
              </header>
              <%= form_with url: strategy_goals_path,
                    method: :post,
                    class: "lp-rpg-float-create__form",
                    data: { turbo: false } do %>
                <%= hidden_field_tag :life_area_id, area.id %>
                <%= hidden_field_tag :life_journey_id, @journey.id %>
                <%= hidden_field_tag :horizon, "day" %>
                <%= hidden_field_tag :parent_id, cat.id %>
                <%= hidden_field_tag :scheduled_on, Date.current %>
                <label class="lp-rpg-float-create__field">
                  <span class="lp-rpg-float-create__label"><%= t("strategy.rpg.practice_name") %></span>
                  <%= text_field_tag :title, nil,
                        required: true,
                        maxlength: 120,
                        class: "lp-rpg-float-create__input",
                        placeholder: t("strategy.rpg.practice_name_placeholder"),
                        autocomplete: "off",
                        data: { floating_create_target: "title" } %>
                </label>
                <fieldset class="lp-rpg-float-create__repeat">
                  <legend class="lp-rpg-float-create__label"><%= t("strategy.rpg.practice_repeat_label") %></legend>
                  <div class="lp-rpg-practice-repeat" role="radiogroup" aria-label="<%= t('strategy.rpg.practice_repeat_label') %>">
                    <label class="lp-rpg-practice-repeat__option">
                      <%= radio_button_tag :repeat, "none", true, class: "lp-rpg-practice-repeat__input" %>
                      <span><%= t("strategy.rpg.practice_repeat_one_time") %></span>
                    </label>
                    <label class="lp-rpg-practice-repeat__option">
                      <%= radio_button_tag :repeat, "daily", false, class: "lp-rpg-practice-repeat__input" %>
                      <span><%= t("strategy.rpg.practice_repeat_daily") %></span>
                    </label>
                  </div>
                </fieldset>
                <div class="lp-rpg-float-create__actions">
                  <button type="button"
                          class="lp-rpg-float-create__btn is-cancel"
                          data-action="click->floating-create#close">
                    <%= t("strategy.rpg.cancel") %>
                  </button>
                  <%= submit_tag t("strategy.rpg.create_practice"),
                        class: "lp-rpg-float-create__btn is-create" %>
                </div>
              <% end %>
            </div>
          </div>
        </details>
      <% end %>

      <%= link_to t("strategy.rpg.begin_todays_battles"),
            dashboard_path,
            class: "lp-rpg-camp-folder__cta",
            data: { turbo: false } %>
    </footer>
  </div>
</div>
