<%# Flat project list. locals: trail, goal, plan, current_project, focus %>
<% trail = local_assigns[:trail] %>
<% goal = local_assigns[:goal] %>
<% plan = local_assigns[:plan] %>
<% area = @journey.life_area %>
<% path_nodes = strategy_climb_path_nodes(trail) %>
<% projects = path_nodes.filter_map(&:record) %>

<% if plan %>
  <section class="lp-climb-path is-list <%= 'is-empty' if projects.empty? %>"
           data-controller="climb-path"
           aria-label="<%= t('strategy.rpg.what_gets_me_there') %>">
    <p class="lp-climb-path__kicker"><%= t("strategy.rpg.what_gets_me_there") %></p>

    <ol class="lp-climb-path__list" id="climb-path-projects">
      <% projects.each do |project| %>
        <%= render "life_journeys/rpg_project_card",
              project: project,
              goal: goal,
              plan: plan,
              area: area %>
      <% end %>
    </ol>

    <% if projects.empty? %>
      <p class="lp-climb-path__invite-copy" id="climb-path-empty">
        <%= t("strategy.rpg.empty_projects_invite") %>
      </p>
    <% end %>

    <%= render "life_journeys/rpg_add_project", plan: plan, area: area, goal: goal %>
  </section>
<% end %>
