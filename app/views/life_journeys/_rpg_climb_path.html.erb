<%# Vertical zigzag climb path. locals: trail, goal, plan, current_project, focus %>
<% trail = local_assigns[:trail] %>
<% goal = local_assigns[:goal] %>
<% plan = local_assigns[:plan] %>
<% current_project = local_assigns[:current_project] %>
<% focus = local_assigns[:focus] %>
<% all_nodes = trail&.nodes || [] %>
<% path_nodes = strategy_climb_path_nodes(trail) %>
<% area = @journey.life_area %>

<% selected_section_id =
     if focus&.project? && plan && focus.parent_id == plan.id
       focus.id
     elsif focus&.project? && plan
       node = focus
       while node&.project? && node.parent_id != plan.id
         node = node.parent
       end
       node&.parent_id == plan.id ? node.id : nil
     elsif focus&.day? && plan
       node = focus.parent
       while node&.project? && node.parent_id != plan.id
         node = node.parent
       end
       node&.parent_id == plan.id ? node.id : nil
     end %>
<% selected_section_id ||= current_project&.id if current_project&.parent_id == plan&.id %>
<% selected_section_id ||= trail&.current_node&.id %>

<% if plan %>
  <section class="lp-climb-path <%= 'is-empty' if all_nodes.empty? %>"
           data-controller="climb-path"
           aria-label="<%= t('strategy.rpg.project_sections') %>">
    <p class="lp-climb-path__kicker"><%= t("strategy.rpg.project_sections") %></p>

    <ol class="lp-climb-path__list">
      <% path_nodes.each_with_index do |node, idx| %>
        <% playable = node.state != :locked %>
        <% selected = selected_section_id == node.id %>
        <% project = node.record %>
        <%# Keep ⋮ on done nodes so sticky Reopen stays reachable. %>
        <% show_menu = project.present? && node.state != :locked %>
        <% zig = idx.even? ? "is-left" : "is-right" %>
        <li class="lp-climb-path__node is-<%= node.state %> <%= zig %> <%= 'is-selected' if selected %> <%= 'is-menu-enabled' if show_menu %> <%= 'is-manual' if project&.manually_completed? %>"
            data-section-id="<%= node.id %>"
            data-climb-path-target="<%= [ 'node', ('current' if node.state == :current), ('selected' if selected) ].compact.join(' ') %>"
            <% if show_menu %>data-controller="plan-card-menu"<% end %>>
          <div class="lp-climb-path__pin is-<%= node.state %>" aria-hidden="true">
            <% if node.state == :done %>
              <span class="lp-climb-path__mark is-done">✓</span>
            <% elsif node.state == :current %>
              <span class="lp-climb-path__mark is-current">
                <%= companion_image_tag class: "lp-climb-path__face", alt: "" %>
              </span>
            <% else %>
              <span class="lp-climb-path__mark is-locked">🔒</span>
            <% end %>
          </div>

          <div class="lp-climb-path__card is-<%= node.state %> <%= 'is-selected' if selected %>">
            <% if show_menu %>
              <button type="button"
                      class="lp-climb-path__menu-btn"
                      data-plan-card-menu-target="button"
                      data-action="click->plan-card-menu#toggle"
                      aria-haspopup="menu"
                      aria-expanded="false"
                      aria-label="<%= t('strategy.rpg.edit_checkpoint') %>">
                <span aria-hidden="true">⋮</span>
              </button>
            <% end %>

            <% card_body = capture do %>
              <span class="lp-climb-path__badge" aria-hidden="true"><%= node.position.to_i + 1 %></span>
              <span class="lp-climb-path__title" title="<%= node.title %>"><%= node.title %></span>
              <% if playable %>
                <% if project&.manually_completed? %>
                  <% pct = project.progress_percent.to_i %>
                  <% if pct < 100 %>
                    <span class="lp-climb-path__meta is-manual"><%= pct %>%</span>
                  <% end %>
                  <span class="lp-climb-path__meta is-manual"><%= t("strategy.rpg.manually_closed") %></span>
                <% elsif project&.quantified? %>
                  <span class="lp-climb-path__meta is-quantity"><%= strategy_quantity_progress_label(project) %></span>
                <% elsif node.state == :current %>
                  <span class="lp-climb-path__meta"><%= t("strategy.rpg.section_active") %></span>
                <% elsif node.state == :done %>
                  <span class="lp-climb-path__meta is-done"><%= t("strategy.rpg.section_done") %></span>
                <% end %>
              <% else %>
                <span class="lp-climb-path__meta is-locked"><%= t("strategy.rpg.section_locked_short") %></span>
              <% end %>
            <% end %>

            <% if playable %>
              <%= link_to life_journey_path(@journey, goal_id: goal&.id, plan_id: plan.id, focus_id: node.id),
                    class: "lp-climb-path__link",
                    data: { turbo: true, action: "click->climb-path#tap" },
                    aria: { current: selected ? "true" : nil } do %>
                <%= card_body %>
              <% end %>
            <% else %>
              <div class="lp-climb-path__link is-static"
                   aria-disabled="true"
                   aria-label="<%= t('strategy.rpg.section_locked', title: node.title) %>">
                <%= card_body %>
              </div>
            <% end %>
          </div>

          <% leaf_folders = project ? project.children.select { |c| c.project? && !c.branch_checkpoint? }.sort_by { |c| [ c.position.to_i, c.id ] } : [] %>
          <% branch_folders = project ? project.children.select(&:branch_checkpoint?).sort_by { |c| [ c.position.to_i, c.id ] } : [] %>
          <% legacy_self_quest = project && leaf_folders.empty? && !project.branch_checkpoint? && project.children.any?(&:day?) %>
          <% quest_folders = legacy_self_quest ? [ project ] : leaf_folders %>
          <% show_quests = quest_folders.any? || branch_folders.any? || (playable && project&.split_eligible?) %>
          <% if show_quests %>
            <% folder_progs = quest_folders.map { |f| folder_objective_progress(f) } %>
            <% quests_done = folder_progs.sum { |p| p[:done] } %>
            <% quests_total = folder_progs.sum { |p| p[:total] } %>
            <details class="lp-climb-path__quests"
                     <%= "open" if selected %>>
              <summary class="lp-climb-path__quests-summary">
                <span class="lp-climb-path__quests-chevron" aria-hidden="true">▸</span>
                <% if quest_folders.any? && quests_total.positive? %>
                  <span class="lp-climb-path__quests-hint">
                    <%= t("strategy.rpg.objectives_done_short", done: quests_done, total: quests_total) %>
                  </span>
                <% elsif quest_folders.any? %>
                  <span class="lp-climb-path__quests-hint">
                    <%= t("strategy.rpg.objectives_empty_short") %>
                  </span>
                <% elsif playable && project&.split_eligible? %>
                  <span class="lp-climb-path__quests-hint">
                    <%= t("strategy.rpg.new_quest") %>
                  </span>
                <% else %>
                  <span class="lp-climb-path__quests-hint">
                    <%= t("strategy.rpg.quest_folders_progress", done: branch_folders.count(&:completed?), total: branch_folders.size) %>
                  </span>
                <% end %>
              </summary>

              <div class="lp-climb-path__quests-body">
                <% branch_folders.each do |branch| %>
                  <%= link_to life_journey_path(@journey, goal_id: goal&.id, plan_id: plan.id, focus_id: branch.id),
                        class: "lp-climb-path__branch",
                        data: { turbo: true } do %>
                    <span class="lp-climb-path__branch-title"><%= branch.title %></span>
                    <span class="lp-climb-path__branch-meta">
                      <%= t("strategy.rpg.quest_folders_progress",
                            done: branch.children.select(&:project?).count(&:completed?),
                            total: branch.children.select(&:project?).size) %>
                    </span>
                    <span class="lp-climb-path__branch-arrow" aria-hidden="true">›</span>
                  <% end %>
                <% end %>

                <% quest_folders.each do |folder| %>
                  <%= render "life_journeys/rpg_climb_path_quest",
                        folder: folder,
                        area: area,
                        goal_id: goal&.id,
                        plan_id: plan.id %>
                <% end %>

                <% if playable && project&.split_eligible? %>
                  <details class="lp-climb-path__new-quest"
                           id="rpg-add-camp-<%= project.id %>"
                           data-controller="floating-create"
                           data-action="toggle->floating-create#onToggle">
                    <summary class="lp-climb-path__new-quest-btn"
                             aria-label="<%= t('strategy.rpg.new_quest') %>">
                      + <%= t("strategy.rpg.new_quest") %>
                    </summary>
                    <div class="lp-rpg-float-create" data-floating-create-target="shell" hidden>
                      <button type="button"
                              class="lp-rpg-float-create__backdrop"
                              data-action="click->floating-create#close"
                              tabindex="-1"
                              aria-label="<%= t('strategy.rpg.cancel') %>"></button>
                      <div class="lp-rpg-float-create__card"
                           data-floating-create-target="card"
                           role="dialog"
                           aria-modal="true"
                           aria-labelledby="rpg-add-camp-title-<%= project.id %>">
                        <header class="lp-rpg-float-create__head">
                          <p class="lp-rpg-float-create__kicker"><%= project.title %></p>
                          <h2 class="lp-rpg-float-create__heading" id="rpg-add-camp-title-<%= project.id %>">
                            <%= t("strategy.rpg.new_quest") %>
                          </h2>
                        </header>
                        <%= form_with url: strategy_goals_path,
                              method: :post,
                              class: "lp-rpg-float-create__form",
                              data: { turbo: false } do %>
                          <%= hidden_field_tag :life_area_id, area.id %>
                          <%= hidden_field_tag :life_journey_id, @journey.id %>
                          <%= hidden_field_tag :horizon, "project" %>
                          <%= hidden_field_tag :parent_id, project.id %>
                          <label class="lp-rpg-float-create__field">
                            <span class="lp-rpg-float-create__label"><%= t("strategy.rpg.quest_name_label") %></span>
                            <%= text_field_tag :title, nil,
                                  required: true,
                                  maxlength: 120,
                                  class: "lp-rpg-float-create__input",
                                  placeholder: t("strategy.rpg.quest_name_placeholder"),
                                  autocomplete: "off",
                                  data: { floating_create_target: "title" } %>
                          </label>
                          <%= render "life_journeys/color_swatch_fields",
                                form_id: "climb-new-quest-#{project.id}" %>
                          <div class="lp-rpg-float-create__actions">
                            <button type="button"
                                    class="lp-rpg-float-create__btn is-cancel"
                                    data-action="click->floating-create#close">
                              <%= t("strategy.rpg.cancel") %>
                            </button>
                            <%= submit_tag t("strategy.rpg.new_quest"),
                                  class: "lp-rpg-float-create__btn is-create" %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </details>
                <% end %>
              </div>
            </details>
          <% end %>

          <% if show_menu %>
            <div class="lp-climb-path__menu"
                 data-plan-card-menu-target="menu"
                 role="menu"
                 hidden>
              <button type="button"
                      class="lp-climb-path__menu-item"
                      role="menuitem"
                      data-action="click->plan-card-menu#edit">
                <span aria-hidden="true">✎</span>
                <%= t("strategy.rpg.edit_checkpoint") %>
              </button>
              <% if project.manually_completed? %>
                <%= button_to t("strategy.rpg.reopen"),
                      strategy_goal_manual_completion_path(project),
                      method: :delete,
                      class: "lp-climb-path__menu-item",
                      form: { class: "lp-climb-path__menu-form", data: { turbo: false } } %>
              <% elsif !project.completed? || project.progress_percent.to_i < 100 %>
                <%= button_to t("strategy.rpg.mark_complete"),
                      strategy_goal_manual_completion_path(project),
                      method: :post,
                      class: "lp-climb-path__menu-item",
                      form: { class: "lp-climb-path__menu-form", data: { turbo: false } } %>
              <% end %>
              <button type="button"
                      class="lp-climb-path__menu-item is-danger"
                      role="menuitem"
                      data-action="click->plan-card-menu#confirmDelete">
                <span aria-hidden="true">🗑</span>
                <%= t("strategy.rpg.delete_checkpoint") %>
              </button>
            </div>
            <dialog class="lp-strategy-sheet is-plan"
                    id="section-edit-<%= project.id %>"
                    data-plan-card-menu-target="editDialog">
              <div class="lp-strategy-sheet__panel">
                <header class="lp-strategy-sheet__head">
                  <p class="lp-strategy-sheet__kind"><%= t("strategy.horizons.project") %></p>
                  <h2 class="lp-strategy-sheet__title"><%= t("strategy.rpg.edit_checkpoint") %></h2>
                  <button type="button"
                          class="lp-strategy-sheet__close"
                          data-action="click->plan-card-menu#closeEdit"
                          aria-label="<%= t('strategy.sheet.close') %>">×</button>
                </header>
                <div class="lp-strategy-sheet__actions">
                  <div class="lp-strategy-sheet__edit">
                    <%= form_with url: strategy_goal_path(project), method: :patch,
                          class: "lp-strategy-sheet__form",
                          data: { turbo: false } do %>
                      <%= text_field_tag :title, project.title,
                            required: true,
                            maxlength: 120,
                            id: "section-edit-title-#{project.id}",
                            class: "lp-rpg-input",
                            autocomplete: "off",
                            aria: { label: t("strategy.rpg.edit_checkpoint") } %>
                      <%= render "life_journeys/quantity_track_fields",
                            project: project,
                            form_id: "section-edit-#{project.id}" %>
                      <div class="lp-strategy-sheet__footer">
                        <%= submit_tag t("strategy.save_changes"),
                              class: "lp-strategy-sheet__btn is-save",
                              data: { plan_card_menu_target: "saveButton" } %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </dialog>
            <dialog class="lp-strategy-sheet is-plan"
                    id="section-delete-<%= project.id %>"
                    data-plan-card-menu-target="deleteDialog">
              <div class="lp-strategy-sheet__panel">
                <header class="lp-strategy-sheet__head">
                  <p class="lp-strategy-sheet__kind"><%= t("strategy.horizons.project") %></p>
                  <h2 class="lp-strategy-sheet__title"><%= t("strategy.rpg.delete_checkpoint_title") %></h2>
                  <p class="lp-strategy-sheet__desc"><%= t("strategy.rpg.delete_checkpoint_body", title: project.title) %></p>
                  <button type="button"
                          class="lp-strategy-sheet__close"
                          data-action="click->plan-card-menu#closeDelete"
                          aria-label="<%= t('strategy.sheet.close') %>">×</button>
                </header>
                <div class="lp-strategy-sheet__footer is-split">
                  <button type="button"
                          class="lp-strategy-sheet__btn is-cancel"
                          data-action="click->plan-card-menu#closeDelete">
                    <%= t("strategy.rpg.cancel") %>
                  </button>
                  <%= form_with url: strategy_goal_path(project), method: :delete,
                        class: "lp-strategy-sheet__form is-delete-action",
                        data: { turbo: false } do %>
                    <%= submit_tag t("strategy.rpg.delete_confirm"),
                          class: "lp-strategy-sheet__btn is-delete" %>
                  <% end %>
                </div>
              </div>
            </dialog>
          <% end %>
        </li>
      <% end %>

      <li class="lp-climb-path__node is-new is-left" data-climb-path-target="node">
        <div class="lp-climb-path__pin is-new" aria-hidden="true">
          <span class="lp-climb-path__mark is-new">+</span>
        </div>
        <details class="lp-climb-path__new"
                 id="rpg-add-section-<%= plan.id %>"
                 data-controller="floating-create"
                 data-action="toggle->floating-create#onToggle">
          <summary class="lp-climb-path__new-btn"
                   aria-label="<%= t('strategy.rpg.new_project') %>">
            + <%= t("strategy.rpg.new_project") %>
          </summary>
          <div class="lp-rpg-float-create" data-floating-create-target="shell" hidden>
            <button type="button"
                    class="lp-rpg-float-create__backdrop"
                    data-action="click->floating-create#close"
                    tabindex="-1"
                    aria-label="<%= t('strategy.rpg.cancel') %>"></button>
            <div class="lp-rpg-float-create__card"
                 data-floating-create-target="card"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="rpg-add-section-title-<%= plan.id %>">
              <header class="lp-rpg-float-create__head">
                <p class="lp-rpg-float-create__kicker"><%= t("strategy.rpg.project_sections") %></p>
                <h2 class="lp-rpg-float-create__heading" id="rpg-add-section-title-<%= plan.id %>">
                  <%= t("strategy.rpg.new_project") %>
                </h2>
              </header>
              <%= form_with url: strategy_goals_path,
                    method: :post,
                    class: "lp-rpg-float-create__form",
                    data: { turbo: false } do %>
                <%= hidden_field_tag :life_area_id, area.id %>
                <%= hidden_field_tag :life_journey_id, @journey.id %>
                <%= hidden_field_tag :horizon, "project" %>
                <%= hidden_field_tag :parent_id, plan.id %>
                <label class="lp-rpg-float-create__field">
                  <span class="lp-rpg-float-create__label"><%= t("strategy.rpg.checkpoint_name") %></span>
                  <%= text_field_tag :title, nil,
                        required: true,
                        maxlength: 120,
                        class: "lp-rpg-float-create__input",
                        placeholder: t("strategy.rpg.checkpoint_name_placeholder"),
                        autocomplete: "off",
                        data: { floating_create_target: "title" } %>
                </label>
                <%= render "life_journeys/quantity_track_fields",
                      form_id: "rpg-add-section-#{plan.id}" %>
                <div class="lp-rpg-float-create__actions">
                  <button type="button"
                          class="lp-rpg-float-create__btn is-cancel"
                          data-action="click->floating-create#close">
                    <%= t("strategy.rpg.cancel") %>
                  </button>
                  <%= submit_tag t("strategy.rpg.new_project"),
                        class: "lp-rpg-float-create__btn is-create" %>
                </div>
              <% end %>
            </div>
          </div>
        </details>
      </li>
    </ol>
  </section>
<% end %>
