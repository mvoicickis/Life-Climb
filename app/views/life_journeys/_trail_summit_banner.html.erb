<%# Goal control on the default photo summit. locals: goal, journey, plan, plans, peak_title, show_arrange_camps, first_camp_reveal %>
<% goal = local_assigns.fetch(:goal) %>
<% journey = local_assigns.fetch(:journey) %>
<% plan = local_assigns[:plan] %>
<% plans = local_assigns[:plans] || [] %>
<% peak_title = local_assigns.fetch(:peak_title) %>
<% show_arrange_camps = local_assigns[:show_arrange_camps] %>
<% first_camp_reveal = local_assigns[:first_camp_reveal] %>
<% summit_anchor = mountain_trail_summit_anchor(goal: goal, journey: journey) %>
<% if summit_anchor.present? %>
<div class="lp-trail__summit<%= ' lp-trail__summit--reveal' if first_camp_reveal %>"
     style="--lp-summit-x: <%= summit_anchor[:x] %>; --lp-summit-y: <%= summit_anchor[:y] %>;"
     data-trail-ignore
     <% if first_camp_reveal %>data-first-camp-reveal-target="summit"<% end %>>
  <div class="lp-trail__summit-row">
    <%= render "life_journeys/trail_summit_glass_button", peak_title: peak_title %>
    <%= link_to world_path,
          class: "lp-trail__my-world-pill",
          aria: { label: t("my_world.pill") } do %>
      <span class="lp-trail__my-world-pill__face">
        <span class="lp-trail__my-world-pill__icon" aria-hidden="true">
          <svg viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
            <ellipse cx="11" cy="11" rx="10.2" ry="3.4" transform="rotate(-20 11 11)"
              stroke="currentColor" stroke-width="1.75"
              pathLength="100" stroke-dasharray="50 50" stroke-dashoffset="50"/>
            <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.75"/>
            <ellipse cx="11" cy="11" rx="10.2" ry="3.4" transform="rotate(-20 11 11)"
              stroke="currentColor" stroke-width="1.75"
              pathLength="100" stroke-dasharray="50 50" stroke-dashoffset="0"/>
          </svg>
        </span>
        <span class="lp-trail__my-world-pill__label"><%= t("my_world.pill") %></span>
      </span>
    <% end %>
  </div>
  <input type="text"
         class="lp-trail__goal-title-input lp-trail__summit-title-input"
         hidden
         autocomplete="off"
         enterkeyhint="done"
         spellcheck="false"
         maxlength="<%= StrategyGoal::TITLE_MAX %>"
         data-trail-canvas-target="peakTitleInput"
         aria-label="<%= t('strategy.rpg.trail.edit_goal_name') %>">
  <div class="lp-trail__goal-menu" data-trail-canvas-target="peakMenu" role="menu" hidden>
    <button type="button"
            class="lp-trail__peak-item"
            role="menuitem"
            data-action="click->trail-canvas#editGoalNameFromMenu">
      <%= t("strategy.rpg.trail.edit_goal_name") %>
    </button>
    <% if show_arrange_camps %>
      <button type="button"
              class="lp-trail__peak-item"
              role="menuitem"
              data-action="click->trail-canvas#openArrangeCamps">
        <%= t("strategy.rpg.trail.arrange.entry") %>
      </button>
    <% end %>
    <% if plans.size > 1 %>
      <% plans.each do |p| %>
        <%= link_to mountain_trail_hud_plan_title(p.title),
              life_journey_path(journey, goal_id: goal.id, plan_id: p.id),
              class: "lp-trail__peak-item lp-trail__peak-item--plan #{'is-active' if plan&.id == p.id}",
              role: "menuitem" %>
      <% end %>
    <% end %>
    <% if journey.mountain_photo.attached? %>
      <%= button_to t("strategy.rpg.trail.reset_photo"),
            life_journey_path(journey),
            method: :patch,
            params: { mountain_photo_intent: "reset" },
            class: "lp-trail__peak-item is-reset",
            form: { class: "lp-trail__photo-form" } %>
    <% end %>
    <%= button_to t("strategy.rpg.trail.delete_destination"),
          strategy_goal_path(goal),
          method: :delete,
          class: "lp-trail__peak-item is-danger",
          form: { class: "lp-trail__photo-form", data: { turbo_confirm: t("strategy.rpg.trail.delete_destination_confirm") } } %>
  </div>
</div>
<% end %>
