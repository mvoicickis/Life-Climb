<%# Floating glass panels — support the world, never replace it. %>
<% plans = local_assigns.fetch(:plans, []) %>
<% focus_plan = local_assigns[:focus_plan] %>
<% projects = local_assigns.fetch(:projects, []) %>
<% focus_project = local_assigns[:focus_project] %>
<% battles = local_assigns.fetch(:battles, []) %>
<% mountain = local_assigns.fetch(:mountain, {}) %>
<% alive = local_assigns[:alive] || current_user.alive_level %>
<% area = @journey.life_area %>
<% streak = @climb_streak || strategy_climb_streak_status %>

<div class="lp-rpg-glass" data-strategy-rpg-target="glass">
  <% if @goal && plans.any? %>
    <section class="lp-rpg-panel is-missions" aria-labelledby="rpg-missions-title">
      <header class="lp-rpg-panel__head">
        <div>
          <p class="lp-rpg-panel__kicker"><%= t("strategy.rpg.missions_kicker") %></p>
          <h2 id="rpg-missions-title" class="lp-rpg-panel__title">
            <%= focus_plan&.title || t("strategy.rpg.missions") %>
          </h2>
        </div>
        <% if focus_plan %>
          <details class="lp-rpg-add">
            <summary><%= t("strategy.sheet.add_project") %></summary>
            <%= form_with url: strategy_goals_path, method: :post, class: "lp-rpg-add__form", data: { turbo: false } do %>
              <%= hidden_field_tag :life_area_id, area.id %>
              <%= hidden_field_tag :life_journey_id, @journey.id %>
              <%= hidden_field_tag :horizon, "project" %>
              <%= hidden_field_tag :parent_id, focus_plan.id %>
              <%= text_field_tag :title, nil,
                    required: true,
                    maxlength: 120,
                    class: "lp-rpg-input",
                    placeholder: t("strategy.project_placeholder"),
                    autocomplete: "off" %>
              <%= submit_tag t("strategy.sheet.add_project"), class: "lp-rpg-btn is-small" %>
            <% end %>
          </details>
        <% end %>
      </header>

      <% if projects.any? %>
        <ul class="lp-rpg-missions">
          <% projects.each do |project| %>
            <% pct = project.progress_percent.to_i %>
            <li>
              <%= link_to life_journey_path(@journey, focus_id: project.id),
                    class: "lp-rpg-mission #{'is-focus' if focus_project&.id == project.id} #{'is-done' if project.completed?}" do %>
                <span class="lp-rpg-mission__ring" style="--lp-pct: <%= pct %>" aria-hidden="true">
                  <% if project.completed? %>
                    ✓
                  <% else %>
                    <%= pct %>%
                  <% end %>
                </span>
                <span class="lp-rpg-mission__body">
                  <span class="lp-rpg-mission__title"><%= project.title %></span>
                  <span class="lp-rpg-mission__meta">
                    <%= t("strategy.zones.battles_count", count: project.children.count(&:day?)) %>
                  </span>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="lp-rpg-panel__empty"><%= t("strategy.zones.add_project_hint") %></p>
      <% end %>

      <% if focus_plan.nil? && plans.any? %>
        <p class="lp-rpg-panel__empty"><%= t("strategy.rpg.pick_checkpoint") %></p>
      <% end %>
    </section>

    <section class="lp-rpg-panel is-battles" aria-labelledby="rpg-battles-title">
      <header class="lp-rpg-panel__head">
        <div>
          <p class="lp-rpg-panel__kicker"><%= t("strategy.rpg.battles_kicker") %></p>
          <h2 id="rpg-battles-title" class="lp-rpg-panel__title"><%= t("strategy.rpg.todays_battles") %></h2>
        </div>
        <% if focus_project %>
          <details class="lp-rpg-add">
            <summary><%= t("strategy.sheet.add_battle") %></summary>
            <%= form_with url: strategy_goals_path, method: :post, class: "lp-rpg-add__form", data: { turbo: false } do %>
              <%= hidden_field_tag :life_area_id, area.id %>
              <%= hidden_field_tag :life_journey_id, @journey.id %>
              <%= hidden_field_tag :horizon, "day" %>
              <%= hidden_field_tag :parent_id, focus_project.id %>
              <%= hidden_field_tag :scheduled_on, Date.current %>
              <%= text_field_tag :title, nil,
                    required: true,
                    maxlength: 120,
                    class: "lp-rpg-input",
                    placeholder: t("strategy.battle_placeholder"),
                    autocomplete: "off" %>
              <%= submit_tag t("strategy.sheet.add_battle"), class: "lp-rpg-btn is-small" %>
            <% end %>
          </details>
        <% end %>
      </header>

      <% if focus_project.nil? %>
        <p class="lp-rpg-panel__empty"><%= t("strategy.rpg.pick_mission") %></p>
      <% elsif battles.any? %>
        <ul class="lp-rpg-battles">
          <% battles.each do |battle| %>
            <li class="lp-rpg-battle <%= 'is-done' if battle.completed? %>"
                data-strategy-rpg-target="battleRow">
              <% if battle.completed? %>
                <span class="lp-rpg-battle__check" aria-hidden="true">✓</span>
                <span class="lp-rpg-battle__title"><%= battle.title %></span>
              <% else %>
                <%= button_to battle_win_path(battle),
                      method: :post,
                      class: "lp-rpg-battle__win",
                      form: { data: { turbo: false } } do %>
                  <span class="lp-rpg-battle__box" aria-hidden="true"></span>
                  <span class="lp-rpg-battle__title"><%= battle.title %></span>
                <% end %>
              <% end %>
              <% if battle.scheduled_on == Date.current || battle.scheduled_on.blank? %>
                <span class="lp-rpg-battle__when"><%= t("strategy.rpg.today") %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="lp-rpg-panel__empty"><%= t("strategy.zones.add_battle_hint") %></p>
      <% end %>
    </section>
  <% elsif @goal && plans.empty? %>
    <%# first climb handles empty plans %>
  <% end %>

  <%# Add plan when goal exists and user has plans — always allow another checkpoint %>
  <% if @goal && plans.any? %>
    <details class="lp-rpg-add is-plan">
      <summary><%= t("strategy.sheet.add_plan") %></summary>
      <%= form_with url: strategy_goals_path, method: :post, class: "lp-rpg-add__form", data: { turbo: false } do %>
        <%= hidden_field_tag :life_area_id, area.id %>
        <%= hidden_field_tag :life_journey_id, @journey.id %>
        <%= hidden_field_tag :horizon, "plan" %>
        <%= hidden_field_tag :parent_id, @goal.id %>
        <%= text_field_tag :title, nil,
              required: true,
              maxlength: 120,
              class: "lp-rpg-input",
              placeholder: t("strategy.plan_placeholder"),
              autocomplete: "off" %>
        <%= submit_tag t("strategy.sheet.add_plan"), class: "lp-rpg-btn is-small" %>
      <% end %>
    </details>
  <% end %>

  <section class="lp-rpg-stats" aria-label="<%= t('strategy.rpg.stats') %>">
    <div class="lp-rpg-stat">
      <span class="lp-rpg-stat__label"><%= t("strategy.rpg.xp") %></span>
      <span class="lp-rpg-stat__value"><%= number_with_delimiter(current_user.life_points) %></span>
    </div>
    <div class="lp-rpg-stat">
      <span class="lp-rpg-stat__label"><%= t("strategy.rpg.level") %></span>
      <span class="lp-rpg-stat__value"><%= alive.title %></span>
    </div>
    <div class="lp-rpg-stat">
      <span class="lp-rpg-stat__label"><%= t("strategy.rpg.streak") %></span>
      <span class="lp-rpg-stat__value"><%= streak.days %></span>
    </div>
    <div class="lp-rpg-stat">
      <span class="lp-rpg-stat__label"><%= t("strategy.rpg.mountain") %></span>
      <span class="lp-rpg-stat__value"><%= mountain[:progress].to_i %>%</span>
    </div>
  </section>
</div>
