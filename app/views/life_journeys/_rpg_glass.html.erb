<%# Projects strip + Today's Battles. locals: plans, focus_plan, projects, focus_project, battles, mountain, alive, streak %>
<% plans = local_assigns.fetch(:plans, []) %>
<% focus_plan = local_assigns[:focus_plan] %>
<% projects = local_assigns.fetch(:projects, []) %>
<% focus_project = local_assigns[:focus_project] %>
<% battles = local_assigns.fetch(:battles, []) %>
<% area = @journey.life_area %>
<% battle_xp = GameRules::BATTLE_TODO_LP %>
<% project_accents = %w[green purple orange pink blue] %>
<% battle_glyphs = %w[⚔️ 📖 💪 🎯 🔥 ✍️] %>

<div class="lp-rpg-glass" data-strategy-rpg-target="glass">
  <% if @goal && plans.any? && focus_plan %>
    <section class="lp-rpg-panel is-projects" aria-labelledby="rpg-projects-title">
      <header class="lp-rpg-panel__head">
        <div>
          <p class="lp-rpg-panel__kicker" id="rpg-projects-title">
            <%= t("strategy.rpg.projects_kicker", plan: focus_plan.title) %>
          </p>
        </div>
        <div class="lp-rpg-panel__actions">
          <details class="lp-rpg-add">
            <summary><%= t("strategy.rpg.add_project") %></summary>
            <%= form_with url: strategy_goals_path, method: :post, class: "lp-rpg-add__form", data: { turbo: false } do %>
              <%= hidden_field_tag :life_area_id, area.id %>
              <%= hidden_field_tag :life_journey_id, @journey.id %>
              <%= hidden_field_tag :horizon, "project" %>
              <%= hidden_field_tag :parent_id, focus_plan.id %>
              <%= text_field_tag :title, nil,
                    required: true,
                    maxlength: 120,
                    class: "lp-rpg-input",
                    placeholder: t("strategy.project_placeholder"),
                    autocomplete: "off" %>
              <%= submit_tag t("strategy.sheet.add_project"), class: "lp-rpg-btn is-small" %>
            <% end %>
          </details>
        </div>
      </header>

      <% if projects.any? %>
        <ul class="lp-rpg-projects">
          <% projects.each_with_index do |project, idx| %>
            <% pct = project.progress_percent.to_i %>
            <% battle_count = project.children.count(&:day?) %>
            <% locked = !project.completed? && battle_count.zero? && focus_project&.id != project.id %>
            <% accent = project_accents[idx % project_accents.size] %>
            <li>
              <% if locked %>
                <div class="lp-rpg-project is-locked is-<%= accent %>" aria-label="<%= t('strategy.rpg.locked') %>">
                  <span class="lp-rpg-project__top">
                    <span class="lp-rpg-project__glyph" aria-hidden="true">🔒</span>
                    <span class="lp-rpg-project__pct">0%</span>
                  </span>
                  <span class="lp-rpg-project__title"><%= project.title %></span>
                  <span class="lp-rpg-project__bar" aria-hidden="true">
                    <span class="lp-rpg-project__fill" style="width: 0%"></span>
                  </span>
                  <span class="lp-rpg-project__meta lp-rpg-mission__meta"><%= t("strategy.rpg.locked") %></span>
                </div>
              <% else %>
                <%= link_to life_journey_path(@journey, focus_id: project.id),
                      class: "lp-rpg-project lp-rpg-mission is-#{accent} #{'is-focus' if focus_project&.id == project.id} #{'is-done' if project.completed?}" do %>
                  <span class="lp-rpg-project__top">
                    <span class="lp-rpg-project__glyph" aria-hidden="true">
                      <%= render "shared/lp_icon", name: "flag", class_name: "lp-icon is-chip" %>
                    </span>
                    <span class="lp-rpg-project__pct"><%= pct %>%</span>
                  </span>
                  <span class="lp-rpg-project__title"><%= project.title %></span>
                  <% if project.description.present? %>
                    <span class="lp-rpg-project__desc"><%= project.description.truncate(48) %></span>
                  <% end %>
                  <span class="lp-rpg-project__bar" aria-hidden="true">
                    <span class="lp-rpg-project__fill" style="width: <%= pct %>%"></span>
                  </span>
                  <span class="lp-rpg-project__meta lp-rpg-mission__meta">
                    <span class="lp-rpg-mission__ring" style="--lp-pct: <%= pct %>" aria-hidden="true"></span>
                    ⚔️ <%= t("strategy.zones.battles_count", count: battle_count) %>
                  </span>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="lp-rpg-panel__empty"><%= t("strategy.zones.add_project_hint") %></p>
      <% end %>
    </section>

    <section class="lp-rpg-panel is-battles" aria-labelledby="rpg-battles-title">
      <header class="lp-rpg-panel__head">
        <div>
          <h2 id="rpg-battles-title" class="lp-rpg-panel__title"><%= t("strategy.rpg.todays_battles") %></h2>
        </div>
        <% if focus_project %>
          <details class="lp-rpg-add">
            <summary><%= t("strategy.rpg.add_battle") %></summary>
            <%= form_with url: strategy_goals_path, method: :post, class: "lp-rpg-add__form", data: { turbo: false } do %>
              <%= hidden_field_tag :life_area_id, area.id %>
              <%= hidden_field_tag :life_journey_id, @journey.id %>
              <%= hidden_field_tag :horizon, "day" %>
              <%= hidden_field_tag :parent_id, focus_project.id %>
              <%= hidden_field_tag :scheduled_on, Date.current %>
              <%= text_field_tag :title, nil,
                    required: true,
                    maxlength: 120,
                    class: "lp-rpg-input",
                    placeholder: t("strategy.battle_placeholder"),
                    autocomplete: "off" %>
              <%= submit_tag t("strategy.sheet.add_battle"), class: "lp-rpg-btn is-small" %>
            <% end %>
          </details>
        <% end %>
      </header>

      <% if focus_project.nil? %>
        <p class="lp-rpg-panel__empty"><%= t("strategy.rpg.pick_mission") %></p>
      <% elsif battles.any? %>
        <ul class="lp-rpg-battles">
          <% battles.each_with_index do |battle, idx| %>
            <% difficulty = strategy_battle_difficulty(battle_xp) %>
            <% glyph = battle_glyphs[idx % battle_glyphs.size] %>
            <li class="lp-rpg-battle <%= 'is-done' if battle.completed? %>"
                data-strategy-rpg-target="battleRow">
              <% if battle.completed? %>
                <span class="lp-rpg-battle__check" aria-hidden="true">✓</span>
                <span class="lp-rpg-battle__glyph" aria-hidden="true"><%= glyph %></span>
                <span class="lp-rpg-battle__body">
                  <span class="lp-rpg-battle__title"><%= battle.title %></span>
                </span>
              <% else %>
                <%= button_to battle_win_path(battle),
                      method: :post,
                      class: "lp-rpg-battle__win",
                      form: { data: { turbo: false } } do %>
                  <span class="lp-rpg-battle__box" aria-hidden="true"></span>
                  <span class="lp-rpg-battle__glyph" aria-hidden="true"><%= glyph %></span>
                  <span class="lp-rpg-battle__body">
                    <span class="lp-rpg-battle__title"><%= battle.title %></span>
                    <span class="lp-rpg-battle__tags">
                      <span class="lp-rpg-diff is-<%= difficulty %>"><%= t("strategy.rpg.difficulty.#{difficulty}") %></span>
                    </span>
                  </span>
                <% end %>
              <% end %>
              <span class="lp-rpg-battle__xp">+<%= battle_xp %> <%= t("strategy.rpg.xp") %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="lp-rpg-panel__empty"><%= t("strategy.zones.add_battle_hint") %></p>
      <% end %>
    </section>
  <% elsif @goal && plans.any? %>
    <p class="lp-rpg-panel__empty"><%= t("strategy.rpg.pick_checkpoint") %></p>
  <% end %>
</div>
