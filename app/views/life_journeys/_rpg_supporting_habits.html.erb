<%# locals: habits %>
<% habits = local_assigns.fetch(:habits) { @supporting_habits || [] } %>
<% return if habits.blank? %>

<section class="lp-rpg-habits" aria-labelledby="rpg-supporting-habits">
  <header class="lp-rpg-habits__head">
    <p class="lp-rpg-habits__eyebrow"><%= t("strategy.rpg.supporting_habits_eyebrow") %></p>
    <h2 id="rpg-supporting-habits" class="lp-rpg-habits__title"><%= t("strategy.rpg.supporting_habits_title") %></h2>
    <p class="lp-rpg-habits__sub"><%= t("strategy.rpg.supporting_habits_sub") %></p>
  </header>

  <ul class="lp-rpg-habits__list">
    <% habits.each do |habit| %>
      <li class="lp-rpg-habits__item has-color is-amber">
        <%= link_to habit_path(habit), class: "lp-rpg-habits__link" do %>
          <span class="lp-rpg-habits__name"><%= habit.name %></span>
          <span class="lp-rpg-habits__meta"><%= habit.unit %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <p class="lp-rpg-habits__cta">
    <%= link_to t("strategy.rpg.supporting_habits_cta"), habits_path, class: "lp-rpg-habits__cta-link" %>
  </p>
</section>
