<% today_card = local_assigns.fetch(:today_card) %>
<% pills = local_assigns.fetch(:pills) %>
<% plant_mode = local_assigns.fetch(:plant_mode) %>
<% mode = today_card[:mode].to_s %>
<% camp_kicker_modes = %w[battle forward add_battle] %>
<span class="lp-trail-base-card__fire" aria-hidden="true">🔥</span>
<span class="lp-trail-base-card__copy">
  <% if camp_kicker_modes.include?(mode) && today_card[:sub].present? %>
    <span class="lp-trail-base-card__kicker"><%= today_card[:sub] %></span>
  <% elsif plant_mode %>
    <span class="lp-trail-base-card__kicker"><%= t("strategy.rpg.trail.plant.kicker") %></span>
  <% else %>
    <span class="lp-trail-base-card__kicker"><%= t("strategy.rpg.trail.base_camp.kicker") %></span>
  <% end %>
  <span class="lp-trail-base-card__title"><%= today_card[:headline] %></span>
  <% if today_card[:sub].present? && !camp_kicker_modes.include?(mode) %>
    <span class="lp-trail-base-card__sub"><%= today_card[:sub] %></span>
  <% end %>
</span>
<% if today_card[:battle].present? %>
  <span class="lp-trail-base-card__tick-slot"
        data-action="click->trail-dock#stopBubble pointerdown->trail-dock#stopBubble">
    <%= render "life_journeys/trail_battle_check", battle: today_card[:battle] %>
  </span>
<% else %>
  <span class="lp-trail-base-card__chev" aria-hidden="true">›</span>
<% end %>
<% if pills[:items].any? %>
  <span class="lp-trail-base-card__peek">
    <% pills[:items].each do |pill| %>
      <span class="lp-trail-base-card__pill"><%= pill[:name].truncate(16) %> <b><%= pill[:count] %>d</b></span>
    <% end %>
    <% if pills[:extra].positive? %>
      <span class="lp-trail-base-card__pill is-more"><%= t("strategy.rpg.trail.base_camp.more", count: pills[:extra]) %></span>
    <% end %>
  </span>
<% end %>
