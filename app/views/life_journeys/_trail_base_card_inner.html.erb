<% today_card = local_assigns.fetch(:today_card) %>
<% pills = local_assigns.fetch(:pills) %>
<% plant_mode = local_assigns.fetch(:plant_mode) %>
<% dock_main_action = local_assigns.fetch(:dock_main_action) %>
<% base_open_action = local_assigns.fetch(:base_open_action) %>
<% base_open_label = local_assigns.fetch(:base_open_label) %>
<% camp_id = local_assigns[:camp_id] %>
<% mode = today_card[:mode].to_s %>
<% camp_kicker_modes = %w[battle forward add_battle] %>
<% pill_total = pills[:total].to_i %>
<% first_pill = pills[:items].first %>
<% more_count = pill_total > 1 ? pill_total - 1 : 0 %>
<div class="lp-trail-base-card__main"
     role="button"
     tabindex="0"
     <% if camp_id.present? %>
     data-camp-id="<%= camp_id %>"
     <% end %>
     data-action="<%= dock_main_action %> keydown->trail-dock#keydown">
  <span class="lp-trail-base-card__copy">
    <% if camp_kicker_modes.include?(mode) && today_card[:sub].present? %>
      <span class="lp-trail-base-card__kicker"><%= today_card[:sub] %></span>
    <% elsif plant_mode %>
      <span class="lp-trail-base-card__kicker"><%= t("strategy.rpg.trail.plant.kicker") %></span>
    <% else %>
      <span class="lp-trail-base-card__kicker"><%= t("strategy.rpg.trail.base_camp.kicker") %></span>
    <% end %>
    <span class="lp-trail-base-card__title" title="<%= today_card[:headline] %>"><%= today_card[:headline] %></span>
    <% if today_card[:sub].present? && !camp_kicker_modes.include?(mode) %>
      <span class="lp-trail-base-card__sub"><%= today_card[:sub] %></span>
    <% end %>
  </span>
  <% if today_card[:battle].blank? %>
    <span class="lp-trail-base-card__chev" aria-hidden="true">›</span>
  <% end %>
</div>
<% if today_card[:battle].present? %>
  <span class="lp-trail-base-card__tick-slot"
        data-action="click->trail-dock#stopBubble pointerdown->trail-dock#stopBubble">
    <%= render "life_journeys/trail_battle_check", battle: today_card[:battle] %>
  </span>
<% end %>
<button type="button"
        class="lp-trail-base-card__base-row"
        data-action="<%= base_open_action %>"
        aria-label="<%= base_open_label %>">
  <span class="lp-trail-base-card__base-head">
    <svg class="lp-trail-base-card__base-tent" viewBox="0 0 56 44" aria-hidden="true">
      <path class="trail-tent-body" d="M6 44 L28 6 L50 44 Z"/>
      <path class="trail-tent-shade" d="M28 6 L50 44 L28 44 Z"/>
      <path class="trail-tent-door" d="M22 44 L22 30 L34 30 L34 44 Z"/>
    </svg>
    <span class="lp-trail-base-card__base-label"><%= t("strategy.rpg.trail.base_camp.kicker") %></span>
  </span>
  <span class="lp-trail-base-card__pills">
    <% if first_pill.present? %>
      <span class="lp-trail-base-card__pill"><%= first_pill[:name] %></span>
      <% if more_count.positive? %>
        <span class="lp-trail-base-card__pill is-more"><%= t("strategy.rpg.trail.base_camp.more", count: more_count) %></span>
      <% end %>
    <% else %>
      <span class="lp-trail-base-card__pill is-add"><%= t("strategy.rpg.trail.base_camp.dock_add_pill") %></span>
    <% end %>
  </span>
</button>
