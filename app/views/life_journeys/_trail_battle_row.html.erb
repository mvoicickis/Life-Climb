<%# One camp-sheet battle row. locals: battle, done:, show_move_up:, show_move_down: %>
<% battle = local_assigns.fetch(:battle) %>
<% done = local_assigns.fetch(:done) { mountain_trail_done_today?(battle) } %>
<% if done %>
  <li class="lp-trail-battles__row is-won"
      id="trail-battle-<%= battle.id %>"
      data-battle-id="<%= battle.id %>">
    <%= button_to battle_reopen_path(battle),
          method: :post,
          class: "lp-trail-battles__won-row-btn",
          form: {
            class: "lp-trail-battles__reopen-form",
            data: {
              turbo: true,
              turbo_stream: true,
              action: "turbo:submit-end->trail-battles#battleReopened"
            }
          } do %>
      <span class="lp-trail-battles__tick is-done" aria-hidden="true">
        <span class="lp-trail-battles__box is-won"></span>
      </span>
      <span class="lp-trail-battles__name"><%= battle.title %></span>
      <%= render "life_journeys/trail_battle_repeat_chip", battle: battle %>
      <span class="sr-only"><%= t("strategy.rpg.trail.undo") %></span>
    <% end %>
  </li>
<% else %>
  <li class="lp-trail-battles__row is-open is-check lp-frost"
      id="trail-battle-<%= battle.id %>"
      data-battle-id="<%= battle.id %>"
      data-battle-title="<%= battle.title %>"
      data-update-url="<%= strategy_goal_path(battle) %>">
    <%= render "life_journeys/trail_battle_check", battle: battle, camp_sheet: true %>
    <details class="lp-trail-battles__kebab"
             data-controller="tcard-menu"
             data-tcard-menu-target="details"
             data-action="toggle->tcard-menu#toggled">
      <summary class="lp-trail-battles__kebab-btn" aria-label="<%= t('strategy.rpg.trail.battle_menu') %>">⋯</summary>
      <div class="lp-trail-battles__kebab-menu">
        <button type="button"
                data-action="click->trail-battles#renameBattle"
                data-update-url="<%= strategy_goal_path(battle) %>"><%= t("strategy.rpg.trail.battle_rename") %></button>
        <%= render "life_journeys/trail_battle_repeat_menu", battle: battle %>
        <% if local_assigns[:show_move_up] %>
          <%= button_to t("strategy.rpg.trail.battle_move_up"),
                strategy_goal_path(battle),
                method: :patch,
                params: { move: "up" },
                form: { data: { turbo: true } } %>
        <% end %>
        <% if local_assigns[:show_move_down] %>
          <%= button_to t("strategy.rpg.trail.battle_move_down"),
                strategy_goal_path(battle),
                method: :patch,
                params: { move: "down" },
                form: { data: { turbo: true } } %>
        <% end %>
        <%= button_to t("strategy.rpg.trail.delete_battle"),
              strategy_goal_path(battle),
              method: :delete,
              class: "is-danger",
              form: {
                data: {
                  turbo: true,
                  turbo_confirm: t("strategy.rpg.trail.delete_battle_body", title: battle.title),
                  action: "submit->trail-battles#stashBattleDelete"
                }
              } %>
      </div>
    </details>
  </li>
<% end %>
