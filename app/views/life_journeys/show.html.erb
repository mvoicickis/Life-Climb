<% content_for :title, t("strategy.page_title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>
<% sp_gained = flash[:sp_gained].to_i %>
<% ap_gained = flash[:ap_gained].to_i %>
<% boss = flash[:climb_boss].present? %>
<% mountain = @mountain || { stage: :empty, progress: 0, flags: 0, label: "" } %>
<% trail = @trail %>
<% climb_reward = flash[:climb_reward] %>
<% first_climb = @first_climb_needed %>
<% progress = mountain[:progress].to_i %>
<% stage =
     if progress >= 75 then "summit"
     elsif progress >= 45 then "ridge"
     elsif progress >= 15 then "trail"
     else "base"
     end %>
<% root_goals = @root_goals || [] %>
<% plans = @goal ? @goal.children.select(&:plan?).sort_by { |p| [ p.position.to_i, p.id ] } : [] %>
<% plan = @plan %>
<% current_project = @current_project %>
<% alive = current_user.alive_level %>
<% streak = @climb_streak || strategy_climb_streak_status %>

<div class="lp-rpg is-focus-phase is-game-first <%= 'is-first-climb' if first_climb %>"
     id="strategy-world"
     data-controller="strategy-celebrate strategy-rpg"
     data-strategy-celebrate-gained-value="<%= sp_gained %>"
     data-strategy-celebrate-ap-gained-value="<%= ap_gained %>"
     data-strategy-celebrate-boss-value="<%= boss %>"
     data-strategy-rpg-progress-value="<%= progress %>"
     data-strategy-rpg-celebrate-value="<%= ap_gained.positive? || flash[:battle_celebrate].present? %>"
     data-progress="<%= progress %>"
     data-stage="<%= stage %>">

  <% if first_climb && @goal %>
    <div class="lp-first-climb-shell">
      <div class="lp-first-climb-shell__sky" aria-hidden="true"></div>
      <%= render "life_journeys/first_climb_coach", journey: @journey, goal: @goal %>
    </div>
  <% else %>
    <div class="lp-rpg-scenic" style="--lp-scenic: url('/images/strategy-mountain-scenic.jpg')" aria-hidden="true"></div>
    <div class="lp-rpg-scenic__veil" aria-hidden="true"></div>

    <%# Hero Rule Q1–Q3 only in first viewport %>
    <div class="lp-rpg-hero">
      <%= render "life_journeys/rpg_goal_switcher",
            root_goals: root_goals,
            goal: @goal %>

      <%= render "life_journeys/rpg_plan_rail",
            plans: plans,
            plan: plan,
            goal: @goal %>

      <div class="lp-rpg-climb is-hero">
        <%= render "life_journeys/rpg_trail",
              trail: trail,
              goal: @goal,
              plan: plan,
              alive: alive %>
      </div>

      <%= render "life_journeys/rpg_battle_sheet",
            current_project: current_project,
            plan: plan,
            goal: @goal,
            trail: trail %>
    </div>

    <%# Fourth-question UI — below the fold %>
    <div class="lp-rpg-support" id="mountain-support">
      <%= render "life_journeys/rpg_stats",
            mountain: mountain,
            alive: alive,
            streak: streak %>

      <% if plan %>
        <details class="lp-rpg-add is-checkpoint">
          <summary aria-label="<%= t('strategy.rpg.add_checkpoint') %>">
            <span class="lp-rpg-add__label lp-rpg-add__label--short" aria-hidden="true">+</span>
            <span class="lp-rpg-add__label lp-rpg-add__label--long"><%= t("strategy.rpg.add_checkpoint") %></span>
          </summary>
          <%= form_with url: strategy_goals_path, method: :post, class: "lp-rpg-add__form", data: { turbo: false } do %>
            <%= hidden_field_tag :life_area_id, @journey.life_area_id %>
            <%= hidden_field_tag :life_journey_id, @journey.id %>
            <%= hidden_field_tag :horizon, "project" %>
            <%= hidden_field_tag :parent_id, plan.id %>
            <%= text_field_tag :title, nil,
                  required: true,
                  maxlength: 120,
                  class: "lp-rpg-input",
                  placeholder: t("strategy.project_placeholder"),
                  autocomplete: "off" %>
            <%= submit_tag t("strategy.sheet.add_project"), class: "lp-rpg-btn is-small" %>
          <% end %>
        </details>
      <% end %>
    </div>
  <% end %>

  <%= render "shared/climb_reward", reward: climb_reward if climb_reward.present? %>
</div>

<%= render "shared/lp_dash_nav", active: :mountain %>
