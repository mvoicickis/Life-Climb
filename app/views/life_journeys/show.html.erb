<% content_for :title, @journey.title %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>

<%
  today_mission = @journey.missions.for_day(Date.current).primary.order(:id).first
%>

<div class="lp-home mx-auto max-w-lg space-y-5 px-4 pb-24 pt-5">
  <header>
    <p class="text-sm text-[var(--lp-muted)]"><%= @journey.life_area.label %></p>
    <h1 class="text-3xl font-semibold text-[var(--lp-ink)]"><%= @journey.title %></h1>
  </header>

  <section class="lp-glass space-y-2 p-4">
    <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--lp-muted)]"><%= t("coach.vision") %></h2>
    <p class="text-[var(--lp-ink)]"><%= @journey.ideal_scene %></p>
  </section>

  <section class="lp-glass space-y-2 p-4">
    <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--lp-muted)]"><%= t("coach.reality") %></h2>
    <p class="text-[var(--lp-ink)]"><%= @journey.current_reality %></p>
  </section>

  <% if @journey.next_win.present? %>
    <section class="lp-glass space-y-2 p-4">
      <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--lp-muted)]"><%= t("coach.next_label") %></h2>
      <p class="text-[var(--lp-ink)]"><%= @journey.next_win %></p>
    </section>
  <% end %>

  <section class="lp-glass space-y-2 p-4">
    <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--lp-muted)]"><%= t("dashboard_v2.today_mission") %></h2>
    <% if today_mission %>
      <p class="text-[var(--lp-ink)]"><%= today_mission.title %></p>
      <% if today_mission.completed? %>
        <p class="mt-2 text-sm text-[var(--lp-lime)]"><%= t("dashboard_v2.done_today") %></p>
      <% else %>
        <%= link_to t("coach.open_home"), dashboard_path, class: "mt-3 inline-flex text-sm font-bold text-[var(--lp-lime)]" %>
      <% end %>
    <% else %>
      <%= link_to t("coach.begin_today"), dashboard_path, class: "lp-cta mt-2 inline-flex" %>
    <% end %>
  </section>

  <section class="lp-glass p-4">
    <p class="text-sm text-[var(--lp-muted)]"><%= t("dashboard_v2.gap") %></p>
    <p class="text-3xl font-semibold text-[var(--lp-ink)]"><%= @journey.gap_percent.to_i %>%</p>
  </section>

  <% if @journey.status != "completed" %>
    <%= button_to t("journeys.reached_this"),
          life_journey_completion_path(@journey),
          method: :post,
          form: { data: { turbo_confirm: t("journeys.confirm_complete") } },
          class: "lp-cta w-full" %>
  <% else %>
    <%= link_to t("next_mountain.title"), next_mountain_path, class: "lp-cta inline-flex" %>
  <% end %>
</div>

<%= render "shared/lp_dash_nav", active: :journey %>

