<% content_for :title, t("strategy.page_title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>
<% sp_gained = flash[:sp_gained].to_i %>
<% ap_gained = flash[:ap_gained].to_i %>
<% boss = flash[:climb_boss].present? %>
<% mountain = @mountain || { stage: :empty, progress: 0, flags: 0, label: "" } %>
<% climb_reward = flash[:climb_reward] %>
<% camera_level =
     if @branch_project.present? then 3
     elsif @branch_plan.present? then 2
     else 1
     end %>
<% camera_focus =
     if @branch_project.present? then @branch_project.id
     elsif @branch_plan.present? then @branch_plan.id
     else @goal&.id
     end %>

<div class="lp-world lp-strategy-page is-living-world is-lit-trail is-gamefeel"
     id="strategy-world"
     data-controller="strategy-celebrate strategy-mountain strategy-camera"
     data-strategy-celebrate-gained-value="<%= sp_gained %>"
     data-strategy-celebrate-ap-gained-value="<%= ap_gained %>"
     data-strategy-celebrate-boss-value="<%= boss %>"
     data-strategy-mountain-open-value="<%= @open_sheet ? 'true' : 'false' %>"
     data-strategy-mountain-open-menu-value="<%= @open_peek ? 'true' : 'false' %>"
     data-strategy-camera-level-value="<%= camera_level %>"
     data-strategy-camera-focus-id-value="<%= camera_focus %>"
     data-strategy-camera-journey-url-value="<%= life_journey_path(@journey) %>"
     <% if @sheet_node.present? %>
       data-strategy-mountain-focus-sheet-value="strategy-sheet-<%= @sheet_node.id %>"
       data-strategy-mountain-focus-menu-value="strategy-menu-<%= @sheet_node.id %>"
     <% end %>>

  <header class="lp-world-hud" aria-label="<%= t('strategy.page_title') %>">
    <div class="lp-world-hud__left">
      <div class="lp-world-hud__chip is-ap" aria-label="<%= t('dash.action_points_label') %>">
        <span class="lp-world-hud__chip-value" data-strategy-celebrate-target="apValue"><%= number_with_delimiter(current_user.life_points) %></span>
        <span class="lp-world-hud__chip-name"><%= t("dash.action_points_short") %></span>
      </div>
      <div class="lp-world-hud__chip is-sp"
           data-strategy-celebrate-target="spBadge"
           aria-label="<%= t('strategy.sp_label') %>">
        <span class="lp-world-hud__chip-value" data-strategy-celebrate-target="spValue"><%= number_with_delimiter(current_user.strategy_points) %></span>
        <span class="lp-world-hud__chip-name"><%= t("strategy.sp_hint_short") %></span>
      </div>
    </div>
    <div class="lp-world-hud__right">
      <%= link_to settings_path, class: "lp-world-hud__gear", aria: { label: t("nav.settings") } do %>
        <span aria-hidden="true">⚙</span>
      <% end %>
    </div>
    <div class="lp-world-hud__meta">
      <% if @goal %>
        <p class="lp-world-hud__goal" title="<%= @goal.title %>">
          <span aria-hidden="true">🎯</span>
          <span><%= @goal.title.truncate(28) %></span>
        </p>
        <p class="lp-world-hud__camp">
          <span aria-hidden="true">🏕</span>
          <span><%= mountain[:label] %></span>
          <span class="lp-world-hud__pct"><%= mountain[:progress].to_i %>%</span>
        </p>
      <% else %>
        <p class="lp-world-hud__goal"><%= t("strategy.promise") %></p>
      <% end %>
      <%= render "shared/climb_streak_chip", status: (@climb_streak || strategy_climb_streak_status), compact: true %>
    </div>
    <button type="button"
            class="lp-world-hud__zoomout"
            data-strategy-camera-target="zoomOut"
            data-action="strategy-camera#zoomOut"
            hidden>
      <%= t("strategy.camera.zoom_out") %>
    </button>
  </header>

  <div class="lp-world__stage" id="strategy-world-map">
    <%= render "life_journeys/strategy_mountain", mountain: mountain %>
  </div>

  <div class="lp-world__dock">
    <%= render "life_journeys/strategy_fight_cta" %>
  </div>

  <% if @goal %>
    <%
      sheet_nodes = [ @goal ]
      @goal.children.select(&:plan?).each do |plan|
        sheet_nodes << plan
        plan.children.select(&:project?).each do |project|
          sheet_nodes << project
          project.children.select(&:day?).each { |battle| sheet_nodes << battle }
        end
      end
    %>
    <% sheet_nodes.uniq.each do |node| %>
      <%= render "life_journeys/strategy_pin_menu", node: node %>
      <%= render "life_journeys/strategy_node_sheet", node: node %>
    <% end %>
  <% end %>

  <%= render "shared/climb_reward", reward: climb_reward if climb_reward.present? %>
</div>

<%= render "shared/lp_dash_nav", active: :mountain %>
