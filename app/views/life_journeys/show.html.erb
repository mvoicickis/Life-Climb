<% content_for :title, t("strategy.page_title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>
<% sp_gained = flash[:sp_gained].to_i %>
<% mountain = @mountain || { stage: :empty, progress: 0, flags: 0, label: "" } %>
<% crumb_nodes = strategy_breadcrumb_nodes(
     goal: @goal,
     plan: @branch_plan,
     project: @branch_project,
     battle: @today_battle
   ) %>

<div class="lp-home lp-strategy-page is-exact-mockup is-lit-trail mx-auto max-w-lg pb-40 pt-4"
     data-controller="strategy-celebrate strategy-mountain"
     data-strategy-celebrate-gained-value="<%= sp_gained %>"
     data-strategy-mountain-open-value="<%= @open_sheet ? 'true' : 'false' %>"
     <% if @sheet_node.present? %>
       data-strategy-mountain-focus-sheet-value="strategy-sheet-<%= @sheet_node.id %>"
     <% end %>>
  <header class="lp-strategy-page__header is-mockup px-4">
    <div class="lp-strategy-page__top">
      <p class="lp-brand-kicker">
        <%= render "shared/lp_brand_mark", size: 22, class_name: "lp-brand-kicker__mark" %>
        <span>LifePoints</span>
      </p>
      <div class="lp-strategy__sp is-soft is-pill shrink-0"
           data-strategy-celebrate-target="spBadge"
           aria-label="<%= t('strategy.sp_label') %>">
        <span class="lp-strategy__sp-value" data-strategy-celebrate-target="spValue"><%= current_user.strategy_points %></span>
        <span class="lp-strategy__sp-label"><%= t("strategy.sp_label") %></span>
      </div>
    </div>
    <h1 class="lp-strategy-page__title"><%= t("strategy.page_title") %></h1>
    <% if @goal %>
      <%= render "life_journeys/strategy_breadcrumb", nodes: crumb_nodes %>
      <p class="lp-strategy-page__goal-pct"><%= t("strategy.sheet.progress", pct: mountain[:progress].to_i) %></p>
      <div class="lp-strategy-page__goal-track" aria-hidden="true">
        <span style="width: <%= mountain[:progress].to_i %>%"></span>
      </div>
    <% else %>
      <p class="lp-strategy-page__promise"><%= t("strategy.promise") %></p>
    <% end %>
  </header>

  <%= render "life_journeys/strategy_mountain", mountain: mountain %>

  <div class="lp-strategy-page__dock px-3">
    <%= render "life_journeys/strategy_fight_cta" %>
  </div>

  <% if @goal %>
    <%
      sheet_nodes = [ @goal ]
      @goal.children.select(&:plan?).each do |plan|
        sheet_nodes << plan
        plan.children.select(&:project?).each do |project|
          sheet_nodes << project
          project.children.select(&:day?).each { |battle| sheet_nodes << battle }
        end
      end
    %>
    <% sheet_nodes.uniq.each do |node| %>
      <%= render "life_journeys/strategy_node_sheet", node: node %>
    <% end %>
  <% end %>
</div>

<%= render "shared/lp_dash_nav", active: :mountain %>
