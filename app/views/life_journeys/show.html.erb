<% content_for :title, t("strategy.page_title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>
<% content_for :head do %>
  <meta name="view-transition" content="same-origin">
<% end %>
<% sp_gained = flash[:sp_gained].to_i %>
<% ap_gained = flash[:ap_gained].to_i %>
<% boss = flash[:climb_boss].present? %>
<% mountain = @mountain || { stage: :empty, progress: 0, flags: 0, label: "" } %>
<% trail = @trail %>
<% climb_reward = flash[:climb_reward] %>
<% first_climb = @first_climb_needed %>
<% progress = mountain[:progress].to_i %>
<% stage =
     if progress >= 75 then "summit"
     elsif progress >= 45 then "ridge"
     elsif progress >= 15 then "trail"
     else "base"
     end %>
<% root_goals = @root_goals || [] %>
<% plans = @goal ? @goal.children.select { |c| c.plan? && !c.holding? }.sort_by { |p| [ p.position.to_i, p.id ] } : [] %>
<% plan = @plan %>
<% current_project = @current_project %>
<% alive = current_user.alive_level %>
<% streak = @climb_streak || strategy_climb_streak_status %>
<% v4_phone = plan.present? && !first_climb %>
<% v4_shell = first_climb || v4_phone %>

<div class="lp-rpg is-focus-phase <%= 'is-first-climb' if first_climb %> <%= 'is-v4-phone' if v4_shell %>"
     id="strategy-world"
     data-controller="strategy-celebrate strategy-rpg"
     data-strategy-celebrate-gained-value="<%= sp_gained %>"
     data-strategy-celebrate-ap-gained-value="<%= ap_gained %>"
     data-strategy-celebrate-boss-value="<%= boss %>"
     data-strategy-rpg-progress-value="<%= progress %>"
     data-strategy-rpg-celebrate-value="<%= ap_gained.positive? || flash[:battle_celebrate].present? %>"
     data-progress="<%= progress %>"
     data-stage="<%= stage %>">

  <% if first_climb && @goal %>
    <div class="lp-rpg__stage is-planning is-v4">
      <div class="lp-rpg__planning is-v4">
        <div class="lp-rpg__stage-sections lp-rpg__stage-trail is-v4">
          <%= render "life_journeys/trail_canvas",
                trail: trail,
                goal: @goal,
                plan: nil,
                plans: [],
                journey: @journey,
                current_project: nil,
                focus: @focus,
                alive: alive,
                streak: streak,
                progress: progress,
                root_goals: root_goals,
                destination_overlay: true %>
        </div>
      </div>
    </div>
  <% elsif v4_phone %>
    <div class="lp-rpg__stage is-planning is-v4">
      <div class="lp-rpg__planning is-v4">
        <div class="lp-rpg__stage-sections lp-rpg__stage-trail is-v4">
          <%= render "life_journeys/trail_canvas",
                trail: trail,
                goal: @goal,
                plan: plan,
                plans: plans,
                journey: @journey,
                current_project: current_project,
                focus: @focus,
                alive: alive,
                streak: streak,
                progress: progress,
                root_goals: root_goals %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="lp-rpg-scenic" style="--lp-scenic: url('/images/strategy-mountain-scenic.jpg')" aria-hidden="true"></div>
    <div class="lp-rpg-scenic__veil" aria-hidden="true"></div>

    <div class="lp-rpg__chrome-top">
      <%= render "life_journeys/rpg_goal_switcher",
            root_goals: root_goals,
            goal: @goal,
            progress: progress,
            mountain: mountain,
            alive: alive,
            streak: streak %>

      <%= render "life_journeys/rpg_plan_rail",
            plans: plans,
            plan: plan,
            goal: @goal %>
    </div>

    <div class="lp-rpg__stage is-planning">
      <div class="lp-rpg__planning">
        <div class="lp-rpg__stage-sections lp-rpg__stage-trail">
          <%= render "life_journeys/rpg_climb_path",
                trail: trail,
                goal: @goal,
                plan: plan,
                current_project: current_project,
                focus: @focus %>
        </div>
      </div>
    </div>
  <% end %>

  <%= render "shared/climb_reward", reward: climb_reward if climb_reward.present? %>
</div>

<%= render "shared/lp_dash_nav",
      active: :mountain,
      variant: (v4_shell ? :v4 : :default) %>
