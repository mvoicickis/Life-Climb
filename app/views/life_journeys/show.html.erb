<% content_for :title, t("strategy.page_title") %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>
<% sp_gained = flash[:sp_gained].to_i %>
<% ap_gained = flash[:ap_gained].to_i %>
<% boss = flash[:climb_boss].present? %>
<% mountain = @mountain || { stage: :empty, progress: 0, flags: 0, label: "" } %>
<% climb_reward = flash[:climb_reward] %>
<% first_climb = @first_climb_needed %>
<% progress = mountain[:progress].to_i %>
<% stage =
     if progress >= 75 then "summit"
     elsif progress >= 45 then "ridge"
     elsif progress >= 15 then "trail"
     else "base"
     end %>
<% plans = @goal ? @goal.children.select(&:plan?).sort_by { |p| [ p.position.to_i, p.id ] } : [] %>
<% focus_plan = @branch_plan || plans.first %>
<% projects = focus_plan ? focus_plan.children.select(&:project?).sort_by { |p| [ p.position.to_i, p.id ] } : [] %>
<% focus_project = @branch_project || projects.find { |p| p.children.any? { |c| c.day? && !c.completed? } } || projects.first %>
<% battles = focus_project ? focus_project.children.select(&:day?).sort_by { |b| [ b.scheduled_on || Date.new(9999), b.position.to_i, b.id ] } : [] %>
<% alive = current_user.alive_level %>
<% streak = @climb_streak || strategy_climb_streak_status %>

<div class="lp-rpg <%= 'is-first-climb' if first_climb %>"
     id="strategy-world"
     data-controller="strategy-celebrate strategy-rpg"
     data-strategy-celebrate-gained-value="<%= sp_gained %>"
     data-strategy-celebrate-ap-gained-value="<%= ap_gained %>"
     data-strategy-celebrate-boss-value="<%= boss %>"
     data-strategy-rpg-progress-value="<%= progress %>"
     data-strategy-rpg-celebrate-value="<%= ap_gained.positive? || flash[:battle_celebrate].present? %>"
     data-progress="<%= progress %>"
     data-stage="<%= stage %>">

  <% if first_climb && @goal %>
    <div class="lp-first-climb-shell">
      <div class="lp-first-climb-shell__sky" aria-hidden="true"></div>
      <%= render "life_journeys/first_climb_coach", journey: @journey, goal: @goal %>
    </div>
  <% else %>
    <div class="lp-rpg-scenic" style="--lp-scenic: url('/images/strategy-mountain-scenic.jpg')" aria-hidden="true"></div>
    <div class="lp-rpg-scenic__veil" aria-hidden="true"></div>

    <%= render "life_journeys/rpg_hud",
          mountain: mountain,
          progress: progress,
          alive: alive,
          streak: streak %>

    <div class="lp-rpg-board">
      <%= render "life_journeys/rpg_plans",
            plans: plans,
            focus_plan: focus_plan %>

      <div class="lp-rpg-stage">
        <%= render "life_journeys/rpg_world",
              mountain: mountain,
              progress: progress,
              stage: stage,
              plans: plans,
              focus_plan: focus_plan,
              alive: alive %>

        <%= render "life_journeys/rpg_glass",
              plans: plans,
              focus_plan: focus_plan,
              projects: projects,
              focus_project: focus_project,
              battles: battles,
              mountain: mountain,
              alive: alive,
              streak: streak %>
      </div>
    </div>

    <%= render "life_journeys/rpg_stats",
          mountain: mountain,
          alive: alive,
          streak: streak %>
  <% end %>

  <%= render "shared/climb_reward", reward: climb_reward if climb_reward.present? %>
</div>

<%= render "shared/lp_dash_nav", active: :mountain %>
