<% content_for :title, @journey.title %>
<% content_for :lp_game, true %>
<% content_for :lp_hide_top_nav, true %>

<%
  today_mission = @today_mission
  area = @journey.life_area
  area_key = area.key
  clarity = @journey.clarity_count
  total = @journey.clarity_total
  pct = total.zero? ? 0 : ((clarity.to_f / total) * 100).round
  focus = @focus_layer.to_s
  section_keys = {
    "goal" => "goal", "purpose" => "purpose", "policy" => "policy", "approach" => "approach",
    "program" => "program", "milestone" => "milestone", "scenes" => "scenes",
    "finished" => "finished", "today" => "today"
  }
  hint_keys = {
    "goal" => "goal_hint", "purpose" => "purpose_hint", "policy" => "policy_hint",
    "approach" => "approach_hint", "program" => "program_hint", "milestone" => "milestone_hint",
    "scenes" => "scenes_hint", "finished" => "finished_hint", "today" => "today_hint"
  }
%>

<div class="lp-climb"
     data-controller="journey-climb"
     data-journey-climb-focus-value="<%= focus %>"
     data-journey-climb-unlocked-value="<%= @unlocked_layer.to_s %>">
  <header class="lp-climb__head">
    <div class="lp-climb__mountains" aria-hidden="true">
      <svg viewBox="0 0 640 120" preserveAspectRatio="xMidYMax meet">
        <path d="M0 95 L80 50 L140 78 L220 28 L320 70 L400 40 L500 78 L640 45" fill="none" stroke="currentColor" stroke-width="1.8" opacity="0.35"/>
        <path d="M0 110 L100 70 L180 95 L280 48 L380 90 L480 55 L640 85" fill="none" stroke="currentColor" stroke-width="2" opacity="0.55"/>
      </svg>
    </div>
    <p class="lp-dash-kicker"><%= area.label %></p>
    <h1><%= area_copy(area_key, "title", default: t("journeys.climb.title")) %></h1>
    <p><%= area_copy(area_key, "climb_subtitle", default: t("journeys.climb.subtitle")) %></p>

    <div class="lp-climb-clarity" data-journey-climb-target="clarity" aria-label="<%= t('journeys.climb.clarity', count: clarity, total: total) %>">
      <div class="lp-climb-clarity__ring" style="--clarity: <%= pct %>">
        <span><%= clarity %>/<%= total %></span>
      </div>
      <div>
        <p class="lp-climb-clarity__label"><%= t("journeys.climb.clarity_label") %></p>
        <p class="lp-climb-clarity__meta"><%= t("journeys.climb.clarity", count: clarity, total: total) %></p>
      </div>
    </div>

    <%= link_to t("journeys.open_today"), dashboard_path, class: "lp-journey-setup__today" %>
  </header>

  <%= render "life_journeys/strategy_board" %>

  <section class="lp-climb-card lp-climb-card--progress">
    <p class="lp-climb-card__kicker"><%= t("journeys.sections.progress") %></p>
    <p class="lp-climb-card__hint"><%= t("journeys.sections.progress_hint") %></p>
    <%= form_with url: life_journey_path(@journey), method: :patch, class: "lp-climb-progress-form", data: { turbo: false } do %>
      <input type="hidden" name="closer_only" value="1">
      <div class="lp-journey-progress">
        <%= number_field_tag "life_journey[closer_percent]", @journey.closer_percent.round,
              min: 0, max: 100, step: 1, class: "lp-input", id: "life_journey_closer_percent" %>
        <span>% closer</span>
        <%= submit_tag t("journeys.climb.save_progress"), class: "lp-climb-card__save lp-climb-card__save--small" %>
      </div>
    <% end %>
  </section>

  <div class="lp-climb__stack">
    <% LifeJourney::CLIMB_LAYERS.each_with_index do |layer, index| %>
      <%
        state = @journey.layer_state(layer)
        editing = focus == layer
        prev = index.positive? ? LifeJourney::CLIMB_LAYERS[index - 1] : nil
        unlock_hint = prev ? t("journeys.climb.unlock_hint", prev: t("journeys.sections.#{section_keys.fetch(prev)}")) : nil
        summary = @journey.layer_summary(layer, today_mission: today_mission, today_todos: @today_todos)
        skipped = @journey.layer_skipped?(layer)
        section_key = section_keys.fetch(layer)
        hint_key = hint_keys.fetch(layer)
      %>
      <section id="climb-<%= layer %>"
               class="lp-climb-card lp-climb-card--<%= state %> <%= 'lp-climb-card--goal' if layer == 'goal' %> <%= 'is-focus' if editing %> <%= 'is-just-unlocked' if @unlocked_layer.to_s == layer %>"
               data-journey-climb-target="card"
               data-layer="<%= layer %>">
        <div class="lp-climb-card__top">
          <p class="lp-climb-card__kicker">
            <% if state == :complete %>
              <span class="lp-climb-card__check" aria-hidden="true">✓</span>
            <% end %>
            <%= t("journeys.sections.#{section_key}") %>
            <% if layer == "policy" %>
              <span class="lp-climb-card__badge"><%= t("journeys.climb.oaths_badge") %></span>
            <% end %>
          </p>
          <% if state == :complete && !editing %>
            <%= link_to t("journeys.climb.reedit"), life_journey_path(@journey, edit: layer), class: "lp-climb-card__edit" %>
          <% end %>
        </div>

        <% if state == :locked %>
          <p class="lp-climb-card__locked"><%= unlock_hint %></p>
        <% elsif state == :complete && !editing %>
          <p class="lp-climb-card__summary">
            <% if skipped %>
              <em><%= t("journeys.climb.skipped_summary") %></em>
            <% else %>
              <%= truncate(summary.to_s, length: 140) %>
            <% end %>
          </p>
        <% else %>
          <p class="lp-climb-card__hint">
            <% if layer == "policy" %>
              <%= area_copy(area_key, "oaths_hint") %>
            <% elsif layer == "today" %>
              <%= t("journeys.climb.today_battle_hint") %>
              <span class="lp-climb-card__hint-extra"><%= area_copy(area_key, "today_hint") %></span>
            <% elsif layer == "scenes" %>
              <%= area_copy(area_key, "ideal_hint", default: t("journeys.sections.scenes_hint")) %>
            <% else %>
              <%= area_copy(area_key, hint_keys.fetch(layer)) %>
            <% end %>
          </p>

          <%= form_with url: life_journey_path(@journey), method: :patch, class: "lp-climb-card__form", data: { turbo: false } do %>
            <input type="hidden" name="layer" value="<%= layer %>">

            <% case layer %>
            <% when "goal" %>
              <%= text_field_tag "life_journey[title]", @journey.title, class: "lp-input", required: true, autocomplete: "off", placeholder: area_copy(area_key, "goal_placeholder") %>
            <% when "purpose" %>
              <%= text_area_tag "life_journey[purpose]", @journey.purpose, rows: 3, class: "lp-input", required: true, placeholder: area_copy(area_key, "purpose_placeholder") %>
            <% when "policy" %>
              <%= text_area_tag "life_journey[policy]", @journey.policy, rows: 3, class: "lp-input", required: true, placeholder: area_copy(area_key, "policy_placeholder") %>
            <% when "approach" %>
              <%= render "life_journeys/climb_list_fields",
                    items: @journey.approaches_items,
                    name: "life_journey[approaches][]",
                    tags_name: "life_journey[approaches_tags][]",
                    placeholder: area_copy(area_key, "approach_placeholder"),
                    input: :text_area %>
            <% when "program" %>
              <%= render "life_journeys/climb_list_fields",
                    items: @journey.programs_items,
                    name: "life_journey[programs][]",
                    tags_name: "life_journey[programs_tags][]",
                    placeholder: area_copy(area_key, "program_placeholder"),
                    input: :text_area %>
            <% when "milestone" %>
              <%= render "life_journeys/climb_list_fields",
                    items: @journey.milestones_items,
                    name: "life_journey[milestones][]",
                    tags_name: "life_journey[milestones_tags][]",
                    placeholder: area_copy(area_key, "milestone_hint") %>
            <% when "scenes" %>
              <label class="lp-climb-mini-label" for="life_journey_ideal_scene"><%= area_copy(area_key, "ideal") %></label>
              <%= text_area_tag "life_journey[ideal_scene]", @journey.ideal_scene, rows: 2, class: "lp-input", id: "life_journey_ideal_scene", required: true, placeholder: area_copy(area_key, "ideal_placeholder") %>
              <label class="lp-climb-mini-label" for="life_journey_current_reality"><%= area_copy(area_key, "reality") %></label>
              <%= text_area_tag "life_journey[current_reality]", @journey.current_reality, rows: 2, class: "lp-input", id: "life_journey_current_reality", required: true, placeholder: area_copy(area_key, "present_placeholder") %>
            <% when "finished" %>
              <%= text_area_tag "life_journey[finished_result]", @journey.finished_result, rows: 3, class: "lp-input", required: true, placeholder: area_copy(area_key, "finished_placeholder") %>
            <% when "today" %>
              <label class="lp-climb-mini-label" for="life_journey_today_mission"><%= t("journeys.climb.today_mission_label") %></label>
              <%= text_field_tag "life_journey[today_mission]", today_mission&.title, class: "lp-input", id: "life_journey_today_mission", autocomplete: "off", placeholder: area_copy(area_key, "today_mission_placeholder") %>
              <p class="lp-climb-mini-label"><%= t("journeys.climb.today_todos_label") %></p>
              <%= render "life_journeys/climb_list_fields",
                    items: @today_todos.map { |t| { "title" => t.title, "tags" => [ t.tag ].compact } },
                    name: "daily_todo_titles[]",
                    tags_name: "daily_todo_tags[]",
                    placeholder: area_copy(area_key, "today_todo_placeholder") %>
            <% end %>

            <div class="lp-climb-card__actions">
              <%= submit_tag (layer == "policy" ? t("journeys.climb.swear_rules") : t("journeys.climb.save_layer")), class: "lp-climb-card__save" %>
              <% if LifeJourney::SKIPPABLE_LAYERS.include?(layer) %>
                <button type="submit" name="skip" value="1" class="lp-climb-card__skip" data-turbo-confirm="<%= t('journeys.climb.skip_confirm') %>"><%= t("journeys.climb.skip") %></button>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </section>
    <% end %>
  </div>

  <section class="lp-climb-card lp-climb-card--targets">
    <p class="lp-climb-card__kicker"><%= t("journeys.climb.targets_title") %></p>
    <p class="lp-climb-card__hint"><%= t("journeys.climb.targets_hint") %></p>

    <% Array(@targets).each do |target| %>
      <div class="lp-climb-target">
        <div>
          <strong><%= target.title %></strong>
          <span class="lp-climb-target__meta"><%= target.progress_label %><% if target.tags.any? %> · <%= target.tags.join(", ") %><% end %></span>
        </div>
        <%= button_to t("journeys.climb.remove_item"), journey_target_path(target), method: :delete, class: "lp-climb-list__remove", form: { data: { turbo: false } } %>
      </div>
    <% end %>

    <%= form_with url: life_journey_journey_targets_path(@journey), method: :post, class: "lp-climb-target-form", data: { turbo: false } do %>
      <%= text_field_tag "journey_target[title]", nil, class: "lp-input", placeholder: area_copy(area_key, "target_title_placeholder"), required: true %>
      <div class="lp-climb-target-form__row">
        <select name="journey_target[kind]" class="lp-input">
          <option value="oneshot"><%= t("journeys.climb.target_kind_oneshot") %></option>
          <option value="count"><%= t("journeys.climb.target_kind_count") %></option>
        </select>
        <%= number_field_tag "journey_target[target_value]", 1, min: 0.01, step: :any, class: "lp-input", placeholder: t("journeys.climb.target_value_placeholder") %>
        <%= text_field_tag "journey_target[unit]", nil, class: "lp-input", placeholder: t("journeys.climb.target_unit_placeholder") %>
        <%= text_field_tag "journey_target[tags]", nil, class: "lp-input", placeholder: t("journeys.climb.tag_placeholder") %>
      </div>
      <%= submit_tag t("journeys.climb.target_add"), class: "lp-climb-card__save lp-climb-card__save--small" %>
    <% end %>
  </section>

  <% if @journey.status == "completed" %>
    <%= link_to t("next_mountain.title"), next_mountain_path, class: "lp-dash-cta" %>
  <% end %>
</div>

<%= render "shared/lp_dash_nav", active: :journey %>
