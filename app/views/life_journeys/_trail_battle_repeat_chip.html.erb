<%# Repeat frequency chip for battle rows. locals: battle, camp_sheet: %>
<% battle = local_assigns.fetch(:battle) %>
<% if local_assigns[:camp_sheet] %>
  <% if battle.repeat_daily? %>
    <span class="lp-trail-battles__repeat-tag">
      <%= render "life_journeys/trail_battle_repeat_icon" %>
      <span class="lp-trail-battles__repeat-label"><%= t("strategy.rpg.trail.every_day") %></span>
    </span>
  <% elsif chip = mountain_trail_repeat_weekday_chip(battle) %>
    <span class="lp-trail-battles__repeat-tag" aria-label="<%= chip[:aria_label] %>">
      <%= render "life_journeys/trail_battle_repeat_icon" %>
      <span class="lp-trail-battles__repeat-label"><%= chip[:label] %></span>
    </span>
  <% end %>
<% elsif battle.repeat_daily? %>
  <span class="lp-trail-battles__daily-chip"><%= t("strategy.rpg.trail.every_day") %></span>
<% elsif chip = mountain_trail_repeat_weekday_chip(battle) %>
  <span class="lp-trail-battles__daily-chip" aria-label="<%= chip[:aria_label] %>"><%= chip[:label] %></span>
<% end %>
