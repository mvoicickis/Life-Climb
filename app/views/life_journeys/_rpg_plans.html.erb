<%# Plans on this trail — overlay sidebar. locals: plans, focus_plan %>
<% plans = local_assigns.fetch(:plans, []) %>
<% focus_plan = local_assigns[:focus_plan] %>
<% area = @journey.life_area %>
<% accents = %w[green purple orange pink blue] %>

<aside class="lp-rpg-plans" aria-labelledby="rpg-plans-title">
  <header class="lp-rpg-plans__head">
    <p class="lp-rpg-panel__kicker" id="rpg-plans-title"><%= t("strategy.rpg.plans_kicker") %></p>
  </header>

  <% if @goal && plans.any? %>
    <ul class="lp-rpg-plan-list">
      <% plans.each_with_index do |plan, idx| %>
        <% kids = plan.children.select { |c| c.project? && !c.holding? } %>
        <% done = kids.count(&:completed?) %>
        <% pct = plan.progress_percent.to_i %>
        <% accent = accents[idx % accents.size] %>
        <li>
          <%= link_to life_journey_path(@journey, focus_id: plan.id),
                class: "lp-rpg-plan is-#{accent} #{'is-focus' if focus_plan&.id == plan.id} #{'is-done' if plan.completed?}",
                data: { strategy_rpg_target: "flag" } do %>
            <span class="lp-rpg-plan__icon" aria-hidden="true">
              <% icon = %w[self career money love growth].include?(area.key.to_s) ? area.key : "tent" %>
              <%= render "shared/lp_icon", name: icon, class_name: "lp-icon is-chip" %>
            </span>
            <span class="lp-rpg-plan__body">
              <span class="lp-rpg-plan__title"><%= plan.title %></span>
              <span class="lp-rpg-plan__meta">
                <%= t("strategy.rpg.projects_progress", done: done, total: kids.size) %>
              </span>
              <span class="lp-rpg-plan__bar" aria-hidden="true">
                <span class="lp-rpg-plan__fill" style="width: <%= pct %>%"></span>
              </span>
            </span>
            <span class="lp-rpg-plan__pct"><%= pct %>%</span>
            <span class="lp-rpg-plan__chev" aria-hidden="true">›</span>
          <% end %>
        </li>
      <% end %>
    </ul>

    <details class="lp-rpg-add is-plan">
      <summary>
        <span class="lp-rpg-add__label lp-rpg-add__label--short" aria-hidden="true">+</span>
        <span class="lp-rpg-add__label lp-rpg-add__label--long"><%= t("strategy.rpg.add_plan") %></span>
      </summary>
      <%= form_with url: strategy_goals_path, method: :post, class: "lp-rpg-add__form", data: { turbo: false } do %>
        <%= hidden_field_tag :life_area_id, area.id %>
        <%= hidden_field_tag :life_journey_id, @journey.id %>
        <%= hidden_field_tag :horizon, "plan" %>
        <%= hidden_field_tag :parent_id, @goal.id %>
        <%= text_field_tag :title, nil,
              required: true,
              maxlength: 120,
              class: "lp-rpg-input",
              placeholder: t("strategy.plan_placeholder"),
              autocomplete: "off" %>
        <%= submit_tag t("strategy.sheet.add_plan"), class: "lp-rpg-btn is-small" %>
      <% end %>
    </details>
  <% elsif @goal %>
    <p class="lp-rpg-panel__empty"><%= t("strategy.zones.add_plan_hint") %></p>
  <% end %>
</aside>
