<%# Kebab opens Edit Basic sheet (portaled). locals: habit, journey, goal, plan %>
<% habit = local_assigns.fetch(:habit) %>
<% journey = local_assigns.fetch(:journey) %>
<% goal = local_assigns.fetch(:goal) %>
<% plan = local_assigns.fetch(:plan) %>
<div class="lp-trail-battles__kebab-host"
     data-controller="tcard-menu"
     data-tcard-menu-portal-value="true">
  <details class="lp-trail-battles__kebab"
           data-tcard-menu-target="details">
    <summary class="lp-trail-battles__kebab-btn" aria-label="<%= t('strategy.rpg.trail.battle_menu') %>">⋯</summary>
  </details>
  <button type="button"
          class="lp-dash-habit__scrim"
          data-tcard-menu-target="scrim"
          data-action="click->tcard-menu#close"
          tabindex="-1"
          hidden
          aria-label="<%= t('dash.timeline.cancel') %>"></button>
  <%= render "habits/edit_sheet",
        habit: habit,
        return_to: "mountain",
        journey: journey,
        goal: goal,
        plan: plan,
        sheet_target: true %>
</div>
