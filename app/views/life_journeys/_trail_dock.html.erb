<%# Next-action chip: chrome above the tab bar. Mountain photo scrolls above. %>
<% today_card = local_assigns.fetch(:today_card) %>
<% mode = today_card[:mode].to_s %>
<% fight_mode = mode == "win_next" %>
<% add_battle_mode = mode == "add_battle" && today_card[:camp_id].present? %>
<% plant_mode = !fight_mode && !add_battle_mode %>

<div class="lp-trail__dock" data-trail-ignore>
  <% plaque_class = "lp-trail-today is-#{mode.tr('_', '-')} #{'is-busy' if today_card[:busy]} #{'is-cheer' if mode == 'cheer'}" %>
  <% if fight_mode %>
    <a href="<%= dashboard_path %>" class="<%= plaque_class %>">
      <%= render "life_journeys/trail_dock_plaque", today_card: today_card, plant_mode: false %>
    </a>
  <% elsif add_battle_mode %>
    <button type="button"
            class="<%= plaque_class %>"
            data-camp-id="<%= today_card[:camp_id] %>"
            data-action="click->trail-camp-sheet#openFromDock">
      <%= render "life_journeys/trail_dock_plaque", today_card: today_card, plant_mode: false %>
    </button>
  <% else %>
    <button type="button"
            class="<%= plaque_class %>"
            data-action="click->trail-canvas#openComposerFromFab">
      <%= render "life_journeys/trail_dock_plaque", today_card: today_card, plant_mode: true %>
    </button>
  <% end %>
</div>
