<%# locals: group (stage + camps), step_number, visible_camp_ids %>
<% group = local_assigns.fetch(:group) %>
<% step_number = local_assigns.fetch(:step_number) %>
<% visible_camp_ids = Array(local_assigns.fetch(:visible_camp_ids)).map(&:to_i) %>
<section class="lp-trail-arrange-group"
         data-stage="<%= group[:stage] %>">
  <h2 class="lp-trail-arrange-group__heading">
    <%= t("strategy.rpg.trail.arrange.step", step: step_number) %>
  </h2>
  <ul class="lp-trail-arrange-list" data-arrange-camps-target="list" data-arrange-list>
    <% group[:camps].each do |camp| %>
      <li class="lp-trail-arrange-row lp-pointer-reorder__row"
          data-id="<%= camp.id %>"
          data-camp-id="<%= camp.id %>"
          data-camp-title="<%= camp.title %>"
          data-quantified="<%= camp.quantified? %>"
          data-completed="false"
          data-update-url="<%= strategy_goal_path(camp) %>"
          data-delete-url="<%= strategy_goal_path(camp) %>">
        <div class="lp-trail-arrange-row__body">
          <button type="button"
                  class="lp-trail-arrange-row__label-btn"
                  data-action="click->arrange-camps#beginRename"
                  data-arrange-rename>
            <%= camp.title %>
          </button>
          <% if visible_camp_ids.include?(camp.id) %>
            <span class="lp-trail-arrange-row__mountain"><%= t("strategy.rpg.trail.arrange.on_mountain") %></span>
          <% end %>
        </div>
        <div class="lp-trail-arrange-row__actions">
          <button type="button"
                  class="lp-trail-arrange-row__trash"
                  data-action="click->arrange-camps#openDelete"
                  aria-label="<%= t('strategy.rpg.trail.arrange.delete_aria', title: camp.title) %>">
            <%= raw('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 3h6l1 2h4v2H4V5h4l1-2zm1 6h2v9h-2V9zm4 0h2v9h-2V9zM7 9h2v9H7V9z"/></svg>') %>
          </button>
          <button type="button"
                  class="lp-trail-arrange-row__handle lp-pointer-reorder__handle"
                  aria-label="<%= t('strategy.rpg.trail.arrange.drag') %>">
            <%= raw('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="9" cy="7" r="1.5"/><circle cx="15" cy="7" r="1.5"/><circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="9" cy="17" r="1.5"/><circle cx="15" cy="17" r="1.5"/></svg>') %>
          </button>
        </div>
      </li>
    <% end %>
  </ul>
</section>
