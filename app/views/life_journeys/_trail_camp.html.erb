<%# Camp marker on the V4 trail. locals: project, index, total, projects, current_project %>
<% project = local_assigns.fetch(:project) %>
<% projects = local_assigns[:projects] || [ project ] %>
<% layout = mountain_trail_layout_slot(project, projects: projects) %>
<% color_key = project.tagged_color_key %>
<% accent = mountain_trail_project_accent(project) %>
<% state = mountain_trail_camp_state(project, projects: projects) %>
<% fog = [ 0, (0.62 - layout[:y].to_f) * 0.4 ].max.round(3) %>
<% shadow = mountain_trail_camp_shadow(layout) %>
<% current = state == :current %>

<button type="button"
        class="lp-trail-camp <%= "has-color is-#{color_key}" if color_key %> is-<%= state %> <%= 'is-pages' if project.pages_mode? %>"
        id="trail-camp-<%= project.id %>"
        style="--lp-trail-x: <%= layout[:x] %>; --lp-trail-y: <%= layout[:y] %>; --lp-trail-accent: <%= accent %>; --lp-trail-fog: <%= fog %>; --lp-trail-shadow-dx: <%= shadow[:dx] %>; --lp-trail-shadow-w: <%= shadow[:width] %>; --lp-trail-shadow-o: <%= shadow[:opacity] %>;"
        data-camp-id="<%= project.id %>"
        data-camp-title="<%= project.title %>"
        data-trail-x="<%= layout[:x] %>"
        data-trail-y="<%= layout[:y] %>"
        data-accent="<%= accent %>"
        data-update-url="<%= strategy_goal_path(project) %>"
        data-action="click->trail-canvas#campClick click->trail-camp-sheet#open pointerdown->trail-canvas#campPointerDown pointermove->trail-canvas#campPointerMove pointerup->trail-canvas#campPointerUp pointercancel->trail-canvas#campPointerUp"
        aria-label="<%= project.title %>">
  <span class="lp-trail-camp__shadow" aria-hidden="true"
        style="--lp-trail-shadow-dx: <%= shadow[:dx] %>; --lp-trail-shadow-w: <%= shadow[:width] %>; --lp-trail-shadow-o: <%= shadow[:opacity] %>;"></span>
  <span class="lp-trail-camp__peg">
    <span class="lp-trail-camp__tent"></span>
    <% if current %>
      <span class="lp-trail-camp__fire" aria-hidden="true"></span>
    <% end %>
  </span>
  <span class="lp-trail-camp__caption">
    <span class="lp-trail-camp__title"><%= project.title.truncate(12) %></span>
  </span>
</button>
