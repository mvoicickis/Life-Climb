<%# Camp marker on the curve trail. locals: project, trail_node, map_nodes, current_project, map_mode, builtin_map %>
<% project = local_assigns.fetch(:project) %>
<% trail_node = local_assigns[:trail_node] %>
<% map_nodes = local_assigns[:map_nodes] || [] %>
<% map_mode = local_assigns[:map_mode] %>
<% builtin_map = local_assigns.fetch(:builtin_map, false) %>
<% color_key = project.tagged_color_key %>
<% accent = mountain_trail_project_accent(project) %>
<% map_fill = map_mode ? mountain_trail_picker_fill(project) : accent %>
<% state = trail_node&.state || mountain_trail_camp_state(project, projects: map_nodes.filter_map(&:record)) %>
<% current = state == :current %>
<% done = state == :done %>
<% fogged = !map_mode && state == :locked %>
<% status = mountain_trail_camp_status(project) %>
<% layout = if trail_node && map_nodes.any?
              mountain_trail_map_layout_slot(trail_node, map_nodes, builtin_map: map_mode && builtin_map)
            else
              mountain_trail_layout_slot(project, projects: [ project ])
            end %>
<% tent_width_frac = map_mode && trail_node ? mountain_trail_map_tent_width_frac(trail_node, map_nodes, builtin_map: builtin_map) : nil %>
<% tent_scale = map_mode && trail_node ? mountain_trail_map_tent_scale(trail_node, map_nodes, builtin_map: builtin_map) : 1 %>
<% ring_stroke_px = map_mode ? mountain_trail_map_ring_stroke_px(tent_scale) : nil %>
<% progress_ratio = current ? mountain_trail_camp_progress(project)[:ratio] : 0 %>

<button type="button"
        class="lp-trail-camp <%= "has-color is-#{color_key}" if color_key %> is-<%= state %> <%= 'is-pages' if project.pages_mode? %> <%= 'is-fogged' if fogged %> <%= 'is-map-tent' if map_mode %>"
        id="trail-camp-<%= project.id %>"
        style="--lp-trail-x: <%= layout[:x] %>; --lp-trail-y: <%= layout[:y] %>; --lp-trail-accent: <%= map_fill %>; --lp-trail-caption-max: <%= mountain_trail_map_caption_max_rem(layout[:x]) %>rem;<%= " --lp-tent-width-frac: #{tent_width_frac}; --lp-tent-scale: #{tent_scale}; --lp-camp-scale: #{tent_scale}; --lp-ring-stroke: #{ring_stroke_px}px;" if map_mode %>"
        data-camp-id="<%= project.id %>"
        data-camp-title="<%= project.title %>"
        data-camp-sheet-title="<%= mountain_trail_camp_sheet_title(project) %>"
        data-camp-description="<%= project.description.to_s %>"
        data-accent="<%= map_fill %>"
        data-update-url="<%= strategy_goal_path(project) %>"
        data-action="click->trail-canvas#campClick click->trail-camp-sheet#open"
        aria-label="<%= project.title %>">
  <span class="lp-trail-camp__shadow" aria-hidden="true"></span>
  <span class="lp-trail-camp__peg">
    <span class="lp-trail-camp__peg-visual">
      <% if map_mode %>
        <% if current %>
          <%= mountain_trail_camp_ring_svg(progress_ratio) %>
        <% end %>
        <span class="lp-trail-camp__tent" aria-hidden="true"></span>
        <% if current %>
          <span class="lp-trail-camp__fire" aria-hidden="true"></span>
        <% end %>
      <% else %>
        <span class="lp-trail-camp__tent" aria-hidden="true">
          <% if fogged %>
            <svg class="lp-trail-camp__fog-tent" viewBox="0 0 56 44" aria-hidden="true"><path class="trail-tent-body" d="M6 44 L28 6 L50 44 Z"/><path class="trail-tent-shade" d="M28 6 L50 44 L28 44 Z"/><path class="trail-tent-door" d="M22 44 L22 30 L34 30 L34 44 Z"/></svg>
          <% end %>
        </span>
      <% end %>
      <% if done %>
        <span class="lp-trail-camp__cleared" aria-hidden="true">✓</span>
      <% end %>
    </span>
  </span>
  <span class="lp-trail-camp__caption">
    <span class="lp-trail-camp__title"><%= mountain_trail_camp_caption_title(project) %></span>
    <% if current && status.present? %>
      <span class="lp-trail-camp__status"><%= status %></span>
    <% end %>
  </span>
</button>
