<%# Mountain undo toast. locals: title, restore (bool), restore_arrange_open (bool) %>
<% title = local_assigns.fetch(:title) %>
<% restore = local_assigns.fetch(:restore, false) %>
<% restore_arrange_open = local_assigns.fetch(:restore_arrange_open, false) %>
<div class="lp-toast is-trail"
     role="status"
     data-controller="lp-toast"
     data-lp-toast-duration-value="5000">
  <span class="lp-toast__ic" aria-hidden="true">↩</span>
  <div class="lp-toast__tx">
    <span><%= title %></span>
  </div>
  <% if restore %>
    <%= button_to t("strategy.rpg.trail.undo"),
          strategy_goal_restores_path(arrange_open: (restore_arrange_open ? 1 : nil)),
          method: :post,
          class: "lp-toast__undo",
          form: {
            data: {
              turbo: restore_arrange_open
            }
          } %>
  <% end %>
</div>
