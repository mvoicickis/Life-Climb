<%# Summit scene or map stack inside #trail-mountain-world. locals from trail_mountain_world_locals %>
<% summit_reached = local_assigns.fetch(:summit_reached) %>
<% if summit_reached %>
  <%= render "life_journeys/trail_summit_reached",
        plan: local_assigns.fetch(:plan),
        goal: local_assigns.fetch(:goal),
        journey: local_assigns.fetch(:journey) %>
<% else %>
  <% custom_mountain_photo = local_assigns.fetch(:custom_mountain_photo) %>
  <% builtin_photos = local_assigns.fetch(:builtin_photos) %>
  <% photo_url = local_assigns.fetch(:photo_url) %>
  <% builtin_daytime = local_assigns[:builtin_daytime] %>
  <% night_photo_url = local_assigns.fetch(:night_photo_url) %>
  <% goal = local_assigns[:goal] %>
  <% journey = local_assigns.fetch(:journey) %>
  <% destination_overlay = local_assigns.fetch(:destination_overlay) %>
  <% plan = local_assigns[:plan] %>
  <% plans = local_assigns.fetch(:plans) %>
  <% peak_title = local_assigns.fetch(:peak_title) %>
  <% show_arrange_camps = local_assigns.fetch(:show_arrange_camps) %>
  <% first_camp_reveal = local_assigns.fetch(:first_camp_reveal) %>
  <% trail = local_assigns.fetch(:trail) %>
  <% current_project = local_assigns.fetch(:current_project) %>
  <div class="lp-trail__photo-wrap"
       aria-hidden="true">
    <% if custom_mountain_photo %>
      <img class="lp-trail__photo-backdrop"
           src="<%= photo_url %>"
           alt=""
           decoding="async"
           aria-hidden="true">
      <img class="lp-trail__photo" src="<%= photo_url %>" alt="" decoding="async">
    <% else %>
      <img class="lp-trail__photo lp-trail__photo--day" src="<%= photo_url %>" alt="" decoding="async">
      <% if builtin_daytime == false %>
        <img class="lp-trail__photo lp-trail__photo--night"
             id="mountain-trail-night-photo"
             src="<%= night_photo_url %>"
             alt=""
             decoding="async"
             data-trail-ambient-target="nightPhoto">
      <% else %>
        <% if builtin_daytime.nil? %>
          <%= javascript_tag(nonce: true) do %>
(function () {
  var root = document.getElementById("mountain-trail");
  var night = document.getElementById("mountain-trail-night-photo");
  if (!root || !night || !root.classList.contains("is-night")) return;
  if (night.dataset.src) night.src = night.dataset.src;
})();
          <% end %>
        <% end %>
        <img class="lp-trail__photo lp-trail__photo--night"
             id="mountain-trail-night-photo"
             src=""
             data-src="<%= night_photo_url %>"
             alt=""
             loading="lazy"
             decoding="async"
             data-trail-ambient-target="nightPhoto">
      <% end %>
    <% end %>
    <% unless builtin_photos %>
      <div class="lp-trail__backlight" data-trail-ambient-target="backlight"></div>
      <div class="lp-trail__night"></div>
      <div class="lp-trail__haze"></div>
      <div class="lp-trail__warm"></div>
      <div class="lp-trail__snow" data-trail-ambient-target="snow"></div>
    <% end %>
    <div class="lp-trail__summit-glow"></div>
  </div>

  <% unless builtin_photos %>
    <div class="lp-trail__ambient" aria-hidden="true">
      <% if custom_mountain_photo %>
      <div class="lp-trail__stars" data-trail-ambient-target="stars">
        <% MountainTrailHelper::MOUNTAIN_STARS.each do |sx, sy, sop| %>
          <span class="lp-trail__star" style="left: <%= sx %>%; top: <%= sy %>%; opacity: <%= sop %>"></span>
        <% end %>
      </div>
      <% end %>
      <div class="lp-trail__mist" data-trail-ambient-target="mist"></div>
      <div class="lp-trail__embers" data-trail-ambient-target="embers">
        <span class="lp-trail__ember"></span>
        <span class="lp-trail__ember"></span>
        <span class="lp-trail__ember"></span>
        <span class="lp-trail__ember"></span>
        <span class="lp-trail__ember"></span>
      </div>
      <div class="lp-trail__lightning" data-trail-ambient-target="lightning"></div>
    </div>
  <% end %>

  <% if goal && !destination_overlay && !custom_mountain_photo %>
    <%= render "life_journeys/trail_summit_banner",
          goal: goal,
          journey: journey,
          plan: plan,
          plans: plans,
          peak_title: peak_title,
          show_arrange_camps: show_arrange_camps,
          first_camp_reveal: first_camp_reveal %>
  <% end %>

  <%= render "life_journeys/trail_map_camps",
        trail: trail,
        current_project: current_project,
        plan: plan,
        journey: journey,
        builtin_photos: builtin_photos,
        destination_overlay: destination_overlay,
        first_camp_reveal: first_camp_reveal %>
<% end %>
