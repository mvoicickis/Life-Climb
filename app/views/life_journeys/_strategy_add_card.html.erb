<%# locals: kind, title, area, journey, parent_id, horizon, placeholder, submit, scheduled_on: nil, input_id: nil, goal_title: nil, plan_title: nil, project_title: nil %>
<% kind = local_assigns.fetch(:kind) %>
<% title = local_assigns.fetch(:title) %>
<% area = local_assigns.fetch(:area) %>
<% journey = local_assigns.fetch(:journey) %>
<% parent_id = local_assigns.fetch(:parent_id) %>
<% horizon = local_assigns.fetch(:horizon) %>
<% placeholder = local_assigns.fetch(:placeholder) %>
<% submit = local_assigns.fetch(:submit) %>
<% scheduled_on = local_assigns[:scheduled_on] %>
<% input_id = local_assigns[:input_id].presence || "strategy-add-#{kind}-title" %>
<% goal_title = local_assigns[:goal_title].presence %>
<% plan_title = local_assigns[:plan_title].presence %>
<% project_title = local_assigns[:project_title].presence %>
<% help_goal = goal_title.presence || StrategyGoal.find_by(id: parent_id)&.title.presence || journey.title %>
<% help_cta =
     case horizon.to_s
     when "goal" then t("strategy.help.cta_goal")
     when "project" then t("strategy.help.cta_project")
     when "day" then t("strategy.help.cta_battle")
     else t("strategy.help.cta")
     end %>

<section class="lp-strategy-add is-<%= kind %>" id="strategy-add-<%= kind %>" aria-label="<%= title %>">
  <div class="lp-strategy-add__head">
    <span class="lp-strategy-add__plus" aria-hidden="true">+</span>
    <h3 class="lp-strategy-add__title"><%= title %></h3>
  </div>

  <%= form_with url: strategy_goals_path, method: :post, class: "lp-strategy-add__form", data: { turbo: false } do %>
    <%= hidden_field_tag :life_area_id, area.id %>
    <%= hidden_field_tag :life_journey_id, journey.id %>
    <%= hidden_field_tag :parent_id, parent_id %>
    <%= hidden_field_tag :horizon, horizon %>
    <% if scheduled_on.present? %>
      <%= hidden_field_tag :scheduled_on, scheduled_on %>
    <% end %>
    <%= text_field_tag :title, nil,
          required: true,
          maxlength: 120,
          id: input_id,
          class: "lp-input w-full lp-strategy-add__input",
          placeholder: placeholder %>
    <%= submit_tag submit, class: "lp-cta w-full" %>
  <% end %>

  <%= render "strategy_helps/launch",
        goal: help_goal,
        ideal_scene: journey.ideal_scene,
        current_reality: journey.current_reality,
        life_area: area&.label,
        goal_title: goal_title || help_goal,
        plan_title: plan_title,
        project_title: project_title,
        horizon: horizon,
        accept_as: "fill",
        parent_id: parent_id,
        life_area_id: area&.id,
        journey_id: journey.id,
        target_input: "##{input_id}",
        panel_id: "strategist-panel-add-#{kind}",
        button_label: help_cta %>
</section>
