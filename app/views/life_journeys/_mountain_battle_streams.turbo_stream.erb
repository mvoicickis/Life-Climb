<% if @project.present? %>
  <%= turbo_stream.replace "trail-battles-#{@project.id}" do %>
    <%= render "life_journeys/trail_camp_battles",
          project: @project,
          goal: @goal,
          plan: @plan,
          area: @project.life_area %>
  <% end %>
<% end %>
<%= turbo_stream.replace "trail-base-sheet" do %>
  <%= render "life_journeys/trail_base_sheet",
        projects: mountain_trail_open_camps(@plan),
        area: @project&.life_area || @plan&.life_area,
        plan: @plan,
        goal: @goal,
        journey: @journey %>
<% end %>
<%= render "life_journeys/trail_climber_stream" %>
