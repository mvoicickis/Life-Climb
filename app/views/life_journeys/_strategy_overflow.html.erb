<%# Overflow chip for capped siblings. locals: count:, href:, kind:, label: %>
<% count = local_assigns.fetch(:count).to_i %>
<% href = local_assigns.fetch(:href) %>
<% kind = local_assigns.fetch(:kind) %>
<% label = local_assigns.fetch(:label) %>

<% if count.positive? %>
  <%= link_to href,
        class: "lp-strategy-overflow is-#{kind}",
        title: label,
        aria: { label: label } do %>
    <span class="lp-strategy-overflow__label"><%= t("strategy.zones.more_count", count: count) %></span>
  <% end %>
<% end %>
