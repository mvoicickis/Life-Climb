<%# Battles inside a trail camp sheet. locals: project, goal, plan, area %>
<% project = local_assigns.fetch(:project) %>
<% area = local_assigns[:area] || project.life_area %>
<% goal = local_assigns[:goal] || project.root_goal %>
<% plan = local_assigns[:plan] || (project.parent if project.parent&.plan?) %>
<% days = project.children.select(&:day?).reject(&:holding?) %>
<% mountain_trail_preload_done_today!(current_user, days) %>
<% days = days.sort_by { |d| [ mountain_trail_done_today?(d) ? 1 : 0, d.scheduled_on || Date.new(9999), d.position.to_i, d.id ] } %>
<% open_battles = days.reject { |d| mountain_trail_done_today?(d) } %>
<% won_battles = days.select { |d| mountain_trail_done_today?(d) } %>
<% accent = mountain_trail_project_accent(project) %>
<% quantified = project.quantified? %>
<% pages_mode = project.pages_mode? %>
<% battle_suggestion = open_battles.empty? && !pages_mode ? mountain_trail_battle_suggestion(project) : nil %>
<% add_form = capture do %>
  <%= form_with url: strategy_goals_path,
        method: :post,
        class: "lp-trail-battles__add",
        data: {
          turbo: true,
          action: "submit->trail-battles#parseDraft turbo:submit-start->trail-battles#beginAddSubmit turbo:submit-end->trail-battles#battleAdded"
        } do %>
    <%= hidden_field_tag :life_area_id, area.id %>
    <%= hidden_field_tag :life_journey_id, project.life_journey_id.presence || @journey&.id %>
    <%= hidden_field_tag :parent_id, project.id %>
    <%= hidden_field_tag :horizon, "day" %>
    <%= hidden_field_tag :scheduled_on, Date.current %>
    <%= hidden_field_tag :repeat, "none", data: { trail_battles_target: "repeatField" } %>
    <div class="lp-trail-battles__add-row" data-trail-battles-target="addRow">
      <label class="lp-trail-battles__field">
        <span class="sr-only"><%= t("strategy.rpg.trail.battle_placeholder") %></span>
        <%= render layout: "shared/title_limit_wrap" do %>
          <%= text_field_tag :title, nil,
                required: true,
                maxlength: StrategyGoal::TITLE_MAX,
                class: "lp-trail-battles__input",
                placeholder: t("strategy.rpg.trail.battle_placeholder"),
                autocomplete: "off",
                data: { trail_battles_target: "titleField" } %>
        <% end %>
      </label>
      <label class="lp-trail-battles__daily-switch">
        <input type="checkbox"
               class="lp-trail-battles__daily-check sr-only"
               data-trail-battles-target="dailyToggle"
               data-action="change->trail-battles#toggleDaily">
        <span class="lp-trail-battles__switch" aria-hidden="true"></span>
        <span class="lp-trail-battles__daily-label"><%= t("strategy.rpg.trail.every_day") %></span>
      </label>
      <%= submit_tag t("strategy.rpg.trail.add_battle"), class: "lp-trail-battles__submit" %>
    </div>
  <% end %>
<% end %>

<div class="lp-trail-battles <%= 'is-pages-mode' if pages_mode %>"
     id="trail-battles-<%= project.id %>"
     style="--lp-trail-accent: <%= accent %>"
     data-controller="trail-battles"
     data-project-id="<%= project.id %>"
     data-project-title="<%= project.title %>"
     data-project-description="<%= project.description.to_s %>"
     data-update-url="<%= strategy_goal_path(project) %>"
     data-delete-url="<%= strategy_goal_path(project) %>"
     data-quantified="<%= quantified %>"
     data-unit="<%= project.unit %>"
     data-quantity-kind="<%= project.try(:quantity_kind).presence || (quantified ? 'up' : 'none') %>"
     data-range-min="<%= project.try(:range_min) %>"
     data-range-max="<%= project.try(:range_max) %>"
     data-trail-battles-session-wins-value="0"
     data-session-win-template="<%= t('strategy.rpg.trail.session_wins_toast') %>"
     data-trail-battles-create-url-value="<%= strategy_goals_path %>"
     data-trail-battles-life-area-id-value="<%= area.id %>"
     data-trail-battles-life-journey-id-value="<%= project.life_journey_id.presence || @journey&.id %>"
     data-trail-battles-parent-id-value="<%= project.id %>"
     data-trail-battles-at-max-template-value="<%= t('title_limit.at_max') %>">
  <% if pages_mode %>
    <div class="lp-trail-battles__pages">
      <p class="lp-trail-battles__pages-label"><%= strategy_quantity_progress_label(project) %></p>
      <% if meta = strategy_project_card_meta(project) %>
        <div class="lp-trail-battles__pages-bar" aria-hidden="true">
          <span class="lp-trail-battles__pages-fill" style="width: <%= ((meta[:ratio] || 0) * 100).round %>%"></span>
        </div>
      <% end %>
      <p class="lp-trail-battles__pages-hint"><%= t("strategy.rpg.trail.pages_mode_hint") %></p>
      <button type="button"
              class="lp-trail-battles__pages-log"
              data-action="click->trail-canvas#openLog"
              data-project-id="<%= project.id %>"
              data-battle-id=""
              data-project-title="<%= project.title %>"
              data-unit="<%= project.unit %>"
              data-quantity-kind="<%= project.quantity_kind_value %>"
              data-range-min="<%= project.try(:range_min) %>"
              data-range-max="<%= project.try(:range_max) %>"
              data-last-log="<%= mountain_trail_last_log_amount(project) %>">
      </button>
    </div>
  <% else %>
    <% if open_battles.empty? && battle_suggestion.present? %>
      <p class="lp-trail-battles__seed-hint" id="trail-battles-seed-hint-<%= project.id %>"><%= t("strategy.rpg.trail.seed_battle_hint") %></p>
    <% end %>
    <ul class="lp-trail-battles__list" id="trail-battles-list-<%= project.id %>">
      <% if open_battles.empty? && battle_suggestion.present? %>
        <%= render "life_journeys/trail_battle_suggestion_row",
              project: project,
              suggestion: battle_suggestion,
              area: area,
              goal: goal,
              plan: plan %>
      <% else %>
        <% open_battles.each_with_index do |battle, index| %>
          <%= render "life_journeys/trail_battle_row",
                battle: battle,
                done: false,
                show_move_up: index.positive?,
                show_move_down: index < open_battles.size - 1 %>
        <% end %>
      <% end %>
    </ul>

    <div id="trail-battles-done-slot-<%= project.id %>">
      <%= render "life_journeys/trail_camp_done_section",
            project: project,
            won_battles: won_battles,
            area: area,
            goal: goal,
            plan: plan %>
    </div>
  <% end %>

  <% unless pages_mode %>
    <div class="lp-trail-battles__dock-spacer" aria-hidden="true"></div>
    <div class="lp-trail-battles__composer is-dock"><%= add_form %></div>
  <% end %>

  <p class="lp-trail-battles__session-toast"
     data-trail-battles-target="sessionToast"
     data-template="<%= t('strategy.rpg.trail.session_wins_toast') %>"
     hidden
     role="status"></p>

  <dialog class="lp-trail-battles__rename" data-trail-battles-target="renameDialog">
    <form method="dialog" class="lp-trail-battles__rename-form" data-action="submit->trail-battles#saveCamp">
      <h3><%= t("strategy.rpg.trail.edit_camp") %></h3>
      <input type="text"
             maxlength="120"
             required
             class="lp-trail-battles__input"
             value="<%= project.title %>"
             data-trail-battles-target="renameField">
      <div class="lp-trail-battles__rename-actions">
        <button type="button" data-action="click->trail-battles#closeRename"><%= t("strategy.rpg.cancel") %></button>
        <button type="submit"><%= t("strategy.rpg.save") %></button>
      </div>
    </form>
  </dialog>

  <dialog class="lp-trail-battles__rename" data-trail-battles-target="descriptionDialog">
    <form method="dialog" class="lp-trail-battles__rename-form" data-action="submit->trail-battles#saveCampDescription">
      <h3><%= t("strategy.rpg.trail.edit_camp_description") %></h3>
      <textarea rows="3"
                maxlength="<%= StrategyGoal::SUMMARY_MAX %>"
                class="lp-trail-battles__input lp-trail-battles__textarea"
                placeholder="<%= t('strategy.rpg.trail.plant_description_placeholder') %>"
                data-trail-battles-target="descriptionField"><%= project.description.to_s %></textarea>
      <div class="lp-trail-battles__rename-actions">
        <button type="button" data-action="click->trail-battles#closeDescription"><%= t("strategy.rpg.cancel") %></button>
        <button type="submit"><%= t("strategy.rpg.save") %></button>
      </div>
    </form>
  </dialog>
</div>
