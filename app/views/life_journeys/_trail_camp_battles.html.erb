<%# Battles inside a trail camp sheet. locals: project, goal, plan, area %>
<% project = local_assigns.fetch(:project) %>
<% area = local_assigns[:area] || project.life_area %>
<% days = project.children.select(&:day?).reject(&:holding?).sort_by { |d| [ d.completed? ? 1 : 0, d.scheduled_on || Date.new(9999), d.position.to_i, d.id ] } %>
<% open_days = days.reject(&:completed?) %>
<% done_days = days.select(&:completed?) %>
<% accent = mountain_trail_project_accent(project) %>
<% quantified = project.quantified? %>
<% pages_mode = project.pages_mode? %>

<div class="lp-trail-battles <%= 'is-pages-mode' if pages_mode %>"
     id="trail-battles-<%= project.id %>"
     style="--lp-trail-accent: <%= accent %>"
     data-controller="trail-battles"
     data-project-id="<%= project.id %>"
     data-project-title="<%= project.title %>"
     data-update-url="<%= strategy_goal_path(project) %>"
     data-delete-url="<%= strategy_goal_path(project) %>"
     data-quantified="<%= quantified %>"
     data-unit="<%= project.unit %>"
     data-quantity-kind="<%= project.try(:quantity_kind).presence || (quantified ? 'up' : 'none') %>"
     data-range-min="<%= project.try(:range_min) %>"
     data-range-max="<%= project.try(:range_max) %>"
     data-trail-battles-session-wins-value="0"
     data-session-win-template="<%= t('strategy.rpg.trail.session_wins_toast') %>">
  <div class="lp-trail-battles__camp-actions">
    <button type="button"
            class="lp-trail-battles__camp-edit"
            data-action="click->trail-battles#editCamp"
            aria-label="<%= t('strategy.rpg.edit_checkpoint') %>">
      ✎ <%= t("strategy.rpg.trail.edit_camp") %>
    </button>
    <%= button_to strategy_goal_path(project),
          method: :delete,
          class: "lp-trail-battles__camp-delete",
          form: {
            data: {
              turbo: true,
              turbo_confirm: t("strategy.rpg.delete_checkpoint_body", title: project.title),
              action: "submit->trail-battles#stashCampDelete"
            }
          } do %>
      🗑 <%= t("strategy.rpg.trail.delete_camp") %>
    <% end %>
    <% if project.completed? %>
      <%= button_to strategy_goal_manual_completion_path(project),
            method: :delete,
            class: "lp-trail-battles__camp-finish",
            form: { class: "lp-trail-battles__camp-finish-form", data: { turbo: false } } do %>
        <%= t("strategy.rpg.trail.reopen_camp") %>
      <% end %>
    <% else %>
      <%= button_to strategy_goal_manual_completion_path(project),
            method: :post,
            class: "lp-trail-battles__camp-finish",
            form: {
              class: "lp-trail-battles__camp-finish-form",
              data: {
                turbo: false,
                turbo_confirm: t("strategy.rpg.trail.finish_camp_confirm")
              }
            } do %>
        <%= t("strategy.rpg.trail.finish_camp") %>
      <% end %>
    <% end %>
  </div>

  <% if pages_mode %>
    <div class="lp-trail-battles__pages">
      <p class="lp-trail-battles__pages-label"><%= strategy_quantity_progress_label(project) %></p>
      <% if meta = strategy_project_card_meta(project) %>
        <div class="lp-trail-battles__pages-bar" aria-hidden="true">
          <span class="lp-trail-battles__pages-fill" style="width: <%= ((meta[:ratio] || 0) * 100).round %>%"></span>
        </div>
      <% end %>
      <p class="lp-trail-battles__pages-hint"><%= t("strategy.rpg.trail.pages_mode_hint") %></p>
      <button type="button"
              class="lp-trail-battles__pages-log"
              data-action="click->trail-canvas#openLog"
              data-project-id="<%= project.id %>"
              data-battle-id=""
              data-project-title="<%= project.title %>"
              data-unit="<%= project.unit %>"
              data-quantity-kind="<%= project.quantity_kind_value %>"
              data-range-min="<%= project.try(:range_min) %>"
              data-range-max="<%= project.try(:range_max) %>"
              data-last-log="<%= mountain_trail_last_log_amount(project) %>">
      </button>
    </div>
  <% else %>
    <p class="lp-trail-battles__stats">
      <%= t("strategy.rpg.trail.battle_stats", open: open_days.size, won: done_days.size) %>
    </p>

    <%= form_with url: strategy_goals_path,
          method: :post,
          class: "lp-trail-battles__add",
          data: {
            turbo: true,
            action: "submit->trail-battles#parseDraft turbo:submit-end->trail-battles#battleAdded"
          } do %>
      <%= hidden_field_tag :life_area_id, area.id %>
      <%= hidden_field_tag :life_journey_id, project.life_journey_id.presence || @journey&.id %>
      <%= hidden_field_tag :parent_id, project.id %>
      <%= hidden_field_tag :horizon, "day" %>
      <%= hidden_field_tag :scheduled_on, Date.current %>
      <%= hidden_field_tag :add_position, "top" %>
      <%= hidden_field_tag :repeat, "none", data: { trail_battles_target: "repeatField" } %>
      <div class="lp-trail-battles__add-row" data-trail-battles-target="addRow">
        <label class="lp-trail-battles__field">
          <span class="sr-only"><%= t("strategy.rpg.trail.battle_placeholder") %></span>
          <%= text_field_tag :title, nil,
                required: true,
                maxlength: 120,
                class: "lp-trail-battles__input",
                placeholder: t("strategy.rpg.trail.battle_placeholder"),
                autocomplete: "off",
                data: { trail_battles_target: "titleField" } %>
        </label>
        <label class="lp-trail-battles__daily-switch">
          <input type="checkbox"
                 class="lp-trail-battles__daily-check sr-only"
                 data-trail-battles-target="dailyToggle"
                 data-action="change->trail-battles#toggleDaily">
          <span class="lp-trail-battles__switch" aria-hidden="true"></span>
          <span class="lp-trail-battles__daily-label"><%= t("strategy.rpg.trail.daily") %></span>
        </label>
        <%= submit_tag t("strategy.rpg.trail.add_battle"), class: "lp-trail-battles__submit" %>
      </div>
    <% end %>

    <% if open_days.any? %>
      <ul class="lp-trail-battles__list">
        <% open_days.each do |battle| %>
          <li class="lp-trail-battles__row is-check"
              id="trail-battle-<%= battle.id %>">
            <% if quantified %>
              <button type="button"
                      class="lp-trail-battles__check"
                      data-action="click->trail-canvas#openLog"
                      data-project-id="<%= project.id %>"
                      data-battle-id="<%= battle.id %>"
                      data-project-title="<%= project.title %>"
                      data-unit="<%= project.unit %>"
                      data-quantity-kind="<%= project.try(:quantity_kind).presence || 'up' %>"
                      data-range-min="<%= project.try(:range_min) %>"
                      data-range-max="<%= project.try(:range_max) %>"
                      data-last-log="<%= mountain_trail_last_log_amount(project) %>"
                      aria-label="<%= t('strategy.rpg.trail.win_battle') %>">
                <span class="lp-trail-battles__box" aria-hidden="true"></span>
                <span class="lp-trail-battles__name"><%= battle.title %></span>
                <% if battle.repeat_daily? %>
                  <span class="lp-trail-battles__daily-chip"><%= t("strategy.rpg.trail.daily") %></span>
                <% end %>
              </button>
            <% else %>
              <%= button_to battle_win_path(battle),
                    method: :post,
                    class: "lp-trail-battles__check",
                    form: {
                      class: "lp-trail-battles__check-form",
                      data: { action: "turbo:submit-end->trail-battles#battleWon" }
                    } do %>
                <span class="lp-trail-battles__box" aria-hidden="true"></span>
                <span class="lp-trail-battles__name"><%= battle.title %></span>
                <% if battle.repeat_daily? %>
                  <span class="lp-trail-battles__daily-chip"><%= t("strategy.rpg.trail.daily") %></span>
                <% end %>
              <% end %>
            <% end %>
            <%= button_to strategy_goal_path(battle),
                  method: :delete,
                  class: "lp-trail-battles__row-delete",
                  form: {
                    data: {
                      turbo: true,
                      turbo_confirm: t("strategy.rpg.delete_checkpoint_body", title: battle.title),
                      action: "submit->trail-battles#stashBattleDelete"
                    }
                  },
                  aria: { label: t("strategy.rpg.delete_checkpoint") } do %>
              🗑
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="lp-trail-battles__empty"><%= t("strategy.rpg.trail.no_open_battles") %></p>
    <% end %>

    <% if done_days.any? %>
      <details class="lp-trail-battles__done" open>
        <summary><%= t("strategy.rpg.trail.won_battles", count: done_days.size) %></summary>
        <ul class="lp-trail-battles__list is-done">
          <% done_days.each do |battle| %>
            <li class="lp-trail-battles__row is-done is-check" id="trail-battle-<%= battle.id %>">
              <span class="lp-trail-battles__check is-static">
                <span class="lp-trail-battles__box is-won" aria-hidden="true">✓</span>
                <span class="lp-trail-battles__name"><%= battle.title %></span>
                <% if battle.repeat_daily? %>
                  <span class="lp-trail-battles__daily-chip"><%= t("strategy.rpg.trail.daily") %></span>
                <% end %>
              </span>
              <%= button_to battle_reopen_path(battle),
                    method: :post,
                    class: "lp-trail-battles__undo-win",
                    form: { data: { turbo: true } } do %>
                <%= t("strategy.rpg.trail.undo") %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
  <% end %>

  <p class="lp-trail-battles__session-toast"
     data-trail-battles-target="sessionToast"
     data-template="<%= t('strategy.rpg.trail.session_wins_toast') %>"
     hidden
     role="status"></p>

  <dialog class="lp-trail-battles__rename" data-trail-battles-target="renameDialog">
    <form method="dialog" class="lp-trail-battles__rename-form" data-action="submit->trail-battles#saveCamp">
      <h3><%= t("strategy.rpg.trail.edit_camp") %></h3>
      <input type="text"
             maxlength="120"
             required
             class="lp-trail-battles__input"
             value="<%= project.title %>"
             data-trail-battles-target="renameField">
      <div class="lp-trail-battles__rename-actions">
        <button type="button" data-action="click->trail-battles#closeRename"><%= t("strategy.rpg.cancel") %></button>
        <button type="submit"><%= t("strategy.rpg.save") %></button>
      </div>
    </form>
  </dialog>
</div>
