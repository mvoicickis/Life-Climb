<% next_up = @next_up %>
<% if next_up.present? %>
  <% area = @journey.life_area %>
  <% form = next_up[:form] %>
  <% examples = Array(next_up[:examples]) %>
  <%
    level =
      if form.present?
        { "goal" => "goal", "plan" => "plan", "project" => "project", "day" => "battle" }.fetch(form[:horizon].to_s, "goal")
      elsif next_up[:key] == :go_today
        "battle"
      elsif @level == "plans"
        "plan"
      elsif @level == "projects"
        "project"
      elsif @level == "battles"
        "battle"
      else
        "goal"
      end
    show_add_battle = next_up[:key] == :go_today && @focus&.project?
  %>
  <div class="lp-strategy-next is-<%= level %> <%= 'is-inline-form' if form.present? %> <%= 'is-handoff' if next_up[:key] == :go_today %>"
       id="strategy-next-up"
       data-controller="strategy-next<%= ' strategy-zoom' if next_up[:zoom] %>">
    <p class="lp-strategy-next__kicker"><%= t("strategy.next_up.kicker") %></p>
    <h2 class="lp-strategy-next__title"><%= next_up[:title] %></h2>
    <p class="lp-strategy-next__hint"><%= next_up[:hint] %></p>

    <% if next_up[:key] == :go_today && @today_battles.any? %>
      <ul class="lp-strategy-next__battles" aria-label="<%= t('strategy.battles_heading') %>">
        <% @today_battles.first(4).each do |battle| %>
          <li>
            <span aria-hidden="true"><%= battle.completed? ? "✓" : "⚔" %></span>
            <%= battle.title %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if form.present? %>
      <%= form_with url: strategy_goals_path, method: :post, class: "lp-strategy-next__form", data: { turbo: false } do %>
        <%= hidden_field_tag :life_area_id, area.id %>
        <%= hidden_field_tag :life_journey_id, @journey.id %>
        <%= hidden_field_tag :horizon, form[:horizon] %>
        <% if form[:parent_id].present? %>
          <%= hidden_field_tag :parent_id, form[:parent_id] %>
        <% end %>
        <% if form[:scheduled_on].present? %>
          <%= hidden_field_tag :scheduled_on, form[:scheduled_on] %>
        <% end %>

        <%= text_field_tag :title,
              (form[:horizon] == "goal" ? @journey.title : nil),
              required: true,
              maxlength: 120,
              id: "next-up-title",
              class: "lp-input w-full lp-strategy-next__input",
              placeholder: next_up[:placeholder] || t("strategy.goal_placeholder"),
              autofocus: true %>

        <% if examples.any? %>
          <div class="lp-strategy-next__examples" role="group" aria-label="<%= t('strategy.next_up.examples_label') %>">
            <% examples.each do |example| %>
              <button type="button"
                      class="lp-strategy-next__chip"
                      data-action="strategy-next#fillExample"
                      data-title="<%= example %>"><%= example %></button>
            <% end %>
          </div>
        <% end %>

        <% if form[:horizon] == "goal" %>
          <p class="lp-strategy-next__meta"><%= t("strategy.fixed_due", date: l(@year_due, format: :long)) %></p>
        <% end %>

        <%= submit_tag next_up[:cta], class: "lp-strategy-next__cta" %>
      <% end %>

    <% elsif next_up[:href].present? %>
      <%= link_to next_up[:cta],
            next_up[:href],
            class: "lp-strategy-next__cta",
            data: (next_up[:zoom] ? { action: "click->strategy-zoom#enter" } : {}) %>

    <% elsif next_up[:sync_today] %>
      <%= form_with url: life_journey_path(@journey), method: :patch, data: { turbo: false } do %>
        <%= hidden_field_tag :sync_today, "1" %>
        <%= submit_tag next_up[:cta], class: "lp-strategy-next__cta" %>
      <% end %>

      <% if show_add_battle %>
        <button type="button"
                class="lp-strategy-next__secondary"
                data-strategy-next-target="addToggle"
                data-action="strategy-next#showAddBattle"><%= t("strategy.add_another_battle") %></button>

        <div class="lp-strategy-next__add-battle"
             id="add-another-battle"
             hidden
             data-strategy-next-target="addForm">
          <p class="lp-strategy-next__add-label"><%= t("strategy.next_up.add_another_battle_hint") %></p>
          <%= form_with url: strategy_goals_path, method: :post, class: "lp-strategy-next__form", data: { turbo: false } do %>
            <%= hidden_field_tag :life_area_id, area.id %>
            <%= hidden_field_tag :life_journey_id, @journey.id %>
            <%= hidden_field_tag :parent_id, @focus.id %>
            <%= hidden_field_tag :horizon, "day" %>
            <%= hidden_field_tag :scheduled_on, Date.current %>
            <%= text_field_tag :title, nil,
                  required: true,
                  maxlength: 120,
                  id: "add-battle-title",
                  class: "lp-input w-full lp-strategy-next__input",
                  placeholder: t("strategy.battle_placeholder") %>
            <%= submit_tag t("strategy.add_battle"), class: "lp-strategy-next__cta is-secondary-cta" %>
          <% end %>
        </div>
      <% end %>

    <% elsif next_up[:anchor].present? %>
      <a href="#<%= next_up[:anchor] %>" class="lp-strategy-next__cta"><%= next_up[:cta] %></a>
    <% end %>
  </div>
<% end %>
