<%# Active Destination selector — Hero center. locals: root_goals, goal, progress, mountain, alive, streak %>
<% root_goals = local_assigns.fetch(:root_goals, []) %>
<% goal = local_assigns[:goal] %>
<% progress = local_assigns.fetch(:progress, 0) %>
<% mountain = local_assigns.fetch(:mountain, {}) %>
<% alive = local_assigns[:alive] || current_user.alive_level %>
<% streak = local_assigns[:streak] || strategy_climb_streak_status %>

<header class="lp-rpg-hud is-focus">
  <div class="lp-rpg-hud__left">
    <%= link_to settings_path, class: "lp-rpg-avatar", aria: { label: t("nav.settings") } do %>
      <%= image_tag current_user.character_image,
            class: "lp-rpg-avatar__img",
            alt: "" %>
      <span class="lp-rpg-avatar__ring" aria-hidden="true"></span>
      <span class="lp-rpg-avatar__level"><%= alive.number %></span>
    <% end %>
  </div>

  <div class="lp-rpg-summit">
    <p class="lp-rpg-summit__kicker"><%= t("strategy.rpg.destination") %></p>

    <div class="lp-rpg-destination" data-controller="destination-switcher">
      <% if root_goals.any? && goal %>
        <button type="button"
                class="lp-rpg-destination__trigger"
                data-destination-switcher-target="button"
                data-action="click->destination-switcher#toggle"
                aria-haspopup="menu"
                aria-expanded="false"
                aria-label="<%= t('strategy.rpg.switch_destination') %>">
          <span class="lp-rpg-destination__icon" aria-hidden="true">🏔</span>
          <span class="lp-rpg-destination__title"><%= goal.title %></span>
          <span class="lp-rpg-destination__icon is-trail" aria-hidden="true">🏔</span>
          <span class="lp-rpg-destination__chevron" aria-hidden="true">▼</span>
        </button>

        <div class="lp-rpg-destination__menu"
             data-destination-switcher-target="menu"
             role="menu"
             hidden>
          <% root_goals.each do |g| %>
            <% active = goal.id == g.id %>
            <%= link_to life_journey_path(@journey, goal_id: g.id),
                  class: "lp-rpg-destination__item #{'is-active' if active}",
                  role: "menuitem",
                  aria: { current: (active ? "true" : nil) },
                  data: { turbo: true, action: "click->destination-switcher#close" } do %>
              <span class="lp-rpg-destination__check" aria-hidden="true"><%= active ? "✓" : "" %></span>
              <span class="lp-rpg-destination__item-title"><%= g.title %></span>
            <% end %>
          <% end %>

          <div class="lp-rpg-destination__divider" role="separator"></div>

          <button type="button"
                  class="lp-rpg-destination__item is-new"
                  role="menuitem"
                  data-action="click->destination-switcher#openCreate">
            <span class="lp-rpg-destination__check" aria-hidden="true"></span>
            <span class="lp-rpg-destination__item-title"><%= t("strategy.rpg.new_destination") %></span>
          </button>
        </div>
      <% else %>
        <button type="button"
                class="lp-rpg-destination__trigger is-empty"
                data-destination-switcher-target="button"
                data-action="click->destination-switcher#openCreate"
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-label="<%= t('strategy.rpg.new_destination') %>">
          <span class="lp-rpg-destination__icon" aria-hidden="true">🏔</span>
          <span class="lp-rpg-destination__title"><%= t("strategy.zones.empty_goal") %></span>
          <span class="lp-rpg-destination__chevron" aria-hidden="true">▼</span>
        </button>
        <p class="lp-rpg-summit__tagline"><%= t("strategy.promise") %></p>
      <% end %>

      <%# Shared LifePoints dialog — Create Destination. %>
      <dialog class="lp-strategy-sheet is-goal"
              id="destination-create"
              data-destination-switcher-target="createDialog">
        <div class="lp-strategy-sheet__panel">
          <header class="lp-strategy-sheet__head">
            <p class="lp-strategy-sheet__kind"><%= t("strategy.horizons.goal") %></p>
            <h2 class="lp-strategy-sheet__title"><%= t("strategy.rpg.create_destination_title") %></h2>
            <button type="button"
                    class="lp-strategy-sheet__close"
                    data-action="click->destination-switcher#closeCreate"
                    aria-label="<%= t('strategy.sheet.close') %>">×</button>
          </header>
          <div class="lp-strategy-sheet__actions">
            <div class="lp-strategy-sheet__edit">
              <%= form_with url: strategy_goals_path, method: :post,
                    class: "lp-strategy-sheet__form",
                    data: { turbo: false } do %>
                <%= hidden_field_tag :life_area_id, @journey.life_area_id %>
                <%= hidden_field_tag :life_journey_id, @journey.id %>
                <%= hidden_field_tag :horizon, "goal" %>
                <%= text_field_tag :title, nil,
                      required: true,
                      maxlength: 120,
                      id: "destination-create-title",
                      class: "lp-rpg-input",
                      autocomplete: "off",
                      placeholder: t("strategy.goal_placeholder"),
                      aria: { label: t("strategy.rpg.create_destination_title") } %>
                <div class="lp-strategy-sheet__footer">
                  <%= submit_tag t("strategy.rpg.create_destination_cta"),
                        class: "lp-strategy-sheet__btn is-save",
                        data: { destination_switcher_target: "saveButton" } %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </dialog>
    </div>

    <% if goal %>
      <p class="lp-rpg-summit__pct" data-strategy-rpg-target="pct" data-strategy-celebrate-target="progressBar">
        <%= progress %>% · <%= mountain[:label].presence || t("strategy.rpg.on_my_way") %>
      </p>
    <% end %>
  </div>

  <div class="lp-rpg-hud__chips">
    <div class="lp-rpg-chip is-xp" data-strategy-celebrate-target="spBadge" aria-label="<%= t('strategy.rpg.xp') %>">
      <span class="lp-rpg-chip__icon" aria-hidden="true">★</span>
      <span class="lp-rpg-chip__value" data-strategy-celebrate-target="apValue"><%= number_with_delimiter(current_user.life_points) %></span>
      <span class="lp-rpg-chip__name"><%= t("strategy.rpg.xp") %></span>
    </div>
    <div class="lp-rpg-chip is-streak" aria-label="<%= t('strategy.rpg.streak') %>">
      <span class="lp-rpg-chip__icon" aria-hidden="true">🔥</span>
      <span class="lp-rpg-chip__value"><%= t("strategy.rpg.day_streak", count: streak.days) %></span>
    </div>
    <div class="lp-rpg-chip is-quiet" aria-hidden="true">
      <span class="lp-rpg-chip__value" data-strategy-celebrate-target="spValue"><%= number_with_delimiter(current_user.strategy_points) %></span>
    </div>
  </div>
</header>
