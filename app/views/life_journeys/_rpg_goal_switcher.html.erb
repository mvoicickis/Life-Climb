<%# Hero Q1 — Destination only. Other goals behind Switch Destination. locals: root_goals, goal %>
<% root_goals = local_assigns.fetch(:root_goals, []) %>
<% goal = local_assigns[:goal] %>

<header class="lp-rpg-hud is-game-first">
  <div class="lp-rpg-summit">
    <% if goal %>
      <p class="lp-rpg-summit__kicker"><%= t("strategy.rpg.destination") %></p>
      <h1 class="lp-rpg-summit__title lp-rpg-goal__title"><%= goal.title %></h1>
      <% if root_goals.size > 1 %>
        <details class="lp-rpg-disclosure is-destination">
          <summary><%= t("strategy.rpg.switch_destination") %></summary>
          <ul class="lp-rpg-goals is-disclosure" aria-label="<%= t('strategy.rpg.destinations') %>">
            <% root_goals.each do |g| %>
              <li>
                <%= link_to life_journey_path(@journey, goal_id: g.id),
                      class: "lp-rpg-goal #{'is-focus' if goal.id == g.id}",
                      data: { turbo: true } do %>
                  <span class="lp-rpg-goal__title"><%= g.title %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </details>
      <% end %>
    <% elsif root_goals.any? %>
      <p class="lp-rpg-summit__kicker"><%= t("strategy.rpg.destination") %></p>
      <div class="lp-rpg-goals" aria-label="<%= t('strategy.rpg.destinations') %>">
        <% root_goals.each do |g| %>
          <%= link_to life_journey_path(@journey, goal_id: g.id),
                class: "lp-rpg-goal",
                data: { turbo: true } do %>
            <span class="lp-rpg-goal__title"><%= g.title %></span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="lp-rpg-summit__kicker"><%= t("strategy.rpg.destination") %></p>
      <h1 class="lp-rpg-summit__title"><%= t("strategy.zones.empty_goal") %></h1>
    <% end %>
  </div>
</header>
