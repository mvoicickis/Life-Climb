<%# Destination carousel — one active world + peeks + arrows + dots + swipe. locals: root_goals, goal, progress, mountain, alive, streak %>
<% root_goals = local_assigns.fetch(:root_goals, []) %>
<% goal = local_assigns[:goal] %>
<% progress = local_assigns.fetch(:progress, 0) %>
<% mountain = local_assigns.fetch(:mountain, {}) %>
<% alive = local_assigns[:alive] || current_user.alive_level %>
<% streak = local_assigns[:streak] || strategy_climb_streak_status %>
<% goal_index = goal ? root_goals.index { |g| g.id == goal.id } : nil %>
<% prev_goal = goal_index&.positive? ? root_goals[goal_index - 1] : nil %>
<% next_goal = goal_index && goal_index < root_goals.size - 1 ? root_goals[goal_index + 1] : nil %>
<% multi = root_goals.size > 1 %>

<header class="lp-rpg-hud is-focus">
  <div class="lp-rpg-hud__left">
    <%= link_to settings_path, class: "lp-rpg-avatar", aria: { label: t("nav.settings") } do %>
      <%= image_tag current_user.character_image,
            class: "lp-rpg-avatar__img",
            alt: "" %>
      <span class="lp-rpg-avatar__ring" aria-hidden="true"></span>
      <span class="lp-rpg-avatar__level"><%= alive.number %></span>
    <% end %>
  </div>

  <div class="lp-rpg-summit">
    <p class="lp-rpg-summit__kicker"><%= t("strategy.rpg.destination") %></p>

    <div class="lp-rpg-destination" data-controller="destination-switcher">
      <% if root_goals.any? && goal %>
        <nav class="lp-rpg-destination-carousel <%= 'is-multi' if multi %>"
             aria-label="<%= t('strategy.rpg.destinations') %>"
             data-action="pointerdown->destination-switcher#swipeStart pointerup->destination-switcher#swipeEnd pointercancel->destination-switcher#swipeCancel">
          <div class="lp-rpg-destination-carousel__nav is-prev">
            <% if prev_goal %>
              <%= link_to life_journey_path(@journey, goal_id: prev_goal.id),
                    class: "lp-rpg-destination-carousel__arrow is-prev",
                    data: {
                      turbo: true,
                      destination_switcher_target: "prevLink"
                    },
                    aria: { label: t("strategy.rpg.destination_prev") } do %>
                <span aria-hidden="true">‹</span>
              <% end %>
            <% else %>
              <span class="lp-rpg-destination-carousel__arrow is-prev is-disabled" aria-hidden="true">
                <span aria-hidden="true">‹</span>
              </span>
            <% end %>
          </div>

          <div class="lp-rpg-destination-carousel__stage">
            <% if prev_goal %>
              <%= link_to life_journey_path(@journey, goal_id: prev_goal.id),
                    class: "lp-rpg-destination-carousel__peek is-prev",
                    data: { turbo: true },
                    tabindex: -1,
                    aria: { hidden: true } do %>
                <span class="lp-rpg-destination-carousel__peek-title"><%= prev_goal.title %></span>
              <% end %>
            <% else %>
              <span class="lp-rpg-destination-carousel__peek is-prev is-empty" aria-hidden="true"></span>
            <% end %>

            <div class="lp-rpg-destination-carousel__active"
                 data-controller="plan-card-menu"
                 aria-current="true">
              <span class="lp-rpg-destination-carousel__icon" aria-hidden="true">🏔</span>
              <div class="lp-rpg-destination-carousel__title-row">
                <h1 class="lp-rpg-destination-carousel__title"><%= goal.title %></h1>
                <button type="button"
                        class="lp-rpg-destination-carousel__edit"
                        data-plan-card-menu-target="button"
                        data-action="click->plan-card-menu#edit"
                        aria-label="<%= t('strategy.rpg.edit_destination') %>">
                  <span aria-hidden="true">✎</span>
                </button>
              </div>

              <dialog class="lp-strategy-sheet is-goal"
                      id="destination-edit-<%= goal.id %>"
                      data-plan-card-menu-target="editDialog">
                <div class="lp-strategy-sheet__panel">
                  <header class="lp-strategy-sheet__head">
                    <p class="lp-strategy-sheet__kind"><%= t("strategy.horizons.goal") %></p>
                    <h2 class="lp-strategy-sheet__title"><%= t("strategy.rpg.edit_destination") %></h2>
                    <button type="button"
                            class="lp-strategy-sheet__close"
                            data-action="click->plan-card-menu#closeEdit"
                            aria-label="<%= t('strategy.sheet.close') %>">×</button>
                  </header>
                  <div class="lp-strategy-sheet__actions">
                    <div class="lp-strategy-sheet__edit">
                      <%= form_with url: strategy_goal_path(goal), method: :patch,
                            class: "lp-strategy-sheet__form",
                            data: { turbo: false } do %>
                        <%= text_field_tag :title, goal.title,
                              required: true,
                              maxlength: 120,
                              id: "destination-edit-title-#{goal.id}",
                              class: "lp-rpg-input",
                              autocomplete: "off",
                              aria: { label: t("strategy.rpg.edit_destination") } %>
                        <div class="lp-strategy-sheet__footer">
                          <%= submit_tag t("strategy.save_changes"),
                                class: "lp-strategy-sheet__btn is-save",
                                data: { plan_card_menu_target: "saveButton" } %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </dialog>
            </div>

            <% if next_goal %>
              <%= link_to life_journey_path(@journey, goal_id: next_goal.id),
                    class: "lp-rpg-destination-carousel__peek is-next",
                    data: { turbo: true },
                    tabindex: -1,
                    aria: { hidden: true } do %>
                <span class="lp-rpg-destination-carousel__peek-title"><%= next_goal.title %></span>
              <% end %>
            <% else %>
              <span class="lp-rpg-destination-carousel__peek is-next is-empty" aria-hidden="true"></span>
            <% end %>
          </div>

          <div class="lp-rpg-destination-carousel__nav is-next">
            <% if next_goal %>
              <%= link_to life_journey_path(@journey, goal_id: next_goal.id),
                    class: "lp-rpg-destination-carousel__arrow is-next",
                    data: {
                      turbo: true,
                      destination_switcher_target: "nextLink"
                    },
                    aria: { label: t("strategy.rpg.destination_next") } do %>
                <span aria-hidden="true">›</span>
              <% end %>
            <% else %>
              <span class="lp-rpg-destination-carousel__arrow is-next is-disabled" aria-hidden="true">
                <span aria-hidden="true">›</span>
              </span>
            <% end %>
          </div>
        </nav>

        <% if multi %>
          <div class="lp-rpg-destination-dots" role="tablist" aria-label="<%= t('strategy.rpg.destinations') %>">
            <% root_goals.each_with_index do |g, i| %>
              <% active = goal.id == g.id %>
              <%= link_to life_journey_path(@journey, goal_id: g.id),
                    class: "lp-rpg-destination-dots__dot #{'is-active' if active}",
                    data: { turbo: true },
                    aria: {
                      label: g.title,
                      current: active ? "true" : nil
                    } do %>
                <span class="lp-rpg-destination-dots__pip" aria-hidden="true"></span>
              <% end %>
            <% end %>
          </div>
          <p class="lp-rpg-destination-swipe-hint"><%= t("strategy.rpg.destination_swipe_hint") %></p>
        <% end %>

        <p class="lp-rpg-summit__pct" data-strategy-rpg-target="pct" data-strategy-celebrate-target="progressBar">
          <%= progress %>% · <%= mountain[:label].presence || t("strategy.rpg.on_my_way") %>
        </p>

        <button type="button"
                class="lp-rpg-destination__new"
                data-action="click->destination-switcher#openCreate"
                aria-haspopup="dialog">
          <%= t("strategy.rpg.new_destination") %>
        </button>
      <% else %>
        <button type="button"
                class="lp-rpg-destination-carousel__active is-empty"
                data-destination-switcher-target="button"
                data-action="click->destination-switcher#openCreate"
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-label="<%= t('strategy.rpg.new_destination') %>">
          <span class="lp-rpg-destination-carousel__icon" aria-hidden="true">🏔</span>
          <span class="lp-rpg-destination-carousel__title"><%= t("strategy.zones.empty_goal") %></span>
        </button>
        <p class="lp-rpg-summit__tagline"><%= t("strategy.promise") %></p>
      <% end %>

      <dialog class="lp-strategy-sheet is-goal"
              id="destination-create"
              data-destination-switcher-target="createDialog">
        <div class="lp-strategy-sheet__panel">
          <header class="lp-strategy-sheet__head">
            <p class="lp-strategy-sheet__kind"><%= t("strategy.horizons.goal") %></p>
            <h2 class="lp-strategy-sheet__title"><%= t("strategy.rpg.create_destination_title") %></h2>
            <button type="button"
                    class="lp-strategy-sheet__close"
                    data-action="click->destination-switcher#closeCreate"
                    aria-label="<%= t('strategy.sheet.close') %>">×</button>
          </header>
          <div class="lp-strategy-sheet__actions">
            <div class="lp-strategy-sheet__edit">
              <%= form_with url: strategy_goals_path, method: :post,
                    class: "lp-strategy-sheet__form",
                    data: { turbo: false } do %>
                <%= hidden_field_tag :life_area_id, @journey.life_area_id %>
                <%= hidden_field_tag :life_journey_id, @journey.id %>
                <%= hidden_field_tag :horizon, "goal" %>
                <%= text_field_tag :title, nil,
                      required: true,
                      maxlength: 120,
                      id: "destination-create-title",
                      class: "lp-rpg-input",
                      autocomplete: "off",
                      placeholder: t("strategy.goal_placeholder"),
                      aria: { label: t("strategy.rpg.create_destination_title") } %>
                <div class="lp-strategy-sheet__footer">
                  <%= submit_tag t("strategy.rpg.create_destination_cta"),
                        class: "lp-strategy-sheet__btn is-save",
                        data: { destination_switcher_target: "saveButton" } %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </dialog>
    </div>
  </div>

  <% xp = current_user.life_points.to_i %>
  <% streak_days = streak.days.to_i %>
  <div class="lp-rpg-hud__chips">
    <% if xp.positive? %>
      <div class="lp-rpg-chip is-xp" data-strategy-celebrate-target="spBadge" aria-label="<%= t('strategy.rpg.xp') %>">
        <span class="lp-rpg-chip__icon" aria-hidden="true">★</span>
        <span class="lp-rpg-chip__value" data-strategy-celebrate-target="apValue"><%= number_with_delimiter(xp) %></span>
        <span class="lp-rpg-chip__name"><%= t("strategy.rpg.xp") %></span>
      </div>
    <% else %>
      <%# Keep celebrate targets mounted so XP awards can animate in later. %>
      <div class="lp-rpg-chip is-xp is-quiet" data-strategy-celebrate-target="spBadge" aria-hidden="true">
        <span class="lp-rpg-chip__value" data-strategy-celebrate-target="apValue">0</span>
      </div>
    <% end %>
    <% if streak_days.positive? %>
      <div class="lp-rpg-chip is-streak" aria-label="<%= t('strategy.rpg.streak') %>">
        <span class="lp-rpg-chip__icon" aria-hidden="true">🔥</span>
        <span class="lp-rpg-chip__value"><%= t("strategy.rpg.day_streak", count: streak_days) %></span>
      </div>
    <% end %>
    <div class="lp-rpg-chip is-quiet" aria-hidden="true">
      <span class="lp-rpg-chip__value" data-strategy-celebrate-target="spValue"><%= number_with_delimiter(current_user.strategy_points) %></span>
    </div>
  </div>
</header>
