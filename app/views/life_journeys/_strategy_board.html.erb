<% area = @journey.life_area %>

<section class="lp-strategy space-y-4" aria-label="<%= t('strategy.title') %>">
  <% if @crumbs.any? %>
    <nav class="lp-strategy__crumbs" aria-label="<%= t('strategy.breadcrumb') %>">
      <%= link_to t("strategy.levels.goal"), life_journey_path(@journey), class: "lp-strategy__crumb" %>
      <% @crumbs.each do |crumb| %>
        <span class="lp-strategy__crumb-sep" aria-hidden="true">/</span>
        <%= link_to crumb[:title].truncate(28),
              life_journey_path(@journey, focus_id: crumb[:id]),
              class: "lp-strategy__crumb" %>
      <% end %>
    </nav>
  <% end %>

  <p class="lp-strategy__step"><%= t("strategy.guided.step", n: @guided_step) %> · <%= t("strategy.guided.steps.#{@guided_step}") %></p>

  <div class="lp-strategy__board lp-glass p-5 space-y-4">
    <% if @goal.nil? %>
      <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("strategy.guided.ask_goal") %></h2>
      <p class="lp-strategy__board-hint"><%= t("strategy.goal_hint") %></p>
      <%= form_with url: strategy_goals_path, method: :post, class: "space-y-3", data: { turbo: false } do %>
        <%= hidden_field_tag :life_area_id, area.id %>
        <%= hidden_field_tag :life_journey_id, @journey.id %>
        <%= hidden_field_tag :horizon, "goal" %>
        <%= text_field_tag :title, @journey.title, required: true, maxlength: 120, class: "lp-input w-full", placeholder: t("strategy.goal_placeholder") %>
        <%= text_area_tag :description, nil, rows: 2, class: "lp-input w-full", placeholder: t("strategy.goal_description_placeholder") %>
        <p class="text-sm text-[var(--lp-muted)]"><%= t("strategy.fixed_due", date: l(@year_due, format: :long)) %></p>
        <%= submit_tag t("strategy.add_goal"), class: "lp-cta w-full" %>
      <% end %>

    <% elsif @level == "plans" %>
      <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= t("strategy.guided.ask_plans") %></h2>
      <p class="lp-strategy__board-hint"><%= t("strategy.plan_hint_v1") %></p>
      <ul class="lp-strategy__list">
        <% @children.select(&:plan?).each do |plan| %>
          <li class="lp-strategy__item">
            <div class="min-w-0 flex-1">
              <%= link_to plan.title, life_journey_path(@journey, focus_id: plan.id), class: "lp-strategy__item-title" %>
              <div class="lp-strategy__bar mt-2"><span style="width: <%= plan.progress_percent %>%"></span></div>
              <p class="lp-strategy__item-meta"><%= plan.progress_percent %>%</p>
            </div>
            <%= button_to t("strategy.remove"), strategy_goal_path(plan), method: :delete, class: "lp-strategy__remove", form: { data: { turbo: false } } %>
          </li>
        <% end %>
      </ul>
      <%= form_with url: strategy_goals_path, method: :post, class: "space-y-3", data: { turbo: false } do %>
        <%= hidden_field_tag :life_area_id, area.id %>
        <%= hidden_field_tag :life_journey_id, @journey.id %>
        <%= hidden_field_tag :parent_id, @goal.id %>
        <%= hidden_field_tag :horizon, "plan" %>
        <%= text_field_tag :title, nil, required: true, maxlength: 120, class: "lp-input w-full", placeholder: t("strategy.plan_placeholder") %>
        <%= submit_tag t("strategy.add_plan"), class: "lp-cta w-full" %>
      <% end %>

    <% elsif @level == "projects" %>
      <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= @focus.title %></h2>
      <p class="lp-strategy__board-hint"><%= t("strategy.guided.ask_projects") %></p>
      <div class="lp-strategy__bar"><span style="width: <%= @focus.progress_percent %>%"></span></div>
      <ul class="lp-strategy__list">
        <% @children.select(&:project?).each do |project| %>
          <li class="lp-strategy__item">
            <div class="min-w-0 flex-1">
              <%= link_to project.title, life_journey_path(@journey, focus_id: project.id), class: "lp-strategy__item-title" %>
              <div class="lp-strategy__bar mt-2"><span style="width: <%= project.progress_percent %>%"></span></div>
              <p class="lp-strategy__item-meta"><%= project.progress_percent %>%</p>
            </div>
            <%= button_to t("strategy.remove"), strategy_goal_path(project), method: :delete, class: "lp-strategy__remove", form: { data: { turbo: false } } %>
          </li>
        <% end %>
      </ul>
      <%= form_with url: strategy_goals_path, method: :post, class: "space-y-3", data: { turbo: false } do %>
        <%= hidden_field_tag :life_area_id, area.id %>
        <%= hidden_field_tag :life_journey_id, @journey.id %>
        <%= hidden_field_tag :parent_id, @focus.id %>
        <%= hidden_field_tag :horizon, "project" %>
        <%= text_field_tag :title, nil, required: true, maxlength: 120, class: "lp-input w-full", placeholder: t("strategy.project_placeholder") %>
        <%= submit_tag t("strategy.add_project"), class: "lp-cta w-full" %>
      <% end %>

    <% elsif @level == "months" %>
      <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= @focus.title %></h2>
      <p class="lp-strategy__board-hint"><%= t("strategy.guided.ask_months") %></p>
      <div class="lp-strategy__bar"><span style="width: <%= @focus.progress_percent %>%"></span></div>
      <ul class="lp-strategy__list">
        <% @month_slots.each do |slot| %>
          <% existing = @children.find { |g| g.month? && g.due_on == slot[:due_on] } %>
          <li class="lp-strategy__item">
            <div class="min-w-0 flex-1">
              <p class="lp-strategy__item-meta"><%= slot[:label] %></p>
              <% if existing %>
                <%= link_to existing.title, life_journey_path(@journey, focus_id: existing.id), class: "lp-strategy__item-title" %>
                <div class="lp-strategy__bar mt-2"><span style="width: <%= existing.progress_percent %>%"></span></div>
              <% else %>
                <%= form_with url: strategy_goals_path, method: :post, class: "mt-2 space-y-2", data: { turbo: false } do %>
                  <%= hidden_field_tag :life_area_id, area.id %>
                  <%= hidden_field_tag :life_journey_id, @journey.id %>
                  <%= hidden_field_tag :parent_id, @focus.id %>
                  <%= hidden_field_tag :horizon, "month" %>
                  <%= hidden_field_tag :due_on, slot[:due_on] %>
                  <%= text_field_tag :title, nil, required: true, maxlength: 120, class: "lp-input w-full", placeholder: t("strategy.month_placeholder") %>
                  <%= submit_tag t("strategy.add_month_goal"), class: "lp-cta w-full" %>
                <% end %>
              <% end %>
            </div>
            <% if existing %>
              <%= button_to t("strategy.remove"), strategy_goal_path(existing), method: :delete, class: "lp-strategy__remove", form: { data: { turbo: false } } %>
            <% end %>
          </li>
        <% end %>
      </ul>

    <% else %>
      <%# month_detail or week battles %>
      <h2 class="text-lg font-semibold text-[var(--lp-ink)]"><%= @focus.title %></h2>
      <p class="lp-strategy__board-hint">
        <%= @focus.month? ? t("strategy.month_detail_hint") : t("strategy.week_hint_v1") %>
      </p>
      <div class="lp-strategy__bar"><span style="width: <%= @focus.progress_percent %>%"></span></div>

      <% if @focus.month? %>
        <% weeks = @children.select(&:week?) %>
        <% if weeks.any? %>
          <ul class="lp-strategy__list">
            <% weeks.each do |week| %>
              <li class="lp-strategy__item">
                <%= link_to week.title, life_journey_path(@journey, focus_id: week.id), class: "lp-strategy__item-title" %>
                <%= button_to t("strategy.remove"), strategy_goal_path(week), method: :delete, class: "lp-strategy__remove", form: { data: { turbo: false } } %>
              </li>
            <% end %>
          </ul>
        <% end %>
        <details class="lp-strategy__optional">
          <summary><%= t("strategy.add_week_optional") %></summary>
          <%= form_with url: strategy_goals_path, method: :post, class: "mt-3 space-y-3", data: { turbo: false } do %>
            <%= hidden_field_tag :life_area_id, area.id %>
            <%= hidden_field_tag :life_journey_id, @journey.id %>
            <%= hidden_field_tag :parent_id, @focus.id %>
            <%= hidden_field_tag :horizon, "week" %>
            <%= text_field_tag :title, nil, required: true, maxlength: 120, class: "lp-input w-full", placeholder: t("strategy.week_placeholder") %>
            <%= date_field_tag :due_on, @focus.due_on, required: true, class: "lp-input w-full", max: @focus.due_on %>
            <%= submit_tag t("strategy.add_week"), class: "lp-cta w-full" %>
          <% end %>
        </details>
      <% end %>

      <h3 class="pt-2 text-base font-semibold text-[var(--lp-ink)]"><%= t("strategy.battles_heading") %></h3>
      <ul class="lp-strategy__list">
        <% @children.select(&:day?).each do |battle| %>
          <li class="lp-strategy__item">
            <div>
              <p class="lp-strategy__item-title"><%= battle.title %></p>
              <p class="lp-strategy__item-meta"><%= l(battle.scheduled_on, format: :long) if battle.scheduled_on %></p>
            </div>
            <%= button_to t("strategy.remove"), strategy_goal_path(battle), method: :delete, class: "lp-strategy__remove", form: { data: { turbo: false } } %>
          </li>
        <% end %>
      </ul>
      <%= form_with url: strategy_goals_path, method: :post, class: "space-y-3", data: { turbo: false } do %>
        <%= hidden_field_tag :life_area_id, area.id %>
        <%= hidden_field_tag :life_journey_id, @journey.id %>
        <%= hidden_field_tag :parent_id, @focus.id %>
        <%= hidden_field_tag :horizon, "day" %>
        <%= hidden_field_tag :scheduled_on, Date.current %>
        <%= text_field_tag :title, nil, required: true, maxlength: 120, class: "lp-input w-full", placeholder: t("strategy.battle_placeholder") %>
        <%= submit_tag t("strategy.add_battle"), class: "lp-cta w-full" %>
      <% end %>
    <% end %>
  </div>

  <aside class="lp-strategy__today lp-glass p-5 space-y-3">
    <h2 class="text-base font-semibold text-[var(--lp-ink)]"><%= t("strategy.today_battle_title") %></h2>
    <% if @today_battles.any? %>
      <ul class="space-y-2">
        <% @today_battles.first(5).each do |battle| %>
          <li class="text-sm text-[var(--lp-ink)]">
            <%= battle.completed? ? "✓" : "□" %>
            <%= battle.title %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-[var(--lp-muted)]"><%= t("strategy.today_battle_empty") %></p>
    <% end %>
    <%= form_with url: life_journey_path(@journey), method: :patch, data: { turbo: false } do %>
      <%= hidden_field_tag :sync_today, "1" %>
      <%= submit_tag t("strategy.go_today"), class: "lp-cta w-full" %>
    <% end %>
  </aside>

  <aside class="lp-glass p-5">
    <h2 class="text-base font-semibold text-[var(--lp-ink)]"><%= t("strategy.plan_together_title") %></h2>
    <p class="mt-2 text-sm text-[var(--lp-muted)] whitespace-pre-line"><%= t("strategy.plan_together_body") %></p>
    <p class="mt-3">
      <%= link_to t("strategy.plan_together_help"), new_feedback_path, class: "font-bold text-[var(--lp-lime)]" %>
    </p>
  </aside>
</section>
