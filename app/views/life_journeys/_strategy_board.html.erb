<% area = @journey.life_area %>
<% focus_create = @next_up.present? && @next_up[:form].present? %>
<% has_quests = @goal.present? && (
     (@level == "plans" && @children.any?(&:plan?)) ||
     (@level == "projects" && @children.any?(&:project?)) ||
     (@focus&.project? && @children.any?(&:day?))
   ) %>

<section class="lp-strategy space-y-4" aria-label="<%= t('strategy.title') %>" id="strategy-board">
  <%= render "life_journeys/strategy_path" %>

  <% if @crumbs.size > 1 %>
    <nav class="lp-strategy__crumbs" aria-label="<%= t('strategy.breadcrumb') %>">
      <%= link_to t("strategy.levels.goal"), life_journey_path(@journey), class: "lp-strategy__crumb is-goal" %>
      <% @crumbs.each do |crumb| %>
        <span class="lp-strategy__crumb-sep" aria-hidden="true">/</span>
        <%= link_to crumb[:title].truncate(24),
              life_journey_path(@journey, focus_id: crumb[:id]),
              class: "lp-strategy__crumb is-#{crumb[:kind]}" %>
      <% end %>
    </nav>
  <% end %>

  <%= render "life_journeys/strategy_next_up" %>

  <% unless focus_create && !has_quests %>
    <%
      board_level =
        case @level
        when "plans" then "plan"
        when "projects" then "project"
        when "battles" then "battle"
        else "goal"
        end
    %>
    <% board_tag = focus_create ? :details : :div %>
    <% board_attrs = focus_create ? { class: "lp-strategy__quests-panel", id: "strategy-quests" } : { class: "lp-strategy__board is-#{board_level}", id: "strategy-quests" } %>
    <%= content_tag board_tag, **board_attrs do %>
      <% if focus_create %>
        <summary class="lp-strategy__quests-summary"><%= t("strategy.your_quests") %></summary>
        <div class="lp-strategy__board-inner space-y-4 is-<%= board_level %>">
      <% end %>

      <% if @goal.nil? %>
        <%# Primary create lives in Next Up %>

      <% elsif @level == "plans" %>
        <% plans = @children.select(&:plan?) %>
        <% if plans.any? %>
          <div class="lp-strategy__board-head">
            <h2 class="lp-strategy__board-title"><%= t("strategy.questions.plan") %></h2>
            <a href="#strategy-add-plan" class="lp-strategy__board-add-link"><%= t("strategy.add_link.plan") %></a>
          </div>
          <div class="lp-strategy-quests">
            <% plans.each do |plan| %>
              <%= render "life_journeys/strategy_quest_card", node: plan, journey: @journey %>
            <% end %>
          </div>
        <% end %>

        <% unless focus_create %>
          <%= render "life_journeys/strategy_add_card",
                kind: "plan",
                title: (plans.empty? ? t("strategy.next_up.add_plan_cta") : t("strategy.add_another_plan")),
                area: area,
                journey: @journey,
                parent_id: @goal.id,
                horizon: "plan",
                placeholder: t("strategy.plan_placeholder"),
                submit: t("strategy.add_plan") %>
        <% end %>

      <% elsif @level == "projects" %>
        <% projects = @children.select(&:project?) %>
        <div class="lp-strategy__board-head">
          <h2 class="lp-strategy__board-title"><%= @focus.title %></h2>
          <% unless focus_create %>
            <a href="#strategy-add-project" class="lp-strategy__board-add-link"><%= t("strategy.add_link.project") %></a>
          <% end %>
        </div>
        <%= render "life_journeys/strategy_siblings" %>
        <p class="lp-strategy__board-hint"><%= t("strategy.questions.project") %></p>
        <div class="lp-strategy__bar" style="--lp-level: var(--lp-level-project)"><span style="width: <%= @focus.progress_percent %>%"></span></div>

        <% if projects.any? %>
          <div class="lp-strategy-quests">
            <% projects.each do |project| %>
              <%= render "life_journeys/strategy_quest_card", node: project, journey: @journey %>
            <% end %>
          </div>
        <% end %>

        <% unless focus_create %>
          <%= render "life_journeys/strategy_add_card",
                kind: "project",
                title: (projects.empty? ? t("strategy.next_up.add_project_cta") : t("strategy.add_another_project")),
                area: area,
                journey: @journey,
                parent_id: @focus.id,
                horizon: "project",
                placeholder: t("strategy.project_placeholder"),
                submit: t("strategy.add_project") %>
        <% end %>

      <% else %>
        <% battles = @children.select(&:day?) %>
        <div class="lp-strategy__board-head">
          <h2 class="lp-strategy__board-title"><%= @focus.title %></h2>
          <% unless focus_create %>
            <a href="#strategy-add-battle" class="lp-strategy__board-add-link"><%= t("strategy.add_link.battle") %></a>
          <% end %>
        </div>
        <%= render "life_journeys/strategy_siblings" %>
        <p class="lp-strategy__board-hint"><%= t("strategy.questions.battle") %></p>
        <div class="lp-strategy__bar" style="--lp-level: var(--lp-level-battle)"><span style="width: <%= @focus.progress_percent %>%"></span></div>

        <% if battles.any? %>
          <h3 class="pt-2 text-base font-semibold text-[var(--lp-ink)]"><%= t("strategy.battles_heading") %></h3>
          <ul class="lp-strategy__list">
            <% battles.each do |battle| %>
              <li class="lp-strategy__item is-battle <%= 'is-done' if battle.completed? %>">
                <div class="min-w-0 flex-1">
                  <p class="lp-strategy__item-title">
                    <span class="lp-strategy__item-marker" aria-hidden="true"><%= battle.completed? ? "✓" : "⚔" %></span>
                    <%= battle.title %>
                  </p>
                  <p class="lp-strategy__item-meta"><%= l(battle.scheduled_on, format: :long) if battle.scheduled_on %></p>
                </div>
                <%= render "life_journeys/strategy_overflow", node: battle %>
              </li>
            <% end %>
          </ul>
        <% end %>

        <%# Always allow more battles on a project; primary first create lives in Next Up when ready. %>
        <% unless focus_create %>
          <%= render "life_journeys/strategy_add_card",
                kind: "battle",
                title: (battles.empty? ? t("strategy.next_up.add_battle_title") : t("strategy.add_another_battle")),
                area: area,
                journey: @journey,
                parent_id: @focus.id,
                horizon: "day",
                scheduled_on: Date.current,
                placeholder: t("strategy.battle_placeholder"),
                submit: t("strategy.add_battle"),
                input_id: "board-add-battle-title" %>
        <% end %>
      <% end %>

      <% if focus_create %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</section>
