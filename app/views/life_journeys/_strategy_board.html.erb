<% area = @journey.life_area %>
<% year = @year_goal %>

<section class="lp-strategy space-y-4" aria-label="<%= t('strategy.title') %>">
  <nav class="lp-strategy__horizons" role="tablist">
    <% [
         ["year", t("strategy.horizons.year")],
         ["brief", t("strategy.horizons.brief")],
         ["month", t("strategy.horizons.month")],
         ["week", t("strategy.horizons.week")],
         ["day", t("strategy.horizons.day")]
       ].each do |key, label| %>
      <%= link_to label,
            life_journey_path(@journey, horizon: key, parent_id: (key.in?(%w[week day]) ? @strategy_parent&.id : nil)),
            class: "lp-strategy__horizon #{'is-active' if @active_horizon == key}",
            role: "tab",
            "aria-selected": (@active_horizon == key) %>
    <% end %>
  </nav>

  <div class="lp-strategy__board lp-glass p-5">
    <% case @active_horizon %>
    <% when "year" %>
      <p class="lp-strategy__board-hint"><%= t("strategy.scale.goal_hint") %></p>
      <% if year %>
        <div class="lp-strategy__item mt-4">
          <div>
            <p class="lp-strategy__item-title"><%= year.title %></p>
            <p class="lp-strategy__item-meta"><%= t("strategy.due_by", date: l(year.due_on, format: :long)) %></p>
          </div>
          <%= button_to t("strategy.remove"), strategy_goal_path(year), method: :delete, class: "lp-strategy__remove", form: { data: { turbo: false } } %>
        </div>
        <p class="lp-strategy__feed-note mt-3"><%= t("strategy.next_months") %></p>
        <%= link_to t("strategy.go_months"), life_journey_path(@journey, horizon: "month"), class: "lp-cta mt-3 inline-flex" %>
      <% else %>
        <%= form_with url: strategy_goals_path, method: :post, class: "lp-strategy__form mt-4 space-y-3", data: { turbo: false } do %>
          <%= hidden_field_tag :life_area_id, area.id %>
          <%= hidden_field_tag :life_journey_id, @journey.id %>
          <%= hidden_field_tag :horizon, "year" %>
          <%= text_field_tag :title, @journey.title, required: true, maxlength: 120, class: "lp-input w-full", placeholder: t("strategy.year_placeholder") %>
          <p class="text-sm text-[var(--lp-muted)]"><%= t("strategy.fixed_due", date: l(@year_due, format: :long)) %></p>
          <%= submit_tag t("strategy.add_year"), class: "lp-cta w-full" %>
        <% end %>
      <% end %>

    <% when "brief" %>
      <p class="lp-strategy__board-hint"><%= t("strategy.brief_hint") %></p>
      <%= form_with url: life_journey_path(@journey), method: :patch, class: "mt-4 space-y-4", data: { turbo: false } do %>
        <%= hidden_field_tag :horizon, "brief" %>
        <% LifeJourney::STRATEGY_BRIEF_KEYS.each do |key| %>
          <div>
            <label class="lp-auth-label" for="strategy_brief_<%= key %>"><%= t("strategy.scale.#{key}") %></label>
            <p class="mb-1 text-xs text-[var(--lp-muted)]"><%= t("strategy.scale.#{key}_hint") %></p>
            <%= text_area_tag "strategy_brief[#{key}]", @journey.strategy_brief_value(key),
                  rows: 2, class: "lp-input w-full", id: "strategy_brief_#{key}",
                  placeholder: t("strategy.scale.#{key}_placeholder") %>
          </div>
        <% end %>
        <%= submit_tag t("strategy.save_brief"), class: "lp-cta w-full" %>
      <% end %>

    <% when "month" %>
      <% unless year %>
        <p class="lp-strategy__empty"><%= t("strategy.need_year") %></p>
        <%= link_to t("strategy.go_year"), life_journey_path(@journey, horizon: "year"), class: "lp-cta mt-3 inline-flex" %>
      <% else %>
        <p class="lp-strategy__board-hint"><%= t("strategy.month_hint") %></p>
        <p class="lp-strategy__parent"><%= t("strategy.under", title: year.title) %></p>
        <ul class="lp-strategy__list">
          <% @month_slots.each do |slot| %>
            <% existing = @month_goals.find { |g| g.parent_id == year.id && g.due_on == slot[:due_on] } %>
            <li class="lp-strategy__item">
              <div class="min-w-0 flex-1">
                <p class="lp-strategy__item-meta"><%= slot[:label] %> · <%= t("strategy.due_by", date: l(slot[:due_on], format: :long)) %></p>
                <% if existing %>
                  <p class="lp-strategy__item-title"><%= existing.title %></p>
                  <div class="lp-strategy__item-actions mt-2">
                    <%= link_to t("strategy.break_down"), life_journey_path(@journey, horizon: "week", parent_id: existing.id), class: "lp-strategy__link" %>
                    <%= button_to t("strategy.remove"), strategy_goal_path(existing), method: :delete, class: "lp-strategy__remove", form: { data: { turbo: false } } %>
                  </div>
                <% else %>
                  <%= form_with url: strategy_goals_path, method: :post, class: "mt-2 flex flex-col gap-2", data: { turbo: false } do %>
                    <%= hidden_field_tag :life_area_id, area.id %>
                    <%= hidden_field_tag :life_journey_id, @journey.id %>
                    <%= hidden_field_tag :parent_id, year.id %>
                    <%= hidden_field_tag :horizon, "month" %>
                    <%= hidden_field_tag :due_on, slot[:due_on] %>
                    <%= text_field_tag :title, nil, required: true, maxlength: 120, class: "lp-input w-full", placeholder: t("strategy.month_placeholder") %>
                    <%= submit_tag t("strategy.add_month"), class: "lp-cta w-full" %>
                  <% end %>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>

    <% when "week" %>
      <% parent = @strategy_parent || @month_goals.first %>
      <% if parent.nil? %>
        <p class="lp-strategy__empty"><%= t("strategy.need_month") %></p>
        <%= link_to t("strategy.go_months"), life_journey_path(@journey, horizon: "month"), class: "lp-cta mt-3 inline-flex" %>
      <% else %>
        <p class="lp-strategy__board-hint"><%= t("strategy.week_hint") %></p>
        <p class="lp-strategy__parent"><%= t("strategy.under", title: parent.title) %></p>
        <ul class="lp-strategy__list">
          <% @week_goals.select { |g| g.parent_id == parent.id }.each do |goal| %>
            <li class="lp-strategy__item">
              <div>
                <p class="lp-strategy__item-title"><%= goal.title %></p>
                <p class="lp-strategy__item-meta"><%= t("strategy.due_by", date: l(goal.due_on, format: :long)) if goal.due_on %></p>
              </div>
              <div class="lp-strategy__item-actions">
                <%= link_to t("strategy.break_down"), life_journey_path(@journey, horizon: "day", parent_id: goal.id), class: "lp-strategy__link" %>
                <%= button_to t("strategy.remove"), strategy_goal_path(goal), method: :delete, class: "lp-strategy__remove", form: { data: { turbo: false } } %>
              </div>
            </li>
          <% end %>
        </ul>
        <%= form_with url: strategy_goals_path, method: :post, class: "lp-strategy__form space-y-3", data: { turbo: false } do %>
          <%= hidden_field_tag :life_area_id, area.id %>
          <%= hidden_field_tag :life_journey_id, @journey.id %>
          <%= hidden_field_tag :parent_id, parent.id %>
          <%= hidden_field_tag :horizon, "week" %>
          <%= text_field_tag :title, nil, required: true, maxlength: 120, class: "lp-input w-full", placeholder: t("strategy.week_placeholder") %>
          <label class="lp-auth-label" for="week_due_on"><%= t("strategy.due_label") %></label>
          <%= date_field_tag :due_on, parent.due_on, required: true, class: "lp-input w-full", id: "week_due_on", max: parent.due_on %>
          <%= submit_tag t("strategy.add_week"), class: "lp-cta w-full" %>
        <% end %>
      <% end %>

    <% else %>
      <% parent = @strategy_parent || @week_goals.first %>
      <% if parent.nil? %>
        <p class="lp-strategy__empty"><%= t("strategy.need_week") %></p>
        <%= link_to t("strategy.go_week"), life_journey_path(@journey, horizon: "week"), class: "lp-cta mt-3 inline-flex" %>
      <% else %>
        <p class="lp-strategy__board-hint"><%= t("strategy.day_hint") %></p>
        <p class="lp-strategy__parent"><%= t("strategy.under", title: parent.title) %></p>
        <div class="lp-strategy__weekdays">
          <% @week_dates.each do |date| %>
            <div class="lp-strategy__day-col <%= 'is-today' if date == Date.current %>">
              <p class="lp-strategy__day-label"><%= l(date, format: "%a %-d") %></p>
              <ul class="lp-strategy__day-list">
                <% @day_goals.select { |g| g.parent_id == parent.id && g.scheduled_on == date }.each do |goal| %>
                  <li>
                    <span><%= goal.title %></span>
                    <%= button_to "×", strategy_goal_path(goal), method: :delete, class: "lp-strategy__remove", form: { data: { turbo: false } } %>
                  </li>
                <% end %>
              </ul>
              <%= form_with url: strategy_goals_path, method: :post, class: "lp-strategy__day-form", data: { turbo: false } do %>
                <%= hidden_field_tag :life_area_id, area.id %>
                <%= hidden_field_tag :life_journey_id, @journey.id %>
                <%= hidden_field_tag :parent_id, parent.id %>
                <%= hidden_field_tag :horizon, "day" %>
                <%= hidden_field_tag :scheduled_on, date %>
                <%= text_field_tag :title, nil, required: true, maxlength: 120, class: "lp-input w-full", placeholder: t("strategy.day_placeholder") %>
                <%= submit_tag "+", class: "lp-strategy__day-add" %>
              <% end %>
            </div>
          <% end %>
        </div>
        <%= form_with url: life_journey_path(@journey), method: :patch, class: "mt-4", data: { turbo: false } do %>
          <%= hidden_field_tag :sync_today, "1" %>
          <%= submit_tag t("strategy.sync_today"), class: "lp-cta w-full" %>
        <% end %>
        <p class="lp-strategy__feed-note"><%= t("strategy.feeds_today") %></p>
      <% end %>
    <% end %>
  </div>

  <aside class="lp-glass p-5">
    <h2 class="text-base font-semibold text-[var(--lp-ink)]"><%= t("strategy.plan_together_title") %></h2>
    <p class="mt-2 text-sm text-[var(--lp-muted)] whitespace-pre-line"><%= t("strategy.plan_together_body") %></p>
    <p class="mt-3">
      <%= link_to t("strategy.plan_together_help"), new_feedback_path, class: "font-bold text-[var(--lp-lime)]" %>
    </p>
  </aside>
</section>
