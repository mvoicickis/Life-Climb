<%# Finish-camp overlay on stage photo. locals: project, visible: %>
<% project = local_assigns.fetch(:project) %>
<% visible = local_assigns.fetch(:visible, false) %>
<div id="trail-camp-finish-<%= project.id %>"
     class="lp-trail-camp-finish"
     data-controller="trail-camp-finish"
     data-camp-overlay-panel="<%= project.id %>"
     data-trail-camp-finish-qualified-value="<%= visible %>"
     data-trail-camp-finish-project-id-value="<%= project.id %>"
     data-trail-camp-finish-win-not-saved-value="<%= t('dash.battlefield.win_not_saved') %>"
     hidden
     aria-hidden="true">
  <% if visible %>
    <div class="lp-trail-camp-finish__card lp-trail-camp-idle">
      <div class="lp-trail-camp-finish__icon" aria-hidden="true">✓</div>
      <h3 class="lp-trail-camp-finish__title"><%= t("strategy.rpg.trail.finish_camp_card.title") %></h3>
      <p class="lp-trail-camp-finish__body"><%= t("strategy.rpg.trail.finish_camp_card.body") %></p>
      <button type="button"
              class="lp-trail-camp-finish__cta"
              data-action="click->trail-camp-finish#addAnotherBattle">
        <%= t("strategy.rpg.trail.finish_camp_card.add_another") %>
      </button>
      <%= button_to t("strategy.rpg.trail.finish_camp_card.finish"),
            strategy_goal_manual_completion_path(project),
            method: :post,
            class: "lp-trail-camp-finish__secondary",
            form: {
              class: "lp-trail-camp-finish__form",
              data: {
                turbo: true,
                trail_camp_finish_target: "finishForm",
                action: "turbo:submit-start->trail-camp-finish#beginFinish turbo:submit-end->trail-camp-finish#finishEnded"
              }
            },
            data: {
              trail_camp_finish_target: "finishButton",
              action: "click->trail-camp-finish#finishClick"
            } %>
      <p class="lp-trail-camp-finish__save-notice"
         data-trail-camp-finish-target="saveNotice"
         data-action="click->trail-camp-finish#retryFinish"
         role="status"
         hidden></p>
    </div>
  <% end %>
</div>
