<%# Finish / completed camp overlay. locals: project, state:, plan:, goal:, next_camp:, visible: %>
<% project = local_assigns.fetch(:project) %>
<% state = local_assigns.fetch(:state, :prompt) %>
<% plan = local_assigns[:plan] %>
<% next_camp = local_assigns[:next_camp] %>
<% visible = local_assigns.fetch(:visible, state == :prompt && mountain_trail_finish_camp_card?(project)) %>
<% hidden = state == :hidden %>
<div id="trail-camp-finish-<%= project.id %>"
     class="lp-trail-camp-finish"
     data-controller="trail-camp-finish"
     data-camp-overlay-panel="<%= project.id %>"
     data-trail-camp-finish-qualified-value="<%= visible %>"
     data-trail-camp-finish-finished-undo-value="<%= state == :finished_undo %>"
     data-trail-camp-finish-project-id-value="<%= project.id %>"
     data-trail-camp-finish-win-not-saved-value="<%= t('dash.battlefield.win_not_saved') %>"
     data-trail-camp-finish-undo-label-value="<%= t('strategy.rpg.trail.undo') %>"
     data-trail-camp-finish-reopen-label-value="<%= t('strategy.rpg.trail.finish_camp_card.reopen_camp') %>"
     <%= "hidden" if hidden %>
     aria-hidden="<%= hidden ? "true" : "false" %>">
  <% if state == :prompt && visible %>
    <div class="lp-trail-camp-finish__card lp-trail-camp-idle"
         data-trail-camp-finish-target="promptCard">
      <div class="lp-trail-camp-finish__icon" aria-hidden="true">✓</div>
      <h3 class="lp-trail-camp-finish__title"><%= t("strategy.rpg.trail.finish_camp_card.title") %></h3>
      <p class="lp-trail-camp-finish__body"><%= t("strategy.rpg.trail.finish_camp_card.body") %></p>
      <button type="button"
              class="lp-trail-camp-finish__cta"
              data-action="click->trail-camp-finish#addAnotherBattle">
        <%= t("strategy.rpg.trail.finish_camp_card.add_another") %>
      </button>
      <%= button_to t("strategy.rpg.trail.finish_camp_card.finish"),
            strategy_goal_manual_completion_path(project),
            method: :post,
            class: "lp-trail-camp-finish__secondary",
            form: {
              class: "lp-trail-camp-finish__form",
              data: {
                turbo: true,
                trail_camp_finish_target: "finishForm",
                action: "turbo:submit-start->trail-camp-finish#beginFinish turbo:submit-end->trail-camp-finish#finishEnded"
              }
            },
            data: {
              trail_camp_finish_target: "finishButton",
              action: "click->trail-camp-finish#finishClick"
            } %>
      <p class="lp-trail-camp-finish__save-notice"
         data-trail-camp-finish-target="saveNotice"
         data-action="click->trail-camp-finish#retryFinish"
         role="status"
         hidden></p>
    </div>
  <% elsif state == :finished_undo %>
    <div class="lp-trail-camp-finish__card lp-trail-camp-idle lp-trail-camp-finish__undo-wrap"
         data-trail-camp-finish-target="undoCard">
      <p class="lp-trail-camp-finish__status"><%= t("strategy.rpg.trail.finish_camp_card.finished") %></p>
      <% if next_camp.present? %>
        <button type="button"
                class="lp-trail-camp-finish__cta"
                data-action="click->trail-camp-sheet#openFromDock"
                data-camp-id="<%= next_camp.id %>">
          <span class="lp-trail-camp-finish__cta-text"><%= t("strategy.rpg.trail.finish_camp_card.next_camp", name: next_camp.title) %></span>
        </button>
      <% else %>
        <button type="button"
                class="lp-trail-camp-finish__cta"
                data-action="click->trail-camp-sheet#close">
          <span class="lp-trail-camp-finish__cta-text"><%= t("strategy.rpg.trail.finish_camp_card.back_to_mountain") %></span>
        </button>
      <% end %>
      <%= button_to t("strategy.rpg.trail.undo"),
            strategy_goal_manual_completion_path(project),
            method: :delete,
            class: "lp-trail-camp-finish__undo",
            form: {
              class: "lp-trail-camp-finish__undo-form",
              data: {
                turbo: true,
                trail_camp_finish_target: "undoForm",
                action: "turbo:submit-start->trail-camp-finish#beginUndo turbo:submit-end->trail-camp-finish#undoEnded"
              }
            },
            data: {
              trail_camp_finish_target: "undoButton",
              action: "click->trail-camp-finish#undoClick"
            } %>
      <p class="lp-trail-camp-finish__save-notice"
         data-trail-camp-finish-target="saveNotice"
         data-action="click->trail-camp-finish#retryUndo"
         role="status"
         hidden></p>
    </div>
  <% end %>
</div>
