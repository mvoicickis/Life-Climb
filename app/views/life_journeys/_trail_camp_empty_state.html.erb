<%# Centered idle block when a camp has no open battles. locals: project, variant:, add_form: %>
<% project = local_assigns.fetch(:project) %>
<% variant = local_assigns.fetch(:variant) %>
<% add_form = local_assigns.fetch(:add_form) %>

<div class="lp-trail-camp-idle lp-frost<%= " lp-trail-camp-idle--won" if variant == :won %>">
  <% if variant == :won %>
    <p class="lp-trail-camp-idle__pill">
      <span class="lp-trail-camp-idle__pill-check" aria-hidden="true">✓</span>
      <%= t("strategy.rpg.trail.camp_idle.won_pill") %>
    </p>
  <% else %>
    <h3 class="lp-trail-camp-idle__title">
      <% case variant %>
      <% when :start %>
        <%= t("strategy.rpg.trail.camp_idle.start_title") %>
      <% when :keep %>
        <%= t("strategy.rpg.trail.camp_idle.keep_title") %>
      <% end %>
    </h3>
    <p class="lp-trail-camp-idle__body">
      <% case variant %>
      <% when :start %>
        <%= t("strategy.rpg.trail.camp_idle.start_body") %>
      <% when :keep %>
        <%= t("strategy.rpg.trail.camp_idle.keep_body") %>
      <% end %>
    </p>
  <% end %>
  <button type="button"
          class="lp-trail-battles__composer-trigger"
          data-trail-battles-target="composerTrigger"
          data-action="click->trail-battles#openComposer">
    <% case variant %>
    <% when :start %>
      <%= t("strategy.rpg.trail.camp_idle.start_button") %>
    <% when :won %>
      <%= t("strategy.rpg.trail.camp_idle.won_button") %>
    <% when :keep %>
      <%= t("strategy.rpg.trail.camp_idle.keep_button") %>
    <% end %>
  </button>
  <div class="lp-trail-battles__composer"
       data-trail-battles-target="composer">
    <div class="lp-trail-battles__composer-form"
         data-trail-battles-target="composerForm"
         hidden>
      <%= add_form %>
    </div>
  </div>
</div>
