<%# Collapsed won battles for a camp sheet. locals: project, done_days, area, goal, plan %>
<% project = local_assigns.fetch(:project) %>
<% done_days = local_assigns.fetch(:done_days) %>
<% if done_days.any? %>
  <details class="lp-trail-battles__done" id="trail-battles-done-<%= project.id %>">
    <summary id="trail-battles-done-summary-<%= project.id %>"><%= t("strategy.rpg.trail.won_battles", count: done_days.size) %></summary>
    <ul class="lp-trail-battles__list is-done" id="trail-battles-done-list-<%= project.id %>">
      <% done_days.each do |battle| %>
        <%= render "life_journeys/trail_battle_row", battle: battle %>
      <% end %>
    </ul>
  </details>
<% end %>
