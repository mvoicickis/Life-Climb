<%# Collapsed won battles for a camp sheet. locals: project, won_battles, area, goal, plan %>
<% project = local_assigns.fetch(:project) %>
<% won_battles = local_assigns.fetch(:won_battles) %>
<% if won_battles.any? %>
  <p class="lp-trail-battles__won-here" id="trail-battles-won-here-<%= project.id %>">
    <%= t("strategy.rpg.trail.won_battles_here", count: won_battles.size) %>
  </p>
  <details class="lp-trail-battles__done" id="trail-battles-done-<%= project.id %>">
    <summary id="trail-battles-done-summary-<%= project.id %>"><%= t("strategy.rpg.trail.won_battles_fold") %></summary>
    <ul class="lp-trail-battles__list is-done" id="trail-battles-done-list-<%= project.id %>">
      <% won_battles.each do |battle| %>
        <%= render "life_journeys/trail_battle_row", battle: battle %>
      <% end %>
    </ul>
  </details>
<% end %>
