<%# First-climb coach — one surface: biggest part + today's action. locals: journey, goal %>
<% journey = local_assigns.fetch(:journey)
   goal = local_assigns.fetch(:goal)
   category = Onboarding::Categories.id_for_journey(journey)
   plan_examples = Array(I18n.t("strategy.first_climb.examples.#{category}.plan", default: []))
   action_examples = Array(I18n.t("strategy.first_climb.examples.#{category}.action", default: [])) %>

<section class="lp-first-climb" id="first-climb-coach" aria-label="<%= t('strategy.first_climb.label') %>">
  <p class="lp-first-climb__kicker"><%= t("strategy.first_climb.kicker") %></p>
  <h1 class="lp-first-climb__title"><%= t("strategy.first_climb.title") %></h1>
  <div class="lp-first-climb__climber" aria-hidden="true">
    <%= image_tag current_user.character_image,
          class: "lp-first-climb__climber-img",
          alt: "" %>
  </div>
  <p class="lp-first-climb__goal" title="<%= goal.title %>">
    <%= render "shared/lp_icon", name: "flag", class_name: "lp-icon is-inline" %>
    <span><%= goal.title %></span>
  </p>
  <p class="lp-first-climb__lead"><%= t("strategy.first_climb.lead") %></p>

  <%= form_with url: first_climbs_path,
        method: :post,
        class: "lp-first-climb__form",
        data: {
          turbo: false,
          controller: "first-climb",
          action: "submit->first-climb#disable"
        } do %>
    <%= hidden_field_tag :life_journey_id, journey.id %>

    <label class="lp-first-climb__label" for="first-climb-plan">
      <span class="lp-first-climb__step">1</span>
      <%= t("strategy.first_climb.plan_label") %>
    </label>
    <%= text_field_tag :plan_title, nil,
          id: "first-climb-plan",
          required: true,
          maxlength: 120,
          autofocus: true,
          autocomplete: "off",
          class: "lp-input w-full lp-first-climb__input",
          data: { first_climb_target: "planInput" },
          placeholder: plan_examples.first.presence || t("strategy.first_climb.plan_placeholder") %>
    <% if plan_examples.any? %>
      <div class="lp-first-climb__chips" role="group" aria-label="<%= t('strategy.first_climb.plan_examples_label') %>">
        <% plan_examples.each do |example| %>
          <button type="button"
                  class="lp-first-climb__chip"
                  data-action="first-climb#fill"
                  data-first-climb-field-param="plan"
                  data-first-climb-value-param="<%= example %>">
            <%= example %>
          </button>
        <% end %>
      </div>
    <% end %>
    <p class="lp-first-climb__hint"><%= t("strategy.first_climb.plan_hint") %></p>

    <label class="lp-first-climb__label" for="first-climb-action">
      <span class="lp-first-climb__step">2</span>
      <%= t("strategy.first_climb.action_label") %>
    </label>
    <%= text_field_tag :today_action, nil,
          id: "first-climb-action",
          required: true,
          maxlength: 120,
          autocomplete: "off",
          class: "lp-input w-full lp-first-climb__input",
          data: { first_climb_target: "actionInput" },
          placeholder: action_examples.first.presence || t("strategy.first_climb.action_placeholder") %>
    <% if action_examples.any? %>
      <div class="lp-first-climb__chips" role="group" aria-label="<%= t('strategy.first_climb.action_examples_label') %>">
        <% action_examples.each do |example| %>
          <button type="button"
                  class="lp-first-climb__chip"
                  data-action="first-climb#fill"
                  data-first-climb-field-param="action"
                  data-first-climb-value-param="<%= example %>">
            <%= example %>
          </button>
        <% end %>
      </div>
    <% end %>
    <p class="lp-first-climb__hint"><%= t("strategy.first_climb.action_hint") %></p>

    <%= submit_tag t("strategy.first_climb.cta"),
          class: "lp-first-climb__cta",
          data: { first_climb_target: "submit" } %>
  <% end %>
</section>
