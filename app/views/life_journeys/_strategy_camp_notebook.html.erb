<%# Camp notebook — working area for Plan → Projects → Battles. Progressive disclosure, no tabs. %>
<% plans = @goal ? @goal.children.select(&:plan?).sort_by(&:position) : [] %>
<% open_plan = @branch_plan %>
<% open_project = @branch_project %>
<% area = @journey.life_area %>
<% notebook_open = open_plan.present? || (@open_sheet && @sheet_node&.plan?) || (@open_sheet && @sheet_node&.goal?) %>

<aside id="strategy-camp-notebook"
       class="lp-camp-notebook <%= 'is-open' if notebook_open %>"
       data-strategy-notebook-target="notebook"
       data-strategy-mountain-target="notebook"
       aria-label="<%= t('strategy.notebook.label') %>"
       <%= "hidden" unless notebook_open %>>
  <div class="lp-camp-notebook__handle" aria-hidden="true"></div>

  <header class="lp-camp-notebook__head">
    <nav class="lp-camp-notebook__crumb" data-strategy-notebook-target="crumb" aria-label="<%= t('strategy.notebook.crumb') %>">
      <% if @goal %>
        <button type="button"
                class="lp-camp-notebook__crumb-item is-goal"
                data-action="strategy-notebook#focusGoal"
                data-node-id="<%= @goal.id %>">
          <span aria-hidden="true">🚩</span>
          <span><%= @goal.title.truncate(18) %></span>
        </button>
      <% end %>
      <span class="lp-camp-notebook__crumb-sep" data-strategy-notebook-target="crumbPlanSep" <%= "hidden" unless open_plan %> aria-hidden="true">›</span>
      <button type="button"
              class="lp-camp-notebook__crumb-item is-plan"
              data-strategy-notebook-target="crumbPlan"
              data-action="strategy-notebook#focusPlanCrumb"
              <%= "hidden" unless open_plan %>>
        <span aria-hidden="true">🪧</span>
        <span data-strategy-notebook-target="crumbPlanTitle"><%= open_plan&.title&.truncate(18) %></span>
      </button>
      <span class="lp-camp-notebook__crumb-sep" data-strategy-notebook-target="crumbProjectSep" <%= "hidden" unless open_project %> aria-hidden="true">›</span>
      <span class="lp-camp-notebook__crumb-item is-project"
            data-strategy-notebook-target="crumbProject"
            <%= "hidden" unless open_project %>>
        <span aria-hidden="true">⛺</span>
        <span data-strategy-notebook-target="crumbProjectTitle"><%= open_project&.title&.truncate(18) %></span>
      </span>
    </nav>

    <div class="lp-camp-notebook__title-row">
      <h2 class="lp-camp-notebook__title" data-strategy-notebook-target="title">
        <%= open_plan&.title || @goal&.title || t("strategy.notebook.label") %>
      </h2>
      <button type="button"
              class="lp-camp-notebook__close"
              data-action="strategy-notebook#close"
              aria-label="<%= t('strategy.sheet.close') %>">×</button>
    </div>
  </header>

  <%# Goal mode: list plans + add plan %>
  <div class="lp-camp-notebook__panel is-goal"
       data-strategy-notebook-target="goalPanel"
       <%= "hidden" if open_plan %>>
    <ul class="lp-camp-notebook__list" role="list">
      <% plans.each do |plan| %>
        <li>
          <button type="button"
                  class="lp-camp-notebook__row is-plan"
                  data-action="strategy-notebook#openPlan"
                  data-plan-id="<%= plan.id %>"
                  data-plan-title="<%= plan.title %>">
            <span class="lp-camp-notebook__row-icon" aria-hidden="true">🪧</span>
            <span class="lp-camp-notebook__row-body">
              <span class="lp-camp-notebook__row-title"><%= plan.title %></span>
              <span class="lp-camp-notebook__row-meta">
                <%= t("strategy.zones.projects_count", count: strategy_projects_count(plan)) %>
              </span>
            </span>
            <span class="lp-camp-notebook__row-chevron" aria-hidden="true">›</span>
          </button>
        </li>
      <% end %>
    </ul>
    <% if plans.empty? %>
      <p class="lp-camp-notebook__empty"><%= t("strategy.zones.add_plan_hint") %></p>
    <% end %>
  </div>

  <%# One panel per plan: projects list with expand-to-battles %>
  <% plans.each do |plan| %>
    <% projects = plan.children.select(&:project?).sort_by(&:position) %>
    <div class="lp-camp-notebook__panel is-plan"
         data-strategy-notebook-target="planPanel"
         data-plan-id="<%= plan.id %>"
         data-plan-title="<%= plan.title %>"
         <%= "hidden" unless open_plan&.id == plan.id %>>
      <ul class="lp-camp-notebook__list" role="list">
        <% projects.each do |project| %>
          <% battles = project.children.select(&:day?).sort_by(&:position) %>
          <% battle_count = battles.size %>
          <% expanded = open_project&.id == project.id %>
          <li class="lp-camp-notebook__project <%= 'is-expanded' if expanded %>"
              data-strategy-notebook-target="projectItem"
              data-project-id="<%= project.id %>"
              data-project-title="<%= project.title %>"
              data-plan-id="<%= plan.id %>">
            <button type="button"
                    class="lp-camp-notebook__row is-project <%= 'is-active' if expanded %>"
                    data-action="strategy-notebook#toggleProject"
                    data-project-id="<%= project.id %>"
                    data-project-title="<%= project.title %>"
                    data-plan-id="<%= plan.id %>"
                    aria-expanded="<%= expanded %>">
              <span class="lp-camp-notebook__row-icon" aria-hidden="true">⛺</span>
              <span class="lp-camp-notebook__row-body">
                <span class="lp-camp-notebook__row-title"><%= project.title %></span>
                <span class="lp-camp-notebook__row-meta">
                  <%= t("strategy.zones.battles_count", count: battle_count) %>
                </span>
              </span>
              <span class="lp-camp-notebook__row-chevron" aria-hidden="true"><%= expanded ? "▾" : "›" %></span>
            </button>

            <div class="lp-camp-notebook__battles" <%= "hidden" unless expanded %>>
              <% battles.each do |battle| %>
                <div class="lp-camp-notebook__battle <%= 'is-done' if battle.completed? %> <%= 'is-today' if @today_battle&.id == battle.id %>">
                  <span class="lp-camp-notebook__battle-icon" aria-hidden="true">⚔</span>
                  <span class="lp-camp-notebook__battle-title"><%= battle.title %></span>
                  <% if battle.completed? %>
                    <span class="lp-camp-notebook__battle-check" aria-hidden="true">✓</span>
                  <% elsif @today_battle&.id == battle.id && @mountain_ready %>
                    <%= button_to life_journey_path(@journey),
                          method: :patch,
                          params: { sync_today: 1 },
                          class: "lp-camp-notebook__fight",
                          form: { data: { turbo: false } } do %>
                      <%= t("strategy.fight.trail_cta") %>
                    <% end %>
                  <% end %>
                  <button type="button"
                          class="lp-camp-notebook__battle-more"
                          data-action="strategy-mountain#openSheetFromButton"
                          data-sheet-id="strategy-sheet-<%= battle.id %>"
                          aria-label="<%= t('strategy.sheet.edit') %>">···</button>
                </div>
              <% end %>
              <% if battles.empty? %>
                <p class="lp-camp-notebook__empty is-nested"><%= t("strategy.zones.add_battle_hint") %></p>
              <% end %>

              <details class="lp-camp-notebook__add is-battle">
                <summary><%= t("strategy.sheet.add_battle") %></summary>
                <%= form_with url: strategy_goals_path, method: :post, class: "lp-camp-notebook__form" do %>
                  <%= hidden_field_tag :life_area_id, area.id %>
                  <%= hidden_field_tag :life_journey_id, @journey.id %>
                  <%= hidden_field_tag :horizon, "day" %>
                  <%= hidden_field_tag :parent_id, project.id %>
                  <%= hidden_field_tag :scheduled_on, Date.current %>
                  <%= text_field_tag :title, nil,
                        required: true,
                        maxlength: 120,
                        class: "lp-input w-full",
                        placeholder: t("strategy.battle_placeholder"),
                        autocomplete: "off" %>
                  <%= submit_tag t("strategy.sheet.add_battle"), class: "lp-camp-notebook__submit" %>
                <% end %>
              </details>
            </div>
          </li>
        <% end %>
      </ul>

      <% if projects.empty? %>
        <p class="lp-camp-notebook__empty"><%= t("strategy.zones.add_project_hint") %></p>
      <% end %>

      <details class="lp-camp-notebook__add is-project" <%= "open" if projects.empty? %>>
        <summary><%= t("strategy.sheet.add_project") %></summary>
        <%= form_with url: strategy_goals_path, method: :post, class: "lp-camp-notebook__form" do %>
          <%= hidden_field_tag :life_area_id, area.id %>
          <%= hidden_field_tag :life_journey_id, @journey.id %>
          <%= hidden_field_tag :horizon, "project" %>
          <%= hidden_field_tag :parent_id, plan.id %>
          <%= text_field_tag :title, nil,
                required: true,
                maxlength: 120,
                class: "lp-input w-full",
                placeholder: t("strategy.project_placeholder"),
                autocomplete: "off" %>
          <%= submit_tag t("strategy.sheet.add_project"), class: "lp-camp-notebook__submit" %>
        <% end %>
      </details>
    </div>
  <% end %>

  <footer class="lp-camp-notebook__foot">
    <button type="button"
            class="lp-camp-notebook__context-add"
            data-strategy-notebook-target="contextAdd"
            data-action="strategy-notebook#contextAdd"
            data-plan="<%= t('strategy.sheet.add_plan') %>"
            data-project="<%= t('strategy.sheet.add_project') %>"
            data-battle="<%= t('strategy.sheet.add_battle') %>">
      <%= if open_project
            t("strategy.sheet.add_battle")
          elsif open_plan
            t("strategy.sheet.add_project")
          else
            t("strategy.sheet.add_plan")
          end %>
    </button>
    <% if @goal %>
      <details class="lp-camp-notebook__add is-plan is-context" data-strategy-notebook-target="goalAdd" <%= "hidden" if open_plan %>>
        <summary class="lp-camp-notebook__sr"><%= t("strategy.sheet.add_plan") %></summary>
        <%= form_with url: strategy_goals_path, method: :post, class: "lp-camp-notebook__form" do %>
          <%= hidden_field_tag :life_area_id, area.id %>
          <%= hidden_field_tag :life_journey_id, @journey.id %>
          <%= hidden_field_tag :horizon, "plan" %>
          <%= hidden_field_tag :parent_id, @goal.id %>
          <%= text_field_tag :title, nil,
                required: true,
                maxlength: 120,
                class: "lp-input w-full",
                placeholder: t("strategy.plan_placeholder"),
                autocomplete: "off" %>
          <%= submit_tag t("strategy.sheet.add_plan"), class: "lp-camp-notebook__submit" %>
        <% end %>
      </details>
    <% end %>
  </footer>
</aside>
