<%# Top-left My world entry on Mountain v4. %>
<%= link_to world_path,
      class: "lp-trail__my-world-corner lp-pressable",
      data: { trail_ignore: true },
      aria: { label: t("my_world.open") } do %>
  <span class="lp-trail__my-world-corner__face" aria-hidden="true">
    <%= render "shared/planet_icon" %>
  </span>
  <span class="lp-trail__my-world-corner__label"><%= t("my_world.pill") %></span>
<% end %>
