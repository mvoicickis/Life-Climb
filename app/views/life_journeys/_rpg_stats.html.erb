<%# Stats strip above bottom nav. locals: mountain, alive, streak %>
<% mountain = local_assigns.fetch(:mountain, {}) %>
<% alive = local_assigns[:alive] || current_user.alive_level %>
<% streak = local_assigns[:streak] || strategy_climb_streak_status %>

<section class="lp-rpg-stats" aria-label="<%= t('strategy.rpg.stats') %>">
  <div class="lp-rpg-stat is-xp">
    <span class="lp-rpg-stat__icon" aria-hidden="true">★</span>
    <span class="lp-rpg-stat__value"><%= number_with_delimiter(current_user.life_points) %></span>
    <span class="lp-rpg-stat__label"><%= t("strategy.rpg.xp") %></span>
  </div>
  <div class="lp-rpg-stat is-streak">
    <span class="lp-rpg-stat__icon" aria-hidden="true">🔥</span>
    <span class="lp-rpg-stat__value"><%= streak.days %></span>
    <span class="lp-rpg-stat__label"><%= t("strategy.rpg.streak") %></span>
  </div>
  <div class="lp-rpg-stat is-mountain">
    <span class="lp-rpg-stat__icon" aria-hidden="true">⛰</span>
    <span class="lp-rpg-stat__value"><%= mountain[:progress].to_i %>%</span>
    <span class="lp-rpg-stat__label"><%= t("strategy.rpg.mountain") %></span>
  </div>
  <div class="lp-rpg-stat is-rank">
    <span class="lp-rpg-stat__icon" aria-hidden="true">⛨</span>
    <span class="lp-rpg-stat__value"><%= alive.title %></span>
    <span class="lp-rpg-stat__label"><%= t("strategy.rpg.level_n", n: alive.number) %></span>
  </div>
</section>
