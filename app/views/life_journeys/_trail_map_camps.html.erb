<%# Curve map: up to 4 tents from Strategy::Trail visible_nodes. locals: trail, current_project %>
<% trail = local_assigns.fetch(:trail) %>
<% current_project = local_assigns[:current_project] %>
<% map_nodes = mountain_trail_map_nodes(trail) %>
<% hidden_ahead = mountain_trail_map_hidden_ahead_count(trail) %>

<div id="trail-map-camps">
  <div class="lp-trail__camps" id="trail-camps" data-trail-canvas-target="camps" aria-label="<%= t('strategy.rpg.what_gets_me_there') %>">
    <% map_nodes.each do |node| %>
      <%= render "life_journeys/trail_camp",
            project: node.record,
            trail_node: node,
            map_nodes: map_nodes,
            current_project: current_project,
            map_mode: true %>
    <% end %>
    <% if hidden_ahead.positive? %>
      <button type="button"
              class="lp-trail-more"
              data-action="click->trail-canvas#openArrangeCamps"
              aria-label="<%= t('strategy.rpg.trail.more_camps', count: hidden_ahead) %>">
        <%= t("strategy.rpg.trail.more_camps", count: hidden_ahead) %>
      </button>
    <% end %>
  </div>
</div>
