<%# Sticky Fight CTA + battle bottom sheet matching mockup. %>
<% next_up = @next_up %>
<section class="lp-strategy-fight is-sticky is-mockup is-sheet" aria-label="<%= t('strategy.fight.label') %>">
  <% if @today_battle.present? && @mountain_ready %>
    <%= button_to life_journey_path(@journey),
          method: :patch,
          params: { sync_today: 1 },
          class: "lp-strategy-fight__cta is-primary",
          form: { data: { turbo: false }, class: "lp-strategy-fight__cta-form" } do %>
      <span class="lp-strategy-fight__cta-icon" aria-hidden="true">⚔</span>
      <span class="lp-strategy-fight__cta-label"><%= t("strategy.fight.trail_cta") %></span>
      <span class="lp-strategy-fight__cta-chevron" aria-hidden="true"></span>
    <% end %>
    <%= link_to life_journey_path(@journey, focus_id: @today_battle.parent_id),
          class: "lp-strategy-fight__sheet",
          aria: { label: t("strategy.fight.current_battle") } do %>
      <span class="lp-strategy-fight__sheet-handle" aria-hidden="true"></span>
      <span class="lp-strategy-fight__sheet-row">
        <span class="lp-strategy-fight__sheet-badge" aria-hidden="true"></span>
        <span class="lp-strategy-fight__sheet-copy">
          <span class="lp-strategy-fight__sheet-title"><%= @today_battle.title %></span>
          <span class="lp-strategy-fight__sheet-meta">
            <%= t("strategy.horizons.day") %>
            · +<%= GameRules::BATTLE_TODO_LP %> <%= t("dash.action_points_short") %>
          </span>
        </span>
        <span class="lp-strategy-fight__sheet-chevron" aria-hidden="true"></span>
      </span>
    <% end %>
  <% elsif next_up.present? && next_up[:form].present? %>
    <% area = @journey.life_area %>
    <% form = next_up[:form] %>
    <% level = { "goal" => "goal", "plan" => "plan", "project" => "project", "day" => "battle" }.fetch(form[:horizon].to_s, "goal") %>
    <div class="lp-strategy-fight__form is-<%= level %>" id="strategy-next-up" data-controller="strategy-next">
      <p class="lp-strategy-fight__kicker"><%= t("strategy.fight.build_kicker") %></p>
      <h2 class="lp-strategy-fight__title"><%= next_up[:title] %></h2>
      <p class="lp-strategy-fight__hint"><%= next_up[:hint] %></p>
      <%= form_with url: strategy_goals_path, method: :post, class: "lp-strategy-fight__create", data: { turbo: false } do %>
        <%= hidden_field_tag :life_area_id, area.id %>
        <%= hidden_field_tag :life_journey_id, @journey.id %>
        <%= hidden_field_tag :horizon, form[:horizon] %>
        <% if form[:parent_id].present? %>
          <%= hidden_field_tag :parent_id, form[:parent_id] %>
        <% end %>
        <% if form[:scheduled_on].present? %>
          <%= hidden_field_tag :scheduled_on, form[:scheduled_on] %>
        <% end %>
        <%= text_field_tag :title,
              (form[:horizon] == "goal" ? @journey.title : nil),
              required: true,
              maxlength: 120,
              id: "next-up-title",
              class: "lp-input w-full",
              placeholder: next_up[:placeholder] || t("strategy.goal_placeholder"),
              autofocus: true %>
        <% Array(next_up[:examples]).each do |example| %>
          <button type="button"
                  class="lp-strategy-fight__chip"
                  data-action="strategy-next#fillExample"
                  data-title="<%= example %>"><%= example %></button>
        <% end %>
        <%= submit_tag next_up[:cta], class: "lp-strategy-fight__cta is-primary" %>
      <% end %>
    </div>
  <% elsif next_up.present? && next_up[:href].present? %>
    <div class="lp-strategy-fight__form is-enter" id="strategy-next-up">
      <p class="lp-strategy-fight__kicker"><%= t("strategy.fight.build_kicker") %></p>
      <h2 class="lp-strategy-fight__title"><%= next_up[:title] %></h2>
      <p class="lp-strategy-fight__hint"><%= next_up[:hint] %></p>
      <%= link_to next_up[:cta], next_up[:href], class: "lp-strategy-fight__cta is-primary" %>
    </div>
  <% elsif next_up.present? && next_up[:key] == :go_today %>
    <%= button_to life_journey_path(@journey),
          method: :patch,
          params: { sync_today: 1 },
          class: "lp-strategy-fight__cta is-primary",
          form: { data: { turbo: false }, class: "lp-strategy-fight__cta-form" } do %>
      <span class="lp-strategy-fight__cta-icon" aria-hidden="true">⚔</span>
      <span class="lp-strategy-fight__cta-label"><%= t("strategy.fight.trail_cta") %></span>
      <span class="lp-strategy-fight__cta-chevron" aria-hidden="true"></span>
    <% end %>
  <% elsif @sheet_node.present? && strategy_child_horizon(@sheet_node).present? %>
    <p class="lp-strategy-fight__hint"><%= next_up&.dig(:hint) || t("strategy.fight.keep_building") %></p>
    <button type="button"
            class="lp-strategy-fight__cta is-quiet"
            data-action="strategy-mountain#openFocusedAdd">
      <%= strategy_add_label(@sheet_node) %>
    </button>
  <% end %>
</section>
