<% if @project.present? %>
  <% finish_state = mountain_trail_finish_card_state(@project) %>
  <%= turbo_stream.replace "trail-camp-finish-#{@project.id}" do %>
    <%= render "life_journeys/trail_camp_finish_card",
          project: @project,
          plan: @plan,
          goal: @goal,
          next_camp: @next_camp,
          state: finish_state,
          visible: finish_state == :prompt %>
  <% end %>
  <%= turbo_stream.replace "trail-battles-#{@project.id}" do %>
    <%= render "life_journeys/trail_camp_battles",
          project: @project,
          goal: @goal,
          plan: @plan,
          area: @project.life_area %>
  <% end %>
  <%= turbo_stream.replace "trail-sheet-menu-#{@project.id}" do %>
    <div id="trail-sheet-menu-<%= @project.id %>"
         class="lp-trail-sheet__camp-menu"
         data-controller="plan-card-menu"
         data-camp-menu-panel="<%= @project.id %>">
      <%= render "life_journeys/trail_camp_sheet_menu", project: @project %>
    </div>
  <% end %>
  <%= turbo_stream.replace "trail-sheet-finish-undo-bar" do %>
    <div id="trail-sheet-finish-undo-bar"
         class="lp-trail-sheet__finish-undo-bar"
         data-trail-camp-sheet-target="finishUndoBar"
         hidden
         aria-hidden="true"></div>
  <% end %>
  <%= render "life_journeys/trail_mountain_state_streams" if @trail_summit_state_flipped %>
  <% if @trail_summit_state_flipped && !@trail_world[:summit_reached] && @project.present? %>
    <%= turbo_stream.open_trail_camp(@project.id) %>
  <% elsif @plan.present? && @journey.present? && !@trail_summit_state_flipped %>
    <%= render "life_journeys/trail_map_camp_stream",
          plan: @plan,
          journey: @journey,
          ensure_visible_id: @project.id %>
  <% end %>
<% end %>
