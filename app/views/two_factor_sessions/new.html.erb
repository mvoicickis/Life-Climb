<% content_for :title, t("two_factor.challenge_title") %>

<div class="lp-auth-card mx-auto max-w-md">
  <%= render "shared/auth_topbar" %>

  <h1 class="lp-auth-title"><%= t("two_factor.challenge_title") %></h1>
  <p class="lp-auth-sub"><%= t("two_factor.challenge_subtitle") %></p>

  <%= form_with url: two_factor_session_path, class: "space-y-4", data: { turbo: false } do |form| %>
    <div>
      <%= form.label :code, t("two_factor.code_label"), class: "lp-auth-label" %>
      <%= form.text_field :code,
            required: true,
            autofocus: true,
            autocomplete: "one-time-code",
            inputmode: "numeric",
            maxlength: 16,
            class: "lp-auth-input",
            placeholder: t("two_factor.code_placeholder") %>
      <p class="mt-2 text-xs font-semibold text-[var(--lp-muted,#475569)]"><%= t("two_factor.code_hint") %></p>
    </div>

    <%= form.submit t("two_factor.verify"), class: "lp-auth-submit" %>
  <% end %>

  <p class="mt-6 text-center text-sm font-semibold">
    <%= button_to t("two_factor.back_to_sign_in"), two_factor_session_path, method: :delete, class: "lp-auth-link", form: { data: { turbo: false } } %>
  </p>
</div>
